114],[-46.54406,-23.71145],[-46.54383,-23.71178],[-46.54371,-23.71195],[-46.54352,-23.71224],[-46.54329,-23.7126],[-46.54293,-23.71309],[-46.54281,-23.71326],[-46.54259,-23.71366],[-46.54236,-23.71399],[-46.54228,-23.71415],[-46.54216,-23.71438],[-46.54214,-23.71455],[-46.54212,-23.7147],[-46.54206,-23.71489],[-46.54189,-23.71481],[-46.54172,-23.71479],[-46.54127,-23.71579]],\\\"mapStops\\\":[{\\\"name\\\":\\\"Allianz Parque — Palmeiras (Palestra Itália)\\\",\\\"lat\\\":-23.5271,\\\"lng\\\":-46.7179,\\\"hasContent\\\":false},{\\\"name\\\":\\\"MUSEU DO FUTEBOL\\\",\\\"lat\\\":-23.5459,\\\"lng\\\":-46.6654,\\\"hasContent\\\":true},{\\\"name\\\":\\\"Canindé — Portuguesa de Desportos\\\",\\\"lat\\\":-23.5049,\\\"lng\\\":-46.6204,\\\"hasContent\\\":false},{\\\"name\\\":\\\"Ponte Metálica do Ibirapuera\\\",\\\"lat\\\":-23.5882,\\\"lng\\\":-46.6605,\\\"hasContent\\\":false},{\\\"name\\\":\\\"Estádio Cícero Pompeu de Toledo (Morumbi)\\\",\\\"lat\\\":-23.6005,\\\"lng\\\":-46.7197,\\\"hasContent\\\":true},{\\\"name\\\":\\\"Autódromo José Carlos Pace — GP do Brasil de F1\\\",\\\"lat\\\":-23.7014,\\\"lng\\\":-46.6991,\\\"hasContent\\\":false},{\\\"name\\\":\\\"Estádio Nicolau Alayon — EC Santo André\\\",\\\"lat\\\":-23.6512,\\\"lng\\\":-46.5318,\\\"hasContent\\\":false},{\\\"name\\\":\\\"Neo Química Arena (Estádio)\\\",\\\"lat\\\":-23.5453,\\\"lng\\\":-46.4741,\\\"hasContent\\\":false},{\\\"name\\\":\\\"Relógio de Sol\\\",\\\"lat\\\":-23.4966,\\\"lng\\\":-46.874,\\\"hasContent\\\":true},{\\\"name\\\":\\\"Centro de Treinamento Paralímpico (legado Pan 2007)\\\",\\\"lat\\\":-23.7158,\\\"lng\\\":-46.5413,\\\"hasContent\\\":false}],\\\"stops\\\":[{\\\"position\\\":1,\\\"name\\\":\\\"Allianz Parque — Palmeiras (Palestra Itália)\\\",\\\"description\\\":\\\"\\\",\\\"audios\\\":[],\\\"hasContent\\\":false,\\\"alsoPositions\\\":[],\\\"defaultLang\\\":\\\"en\\\"},{\\\"position\\\":2,\\\"name\\\":\\\"MUSEU DO FUTEBOL\\\",\\\"description\\\":\\\"Nestled within the iconic Pacaembu Stadium, this vibrant museum celebrates the profound cultural significance of football in Brazil. Inaugurated in 2008, it offers an immersive journey through the sport's history, from its European origins to its deep integration into the national identity. Through interactive exhibits and a unique architectural integration with the stadium, visitors can explore the evolution of the game, its social impact, and its connection to Brazilian arts and life. A notable architectural feature is the \\\\\\\"Exaltation Room,\\\\\\\" which offers a dramatic view into the stadium's underbelly, surrounded by projected images and sounds of passionate fans.\\\",\\\"audios\\\":[{\\\"lang\\\":\\\"en\\\",\\\"label\\\":\\\"EN\\\",\\\"audioUrl\\\":\\\"https://tysnkzmljlmmqpbotkxv.supabase.co/storage/v1/object/public/travel-app-audios/master_audio/0e8d7ebd-8ff6-56b7-8129-4e19fab86c38/0e8d7ebd-8ff6-56b7-8129-4e19fab86c38-en-us-male.mp3\\\"},{\\\"lang\\\":\\\"pt-br\\\",\\\"label\\\":\\\"PT-BR\\\",\\\"audioUrl\\\":\\\"https://tysnkzmljlmmqpbotkxv.supabase.co/storage/v1/object/public/travel-app-audios/master_audio/0e8d7ebd-8ff6-56b7-8129-4e19fab86c38/0e8d7ebd-8ff6-56b7-8129-4e19fab86c38-pt-br-male.mp3\\\"}],\\\"hasContent\\\":true,\\\"alsoPositions\\\":[],\\\"defaultLang\\\":\\\"en\\\"},{\\\"position\\\":3,\\\"name\\\":\\\"Canindé — Portuguesa de Desportos\\\",\\\"description\\\":\\\"\\\",\\\"audios\\\":[],\\\"hasContent\\\":false,\\\"alsoPositions\\\":[],\\\"defaultLang\\\":\\\"en\\\"},{\\\"position\\\":4,\\\"name\\\":\\\"Ponte Metálica do Ibirapuera\\\",\\\"description\\\":\\\"\\\",\\\"audios\\\":[],\\\"hasContent\\\":false,\\\"alsoPositions\\\":[],\\\"defaultLang\\\":\\\"en\\\"},{\\\"position\\\":5,\\\"name\\\":\\\"Estádio Cícero Pompeu de Toledo (Morumbi)\\\",\\\"description\\\":\\\"\\\",\\\"audios\\\":[{\\\"lang\\\":\\\"pt-br\\\",\\\"label\\\":\\\"PT-BR\\\",\\\"audioUrl\\\":\\\"https://tysnkzmljlmmqpbotkxv.supabase.co/storage/v1/object/public/travel-app-audios/master_audio/3704c134-946f-41ca-82c