ntity\":[{\"@type\":\"Question\",\"name\":\"How long does this tour take?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"About 4h 18min of audio across 10 stops, covering roughly 201.6 km. Go at your own pace — the audio plays automatically as you move.\"}},{\"@type\":\"Question\",\"name\":\"Is this tour accessible?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"This route is rated: Partially accessible. Check each stop for specific access details.\"}},{\"@type\":\"Question\",\"name\":\"What languages is it available in?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"This tour is available in: English, Español, Português, Italiano.\"}},{\"@type\":\"Question\",\"name\":\"Do I need an internet connection?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Download the tour in the Tuggi app and listen offline — the audio is triggered by your location, hands-free.\"}},{\"@type\":\"Question\",\"name\":\"Can I do it walking or driving?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"This route is designed for Moderate travel. The audio adapts to your pace.\"}}]}]}0:{\"buildId\":\"sgcYRXgj6Q_bI4KL2gAqo\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"article\",null,{\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2\"}}],\"$L3\",\"$L4\",\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\"]}],[\"$La\",\"$Lb\"],\"$Lc\"]}],\"loading\":null,\"isPartial\":false}\n3:[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"bg-white border-b border-gray-100\",\"children\":[\"$\",\"div\",null,{\"className\":\"page-shell py-3 text-sm text-tuggi-slate flex flex-wrap gap-2\",\"children\":[[\"$\",\"$Ld\",null,{\"href\":\"/en/tours\",\"className\":\"hover:text-tuggi-primary-text\",\"children\":\"Audio Tours\"}],[\"$\",\"span\",null,{\"aria-hidden\":true,\"children\":\"›\"}],[\"$\",\"$Ld\",null,{\"href\":\"/en/tours/brazil\",\"className\":\"hover:text-tuggi-primary-text\",\"children\":\"B