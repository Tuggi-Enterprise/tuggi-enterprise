-46.54228,-23.71415],[-46.54216,-23.71438],[-46.54214,-23.71455],[-46.54212,-23.7147],[-46.54206,-23.71489],[-46.54189,-23.71481],[-46.54172,-23.71479],[-46.54127,-23.71579]],\"mapStops\":[{\"name\":\"Allianz Parque — Palmeiras (Palestra Itália)\",\"lat\":-23.5271,\"lng\":-46.7179,\"hasContent\":false},{\"name\":\"MUSEU DO FUTEBOL\",\"lat\":-23.5459,\"lng\":-46.6654,\"hasContent\":true},{\"name\":\"Canindé — Portuguesa de Desportos\",\"lat\":-23.5049,\"lng\":-46.6204,\"hasContent\":false},{\"name\":\"Ponte Metálica do Ibirapuera\",\"lat\":-23.5882,\"lng\":-46.6605,\"hasContent\":false},{\"name\":\"Estádio Cícero Pompeu de Toledo (Morumbi)\",\"lat\":-23.6005,\"lng\":-46.7197,\"hasContent\":true},{\"name\":\"Autódromo José Carlos Pace — GP do Brasil de F1\",\"lat\":-23.7014,\"lng\":-46.6991,\"hasContent\":false},{\"name\":\"Estádio Nicolau Alayon — EC Santo André\",\"lat\":-23.6512,\"lng\":-46.5318,\"hasContent\":false},{\"name\":\"Neo Química Arena (Estádio)\",\"lat\":-23.5453,\"lng\":-46.4741,\"hasContent\":false},{\"name\":\"Relógio de Sol\",\"lat\":-23.4966,\"lng\":-46.874,\"hasContent\":true},{\"name\":\"Centro de Treinamento Paralímpico (legado Pan 2007)\",\"lat\":-23.7158,\"lng\":-46.5413,\"hasContent\":false}],\"stops\":[{\"position\":1,\"name\":\"Allianz Parque — Palmeiras (Palestra Itália)\",\"description\":\"\",\"audios\":[],\"hasContent\":false,\"alsoPositions\":[],\"defaultLang\":\"en\"},{\"position\":2,\"name\":\"MUSEU DO FUTEBOL\",\"description\":\"Nestled within the iconic Pacaembu Stadium, this vibrant museum celebrates the profound cultural significance of football in Brazil. Inaugurated in 2008, it offers an immersive journey through the sport's history, from its European origins to its deep integration into the national identity. Through interactive exhibits and a unique architectural integration with the stadium, visitors can explore the evolution of the game, its social impact, and its connection to Brazilian arts and life. A notable architectural feature is the \\\"Exaltation Room,\\\" which offers a dramatic view into the stadium's underbelly, surrounded by projected images and sounds of passionate fans.\",\"audios\":[{\"lang\":\"en\",\"label\":\"EN\",\"audioUrl\":\"https://tysnkzmljlmmqpbotkxv.supabase.co/storage/v1/object/public/travel-app-audios/master_audio/0e8d7ebd-8ff6-56b7-8129-4e19fab86c38/0e8d7ebd-8ff6-56b7-8129-4e19fab86c38-en-us-male.mp3\"},{\"lang\":\"pt-br\",\"label\":\"PT-BR\",\"audioUrl\":\"https://tysnkzmljlmmqpbotkxv.supabase.co/storage/v1/object/public/travel-app-audios/master_audio/0e8d7ebd-8ff6-56b7-8129-4e19fab86c38/0e8d7ebd-8ff6-56b7-8129-4e19fab86c38-pt-br-male.mp3\"}],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"en\"},{\"position\":3,\"name\":\"Canindé — Portuguesa de Desportos\",\"description\":\"\",\"audios\":[],\"hasContent\":false,\"alsoPositions\":[],\"defaultLang\":\"en\"},{\"position\":4,\"name\":\"Ponte Metálica do Ibirapuera\",\"description\":\"\",\"audios\":[],\"hasContent\":false,\"alsoPositions\":[],\"defaultLang\":\"en\"},{\"position\":5,\"name\":\"Estádio Cícero Pompeu de Toledo (Morumbi)\",\"description\":\"\",\"audios\":[{\"lang\":\"pt-br\",\"label\":\"PT-BR\",\"audioUrl\":\"https://tysnkzmljlmmqpbotkxv.supabase.co/storage/v1/object/public/travel-app-audios/master_audio/3704c134-946f-41ca-82c8-27db2ebb68af/3704c134-946f-41ca-82c8-27db2ebb68af-pt-br-male.mp3\"}],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"en\"},{\"position\":6,\"name\":\"Autódromo José Carlos Pace — GP do Brasil de F1\",\"description\":\"\",\"audios\":[],\"hasContent\":false,\"alsoPositions\":[],\"defaultLang\":\"en\"},{\"position\":7,\"name\":\"Estádio Nicolau Alayon — EC Santo André\",\"description\":\"\",\"audios\":[],\"hasContent\":false,\"alsoPositions\":[],\"defaultLang\":\"en\"},{\"position\":8,\"name\":\"Neo Química Arena (Estádio)\",\"description\":\"\",\"audios\":[],\"hasContent\":false,\"alsoPositions\":[],\"defaultLang\":\"en\"},{\"position\":9,\"name\":\"Relógio de Sol\",\"description\":\"\",\"audios\":[{\"lang\":\"pt-br\",\"label\":\"PT-BR\",\"audioUrl\":\"https://tysnkzmljlmmqpbotkxv.supabase.co/storage/v1/object/public/travel-app-audios/master_audio/27a931cf-8261-5cbb-b799-1bf62d91f32e/27a931cf-8261-5cbb-b799-1bf62d91f32e-pt-br-male.mp3\"}],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"en\"},{\"position\":10,\"name\":\"Centro de Treinamento Paralímpico (legado Pan 2007)\",\"description\":\"\",\"audios\":[],\"hasContent\":false,\"alsoPositions\":[],\"defaultLang\":\"en\"}]}]\n13:[\"$\",\"$L1e\",null,{\"items\":[{\"question\":\"How long does this tour take?\",\"answer\":\"About 4h 18min of audio across 10 stops, covering roughly 201.6 km. Go at your own pace — the audio plays automatically as you move.\"},{\"question\":\"Is this tour accessible?\",\"answer\":\"This route is rated: Partially accessible. Check each stop for specific access details.\"},{\"question\":\"What languages is it available in?\",\"answer\":\"This tour is available in: English, Español, Português, Italiano.\"},{\"question\":\"Do I need an internet connection?\",\"answer\":\"No. Download the tour in the Tuggi app and listen offline — the audio is triggered by your location, hands-free.\"},{\"question\":\"Can I do it walking or driving?\",\"answer\":\"This route is designed for Moderate travel. The audio adapts to your pace.\"}]}]\n20:T4c4,M37.7 30.8L38.1 30.5L39.2 31L40.8 28.8L40.7 31L37.1 35.2L36.4 34.6L39.6 28.5L42.4 26.5L41.3 26.6L40.9 25.8L38.3 26.6L38.9 28.4L38.2 30.4L39.2 31L37.7 29.4L37.6 27.9L37 27.5L37.8 26.3L38.3 28.2L37.9 29.6L33.1 34.7L32.4 34.1L33.9 32.3L32.4 31L32.6 30.6L38.5 24.6L44.8 22L45.4 20L47.4 20.4L49.3 20.1L50.4 18.4L48.3 16.8L46.8 18.1L47.8 22.5L50.7 24L52.6 23.4L54 24L54.9 22.3L57.7 21.5L58.3 20.8L58.5 18.6L58.2 16.7L57.2 16.6L57.4 15.6L55.9 18.7L57.3 21.2L57.8 26.5L56.6 27L55.1 29.7L53.9 29.7L52.8 30.5L52.7 30L52.6 28.5L54 28.4L53.8 24.4L54.8 22.4L57.7 21.5L58.3 20.8L58.7 18.1L58.2 13.8L59.6 10.1L54.2 8.6L53.2 10.5L51.3 9.9L52.4 5L54.9 5.8L52.1 15.3L52.7 16.1L49.8 21L51.4 24.6L49 30.7L48 41.3L39.6 47.8L38.3 48.2L34.7 50.9L31.8 50.8L29.4 49L27.9 49L29.4 49.3L31.6 50.8L34.2 51.1L37.9 48.8L39.7 50.3L41.1 53.4L41.9 54.1L46.1 55.8L50.2 55.4L51.3 54.7L51.5 55.1L53.2 55.1L55.2 56.6L56.3 55.8L59.7 56.8L61 56L62.8 57L63.5 56.1L63.2 54.7L64.7 53.8L65 52.5L65.9 51.7L67 52.6L72.1 52.3L71.7 47.7L68.7 48L68.5 47.3L64.5 44.3L63.7 42.6L56.9 43.1L56.5 42.2L55.5 42.5L55.1 41.4L53.3 41.6L53.3 41.2L47.8 39.7L46.5 38.6L46.4 37.5L42.3 33.7L39.2 37L40.5 38L42.3 36.1L45.2 31.9L45 30.5L45.5 29.6L44.8 22.1L43.4 22.4L42.8 20.5L40.8 21.121:T436,M60.2 39.2L59.7 39L59.1 40.2L59.9 40.5L60.5 39.6L62.3 38.8L62.4 34.6L63 33.1L64.3 33.3L64.7 31.2L65.8 31.5L66.3 30.2L67.8 30L68.6 29.1L69.6 25.1L70.6 25.4L69.7 25.4L70 24.4L68.6 28.9L67.6 29.7L68.7 30.9L68 31.8L69.9 33.6L70.5 36.1L73.4 40.2L73.3 43.4L74.8 45.8L73.7 46.9L74.9 47.7L77.1 53.6L74.6 53.4L73.1 54.1L68.5 54.5L65.6 51.4L61.6 51.7L61.3 50.5L59.8 49.1L60.1 48.2L59.7 47.3L60.6 46.3L60.5 45.4L59.5 45.2L59.7 45.9L59.2 45.7L57.6 47.6L57.4 50L56.9 49.9L56.7 51.2L54.9 51.3L54.4 52.2L49.1 56.1L47 56.1L44.8 54.7L47.3 53L48.4 52.9L50 53.8L51.8 56.2L51.7 57L51.6 56.1L50.9 56.6L50.3 56.3L50.9 56.6L51.4 56L50.7 55.3L51.8 55.8L51.4 54.6L49 53.1L42.2 46.3L43.6 44.4L46.5 42.4L45.8 41.8L46.7 40.1L46.3 38.1L46.7 36.9L46.9 38L46.7 36.5L42.9 38.8L42.3 40.2L36.9 38.2L33.7 35.2L32.6 35.4L32.3 36.3L30.3 36.9L30 37.6L27 37.5L26.2 38.3L24.7 37.1L22.9 36.8L24.8 37.3L26.2 38.4L26.9 37.6L28.2 37.7L27.1 32.7L27.9 30.2L29 29L31.5 29.8L32 26.2L33.5 24L36.4 24.1L37.2 19.4L38.5 18.8L40.7 19.2L41.1 18.7L43.8 18.9L45.2 18.2L45.9 18.7L51.2 12.2L56.9 11.2L58.7 9.7L60.4 9.5L60.1 7.1L61.2 5.214:[\"$\",\"$L1f\",null,{\"vms\":[{\"href\":\"/en/tours/brazil/avenida-paulista-e-arredores\",\"name\":\"Paulista Avenue and Its Surroundings\",\"region\":\"São Paulo\",\"country\":\"Brazil\",\"stopsCount\":14,\"durationStr\":\"1h 35min\",\"distanceStr\":\"52.8 km\",\"trace\":{\"d\":\"$20\",\"width\":100,\"height\":62,\"start\":[37.7,30.8],\"end\":[40.8,21.1]},\"themes\":[\"urban\",\"historical\"],\"languageCount\":4},{\"href\":\"/en/tours/brazil/sao-paulo-a-noite\",\"name\":\"São Paulo by Night\",\"region\":\"São Paulo\",\"country\":\"Brazil\",\"stopsCount\":12,\"durationStr\":\"1h 1min\",\"distanceStr\":\"30.9 km\",\"trace\":{\"d\":\"M48.7 29.4L48.9 30.1L46.8 30.7L44.6 26.9L46.2 25.8L55.3 16.3L56.7 17.6L57 17.3L62 12L61.4 11.2L62.3 9.8L67.2 7.3L66.5 5L60.8 7.8L57.9 10.1L55.9 10.4L51.2 8.3L42.1 14.3L39.2 10L36.6 8.9L37 8.6L37.3 9.3L39.1 9.9L39.7 9.6L40.4 10.6L41.6 9.9L42.3 10.9L40.6 12.1L39.2 10L37.3 9.3L35.8 12L37.2 13L36.4 13L37.2 11.2L36.8 10.6L35.8 12L37.2 12.9L37.3 15.7L36.4 15.7L36.4 14L37.2 13.9L37.3 15.7L37.9 15.6L37.9 16.4L35.7 16.7L35.5 18.2L38.8 18.1L39.6 18.6L44.6 27.5L47.2 36.2L43.7 37.1L45.4 36.8L45.9 37.3L44.9 36.8L43 37.3L41 36.5L40.3 38.1L40.6 39.9L35.9 54.1L34.2 57L32.8 56.2L34.7 53.8L35.5 51\",\"width\":100,\"height\":62,\"start\":[48.7,29.4],\"end\":[35.5,51]},\"themes\":[\"urban\"],\"languageCount\":4},{\"href\":\"/en/tours/brazil/sao-paulo-com-criancas\",\"name\":\"São Paulo with Kids\",\"region\":\"São Paulo\",\"country\":\"Brazil\",\"stopsCount\":9,\"durationStr\":\"1h 55min\",\"distanceStr\":\"64.7 km\",\"trace\":{\"d\":\"$21\",\"width\":100,\"height\":62,\"start\":[60.2,39.2],\"end\":[61.2,5.2]},\"themes\":[\"nature\",\"urban\"],\"languageCount\":4}]}]\n15:[\"$\",\"section\",null,{\"id\":\"route-final-cta\",\"className\":\"py-20 bg-tuggi-primary/5 border-t border-gray-100\",\"children\":[\"$\",\"div\",null,{\"className\":\"page-shell\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-2xl text-center\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-3xl md:text-4xl font-black text-tuggi-dark mb-4\",\"children\":\"Hear the whole story\"}],[\"$\",\"p\",null,{\"className\":\"text-tuggi-slate text-lg mb-8\",\"children\":\"Get the Tuggi app and let every stop come to life — hands-free, offline, in your language.\"}],[\"$\",\"$L22\",null,{\"eventLabel\":\"route_footer\",\"className\":\"inline-block px-10 py-5 bg-tuggi-primary text-tuggi-dark font-black rounded-2xl shadow-xl shadow-tuggi-primary/20 hover:shadow-2xl hover:-translate-y-1 transition-all\",\"children\":\"Get the Tuggi app\"}]]}]}]}]\n16:[\"$\",\"$L23\",null,{\"text\":\"Hear this route, hands-free\",\"cta\":\"Get the app\",\"afterId\":\"route-hero\",\"untilId\":\"route-final-cta\",\"placement\":\"route_sticky\"}]\n24:I[175696,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\"],\"default\"]\n25:T5cf,<strong>Partnership Proposal Data:</strong> There is a partnership proposal form on this site, open to any establishment that wants to propose a partnership. Whoever fills it in sends us two things. One is the establishment, with its trading name and registered company name, CNPJ, category, full address with postcode, district, city and state, opening hours, website and Instagram. The other is the person who answers for the establishment, with name, role, email and phone, and those are one person's data. For a Brazilian MEI or sole trader, the registered company name carries the owner's own name, and the address may be their home address, so we treat that whole form as personal data. We use what arrives there for five things: assessing the proposal, talking to the person about this partnership, drawing up the contract and sending it for signature to the email given, limiting abuse on the page, which anyone can open, and measuring where the form gets in the way. To limit abuse we count how many proposals come from each connection. For that count we store a code calculated from the IP address, and not the address. That code is not anonymous, because the same connection always produces the same code. To measure where the form gets in the way we count how many people open each step and at which step they stop. For that count we store neither your name, nor your connection address, nor anything you wrote. You can ask us to remove this data, and section 5 explains how.26:T4ca,<strong>Visit to a Partner Page:</strong> When you reach a partner page on this site, through a QR code or through a link of theirs, we record that visit. If you are browsing from outside Brazil and the United States, that record is only created after you accept cookies on this site. Until you accept, we store nothing of that visit and write no cookie on your device. We store your connection's IP address, the identification the browser declares, the browser language and the device time zone. We also store which partner you visited and the time. Alongside that we write a cookie of this site, named tuggi_attr, which lasts 30 days and holds the partner identifier, the identifier of that visit and the date. This record serves one purpose only, which is to know which partner brought you to the app, because that is how we pay that partner. It feeds no advertising and it is not used for contact. The IP address and the browser identification leave that record after 48 hours, and the whole record is deleted after 30 days, by a routine that runs every day. When that record exists and you tap a button that leads to the store, the identifier of that visit travels inside the link, and section 3 tells what happens to it.17:[\"$\",\"$L24\",null,{\"formats\":\"$undefined\",\"locale\":\"en\",\"messages\":{\"Download\":{\"metaTitle\":\"Download TUGGI – Self-Guided Audio Travel Guide\",\"metaDesc\":\"Get the TUGGI app: self-guided audio tours, hands-free and offline. Listen in {contentLanguages} languages with closed captions. Free to start.\",\"partnerBadge\":\"TUGGI PARTNER INVITATION ACTIVATED\",\"heroWelcomeLabel\":\"Welcome\",\"heroWelcomeTitle\":\"Tuggi Experience\",\"heroTitle1\":\"Your\",\"heroTitle2\":\"cultural\",\"heroTitle3\":\"experience has started.\",\"heroSubtitle\":\"We are preparing everything for you. You will be redirected to the official store in a moment.\",\"partnerVisitSite\":\"Visit site\",\"redirecting\":\"Redirecting\",\"openingStore\":\"Opening store...\",\"initializing\":\"Initializing download for\",\"cta\":\"DISCOVER MORE IN THE APP\",\"officialApp\":\"Official App\",\"trustFooter\":\"Secure Connection • Official App Distribution • Powered by Tuggi\",\"loading\":\"Loading...\",\"readMore\":\"MORE\",\"readLess\":\"LESS\",\"Campaign\":{\"headline\":\"Between one dish and the next, the region tells <accent>its own story</accent>.\",\"subtext\":\"You keep going. The narration follows.\",\"referredBy\":\"Referred by <partner>{name}</partner>\",\"stepsHeading\":\"How it works\",\"step1Title\":\"Open it and forget it\",\"step1Text\":\"Start the app at the beginning of the outing and put your phone back in your pocket.\",\"step2Title\":\"The audio starts on its own\",\"step2Text\":\"As you get close to a place, the narration comes in automatically.\",\"step3Title\":\"The route is yours\",\"step3Text\":\"A detour, a stop, the long way back along the beach. The content is in the territory, not in a fixed itinerary.\",\"bandTitle\":\"Download free\",\"bandSubtitle\":\"Try it now!\"},\"Player\":{\"playing\":\"Playing\",\"tapToPlay\":\"Tap the play button\",\"paused\":\"Paused\"}},\"Header\":{\"navPartners\":\"Partners\",\"navDestinations\":\"Destinations\",\"navTech\":\"Technology\",\"navPlans\":\"Passes\",\"navAudioGuides\":\"Audio Guides\",\"navPurpose\":\"Purpose\",\"downloadApp\":\"Download App\"},\"Footer\":{\"tagline\":\"Connecting people to the context of the physical world\",\"driveB2c\":\"TUGGI (B2C)\",\"appDownload\":\"App Download\",\"plans\":\"Passes\",\"enterprise\":\"Enterprise (B2B/B2G)\",\"destinations\":\"Destinations\",\"fleets\":\"Fleets\",\"technology\":\"Technology\",\"institutional\":\"Institutional\",\"ourPurpose\":\"Our Purpose\",\"contact\":\"Contact\",\"trustCenter\":\"Trust Center & Compliance\",\"terms\":\"Terms of Use\",\"privacy\":\"Privacy Policy\",\"accessibility\":\"Accessibility\",\"security\":\"B2G Security\",\"coverage\":\"Global Coverage\",\"updates\":\"Updates\",\"audioTours\":\"Audio Tours\",\"rights\":\"All rights reserved.\"},\"Home\":{\"FAQ\":{\"title\":\"Frequently Asked Questions\",\"q1\":\"What is the best app for self-guided audio tours?\",\"a1\":\"TUGGI is a self-guided audio travel guide for iOS and Android. It plays audio stories about the places around you automatically, triggered by GPS — hands-free and screen-off — while you drive, walk, or cycle. It works offline, supports {contentLanguages} languages with closed captions, and is free to start.\",\"q2\":\"Is there a free audio travel guide app?\",\"a2\":\"Yes. TUGGI is free to download and starts with stories every day. To listen without a daily limit, a Tuggi Pass gives you 10, 25 or 45 hours of use, with a one-time payment. The hours never expire, and you'll see the price in the App Store or Google Play.\",\"q3\":\"What's a good travel app for a road trip?\",\"a3\":\"TUGGI was built for road trips: it runs alongside your navigation and music and narrates the landmarks, towns, and history you pass automatically — no screen, no searching. Download your route in advance to use it offline with no roaming charges.\",\"q4\":\"Can I explore a city without a tour guide?\",\"a4\":\"Yes. TUGGI acts as a self-guided audio guide, so you can explore at your own pace without booking a human guide or a fixed tour. Stories play automatically as you reach each point of interest, on foot or by car.\",\"q5\":\"Does TUGGI work offline and in my language?\",\"a5\":\"Yes. Download a route in advance and listen with no signal and no roaming charges. TUGGI offers audio in {contentLanguages} languages with synchronized closed captions for deaf and hard-of-hearing travelers.\",\"q6\":\"How is TUGGI different from Google Maps or a human guide?\",\"a6\":\"TUGGI isn't a navigation app and doesn't replace your GPS — it runs alongside it and adds self-guided audio storytelling about the places you pass. Unlike a human guide, it's available 24/7, in multiple languages, hands-free, and free to start.\",\"q7\":\"Who is TUGGI for?\",\"a7\":\"For anyone who likes to explore on the move: tourists, curious locals, cyclists, walkers, passengers on a bus, train or van, and drivers too. It works on a road trip, on a walking city tour, on a bike or scooter ride, and on public transport. Because the audio is triggered by GPS and runs offline, the experience is the same in any mode of transport.\"},\"Hero\":{\"title\":\"You move, TUGGI tells the story of every place.\",\"subtitle\":\"Turn TUGGI on, start moving and put your phone away. It uses GPS to spot each point of interest along the way and reads its story out loud. Works on foot, by bike, by car or on public transport, offline and in your language.\",\"trustLine\":\"Free to start · Works offline · Audio in {contentLanguages} languages\",\"appStoreAlt\":\"Download TUGGI on the App Store\",\"playStoreAlt\":\"Get TUGGI on Google Play\",\"phoneAlt\":\"A point's card in the TUGGI app, open over the map: the name of the place, the distance, the opening of the story, and the buttons to hear the story or read the transcript.\"},\"Scene\":{\"lead\":\"Today you drove past forty stories.\\nYou heard none.\",\"body\":\"The fort at the edge of town, the eighteenth-century church, the ridge that has a name and a reason. All of it went by the window in silence, because nobody pulls over to look up what has just gone past.\"},\"HowItWorks\":{\"title\":\"Start listening in one minute\",\"step1\":\"Download the app and pick your language.\",\"step2\":\"Start the guide and put your phone away.\",\"step3\":\"Stories play on their own as you pass each place.\"},\"Showcase\":{\"feat2Title\":\"Still, it shows you around. Moving, it speaks.\",\"feat2Body\":\"When you stop, open the map and see what's around: points of interest, events and trails, each with its distance. Start moving again and TUGGI goes back to narrating: it says the name of the place, then tells the story.\",\"feat2Alt\":\"TUGGI explore-around-you list of nearby points of interest with distances\",\"feat3Title\":\"See what's happening right now\",\"feat3Body\":\"Festivals, fairs and local events show up on your map with dates and reminders. Found something you like? Tap \\\"take me there\\\" and go.\",\"feat3Alt\":\"TUGGI event detail card with the date, a reminder and a take-me-there button\",\"feat4Title\":\"There's a route ready, but you're in charge\",\"feat4Body\":\"If you feel like it, follow a themed trail, such as the Rota Religiosa de Búzios, with its stops and stories already in place. If you don't, forget the route: TUGGI narrates wherever you go.\",\"feat4Alt\":\"TUGGI trail detail with the route drawn on the map and its stops\",\"feat5Title\":\"Every trip lands in your passport\",\"feat5Body\":\"The app adds it all up: places discovered, cities, kilometers covered and hours of audio. It becomes a log of your travels you can show your friends.\",\"feat5Alt\":\"TUGGI explorer passport showing discoveries, cities, kilometers and listening hours\",\"feat6Title\":\"Made to go anywhere\",\"feat6Body\":\"Download the maps and use everything without internet. Control the guide by voice with Siri or Google, without taking your phone out of your pocket. And listen in {contentLanguages} languages, whichever suits you.\",\"feat6AltTools\":\"TUGGI explorer tools including offline maps and voice commands\",\"feat6AltLanguages\":\"TUGGI audio language selector with English, Spanish, Italian, Portuguese and more\"},\"AudioSample\":{\"title\":\"Hear TUGGI for yourself\",\"subtitle\":\"Short stories, just the way you'd hear them while exploring.\"},\"Business\":{\"title\":\"TUGGI for your business\",\"body\":\"Transfer companies, rental fleets and destinations use TUGGI to give every traveler a local guide.\",\"fleetsLink\":\"For fleets & operators\",\"cityOsLink\":\"For destinations\"},\"Context\":{\"title\":\"What is TUGGI\",\"p1\":\"TUGGI is a self-guided audio travel guide for iPhone and Android. It uses GPS to recognize the places you pass and tells the story of each one out loud, at the right moment, without you searching for anything on the screen. It works however you travel: on foot, by bike, by car, by bus or on the metro.\",\"p2\":\"Stories start on their own as you get close to a point of interest. Because everything works offline, you download a city before you leave and listen with no internet and no roaming data. And since every story comes with synchronized captions, deaf and hard-of-hearing travelers follow along on screen.\",\"p3\":\"TUGGI does not replace your navigation app: it runs alongside it, without getting in the way of your map or your music, and simply adds the cultural narration of the route. Start free, pick from {contentLanguages} languages, and turn any trip into a journey with a story.\"}},\"AudioSample\":{\"play\":\"Play the story of {name}\",\"pause\":\"Pause the story of {name}\",\"seek\":\"Seek within the story of {name}\",\"transcriptShow\":\"Read the transcript\",\"transcriptHide\":\"Close the transcript\",\"tagDirectional\":\"Directional\",\"tagStory\":\"Story\",\"error\":\"This story could not play right now. Try again.\",\"sample1Name\":\"Walt Disney World Resort\",\"sample1City\":\"Orlando\",\"sample2Name\":\"Paulista Avenue\",\"sample2City\":\"São Paulo\",\"sample3Name\":\"Rialto Bridge\",\"sample3City\":\"Venice\"},\"Proof\":{\"points\":\"<strong>More than {mappedPointMillions} million</strong> mapped points, across {coverageCountries} countries.\",\"guides\":\"<strong>More than {audioGuidesFloor, number}</strong> audio guides produced, with audio in {contentLanguages} languages.\",\"since\":\"Operating since {operatingSince}.\"},\"CityOS\":{\"Hero\":{\"title\":\"The Definitive Infrastructure for Smart Tourism Destinations (DTI).\",\"subtitle\":\"TUGGI City OS aligns your territorial governance with global pillars of Technology, Sustainability, Accessibility, and Data.\",\"cta\":\"Request City OS Demo\"},\"Animator\":{\"geoTriggerActive\":\"GEO-TRIGGER ACTIVE\",\"newPoi\":\"New POI\",\"poiName\":\"POI Name\",\"audio\":\"Audio\",\"coordinates\":\"Coordinates\",\"activationRadius\":\"Activation Radius\",\"deployButton\":\"Deploy to Grid\",\"defaultPoiName\":\"Main Monument\"},\"Accessibility\":{\"title\":\"Universal Accessibility\",\"desc\":\"Universal Accessibility is the hardest DTI pillar. TUGGI brings down both sensory barriers: an audio-first experience that describes the surroundings, for tourists who are blind or have low vision; and geolocated closed captions for passengers who are deaf or hard of hearing. We design following WCAG 2.1 AA.\",\"Panel\":{\"title\":\"Accessibility module\",\"feat1Title\":\"Audio-first experience\",\"feat1Desc\":\"Works with VoiceOver and TalkBack\",\"feat2Title\":\"Spatial context\",\"feat2Desc\":\"Immersive audio\",\"feat3Title\":\"Dynamic subtitles\",\"feat3Desc\":\"Geolocated closed captions\"}},\"Intelligence\":{\"title\":\"Data-Driven Tourism Intelligence\",\"desc\":\"Governments are usually blind to tourist flow. TUGGI delivers anonymized telemetry: know exactly which routes are taken, at what times, and in which languages, enabling hyper-targeted international marketing campaigns.\"}},\"Fleets\":{\"Hero\":{\"title\":\"De-commoditize Your Fleet.\",\"subtitle\":\"Transform a standard vehicle rental into a Premium Cultural Experience.\",\"cta\":\"Partner with TUGGI\",\"eyebrow\":\"For fleets and rental companies\"},\"Financial\":{\"col2Title\":\"Instant Scalability\",\"col2Desc\":\"Deploy across your entire national fleet via QR Code integration at the counter.\",\"col3Title\":\"Revenue Share\",\"col3Desc\":\"A tourist who downloads Tuggi through your QR Code is attributed to you. Any purchase they make enters the calculation of your revenue share, at a percentage set in the commercial agreement.\"},\"ESG\":{\"title\":\"Seamless Digital Deployment\",\"desc\":\"Cultivate your ESG targets by fostering the local creative economy and decompressing overtourism through guided routes.\",\"cta\":\"Request B2B Demo\"}},\"Partners\":{\"hero\":{\"eyebrow\":\"For businesses that welcome travellers\",\"title\":\"Be found by the traveller who is already on your street\",\"subtitle\":\"Your business can be part of the story of that street: every Tuggi traveller finds and reads your place, and whoever has the guide on hears it. No Tuggi plan hides you from the traveller.\"},\"grid\":{\"title\":\"Choose your type of business\",\"lead\":\"Every business catches the traveller at a different moment of the day. Find yours, and we will talk about it.\",\"actionOpen\":\"See how it works\"},\"mechanism\":{\"place\":\"the counter, the room, the car\"},\"seo\":{\"primaryTerm\":\"partner program\",\"title\":\"Partner program for businesses that host travellers\",\"description\":\"Restaurants, hotels, transfers and car rentals: see how your business can appear to the traveller already using Tuggi on your street, on any plan.\"},\"cta\":{\"action\":\"I want to appear on Tuggi\"},\"FAQ\":{\"title\":\"The questions we hear most\",\"q1\":\"What does it cost?\",\"a1\":\"Appearing on Tuggi costs nothing: you sign up, we approve you, you display the QR Code and, after we assess it, your place is published, found and read by every traveller. Tuggi also takes no cut of your sales, and you pay for nobody's access. The one who pays for Tuggi is the traveller. There is one paid part of the partnership, outside that list, and we go over it with you.\",\"q2\":\"Do I have to change anything in how I work?\",\"a2\":\"Two things. You put the QR Code where the traveller is already looking — on the menu, at the front desk, on the counter, on the back of the seat — and you tell us the story of your place, once. Beyond that, the partnership requires no integration with your system, no equipment and no software for your staff to operate.\",\"q3\":\"Will my place really get into Tuggi?\",\"a3\":\"It is not automatic, and we would rather say so now. Once the partnership is approved, our team assesses your place. What gets in is permanent, open to the public and has a story of its own to tell. It does not have to be famous or old. If something is missing, we tell you what it was, and you can fix it and put it forward again.\",\"q4\":\"And if my place does not get in?\",\"a4\":\"You are still a partner. Your QR Code, the traveller attributed to you and your revenue share do not depend on it. Nothing you already have goes away.\",\"q5\":\"What if my guest does not speak English?\",\"a5\":\"Tuggi speaks {contentLanguages} languages to the traveller. When your place is published, it is read in the language of whoever arrives. And whoever has the guide on hears it in that same language. We produce the narration the moment someone asks for it in that language.\",\"q6\":\"What do I earn from this?\",\"a6\":\"The traveller downloads Tuggi through your QR Code and is attributed to you. From then on, every purchase they make counts towards your revenue share. The percentage is set in a commercial agreement, and that is what we talk about when you leave your details below.\"},\"form\":{\"title\":\"The first step is a conversation\",\"body\":\"Leave your details and we will reply on the channel you choose, with what the partnership does in your case. Leaving your details costs nothing and commits you to nothing.\",\"allRequired\":\"All fields are required.\",\"name\":\"Your name\",\"business\":\"Name of your business\",\"businessType\":\"Type of business\",\"businessTypePlaceholder\":\"Select an option\",\"businessTypeOther\":\"Other\",\"channelLegend\":\"How would you like us to get in touch?\",\"channelWhatsapp\":\"WhatsApp\",\"channelEmail\":\"Email\",\"whatsappLabel\":\"Your WhatsApp number\",\"whatsappHint\":\"With country and area code. Example: +1 555 000 0000.\",\"emailLabel\":\"Your email\",\"emailHint\":\"It can be the address you already use every day.\",\"sending\":\"Sending…\",\"consent\":\"I allow Tuggi to store these details and to contact me by phone call, WhatsApp or email — about this partnership only. Read the <policy>Privacy Policy</policy>.\",\"consentLinkNewTab\":\"opens in a new tab\",\"errorSummary\":\"Check the fields marked below before sending.\",\"errorName\":\"Enter your name.\",\"errorBusiness\":\"Enter the name of your business.\",\"errorBusinessType\":\"Choose the type of business.\",\"errorWhatsapp\":\"Enter the number with country and area code — for example, +1 555 000 0000.\",\"errorEmail\":\"Enter an email with @ and a domain — for example, name@example.com.\",\"errorConsent\":\"Tick the consent box so we can get in touch.\",\"errorSend\":\"We could not send it just now. Try again in a moment — what you typed is still here.\",\"successTitle\":\"We have your details.\",\"successBody\":\"We will reach out on the channel you chose, to understand how travellers arrive at your business. The partner registration itself happens later, inside the Tuggi app — and we will walk you through it.\",\"noscript\":\"Without JavaScript the form cannot be sent. Write to {email} and we will answer.\"}},\"Segments\":{\"commercial\":{\"title\":\"How your revenue share works\",\"lead\":\"You offer Tuggi to your customer. When they buy, part of the sale comes back to you.\",\"note\":\"The percentage is set in the commercial agreement.\"},\"steps\":{\"title\":\"How the partnership works\",\"s1Title\":\"You sign up and we approve\",\"s1Body\":\"Registration happens in the Tuggi app. Our team checks your details and approves the partnership.\",\"s2Title\":\"You display your QR Code\",\"s2Body\":\"Once approved, you get your QR Code and put it where the traveller already is: {place}. Whoever downloads Tuggi through that code is attributed to you.\",\"s3Title\":\"Your revenue share\",\"s3Body\":\"Every purchase made by a traveller attributed to you counts towards your revenue share. The percentage is set in the commercial agreement.\",\"s4Title\":\"Your venue can join Tuggi\",\"s4Body\":\"Once the partnership is approved, our team assesses whether to register your place as a point of interest. It is an editorial decision at Tuggi, and it is not automatic. Within {partnerTriageHours} hours of the approval you have the outcome. And your QR Code and your revenue share do not depend on it.\",\"lead\":\"On your side it is two things: display the QR Code and tell us the story of your place. The rest happens on the traveller's phone.\"},\"cta\":{\"title\":\"Tell us how travellers reach you\",\"body\":\"We will come back with what the partnership does in your case, with no commitment.\",\"action\":\"Talk to Tuggi\"},\"car-rental\":{\"hub\":{\"cardTitle\":\"Car rental\",\"cardBody\":\"The traveller picks up the car and takes the guide along. The QR Code goes on the counter or inside the vehicle.\"}},\"lodging\":{\"hub\":{\"cardTitle\":\"Hotels and lodging\",\"cardBody\":\"Guests arrive without knowing what to do in the city. The QR Code goes at reception or in the room.\"}},\"transfer\":{\"hub\":{\"cardTitle\":\"Transfer and taxi\",\"cardBody\":\"Airport to hotel is the first half hour of the trip. The QR Code goes on the seat back or on the window.\"}},\"motorhome\":{\"hub\":{\"cardTitle\":\"Motorhome\",\"cardBody\":\"Motorhome travellers spend the day on the road. The QR Code goes with the keys at handover.\"}},\"restaurants\":{\"hub\":{\"cardTitle\":\"Restaurants\",\"cardBody\":\"People sitting down to eat have time to listen. The QR Code goes on the menu or on the bill.\"}},\"receptive\":{\"hub\":{\"cardTitle\":\"Tour operators\",\"cardBody\":\"Your guest spends the day with you and wants to hear about what they are seeing. The QR Code goes on the voucher or at the meeting point.\"}}},\"Technology\":{\"Hero\":{\"eyebrow\":\"Architecture overview\",\"title\":\"Enterprise-Grade Spatial Audio Infrastructure.\",\"subtitle\":\"Built for scale and resilience.\"},\"Comparison\":{\"title\":\"Being nearby is not having it in front of you\",\"subtitle\":\"Two ways of deciding when the story starts. The difference is the direction you are moving in.\",\"radiusLabel\":\"Proximity radius\",\"radiusBody\":\"This is the industry standard. Everything inside the radius counts the same, including what you have already left behind. What comes out is a list of what exists around you.\",\"coneLabel\":\"Direction of movement\",\"coneBody\":\"This is what Tuggi does. The direction you are moving in picks a single place: the one in front of your eyes. That is the story you hear, at the moment it comes into view.\"},\"Data\":{\"col2Title\":\"Serverless & Mega-Event Ready.\",\"col2Desc\":\"Backed by global CDNs and an edge-computing architecture, ready to handle massive traffic spikes during events like the World Cup or Olympics.\"}},\"Drive\":{\"Hero\":{\"title\":\"Self-Guided Audio Tours, Hands-Free.\",\"subtitle\":\"No scrolling. No searching. Set your language and TUGGI plays self-guided audio stories about every place you pass — by car, on foot, or by bike. Hands-free, offline, eyes on the scenery.\",\"downloadApp\":\"Download on the App Store\",\"downloadPlay\":\"Get it on Google Play\",\"animatorLabel\":\"Now Playing\",\"animatorPoi\":\"Miradouro da Serra\",\"animatorAhead\":\"On your right\",\"stopGuide\":\"Stop Guide\",\"startGuide\":\"Start Guide\",\"ccText\":\"Miradouro da Serra, at 847 metres above sea level, offers one of the most stunning views in the mountain region, with a 360° panorama over the surrounding valleys and peaks...\"},\"Samples\":{\"tag\":\"Premium Curation\",\"title\":\"Hear what you're unlocking\",\"subtitle\":\"Every road trip, walking tour, or cycling route comes alive with stories you'd never find on your own. No fixed itineraries — your self-guided audio tour plays automatically, exactly at each landmark.\"},\"Features\":{\"title\":\"Included in every pass\",\"feat1Title\":\"100% Offline Mode\",\"feat1Desc\":\"Download the city pack at your hotel. Zero data roaming charges on the road.\",\"feat3Title\":\"Multilingual Audio\",\"feat3Desc\":\"High-fidelity storytelling in {contentLanguages} native languages.\"},\"Pricing\":{\"kicker\":\"Tuggi Passes\",\"title\":\"You only spend with the guide on.\",\"subtitle\":\"Your hours never expire. Turn the guide off whenever you like, pick up on your next trip.\",\"anchor\":\"Less than a single guided tour — and it narrates your whole trip.\",\"chip2\":\"One-time payment\",\"chip3\":\"No auto-renewal\",\"recommended\":\"RECOMMENDED\",\"pass1Title\":\"10 hours\",\"pass1Desc\":\"a day trip\",\"pass1Action\":\"Buy 10 hours in the app\",\"pass2Title\":\"25 hours\",\"pass2Desc\":\"a weekend\",\"pass2Action\":\"Buy 25 hours in the app\",\"pass3Title\":\"45 hours\",\"pass3Desc\":\"a full trip\",\"pass3Action\":\"Buy 45 hours in the app\",\"priceInStore\":\"Price in the store\",\"passesNote\":\"One-time payment. Hours from different passes add up.\",\"storeNoteWithPrice\":\"You buy inside the app. These are the prices the App Store and Google Play charge here, and you confirm before paying.\",\"storeNoteNoPrice\":\"You buy inside the app. Each country has its own price in the App Store and Google Play. You see the exact amount, in your currency, before you confirm.\",\"freeTitle\":\"Explore\",\"freePrice\":\"Free\",\"free1\":\"Start with the full guide — you turn it on in the app\",\"free2\":\"After that, the app stays free with stories every day\",\"free3\":\"No card required\",\"freeAction\":\"Start free\"},\"Conversion\":{\"title\":\"Every place has a story. Start listening today.\",\"downloadApp\":\"Download on the App Store\",\"downloadPlay\":\"Get it on Google Play\",\"qrCaption\":\"Point your camera to download\"},\"FAQ\":{\"title\":\"Frequently Asked Questions\",\"q1\":\"Is TUGGI free?\",\"a1\":\"Yes. Start free, with stories every day. To listen without a daily limit, a Tuggi Pass gives you 10, 25 or 45 hours of use — one-time payment, and the hours only run with the guide on.\",\"q2\":\"Does TUGGI work offline?\",\"a2\":\"Yes. Download a route in advance and listen with no signal — no roaming charges.\",\"q3\":\"How is TUGGI different from Google Maps or a GPS?\",\"a3\":\"TUGGI isn't a navigation app. It runs alongside your navigation and music and plays self-guided audio stories about the places you pass — hands-free, no screen.\",\"q4\":\"What languages does TUGGI support?\",\"a4\":\"Audio in {contentLanguages} languages, with synchronized closed captions so deaf and hard-of-hearing travelers can follow every story.\",\"q5\":\"Can I use TUGGI walking or cycling?\",\"a5\":\"Yes — road trips, walking tours, cycling, and family travel all work.\",\"q6\":\"Do I have to look at my phone?\",\"a6\":\"No. The audio triggers automatically by location, hands-free and screen-off.\"},\"Accessibility\":{\"title\":\"Full accessibility\",\"body\":\"Synchronized captions let deaf and hard-of-hearing travelers follow every story. And because TUGGI is audio-first, travelers with low vision explore without needing to read.\"},\"PlansHero\":{\"title\":\"Choose your pass\",\"subtitle\":\"Download and start with no card and nothing to subscribe to. You turn the full guide on yourself, inside the app — and after that the app stays free, with stories every day.\",\"appStoreAlt\":\"Download TUGGI on the App Store\",\"playStoreAlt\":\"Get TUGGI on Google Play\"},\"Comparison\":{\"title\":\"How TUGGI compares\",\"colGuide\":\"Private guide\",\"colAudio\":\"Traditional audio tours\",\"colTuggi\":\"TUGGI\",\"rowCost\":\"Cost\",\"costGuide\":\"Guide's day rate\",\"costAudio\":\"Paid per tour, per city\",\"costTuggi\":\"One pass, your whole trip\",\"rowLang\":\"Languages\",\"langGuide\":\"The guide's language\",\"langAudio\":\"A few per tour\",\"langTuggi\":\"{contentLanguages} languages\",\"rowRoute\":\"Route\",\"routeGuide\":\"The guide's itinerary\",\"routeAudio\":\"A fixed route to follow\",\"routeTuggi\":\"Any path you choose\",\"rowDrive\":\"While driving\",\"driveAudio\":\"Tap the screen at each stop\",\"driveTuggi\":\"Automatic, hands-free\",\"rowOffline\":\"Offline\",\"offlineAudio\":\"Varies\",\"offlineTuggi\":\"Always\",\"rowCaptions\":\"Synced captions\",\"captionsAudio\":\"Rare\",\"captionsTuggi\":\"On every story\",\"notApplicable\":\"Not applicable\",\"footnote\":\"TUGGI runs alongside your navigation app and your music.\"},\"Sticky\":{\"text\":\"Start free — no card required\",\"cta\":\"Download\"},\"PlansExplainer\":{\"title\":\"How Tuggi Passes work\",\"p1\":\"You can use TUGGI for free: download it, and the full guide is unlocked by you, with one tap, inside the app — no card and nothing to sign up for. After that, the app stays free with a limited number of stories a day, so you explore at your own pace before deciding.\",\"p2\":\"When you want to listen without a daily limit, pick a pass: 10 hours for a day trip, 25 for a weekend, 45 for a full trip. These are hours of use, not days on a calendar — the time only runs with the guide on, and whatever is left waits for your next trip. One-time payment, no auto-renewal.\",\"p3\":\"Every pass includes fully offline maps and audio, synchronized captions and all {contentLanguages} languages. Prices vary by country, and you see the exact price in the App Store or Google Play before you confirm. Nothing is charged without your confirmation in the store.\"}},\"Contact\":{\"Hero\":{\"title\":\"Talk to TUGGI.\",\"subtitle\":\"Select how we can help you today to be routed to the right team.\"},\"Triage\":{\"card1Title\":\"City / Government\",\"card1Desc\":\"I represent a municipality or regional authority.\",\"card2Title\":\"Car Rental / Fleet\",\"card2Desc\":\"I represent an enterprise fleet or rental agency.\",\"card3Title\":\"Tourist / App User\",\"card3Desc\":\"I am a driver or passenger needing app support.\"},\"B2G\":{\"fullName\":\"Full Name\",\"role\":\"Official Position / Role\",\"city\":\"Municipality / City Name\",\"email\":\"Work Email\",\"emailError\":\"Please use an official government email address.\",\"cta\":\"Request City OS Demo\"},\"B2B\":{\"fullName\":\"Full Name\",\"company\":\"Company Name\",\"email\":\"Work Email\",\"fleetSize\":\"Estimated Fleet Size\",\"fleetTarget\":\"Select fleet size\",\"emailError\":\"Please use a corporate email address.\",\"cta\":\"Contact B2B Sales\"},\"B2C\":{\"desc\":\"Need help with your trip? Our support team is ready to assist you.\",\"cta\":\"Email Support Team\"},\"Sidebar\":{\"hqTitle\":\"Corporate Headquarters\",\"hqValue\":\"São Paulo, SP, Brazil\",\"slaTitle\":\"Sales SLA\",\"slaValue\":\"Our enterprise experts typically respond within 24 business hours.\",\"pressTitle\":\"Press, Partnerships & Support\",\"pressValue\":\"suporte@tuggi.app\"},\"Success\":{\"title\":\"Request received.\",\"body\":\"Thank you for your interest. Our representative will contact you via your corporate email shortly.\",\"again\":\"Send another message\"}},\"Legal\":{\"Sidebar\":{\"title\":\"Legal & Compliance\",\"terms\":\"Terms of Use\",\"privacy\":\"Privacy Policy\",\"deletion\":\"Data Deletion\",\"security\":\"Security SLA\",\"accessibility\":\"Accessibility & Inclusion\"},\"Terms\":{\"title\":\"Terms of Use\",\"lastUpdated\":\"February 2026\",\"intro\":\"Welcome to TUGGI. By creating an account, logging in via partner platforms, or using our app, you expressly agree to the terms described below.\",\"s1Title\":\"1. Eligibility and Account Creation\",\"s1Item1\":\"<strong>Minimum Age:</strong> TUGGI is a cultural and educational application. The minimum age to create an account and use the service as a listener is 13 years old.\",\"s1Item2\":\"<strong>Responsibility at the Wheel:</strong> If you are the driver of the vehicle, you represent and warrant that you are of legal age and possess the necessary license required by the laws of your country or state to drive.\",\"s1Item3\":\"<strong>Data Accuracy:</strong> You agree not to create accounts on behalf of third parties or use false identities.\",\"s2Title\":\"2. The Golden Rule: Traffic Liability Disclaimer (Safety First)\",\"s2Item1\":\"<strong>TUGGI was strictly designed to operate in the background (hands-free).</strong>\",\"s2Item2\":\"<strong>You are solely responsible for driving the vehicle.</strong> The app does not replace your attention to the road, traffic signs, or traffic conditions.\",\"s2Item3\":\"TUGGI Technologies, as well as its government and corporate partners, fully disclaim any responsibility for accidents, material/physical damage, or traffic fines incurred during the use of the application. Always respect local traffic laws.\",\"s3Title\":\"3. Technology Limitations (Artificial Intelligence and GPS)\",\"s3Item1\":\"<strong>Location Signals:</strong> Our spatial trigger engine depends on third-party GPS signals and collaborative mapping (such as OpenStreetMap). We do not guarantee absolute trigger accuracy in network shadow areas, such as tunnels or deep valleys.\",\"s3Item2\":\"<strong>AI-Assisted Content:</strong> Our audio narratives are compiled and generated using a combination of manual curation and advanced Artificial Intelligence (AI) models. The narrated content is cultural and educational in nature. TUGGI provides the content \\\"as-is\\\" and does not guarantee absolute academic, historical, or geographical accuracy, and is not responsible for factual discrepancies.\",\"s4Title\":\"4. Content Reporting and Corrections (Safe Harbor)\",\"s4Text\":\"We are committed to maintaining a respectful and accurate cultural environment. If you find incorrect information, cultural inaccuracies, or if you are the owner of a location and wish to request the removal of a Point of Interest (POI), use our Contact page, choosing the profile that describes you. Our team reviews all feedback and reserves the right to correct, alter, or remove triggers at our sole discretion.\",\"s5Title\":\"5. Civic Conduct and Public Use\",\"s5Text\":\"When using the application in public transport, pedestrian paths, or shared vehicles, we request the use of headphones or the prior consent of other passengers.\",\"s6Title\":\"6. Subscriptions, Travel Passes, and Refunds\",\"s6Item1\":\"<strong>Travel Passes:</strong> TUGGI offers different access levels: (a) 7-Day and 30-Day Passes are one-time digital purchases and do not auto-renew; (b) Annual Passes are auto-renewing subscriptions.\",\"s6Item2\":\"<strong>App Store Subscriptions (Annual Plan):</strong> For auto-renewing subscriptions, payment will be charged to your Store Account at confirmation of purchase. The subscription automatically renews unless auto-renew is turned off at least 24-hours before the end of the current period. Your account will be charged for renewal within 24-hours prior to the end of the current period. You can manage or turn off auto-renew in your Account Settings at any time after purchase.\",\"s6Item3\":\"<strong>Local Legislation:</strong> We respect the 7-day Right of Withdrawal (Brazilian Consumer Defense Code - CDC), applicable only when the purchase is processed directly through our web systems, and strictly if the digital service has not been partially or fully consumed (use of audio triggers).\",\"s7Title\":\"7. Jurisdiction and Venue\",\"s7Text\":\"These Terms of Use are governed by the laws of the Federative Republic of Brazil. The courts of the District of São Paulo, State of São Paulo, are chosen to resolve any controversies arising from the use of TUGGI, with express waiver of any other.\",\"s8Title\":\"8. Apple App Store and Google Play Store (Mandatory Clauses)\",\"s8Item1\":\"<strong>Acknowledgement:</strong> You acknowledge that these Terms are concluded between you and TUGGI only, and not with Apple or Google. TUGGI is solely responsible for the Application and its content.\",\"s8Item2\":\"<strong>Maintenance and Support:</strong> You acknowledge that Apple and Google have no obligation whatsoever to furnish any maintenance and support services with respect to the Application.\",\"s8Item3\":\"<strong>Warranty and Refunds:</strong> In the event of any failure of the Application to conform to any applicable warranty, Apple/Google's sole obligation is to refund the purchase price. To the maximum extent permitted by law, Apple/Google will have no other warranty obligation whatsoever.\",\"s8Item4\":\"<strong>Product Claims and Intellectual Property:</strong> TUGGI, not Apple or Google, is responsible for addressing any claims relating to the Application (e.g., product liability, legal compliance) and for the investigation, defense, settlement, and discharge of any third-party intellectual property infringement claims.\",\"s8Item5\":\"<strong>Legal Compliance:</strong> You represent and warrant that (i) you are not located in a country subject to a U.S. Government embargo or designated as a “terrorist supporting” country; and (ii) you are not listed on any U.S. Government list of prohibited or restricted parties.\",\"s8Item6\":\"<strong>Third Party Beneficiary:</strong> You acknowledge and agree that Apple and Google, and their subsidiaries, are third-party beneficiaries of these Terms, and have the right to enforce these Terms against you.\",\"s9Title\":\"9. Developer Contact Information\",\"s9Text\":\"TUGGI Technologies Ltda. São Paulo, SP, Brazil. Email: suporte@tuggi.app\"},\"Privacy\":{\"title\":\"Privacy Policy\",\"lastUpdated\":\"August/2026\",\"intro\":\"TUGGI Technologies values your privacy. This policy describes how we collect, use, protect, and handle your data, in strict compliance with the General Data Protection Law (LGPD - Brazil) and the General Data Protection Regulation (GDPR - European Union).\",\"s1Title\":\"1. Data We Collect\",\"s1Intro\":\"For TUGGI to function as your cultural copilot, we collect the information below. The list does not stop at the app. It also covers the data of people who approach Tuggi about a partnership, even if they have never had an account.\",\"s1Item1\":\"<strong>Account and Authentication Data:</strong> When creating an account via email or partner providers (Google, Apple, Facebook), we receive basic profile data (Name, Email, and user ID generated by our secure Supabase infrastructure).\",\"s1Item2\":\"<strong>Geolocation Data (GPS):</strong> TUGGI requires real-time location access (including in the background) to trigger audio exactly when you cross a Point of Interest (POI).\",\"s1Item3\":\"<strong>Usage and Telemetry Data:</strong> We collect information about application interactions, such as which audios were played, selected languages, and system stability metrics.\",\"s1Item4\":\"<strong>Business Contact Details:</strong> When you leave your details in the form on the partnerships page of this site, we store what you typed there. That is your name, your business name, the type of business and the channel you chose, WhatsApp number or email. We also store the language the page was in. The approximate city comes from your connection, and alongside your details we store that city, not the IP address. We use these details for one purpose only, which is to talk to you about the partnership, by phone call or by message. That means at most 4 contact attempts, within 14 calendar days of your submission. The cycle ends at whichever comes first, and after it we no longer use your details for this. To pick it up again, just send the form once more. We never use these details for newsletters, broadcast lists or marketing campaigns. You can ask us to remove them whenever you want, and section 5 explains how.\",\"s1Item5\":\"$25\",\"s1Item6\":\"<strong>The Story of the Place:</strong> In that same form we ask up to four questions about the history of the place, and the answers are free text. They are not internal material and they are not confidential. They are the raw material for the text the app may narrate to a traveller, rewritten by us and translated into the languages of the app. So write there only what you accept seeing published, including the name of anyone you mention.\",\"s1Item7\":\"<strong>Record of Contract Acceptance:</strong> When someone accepts the partnership contract on screen, we store the record of that act. It holds the name and role of the person who accepted, the email we sent the link to, the date and time from our server, the connection's IP address, the identification the browser declares, the code of the document shown and the template version. Here the IP address is stored as it is, and not turned into a code, because the purpose is a different one. This record serves one purpose only, which is to prove who accepted the contract, what they accepted, when and from where. It feeds no metric, it is not used for contact, and it is kept as proof of the contract.\",\"s1Item8\":\"$26\",\"s2Title\":\"2. How We Use Your Data (Anonymized Telemetry)\",\"s2Item1\":\"<strong>Service Operation:</strong> We use your location strictly to calculate the direction vector and proximity to cultural triggers, ensuring audio delivery at the correct timing.\",\"s2Item2\":\"<strong>Territorial Intelligence (The B2G Standard):</strong> Geolocation and audio playback data are <strong>de-linked from your personal identity (anonymized)</strong> before being stored for flow analysis. We provide aggregated reports to Governments and Rental Companies (e.g., \\\"How many plays occurred at monument X today\\\") without ever exposing who the user was. In those reports we track cultural flows, not individuals.\",\"s3Title\":\"3. Data Sharing\",\"s3Item1\":\"<strong>We do not sell your data.</strong> TUGGI does not trade Personally Identifiable Information (PII) with data brokers or ad networks.\",\"s3Item2\":\"Beyond the case described below, we share data only with infrastructure providers strictly necessary for the app to function, such as secure cloud services (e.g., Supabase for database/authentication and Google Cloud for the Text-to-Speech engine). These partners operate under strict confidentiality agreements.\",\"s3Item3\":\"<strong>The Partner Visit Identifier:</strong> On Android that identifier travels inside the Google Play link, so Google receives it when you go to install the app from the store. It is a code on our side, and it carries neither your name nor your email. On iPhone that route does not exist. There we copy the same identifier to your device's clipboard, at the moment you tap the button, for the app to read the first time it opens.\",\"s4Title\":\"4. Security and Retention\",\"s4Item1\":\"We employ end-to-end encryption in transit and at rest. Access to corporate databases and the City OS dashboard is protected by Role-Based Access Control (RBAC), ensuring data isolation.\",\"s4Item2\":\"We retain your personal data only for as long as necessary to provide the service. Anonymized telemetry data may be retained permanently for product improvement.\",\"s5Title\":\"5. Your Rights (LGPD and GDPR)\",\"s5Intro\":\"You have full control over your data. At any time, you can request:\",\"s5Item1\":\"Access, correction, or portability of your information.\",\"s5Item2\":\"The revocation of GPS use consent (which will make the app's core functionality impossible).\",\"s5ItemO1\":\"<strong>The permanent deletion of your account and personal data.</strong> To exercise this right, access our \",\"s5ItemO2\":\"Data Deletion Page\",\"s5ItemO3\":\" or use the native function within the app.\",\"s5ItemLead1\":\"<strong>Removal of the business contact details you left in a form on this site</strong>, even if you have never had an account in the app. Write to \",\"s5ItemLeadEmail\":\"suporte@tuggi.app\",\"s5ItemLead2\":\" asking for removal: we close any contact cycle under way and delete your details from our business contact list. The data deletion page is only for app accounts.\",\"s5ItemPartner1\":\"<strong>Removal of the data you sent in a partnership proposal</strong>, as far as it is not needed for the partnership under way. Write to \",\"s5ItemPartner2\":\" telling us what you want removed. If you ask us not to contact you again, contact stops immediately. The record of acceptance of a contract already signed stays as proof of it, and a request to remove contact details does not erase that record.\",\"s6Title\":\"6. Contacting the Data Protection Officer (DPO)\",\"s6P1\":\"If you have questions about this policy or the processing of your data, please contact our Data Protection Officer (DPO) through our \",\"s6P2\":\"Contact\",\"s6P3\":\" page, by choosing the profile that describes you.\",\"s7Title\":\"7. Children's Privacy\",\"s7Text\":\"TUGGI does not knowingly collect data from children under 13 without parental consent. If we discover we have collected such data, we will take steps to delete it immediately.\"},\"DataDeletion\":{\"title\":\"Data Deletion Protocol\",\"intro\":\"You hold absolute control over your telemetry and account records. At TUGGI, we ensure that your right to be forgotten is respected across our entire infrastructure.\",\"formTitle\":\"Request Account Deletion\",\"formDesc\":\"Enter your account email below. Our team will review your request and process the deletion within 24-48 business hours. You will receive a confirmation email once the process is complete.\",\"s1Title\":\"What happens to my data?\",\"s1Desc\":\"When you execute a deletion request:\",\"s1Item1\":\"Your account profile and login credentials are permanently removed from our Auth provider.\",\"s1Item2\":\"All device identifiers linked to your previous sessions are scrubbed from our telemetry database.\",\"s1Item3\":\"Any anonymized flow data previously generated remains in the aggregate, but can never be re-associated with your identity.\",\"Form\":{\"placeholder\":\"your@email.com\",\"submit\":\"Request Data Deletion\",\"success\":\"Request Received - We'll contact you in 48h\"}},\"Security\":{\"title\":\"Governance, Security, and Availability\",\"subtitle\":\"A Commitment of Trust.\",\"s1Title\":\"1. Global TUGGI Curation\",\"s1Desc\":\"TUGGI maintains its standard curation via CMS, using verified sources and artificial intelligence.\",\"s2Title\":\"2. Audit Logs and Integrity (Institutional Security)\",\"s2Item1\":\"<strong>Information Custody:</strong> TUGGI acts as the technical custodian of the platform. Every change to an audio trigger, whether made by TUGGI or a government partner, is recorded in immutable audit logs (RBAC), making it possible to track who, when, and where a narrative was altered.\",\"s3Title\":\"3. Reliability and Performance (For the B2C User)\",\"s3Intro\":\"For the traveler, reliability is measured in use. With the content already downloaded, the audio starts on its own, even where there is no signal:\",\"s3Item1\":\"<strong>Offline-First Availability:</strong> We designed TUGGI not to rely on the cloud at the moment of triggering. Once the travel package is downloaded, audio activation is local and immediate.\",\"s4Title\":\"4. Global Infrastructure\",\"s4Desc\":\"Our data is hosted in world-class data centers with AES-256 encryption at rest and TLS 1.3 in transit. We use Supabase for identity management and Google Cloud for audio processing.\"},\"Accessibility\":{\"title\":\"Accessibility & Inclusion\",\"subtitle\":\"Commitment to Inclusion and Universal Design.\",\"intro\":\"At TUGGI Technologies, we believe that access to local culture and history should have no barriers. TUGGI was conceived under the \\\"Audio-First\\\" premise, transforming the discovery experience into something purely sensory and auditory, which naturally benefits users with different accessibility profiles.\",\"s1Title\":\"1. Technical guidelines we follow (WCAG 2.1)\",\"s1Intro\":\"We are committed to ensuring that our digital platform and mobile app follow the Web Content Accessibility Guidelines (WCAG) 2.1, at Level AA.\",\"s1Item1\":\"<strong>Visual Design:</strong> We measured this site's palette against the WCAG 2.1 Level AA contrast minimum, the threshold that keeps text readable for people with low vision (audit: {a11ySiteAuditDate}). On brand colors, text and icons use the palette's dark color, and the typeface is Inter.\",\"s1Item2\":\"<strong>Navigation:</strong> Our interface is structured to be compatible with screen readers (such as VoiceOver on iOS and TalkBack on Android).\",\"s2Title\":\"2. Inclusion Features in TUGGI\",\"s2Intro\":\"Our product is designed to be accessible to both drivers and passengers:\",\"s2Item1\":\"<strong>Audio-First Experience:</strong> We eliminate the need for visual or tactile interaction with the screen during the trip. Stories are automatically triggered via geolocation, allowing visually impaired people and those with reduced mobility to enjoy the content autonomously.\",\"s2Item2\":\"<strong>Closed Captions:</strong> For passengers with hearing impairments, TUGGI offers real-time synchronized transcription. While the audio plays, the narrative text is displayed on the screen, ensuring that no one misses the cultural context of the route.\",\"s2Item3\":\"<strong>Linguistic Accessibility:</strong> We offer multilingual support in {contentLanguages} languages, ensuring that the language barrier is not an impediment to knowledge.\",\"s3Title\":\"3. Feedback Channel and Continuous Improvement\",\"s3Intro\":\"Accessibility is an ongoing process. We recognize that there is always room for improvement and are ready to listen to our users.\",\"s4Title\":\"4. Cultural Inclusion and Social Impact\",\"s4Desc\":\"Beyond technical accessibility, TUGGI acts as an agent of social inclusion. We democratize access to culture by decentralizing tourism. By redirecting flow from saturated areas to peripheral zones, we foster the local creative economy, giving a voice to the native historians, actors, and guides who build our narratives.\",\"s3Item1\":\"<strong>Report a Barrier:</strong> If you run into an access difficulty on our website or app, tell us which page or screen it happened on, what you were trying to do, and what you navigate with, such as a screen reader, the keyboard or zoom.\",\"s3Item2\":\"<strong>Commitment:</strong> We analyze each report with technical priority to ensure that TUGGI continues to be the cultural co-pilot for everyone, without exception.\",\"contactIntro\":\"To report a barrier, write to:\",\"contactEmail\":\"suporte@tuggi.app\"}},\"CookieBanner\":{\"text\":\"We use cookies to measure this site's audience, and also to know which partner brought you to the app, which is how we pay that partner. By clicking 'Accept', you agree to both uses.\",\"accept\":\"Accept\",\"decline\":\"Decline\"},\"Purpose\":{\"Hero\":{\"title\":\"Before we see, we hear.\",\"body\":\"Hearing is our oldest and most fundamental sense. Before we are born, we recognize the world through the sound of our mother's voice. We learn to listen before we learn to speak, read, or walk. TUGGI was born from this biological truth: the most natural way to absorb the world around us is not by staring at a screen, but by listening to it.\"},\"Freedom\":{\"title\":\"The Freedom to Explore.\",\"body\":\"Tourism has been trapped in rigid schedules, crowded buses, and language barriers. We believe exploration should be absolute freedom. You shouldn't have to wait for a tour guide or keep your eyes glued to a map app. With TUGGI, you drive, walk, or ride at your own pace. The stories find you at the exact geographical moment they matter.\"},\"Values\":{\"title\":\"The Foundation\",\"v2Title\":\"Operational Simplicity.\",\"v2Desc\":\"Just start the route and the app takes care of the rest.\",\"v3Title\":\"Contextual Respect.\",\"v3Desc\":\"Stories deeply connected to the physical route and narrative coherence.\",\"v4Title\":\"Precision & Reliability.\",\"v4Desc\":\"Geographical execution with perfect timing.\",\"v5Title\":\"Cultural Curation.\",\"v5Desc\":\"We skip the basics to deliver the hidden gems and true local knowledge.\",\"v6Title\":\"Universal Accessibility.\",\"v6Desc\":\"Designed to be consumed across different profiles and native languages.\"},\"Manifesto\":{\"quote\":\"“The world is better when we stop looking at it through a window, and start hearing it breathe.”\"}},\"NotFound\":{\"title\":\"Uncharted Territory\",\"subtitle\":\"You have total freedom to go anywhere and our app works offline, but it seems you've discovered a page that we haven't mapped yet.\",\"backHome\":\"Back to Civilization\",\"support\":\"Report to Support\"},\"Metadata\":{\"rootTitle\":\"TUGGI — Self-Guided Audio Travel Guide\",\"rootDescription\":\"TUGGI tells you a place's story out loud the moment you get near it. Works offline, in {contentLanguages} languages, free to start on iOS and Android.\",\"homeTitle\":\"Self-Guided Audio Travel Guide — Stories That Play As You Go | TUGGI\",\"homeDescription\":\"TUGGI tells you each place's story out loud as you pass by, however you travel. A self-guided audio travel guide that works offline, in your language. Free to start.\",\"driveTitle\":\"Tuggi Passes — guide hours that never expire\",\"driveDescription\":\"Start free, no card: you activate the full guide inside the app. Then passes of 10, 25 or 45 hours of use — one-time payment, and the hours never expire.\",\"techTitle\":\"How TUGGI Works - Offline, GPS-Triggered Audio\",\"techDescription\":\"A look under TUGGI's hood: how GPS triggers each story, how it knows which side you're passing, and how it keeps playing offline on iOS and Android.\",\"purposeTitle\":\"Our Purpose\",\"purposeDescription\":\"We built TUGGI on one idea: every place has a story worth hearing, and everyone should be able to listen, in their own language and hands-free.\",\"contactTitle\":\"Contact Us\",\"contactDescription\":\"Have a question about the app, a fleet, a destination, or press? The TUGGI team is here to help.\",\"trustCenterTitle\":\"Trust Center\",\"trustCenterDescription\":\"Legal and Compliance\",\"termsTitle\":\"Terms of Use\",\"termsDescription\":\"Terms and conditions of our services\",\"privacyTitle\":\"Privacy Policy\",\"privacyDescription\":\"How we process your data\",\"deletionTitle\":\"Data Deletion\",\"deletionDescription\":\"Request your data to be deleted\",\"securityTitle\":\"Security SLA\",\"securityDescription\":\"Our security commitments\",\"accessibilityTitle\":\"Accessibility & Inclusion\",\"accessibilityDescription\":\"Accessibility policies\",\"homeOgImageAlt\":\"TUGGI: self-guided audio travel guide\"},\"SEO_CITY_OS\":{\"title\":\"Multilingual Audio Guides for Smart Destinations\",\"description\":\"Every visitor hears your destination's own stories, in their language, as they explore. Accessible, territory-wide.\",\"ogTitle\":\"TUGGI City OS: Your Destination, Narrated for Every Visitor\",\"ogImageAlt\":\"TUGGI City OS: infrastructure for smart tourism destinations\"},\"SEO_FLEETS\":{\"title\":\"In-Car Audio Guides for Rental & Transfer Fleets\",\"description\":\"Turn rentals and transfers into a ride worth remembering. Passengers hear a local guide in their language; nothing to install.\",\"ogTitle\":\"TUGGI Fleets: An Audio Guide for Every Passenger\",\"ogImageAlt\":\"TUGGI Fleets: revenue share for car rental and transfer companies\"},\"SEO_PURPOSE\":{\"title\":\"Our Purpose — Why Every Place Deserves to Be Heard\",\"description\":\"We built TUGGI on one idea: every place has a story worth hearing, and everyone should be able to listen, in their own language and hands-free.\",\"ogTitle\":\"TUGGI: Why Every Place Deserves to Be Heard\",\"ogImageAlt\":\"TUGGI: the audio manifesto\"},\"SEO_COVERAGE\":{\"title\":\"Live Destinations — Choose Where You Explore\",\"description\":\"TUGGI is live in {coverageCountries} countries and over {mappedPointMillions} million points of interest — Italy, Spain, Portugal, Brazil, Chile, the USA and more. Audio stories play automatically the moment you start exploring.\",\"ogTitle\":\"TUGGI is Live in {coverageCountries} Countries — Over {mappedPointMillions} Million Mapped Points\",\"ogImageAlt\":\"TUGGI global coverage map: mapped points around the world\",\"ogEyebrow\":\"Global coverage\",\"ogHeadline\":\"Mapped points around the world\",\"ogStatCountries\":\"Countries\",\"ogStatRegions\":\"Regions\",\"ogCountryList\":\"Coverage by country\"},\"Coverage\":{\"Hero\":{\"tag\":\"Live Destinations\",\"title\":\"Pick a destination. Your stories are ready.\",\"subtitle\":\"TUGGI is live in {coverageCountries} countries — Italy, Spain, Portugal, Brazil, Chile, the USA and more. Select a country below — audio plays automatically the moment you start exploring.\"},\"Stats\":{\"countries\":\"Countries Live\",\"points\":\"Mapped Points\",\"regions\":\"Regions Covered\"},\"Density\":{\"sectionTitle\":\"Where TUGGI already is\",\"sectionSubtitle\":\"The lighter the area, the denser the mapped points in that region.\",\"filterAll\":\"All countries\",\"legendTitle\":\"Coverage density\",\"legend\":{\"lowest\":\"Early coverage\",\"low\":\"Moderate coverage\",\"high\":\"High coverage\",\"highest\":\"Densest coverage\"},\"listTitle\":\"Every destination, region by region\",\"listIntro\":\"The full list of what the map draws — and the regions the frame leaves out. Where an audio route already exists, the region name takes you to it.\",\"countryListTitle\":\"See if your destination is already on the map\",\"countryListIntro\":\"The full list, region by region, is on the coverage page.\",\"countryListCta\":\"See full coverage\",\"group\":{\"americas\":\"Americas\",\"europe\":\"Europe\",\"other\":\"Other destinations\"},\"outOfFrame\":\"Outside the map frame: {regions}.\"},\"CTA\":{\"title\":\"Bring TUGGI to your city.\",\"description\":\"We partner with cities, destinations, and travel companies worldwide. If your region isn't on the map yet — let's change that.\",\"button\":\"GET IN TOUCH\"}},\"Coupon\":{\"block_title\":\"Special gift\",\"block_subtitle\":\"You get {days} days of Tuggi Premium free\",\"code_label\":\"Your code\",\"copy\":\"Copy code\",\"copied\":\"Code copied!\",\"open_app\":\"Redeem in app\",\"desktop_hint\":\"Don't have the app yet? Use the buttons below to install and redeem.\"},\"Tours\":{\"heroTag\":\"Self-Guided Audio Tour\",\"heroSubtitle\":\"Self-guided audio tour · {place}\",\"heroCtaPrimary\":\"Listen in the Tuggi app\",\"heroCtaSecondary\":\"View the map\",\"facts\":{\"duration\":\"Duration\",\"distance\":\"Distance\",\"stops\":\"Stops\",\"drivability\":\"Difficulty\",\"accessibility\":\"Accessibility\",\"bestTime\":\"Best time\",\"languages\":\"Languages\",\"varies\":\"Varies\"},\"drivability\":{\"easy\":\"Easy\",\"moderate\":\"Moderate\",\"demanding\":\"Demanding\",\"unknown\":\"—\"},\"accessibility\":{\"accessible\":\"Accessible\",\"partial\":\"Partially accessible\",\"not_accessible\":\"Not accessible\",\"unknown\":\"—\"},\"bestTime\":{\"morning\":\"Morning\",\"afternoon\":\"Afternoon\",\"sunset\":\"Sunset\",\"evening\":\"Evening\",\"night\":\"Night\",\"anytime\":\"Anytime\"},\"itineraryTitle\":\"What you'll see and hear\",\"itinerarySubtitle\":\"The stops on this route, in order — with audio previews where available.\",\"audioPreview\":\"Audio preview\",\"faqTitle\":\"Frequently asked questions\",\"faq\":{\"duration\":{\"q\":\"How long does this tour take?\",\"a\":\"About {duration} of audio across {stops} stops, covering roughly {distance}. Go at your own pace — the audio plays automatically as you move.\"},\"accessibility\":{\"q\":\"Is this tour accessible?\",\"a\":\"This route is rated: {level}. Check each stop for specific access details.\"},\"languages\":{\"q\":\"What languages is it available in?\",\"a\":\"This tour is available in: {languages}.\"},\"offline\":{\"q\":\"Do I need an internet connection?\",\"a\":\"No. Download the tour in the Tuggi app and listen offline — the audio is triggered by your location, hands-free.\"},\"mode\":{\"q\":\"Can I do it walking or driving?\",\"a\":\"This route is designed for {level} travel. The audio adapts to your pace.\"}},\"relatedTitle\":\"More tours nearby\",\"stopsCount\":\"{count, plural, one {# stop} other {# stops}}\",\"stopsMerged\":\"Stops {from}–{to}\",\"breadcrumbTours\":\"Audio Tours\",\"metaTitle\":\"{name} — Self-Guided Audio Tour\",\"metaDescFallback\":\"A self-guided audio tour in {place} with Tuggi. Stories that play automatically as you explore.\",\"ctaTitle\":\"Hear the whole story\",\"ctaSubtitle\":\"Get the Tuggi app and let every stop come to life — hands-free, offline, in your language.\",\"ctaButton\":\"Get the Tuggi app\",\"countryIn\":{\"BR\":\"in Brazil\",\"ES\":\"in Spain\",\"FR\":\"in France\",\"GB\":\"in the United Kingdom\",\"IT\":\"in Italy\",\"PT\":\"in Portugal\",\"US\":\"in the United States\"},\"countryMetaTitle\":\"Self-Guided Audio Tours {inCountry}\",\"countryMetaDesc\":\"Explore self-guided audio tours {inCountry} with Tuggi — maps, real audio previews and practical info for each route.\",\"countryTitle\":\"Self-Guided Audio Tours {inCountry}\",\"countrySubtitle\":\"{count, plural, one {# curated route} other {# curated routes}} {inCountry}, each with a map, stops and real audio previews.\",\"hubMetaTitle\":\"Self-Guided Audio Tours\",\"hubMetaDesc\":\"Browse Tuggi's self-guided audio tours by country — curated routes with maps, stops and real audio previews.\",\"hubTitle\":\"Self-Guided Audio Tours\",\"hubSubtitle\":\"Curated routes that play automatically as you explore — browse by country.\",\"hubEmpty\":\"This list is empty in your language. In the app, the narration follows the language you use — your journey is what creates the audio.\",\"viewAllInCountry\":\"View all {count}\",\"themes\":{\"historical\":\"Historic\",\"urban\":\"Urban\",\"nature\":\"Nature\",\"panoramic\":\"Panoramic\",\"cultural\":\"Cultural\",\"scenic\":\"Scenic\",\"coastal\":\"Coastal\",\"religious\":\"Religious\",\"gastronomic\":\"Food\",\"rural\":\"Countryside\"},\"languagesCount\":\"{count, plural, one {# language} other {# languages}}\",\"statesNavLabel\":\"States with routes\",\"stateMetaTitle\":\"{state} — Self-Guided Audio Tours\",\"stateMetaDesc\":\"{count, plural, one {# curated self-guided audio tour} other {# curated self-guided audio tours}} in {state}, {country} — maps, stops and real audio previews.\",\"stateTitle\":\"{state}\",\"stateSubtitle\":\"{count, plural, one {# curated route} other {# curated routes}} across {country}, each with a map, stops and real audio previews.\",\"viewAllInState\":\"View all {count}\",\"audioLanguages\":\"Audio languages\",\"legendWithAudio\":\"With audio and story\",\"legendPassThrough\":\"Pass-through point\",\"stickyText\":\"Hear this route, hands-free\",\"stickyCta\":\"Get the app\"},\"Languages\":{\"title\":\"Listen in your language\",\"subtitle\":\"From Portuguese to Korean, with distinct accents so you feel at home. Find yours below.\",\"langs\":[\"Portuguese (BR)\",\"Portuguese (PT)\",\"English (US)\",\"English (UK)\",\"Spanish\",\"Italian\",\"French\",\"German\",\"Mandarin\",\"Korean\"]},\"A11y\":{\"openMenu\":\"Open menu\",\"closeMenu\":\"Close menu\",\"menu\":\"Menu\",\"mainMenu\":\"Main menu\",\"sitePages\":\"Site pages\",\"breadcrumb\":\"Breadcrumb\",\"routeMap\":\"Interactive route map\",\"toggleCaptions\":\"Turn captions on or off\",\"skipToContent\":\"Skip to main content\",\"playAudio\":\"Play audio\",\"pauseAudio\":\"Pause audio\"},\"Updates\":{\"seo\":{\"title\":\"Updates and release notes\",\"description\":\"What changed in the app, when it changed, and what happens to what you already bought.\",\"ogImageAlt\":\"Share card for the Tuggi updates section.\"},\"title\":\"Updates\",\"subtitle\":\"Release notes and product news, newest first.\",\"readMore\":\"Read\",\"cta\":{\"button\":\"Get the app\",\"body\":\"Your welcome hours are waiting in the app.\"},\"rail\":{\"title\":\"Explore Tuggi\"},\"backToSection\":\"Back to Updates\",\"empty\":{\"body\":\"Nothing published in this language yet.\",\"link\":\"Read in Engli