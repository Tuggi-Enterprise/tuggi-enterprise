ue},{\"name\":\"Canindé — Portuguesa de Desportos\",\"lat\":-23.5049,\"lng\":-46.6204,\"hasContent\":false},{\"name\":\"Ponte Metálica do Ibirapuera\",\"lat\":-23.5882,\"lng\":-46.6605,\"hasContent\":false},{\"name\":\"Estádio Cícero Pompeu de Toledo (Morumbi)\",\"lat\":-23.6005,\"lng\":-46.7197,\"hasContent\":true},{\"name\":\"Autódromo José Carlos Pace — GP do Brasil de F1\",\"lat\":-23.7014,\"lng\":-46.6991,\"hasContent\":false},{\"name\":\"Estádio Nicolau Alayon — EC Santo André\",\"lat\":-23.6512,\"lng\":-46.5318,\"hasContent\":false},{\"name\":\"Neo Química Arena (Estádio)\",\"lat\":-23.5453,\"lng\":-46.4741,\"hasContent\":false},{\"name\":\"Relógio de Sol\",\"lat\":-23.4966,\"lng\":-46.874,\"hasContent\":true},{\"name\":\"Centro de Treinamento Paralímpico (legado Pan 2007)\",\"lat\":-23.7158,\"lng\":-46.5413,\"hasContent\":false}],\"stops\":[{\"position\":1,\"name\":\"Allianz Parque — Palmeiras (Palestra Itália)\",\"description\":\"\",\"audios\":[],\"hasContent\":false,\"alsoPositions\":[],\"defaultLang\":\"en\"},{\"position\":2,\"name\":\"MUSEU DO FUTEBOL\",\"description\":\"Nestled within the iconic Pacaembu Stadium, this vibrant museum celebrates the profound cultural significance of football in Brazil. Inaugurated in 2008, it offers an immersive journey through the sport's history, from its European origins to its deep integration into the national identity. Through interactive exhibits and a unique architectural integration with the stadium, visitors can explore the evolution of the game, its social impact, and its connection to Brazilian arts and life. A notable architectural feature is the \\\"Exaltation Room,\\\" which offers a dramatic view into the stadium's underbelly, surrounded by projected images and sounds of passionate fans.\",\"audios\":[{\"lang\":\"en\",\"label\":\"EN\",\"audioUrl\":\"https://tysnkzmljlmmqpbotkxv.supabase.co/storage/v1/object/public/travel-app-audios/master_audio/0e8d7ebd-8ff6-56b7-8129-4e19fab86c38/0e8d7ebd-8ff6-56b7-8129-4e19fab86c38-en-us-male.mp3\"},{\"lang\":\"pt-br\",\"label\":\"PT-BR\",\"audioUrl\":\"https://tysnkzmljlmmqpbotkxv.supabase.co/storage/v1/object/public/travel-app-audios/master_audio/0e8d7ebd-8ff6-56b7-8129-4e19fab86c38/0e8d7ebd-8ff6-56b7-8129-4e19fab86c38-pt-br-male.mp3\"}],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"en\"},{\"position\":3,\"name\":\"Canindé — Portuguesa de Desportos\",\"description\":\"\",\"audios\":[],\"hasContent\":false,\"alsoPositions\":[],\"defaultLang\":\"en\"},{\"position\":4,\"name\":\"Ponte Metálica do Ibirapuera\",\"description\":\"\",\"audios\":[],\"hasContent\":false,\"alsoPositions\":[],\"defaultLang\":\"en\"},{\"position\":5,\"name\":\"Estádio Cícero Pompeu de Toledo (Morumbi)\",\"description\":\"\",\"audios\":[{\"lang\":\"pt-br\",\"label\":\"PT-BR\",\"audioUrl\":\"https://tysnkzmljlmmqpbotkxv.supabase.co/storage/v1/object/public/travel-app-audios/master_audio/3704c134-946f-41ca-82c8-27db2ebb68af/3704c134-946f-41ca-82c8-27db2ebb68af-pt-br-male.mp3\"}],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"en\"},{\"position\":6,\"name\":\"Autódromo José Carlos Pace — GP do Brasil de F1\",\"description\":\"\",\"audios\":[],\"hasContent\":false,\"alsoPositions\":[],\"defaultLang\":\"en\"},{\"position\":7,\"name\":\"Estádio Nicolau Alayon — EC Santo André\",\"description\":\"\",\"audios\":[],\"hasContent\":false,\"alsoPositions\":[],\"defaultLang\":\"en\"},{\"position\":8,\"name\":\"Neo Química Arena (Estádio)\",\"description\":\"\",\"audios\":[],\"hasContent\":false,\"alsoPositions\":[],\"defaultLang\":\"en\"},{\"position\":9,\"name\":\"Relógio de Sol\",\"description\":\"\",\"audios\":[{\"lang\":\"pt-br\",\"label\":\"PT-BR\",\"audioUrl\":\"https://tysnkzmljlmmqpbotkxv.supabase.co/storage/v1/object/public/travel-app-audios/master_audio/27a931cf-8261-5cbb-b799-1bf62d91f32e/27a931cf-8261-5cbb-b799-1bf62d91f32e-pt-br-male.mp3\"}],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"en\"},{\"position\":10,\"name\":\"Centro de Treinamento Paralímpico (legado Pan 2007)\",\"description\":\"\",\"audios\":[],\"hasContent\":false,\"alsoPositions\":[],\"defaultLang\":\"en\"}]}]\n13:[\"$\",\"$L1e\",null,{\"items\":[{\"question\":\"How long does this tour take?\",\"answer\":\"About 4h 18min of audio across 10 stops, covering roughly 201.6 km. Go at your own pace — the audio plays automatically as you move.\"},{\"question\":\"Is this tour accessible?\",\"answer\":\"This route is rated: Partially accessible. Check each stop for specific access details.\"},{\"question\":\"What languages is it available in?\",\"answer\":\"This tour is available in: English, Español, Português, Italiano.\"},{\"question\":\"Do I need an internet connection?\",\"answer\":\"No. Download the tour in the Tuggi app and listen offline — the audio is triggered by your location, hands-free.\"},{\"question\":\"Can I do it walking or driving?\",\"answer\":\"This route is designed for Moderate travel. The audio adapts to your pace.\"}]}]\n20:T4c4,M37.7 30.8L38.1 30.5L39.2 31L40.8 28.8L40.7 31L37.1 35.2L36.4 34.6L39.6 28.5L42.4 26.5L41.3 26.6L40.9 25.8L38.3 26.6L38.9 28.4L38.2 30.4L39.2 31L37.7 29.4L37.6 27.9L37 27.5L37.8 26.3L38.3 28.2L37.9 29.6L33.1 34.7L32.4 34.1L33.9 32.3L32.4 31L32.6 30.6L38.5 24.6L44.8 22L45.4 20L47.4 20.4L49.3 20.1L50.4 18.4L48.3 16.8L46.8 18.1L47.8 22.5L50.7 24L52.6 23.4L54 24L54.9 22.3L57.7 21.5L58.3 20.8L58.5 18.6L58.2 16.7L57.2 16.6L57.4 15.6L55.9 18.7L57.3 21.2L57.8 26.5L56.6 27L55.1 29.7L53.9 29.7L52.8 30.5L52.7 30L52.6 28.5L54 28.4L53.8 24.4L54.8 22.4L57.7 21.5L58.3 20.8L58.7 18.1L58.2 13.8L59.6 10.1L54.2 8.6L53.2 10.5L51.3 9.9L52.4 5L54.9 5.8L52.1 15.3L52.7 16.1L49.8 21L51.4 24.6L49 30.7L48 41.3L39.6 47.8L38.3 48.2L34.7 50.9L31.8 50.8L29.4 49L27.9 49L29.4 49.3L31.6 50.8L34.2 51.1L37.9 48.8L39.7 50.3L41.1 53.4L41.9 54.1L46.1 55.8L50.2 55.4L51.3 54.7L51.5 55.1L53.2 55.1L55.2 56.6L56.3 55.8L59.7 56.8L61 56L62.8 57L63.5 56.1L63.2 54.7L64.7 53.8L65 52.5L65.9 51.7L67 52.6L72.1 52.3L71.7 47.7L68.7 