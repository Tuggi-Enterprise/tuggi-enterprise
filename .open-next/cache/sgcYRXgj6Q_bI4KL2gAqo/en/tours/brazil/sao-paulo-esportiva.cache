/2 -translate-x-1/2 w-full h-full pointer-events-none opacity-5\"><div class=\"absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-tuggi-primary blur-[120px]\"></div></div><div class=\"page-shell relative z-10\"><span class=\"inline-block px-4 py-1.5 mb-5 text-sm font-bold tracking-wider text-tuggi-primary-text uppercase bg-tuggi-primary/5 rounded-full\">Self-Guided Audio Tour</span><h1 class=\"text-4xl md:text-6xl font-black text-tuggi-dark mb-4 leading-tight\">São Paulo Sports Scene</h1><p class=\"text-lg text-tuggi-slate\">Self-guided audio tour · São Paulo</p><div class=\"mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] xl:grid-cols-[minmax(0,1fr)_minmax(0,32rem)] lg:gap-12 lg:items-start\"><div class=\"order-1 lg:order-2\"><div class=\"max-w-lg lg:max-w-none rounded-3xl border border-gray-100 bg-tuggi-bg p-6 shadow-sm\"><dl class=\"grid grid-cols-3 gap-4\"><div class=\"flex flex-col-reverse\"><dt class=\"mt-1 text-[11px] font-bold uppercase tracking-wider text-tuggi-slate\">Duration</dt><dd class=\"text-xl font-black text-tuggi-dark leading-none\">4h 18min</dd></div><div class=\"flex flex-col-reverse\"><dt class=\"mt-1 text-[11px] font-bold uppercase tracking-wider text-tuggi-slate\">Distance</dt><dd class=\"text-xl font-black text-tuggi-dark leading-none\">201.6 km</dd></div><div class=\"flex flex-col-reverse\"><dt class=\"mt-1 text-[11px] font-bold uppercase tracking-wider text-tuggi-slate\">Stops</dt><dd class=\"text-xl font-black text-tuggi-dark leading-none\">10</dd></div></dl><dl class=\"mt-5 border-t border-gray-200/70\"><div class=\"flex items-baseline justify-between gap-4 border-b border-gray-200/70 py-2.5 last:border-b-0\"><dt class=\"inline-flex items-center gap-2 shrink-0 text-sm text-tuggi-slate\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-car w-4 h-4 text-tuggi-slate/70 shrink-0\" aria-hidden=\"true\"><path d=\"M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2\"></path><circle cx=\"7\" cy=\"17\" r=\"2\"></circle><path d=\"M9 17h6\"></path><circle cx=\"17\" cy=\"17\" r=\"2\"></circle></svg>Difficulty</dt><dd class=\"text-sm font-semibold text-tuggi-dark text-right\">Moderate</dd></div><div class=\"flex items-baseline justify-between gap-4 border-b border-gray-200/70 py-2.5 last:border-b-0\"><dt class=\"inline-flex items-center gap-2 shrink-0 text-sm text-tuggi-slate\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-accessibility w-4 h-4 text-tuggi-slate/70 shrink-0\" aria-hidden=\"true\"><circle cx=\"16\" cy=\"4\" r=\"1\"></circle><path d=\"m18 19 1-7-6 1\"></path><path d=\"m5 8 3-3 5.5 3-2.36 3.5\"></path><path d=\"M4.24 14.5a5 5 0 0 0 6.88 6\"></path><path d=\"M13.76 17.5a5 5 0 0 0-6.88-6\"></path></svg>Accessibility</dt><dd class=\"text-sm font-semibold text-tuggi-dark text-right\">Partially accessible</dd></div><div class=\"flex items-baseline justify-between gap-4 border-b border-gray-200/70 py-2.5 last:border-b-0\"><dt class=\"inline-flex items-center gap-2 shrink-0 text-sm text-tuggi-slate\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sun w-4 h-4 text-tuggi-slate/70 shrink-0\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2\"></path><path d=\"M12 20v2\"></path><path d=\"m4.93 4.93 1.41 1.41\"></path><path d=\"m17.66 17.66 1.41 1.41\"></path><path d=\"M2 12h2\"></path><path d=\"M20 12h2\"></path><path d=\"m6.34 17.66-1.41 1.41\"></path><path d=\"m19.07 4.93-1.41 1.41\"></path></svg>Best time</dt><dd class=\"text-sm font-semibold text-tuggi-dark text-right\">Morning · Afternoon</dd></div><div class=\"flex items-baseline justify-between gap-4 border-b border-gray-200/70 py-2.5 last:border-b-0\"><dt class=\"inline-flex items-center gap-2 shrink-0 text-sm text-tuggi-slate\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe w-4 h-4 text-tuggi-slate/70 shrink-0\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg>Languages</dt><dd class=\"text-sm font-semibold text-tuggi-dark text-right\">English · Español · Português · Italiano</dd></div></dl><div class=\"mt-6 flex flex-col gap-3\"><a href=\"/d/tuggi\" class=\"inline-flex items-center justify-center gap-2 px-6 py-4 bg-tuggi-primary text-tuggi-dark font-black rounded-2xl shadow-lg shadow-tuggi-primary/20 hover:shadow-xl hover:-translate-y-0.5 transition-all\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-headphones w-5 h-5\" aria-hidden=\"true\"><path d=\"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3\"></path></svg>Listen in the Tuggi app</a><a href=\"#route-map\" class=\"inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-white text-tuggi-dark font-bold rounded-2xl border border-gray-200 hover:bg-gray-50 transition-all\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-5 h-5 text-tuggi-primary\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>View the map</a></div></div></div><p class=\"order-2 lg:order-1 text-lg text-tuggi-slate leading-relaxed whitespace-pre-line\">A road trip through São Paulo&#x27;s legendary sports arenas. We&#x27;ll visit Allianz Parque, home of Palmeiras, Morumbi, where São Paulo FC plays, the historic Pacaembu stadium, Canindé, the grounds of Portuguesa, the Ibirapuera Gymnasium, a hub for volleyball, the Interlagos Racetrack, host of the Formula 1 Brazilian Grand Prix, and finally, Neo Química Arena in Itaquera, the Corinthians&#x27; stadium.</p></div></div></section><section id=\"route-map\" class=\"py-16 bg-white\" aria-labelledby=\"itinerary-heading\"><div class=\"page-shell\"><h2 id=\"itinerary-heading\" class=\"text-3xl md:text-4xl font-black text-tuggi-dark mb-3\">What you&#x27;ll see and hear</h2><p class=\"text-tuggi-slate\">The stops on this route, in order — with audio previews where available.</p><div class=\"mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] xl:grid-cols-[minmax(0,1fr)_minmax(0,32rem)] lg:gap-12 lg:items-start\"><div class=\"lg:order-2 lg:sticky lg:top-24\"><div class=\"rounded-3xl overflow-hidden border border-gray-100 shadow-sm h-[340px] sm:h-[420px] lg:h-[min(30rem,calc(100vh-16rem))]\"><div style=\"width:100%;height:100%;min-height:320px\" role=\"application\" aria-label=\"Interactive route map\"></div></div><ul class=\"mt-3 flex flex-wrap gap-x-5 gap-y-2 text-xs text-tuggi-slate\"><li class=\"inline-flex items-center gap-2\"><span class=\"w-3 h-3 rounded-full bg-tuggi-primary shadow-sm\"></span>With audio and story</li><li class=\"inline-flex items-center gap-2\"><span class=\"w-3 h-3 rounded-full bg-white border-2 border-tuggi-slate\"></span>Pass-through point</li></ul><a href=\"/d/tuggi\" class=\"hidden md:inline-flex items-center gap-2 mt-6 px-6 py-3.5 bg-tuggi-primary text-tuggi-dark font-black rounded-2xl shadow-lg shadow-tuggi-primary/20 hover:shadow-xl hover:-translate-y-0.5 transition-all\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-headphones w-5 h-5\" aria-hidden=\"true\"><path d=\"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3\"></path></svg>Listen in the Tuggi app</a></div><div class=\"lg:order-1\"><ol class=\"relative border-l-2 border-tuggi-primary/20 ml-3\"><li id=\"stop-1\" data-position=\"1\" class=\"ml-8 scroll-mt-28 mb-5\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-white text-tuggi-slate border-2 border-tuggi-slate \" aria-hidden=\"true\">1</span><h3 class=\"flex items-center gap-2 py-1 font-semibold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-slate/60 shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Allianz Parque — Palmeiras (Palestra Itália)</h3></li><li id=\"stop-2\" data-position=\"2\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">2</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-primary shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>MUSEU DO FUTEBOL</h3><p class=\"mt-2 text-tuggi-slate leading-relaxed\">Nestled within the iconic Pacaembu Stadium, this vibrant museum celebrates the profound cultural significance of football in Brazil. Inaugurated in 2008, it offers an immersive journey through the sport&#x27;s history, from its European origins to its deep integration into the national identity. Through interactive exhibits and a unique architectural integration with the stadium, visitors can explore the evolution of the game, its social impact, and its connection to Brazilian arts and life. A notable architectural feature is the &quot;Exaltation Room,&quot; which offers a dramatic view into the stadium&#x27;s underbelly, surrounded by projected images and sounds of passionate fans.</p><div class=\"mt-4\"><div class=\"flex items-center gap-2 mb-2 text-xs font-bold uppercase tracking-wider text-tuggi-primary-text\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-volume2 lucide-volume-2 w-4 h-4\" aria-hidden=\"true\"><path d=\"M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .9