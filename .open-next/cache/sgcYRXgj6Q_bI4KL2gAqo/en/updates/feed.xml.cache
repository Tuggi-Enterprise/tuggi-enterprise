{"type":"route","meta":{"status":200,"headers":{"cache-control":"public, max-age=3600, s-maxage=86400","content-type":"application/rss+xml; charset=utf-8","x-next-cache-tags":"_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/updates/layout,_N_T_/[locale]/updates/feed.xml/layout,_N_T_/[locale]/updates/feed.xml/route,_N_T_/en/updates/feed.xml"}},"body":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<rss version=\"2.0\" xmlns:atom=\"http://www.w3.org/2005/Atom\">\n  <channel>\n    <title>Updates and release notes</title>\n    <link>https://www.tuggi.app/en/updates</link>\n    <description>What changed in the app, when it changed, and what happens to what you already bought.</description>\n    <language>en</language>\n    <atom:link href=\"https://www.tuggi.app/en/updates/feed.xml\" rel=\"self\" type=\"application/rss+xml\"/>\n    <item>\n      <title>When the guide starts talking</title>\n      <link>https://www.tuggi.app/en/updates/audio-guide-that-starts-on-its-own</link>\n      <guid isPermaLink=\"true\">https://www.tuggi.app/en/updates/audio-guide-that-starts-on-its-own</guid>\n      <pubDate>Sun, 30 Aug 2026 00:00:00 GMT</pubDate>\n      <description>You come near a place worth hearing and the story starts, with no typing, no stopping the car and no looking at the screen.</description>\n    </item>\n    <item>\n      <title>The hour passes are here</title>\n      <link>https://www.tuggi.app/en/updates/hour-passes</link>\n      <guid isPermaLink=\"true\">https://www.tuggi.app/en/updates/hour-passes</guid>\n      <pubDate>Sun, 30 Aug 2026 00:00:00 GMT</pubDate>\n      <description>You buy hours of guide, and your balance runs while the guide is on. The map, the descriptions and the events nearby cost no hours at all.</description>\n    </item>\n  </channel>\n</rss>"}