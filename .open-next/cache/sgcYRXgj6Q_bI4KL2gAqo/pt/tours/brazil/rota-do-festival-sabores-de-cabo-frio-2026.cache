\":\"Andressa Aguiar Confeitaria\",\"lat\":-22.88937,\"lng\":-42.02943,\"hasContent\":true},{\"name\":\"Office Café\",\"lat\":-22.88973,\"lng\":-42.03042,\"hasContent\":true},{\"name\":\"Restaurante Pelicano Oásis\",\"lat\":-22.89088,\"lng\":-42.0319,\"hasContent\":true},{\"name\":\"Zion Bike Café\",\"lat\":-22.89176,\"lng\":-42.03463,\"hasContent\":true},{\"name\":\"Bistrô Milano\",\"lat\":-22.8959,\"lng\":-42.0342,\"hasContent\":true},{\"name\":\"Mangia Que Cresce Pizzaria\",\"lat\":-22.88444,\"lng\":-42.03611,\"hasContent\":true},{\"name\":\"Ancho e Faca\",\"lat\":-22.88013,\"lng\":-42.03568,\"hasContent\":true},{\"name\":\"Família Braga Gourmet\",\"lat\":-22.8799,\"lng\":-42.03932,\"hasContent\":true},{\"name\":\"Família Braga Pizzaria\",\"lat\":-22.8799,\"lng\":-42.03932,\"hasContent\":true},{\"name\":\"Hey Crepe\",\"lat\":-22.87989,\"lng\":-42.03944,\"hasContent\":true},{\"name\":\"Boteco Seu Osmar\",\"lat\":-22.87946,\"lng\":-42.04186,\"hasContent\":true},{\"name\":\"Japa do Seu Osmar\",\"lat\":-22.87946,\"lng\":-42.04186,\"hasContent\":true},{\"name\":\"Limoeiro Bar e Quitutes\",\"lat\":-22.8796,\"lng\":-42.04282,\"hasContent\":true},{\"name\":\"Faella Bistrô\",\"lat\":-22.87804,\"lng\":-42.04124,\"hasContent\":true},{\"name\":\"Tucas Empório Bistrô\",\"lat\":-22.879,\"lng\":-42.0457,\"hasContent\":true},{\"name\":\"Pizza 55\",\"lat\":-22.88826,\"lng\":-42.04578,\"hasContent\":true},{\"name\":\"Nina Pasta e Basta\",\"lat\":-22.87606,\"lng\":-42.03532,\"hasContent\":true},{\"name\":\"Garota Beer\",\"lat\":-22.87604,\"lng\":-42.0351,\"hasContent\":true},{\"name\":\"Paelo Hamburgueria\",\"lat\":-22.8762,\"lng\":-42.03456,\"hasContent\":true},{\"name\":\"Showrrasquinho Gourmet\",\"lat\":-22.87657,\"lng\":-42.03237,\"hasContent\":true},{\"name\":\"Gunther Hamburgueria\",\"lat\":-22.87729,\"lng\":-42.03162,\"hasContent\":true},{\"name\":\"Bazar Bakery\",\"lat\":-22.87261,\"lng\":-42.03572,\"hasContent\":true},{\"name\":\"Âncora Restaurante\",\"lat\":-22.86293,\"lng\":-41.98595,\"hasContent\":true}],\"stops\":[{\"position\":1,\"name\":\"Nonna Tiva Bistrô\",\"description\":\"Restaurante na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Arantella, risoto de costela em formato de bolinho crocante, servido com aioli defumado de páprica e pesto de agrião.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":2,\"name\":\"Pão do Edu — Passagem\",\"description\":\"Padaria na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Uai Dog, sanduiche de linguiça mineira artesanal com creme de queijo meia cura, rúcula, pesto de ora-pro-nobis, no pão brioche de bacon, queijo e ervas.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":3,\"name\":\"Felicitá Gelato Artesanal\",\"description\":\"Doceria na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Cookie Cremoso Biscoff, cookie cremoso recheado com creme de biscoff, finalizado com gelato de flor de latte e farofa de biscoff.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":4,\"name\":\"Ateliê Cafeteria e Confeitaria\",\"description\":\"Cafeteria na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Delicatto, mousse de chocolate belga meio amargo com avelãs in natura, brownie, cápsula de chocolate recheado com creme de vanilla french, acompanhado de calda meia amarga e avelãs tostados.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":5,\"name\":\"Escritório do Chef\",\"description\":\"Restaurante na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Panelas da Memória, nacos de filé mignon de panela, envolvidas em molho com toque de vinho, lascas de aipim frito na manteiga de ervas e mini cebolas glaceadas.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":6,\"name\":\"Restaurante O Pescador\",\"description\":\"Restaurante na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Memórias do Cais, lascas de peixe branco grelhadas em azeite de ervas, com purê de batata-baroa, toque de queijo coalho e farofa de camarão.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":7,\"name\":\"José Bakery\",\"description\":\"Cafeteria na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Pavê da Dona Leda, massa sablée, creme diplomata, brigadeiro, biscoito champagne e glaçagem chocolate branco.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":8,\"name\":\"Borogodó Nordestino\",\"description\":\"Restaurante na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato As Nordestinas, cocada cremosa quente com sorvete de tapioca ou paçoca, finalizado com castanha granulada e melaço de cana.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":9,\"name\":\"Quintal Restaurante\",\"description\":\"Restaurante na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Bifanas Portuguesas, finas fatias de pernil de porco marinadas em vinho branco, alho e especiarias, cozidas lentamente até ficarem extremamente macias. Servidas no pão crocante, envolvidas no seu molho típico e finalizadas com queijo prato derretido.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":10,\"name\":\"The Duck Rock Pub\",\"description\":\"Pub na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Raizes do Mar, bobo de camarão com arroz de castanhas e farofa de coco.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":11,\"name\":\"San Lorenzo Gelateria\",\"description\":\"Gelateria na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Sabor de Infância, bolo de chocolate com calda de brigadeiro quente e sorbet de morango, finalizado com granulado ao leite e disco de biscoito de vanilla artesanal.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":12,\"name\":\"Arcos do Canal\",\"description\":\"Restaurante mediterrâneo na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Costela de herança, costela prensada ao molho de agrião com nhoques de aipim.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":13,\"name\":\"Pizza da Mari\",\"description\":\"Pizzaria na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Sicilia al Mare, pizza de longa fermentação com molho branco de limão siciliano, mussarela de búfala, camarão salteado e coentro.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":14,\"name\":\"Giulietta Gelato\",\"description\":\"Gelateria na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Doce Abraço da Giulietta, tarte de Baunilha com praliné artesanal. Massa sablée amanteigada, creme de baunilha, praliné artesanal de castanha de caju, amêndoas e amendoim, servida com gelato de bala de manteiga e toffee.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":15,\"name\":\"Baires Bistrô\",\"description\":\"Bistrô na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Pérolas da Vovó, nhoque de rúcula recheado com gorgonzola. Molho de tomate fresco e manjericão.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":16,\"name\":\"Fornalha Nobre Pizzeria\",\"description\":\"Pizzaria na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Minas Gerais, massa de fermentação longa, com muçarela, frango assado defumado e requeijão de corte, finalizado com azeite, orégano siciliano e broto.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":17,\"name\":\"Paelo & Parrilla\",\"description\":\"Restaurante na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Dona Chica, feijão Tropeiro preparado na brasa com farinha de milho e crocante de panko com banana, linguiça mineira artesanal e panceta, finalizado com couve selada na parrilla, acompanhado de costelinha suína defumada lentamente e glaceada com rapadura, cachaça e limão.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":18,\"name\":\"Armazém da Passagem\",\"description\":\"Restaurante na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Açorda da Vó, açorda de camarões salteados no pão artesanal umedecido em um caldo intenso de camarão, coroado com ovo pochê.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":19,\"name\":\"Bamba\",\"description\":\"Bar na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Rolê da Vó Dina, pão rústico com rolé bovino, rúcula, queijo canastra e molho pomodoro.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":20,\"name\":\"José Restaurante\",\"description\":\"Restaurante mediterrâneo na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Brasas de Família, coxa e sobrecoxa cozido lentamente no sous vide e finalizadas na brasa, batata assada e redução de laranja.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":21,\"name\":\"Casa Kanaloa\",\"description\":\"Restaurante tailandês na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Arroz Thai, arroz Thai frito ao mar e terra com vegetais e curry.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":22,\"name\":\"Passagem Altto Sushi\",\"description\":\"Restaurante japonês na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Takoyaki, bolinhas de massa de crepe grelhadas e recheadas de polvo.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":23,\"name\":\"Bravo Café\",\"description\":\"Cafeteria na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Atacama, sanduíche de filé mignon, servido no pão italiano, recheado com cream cheese, queijo gouda e cebola caramelizada.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":24,\"name\":\"Iconiko\",\"description\":\"Restaurante japonês na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Tartar Mexicano, tartar de atum marinado no limão e flor de sal, com molho de ervas finas, guacamole, ovas de masago, molho ponzu e maracujá, finalizado com broto de beterraba.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":25,\"name\":\"Leña Casa Italiana\",\"description\":\"Restaurante italiano na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Essenza Italiana, risoto de vinho tinto com ossobuco.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":26,\"name\":\"Restaurante do Deck\",\"description\":\"Restaurante na Ogiva, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Nhoque do Deck, nhoque artesanal de batata dourada na manteiga, ragù de costela cozido lentamente, fonduta de parmesão e farofa crocante de panko com bacon.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":27,\"name\":\"Delírios Restaurante\",\"description\":\"Restaurante na Ogiva, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Nhoque da Dona Mercedes, nhoque de batata ao sugo com ragu de fraldinha.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":28,\"name\":\"Mar. Restaurante\",\"description\":\"Restaurante de frutos do mar em São Bento, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Mirante do Mar, escondidinho de camarão e palmito, com base de mousseline de raízes, farofa de panko e parmesão, espuma aerada de catupiry, finalizada com crispy de filo.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":29,\"name\":\"Cozí+ Cafeteria e restaurante\",\"description\":\"Restaurante no Centro, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Felicidade na Panela, camarão e lula ao curry suave, com arroz cremoso ao leite de coco, finalizado com camarão crocante.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":30,\"name\":\"O Suisso\",\"description\":\"Confeitaria em São Bento, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Minuit Du Nouvel An, base de massa folhada recheada com purê de batata, tiras de alcatra na manteiga, molho bechamel de cogumelos paris gratinado com queijo muçarela.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":31,\"name\":\"La Pastaria\",\"description\":\"Restaurante italiano no Centro, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Gnochi Nuvem Coral, gnochi da Nona, ao molho branco com bisque de camarão e alho-poró, finalizado com camarão flambado ao rum, farofa de bacon e tuile coral.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":32,\"name\":\"Tróia Bar Lounge\",\"description\":\"Bar em São Bento, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Memórias entre duas mordidas, pão de hambúrguer e blend de carne 150g, gorgonzola, geléia de bacon, rúcula e cebola crispy.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":33,\"name\":\"Lino Cafeteria\",\"description\":\"Cafeteria no Boulevard Canal, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Três Pausas, tortinha de Laranja recheada com creme e compota artesanal de laranja. Tortinha Floresta Negra com mousse de chocolate e cereja, geléia de frutas vermelhas e cereja marraschino. Tortinha de Caramelo salgado com recheio de caramelo e flor de sal. Todas finalizadas com marshmallow.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":34,\"name\":\"Restaurante Picolino\",\"description\":\"Restaurante de cozinha brasileira no Boulevard Canal, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Legado, nhoque de batata com camarões ao molho à la Mourisco, creme de leite fresco, mostarda e damasco, finalizado com amêndoas laminadas.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":35,\"name\":\"Quasar Sorveteria Artesanal\",\"description\":\"Gelateria no Centro, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Abraço de Vó, torta de Maçã com toque de canela, acompanhado com sorvete de creme e finalizada com caramelo salgado.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":36,\"name\":\"Pão do Edu — Centro\",\"description\":\"Padaria no Centro, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Uai Dog, sanduiche de linguiça mineira artesanal com creme de queijo meia cura, rúcula, pesto de ora-pro-nobis, no pão brioche de bacon, queijo e ervas.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":37,\"name\":\"Nevada Doçaria\",\"description\":\"Confeitaria no Centro, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Bella Sicilia, tortinha individual de brigadeiro de limão siciliano com geléia de amora envolta de nozes pecã triturados.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":38,\"name\":\"Armazém do Portuga\",\"description\":\"Restaurante no Centro, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Bacalhau a Brás, lascas de Bacalhau refogado no azeite, cebola, alho e azeitona, com ovos caipira mexidos, finalizado com batata palha e salsinha.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":39,\"name\":\"Brigaderia da Vovó\",\"description\":\"Doceria no Centro, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Doce lembrança, bolo úmido de chocolate e amêndoas com calda de creme inglês.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":40,\"name\":\"Sabor e Arte Restaurante\",\"description\":\"Restaurante de cozinha brasileira no Centro, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Abraço de Domingo, pappardelle artesanal ao molho cremoso de curry, lascas de sobrecoxa e cubos de manga.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":41,\"name\":\"Constantino Hamburgueria\",\"description\":\"Hamburgueria no Centro, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Quinto Quarto, sanduíche de rabada ao demi-glace, pesto de agrião, nosso brazilian cheese, pão de fermentação selvagem e palha de mandioca.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":42,\"name\":\"Cafeteria Encontros\",\"description\":\"Cafeteria no Centro, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Sanduíche de Pernil da Vó Necy, sanduíche de pão ciabatta com pernil suíno desfiado, queijo muçarela, rúcula fresca, fatias de tomate seco e vinagrete de abacaxi.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":43,\"name\":\"Bom Apetite\",\"description\":\"Restaurante de cozinha brasileira na Praia do Forte, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Peixe Cremoso, peixe do dia (pescada amarela, namorado ou cherne), ao molho branco, gratinado no forno com batatas.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":44,\"name\":\"Nova Onda Hotel\",\"description\":\"Hotel no Centro, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Rolé do Nova Onda, bife rolé de filé mignon ao molho ferrugem, acompanhado de nhoque artesanal com molho da casa, finalizado com bacon crocante e parmesão.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":45,\"name\":\"Restaurante Farol do Forte\",\"description\":\"Restaurante no Centro, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Cinquenta Anos de Praia, arroz cozido no vapor, camarões salteados, molho de camarão com catupiry e muçarela, cebola roxa suavizada, salsa fresca, finalizado com queijo parmesão e cebola crispy.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":46,\"name\":\"Mará Cozinha Memorável\",\"description\":\"Restaurante de frutos do mar na Praia do Forte, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Camarão ao pôr do sol, rigatone com Creme de Abóbora e Catupiry, camarão grelhado com flocos de queijo azul.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":47,\"name\":\"Cookiz & Coffee\",\"description\":\"Cafeteria no Jardim Flamboyant, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Memória Feliz, croissant recheado de Blent suíno, creme de queijo e abacaxi temperado, acompanhado de cookie red velvet, recheado com doce de leite da casa, finalizado com caramelo salgado e pudim de pão.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":48,\"name\":\"Sem Frescura Burger\",\"description\":\"Hamburgueria no Braga, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato De volta para casa, pão brioche com maionese trufada, carne 150g, queijo minas padrão, geléia de goiaba artesanal e batata palha.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":49,\"name\":\"Mesona\",\"description\":\"Restaurante no Braga, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Sabor de Domingo, creme de milho feito na casa, costela bovina envolta em um dry rub super especial e assada lentamente e finalizado com picles de cebola roxa e farofa de brioche.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":50,\"name\":\"Andressa Aguiar Confeitaria\",\"description\":\"Confeitaria no Braga, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Torta de Avelã Crocante, massa sablée de avelã, recheada de brigadeiro intenso de cacau 50%, finalizada com crocante de pailleté feuilletine e creme de avelã.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":51,\"name\":\"Office Café\",\"description\":\"Cafeteria no Braga, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Dorama Ice, stecco de Gelato Fior di Latte, envolto em chocolate meio amargo, coberto com marshmallow maçaricado, decorado com Creme de avelã e creme de pistache, com castanhas crocantes.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":52,\"name\":\"Restaurante Pelicano Oásis\",\"description\":\"Restaurante no Braga, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Memórias Oásis, risoto cremoso de 2 queijos, provolone e parmesão, acompanhado de fraldinha desfiada ao molho da carne, finalizado com tuile de parmesão.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":53,\"name\":\"Zion Bike Café\",\"description\":\"Cafeteria no Braga, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Doce Mala, cheesecake de pé de moleque, com base crocante e recheio de cream cheese com cobertura de doce de leite caseiro.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":54,\"name\":\"Bistrô Milano\",\"description\":\"Bistrô no Braga, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Bão Demais, baguete de pão de queijo recheada com pernil suíno, cebola caramelizada e goiabada levemente picante.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":55,\"name\":\"Mangia Que Cresce Pizzaria\",\"description\":\"Pizzaria no Jardim Caiçara, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Mangia Dog, dogão artesanal com linguiça suína, pão de massa de pizza de longa fermentação, molho de tomate artesanal, creme de burrata, vinagrete de cebola roxa, tomate e jalapeño.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":56,\"name\":\"Ancho e Faca\",\"description\":\"Churrascaria no Jardim Excelsior, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Involtinis di Pollo e Bechamel de Milho, involtinis de sobrecoxa de frango desossada recheados com provolone defumado, presunto, pimentão vermelho assado na brasa, acompanhados de bechamel de milho, cebolinha, alecrim e bastão de milho assado.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":57,\"name\":\"Família Braga Gourmet\",\"description\":\"Pizzaria no Jardim Excelsior, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Pão Rústico do Mar, pão rústico recheado com fondue de 3 queijos e camarão marinado e cheiro verde fresco com crosta maçaricada.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":58,\"name\":\"Família Braga Pizzaria\",\"description\":\"Pizzaria no Jardim Excelsior, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Pizza Mare & Crean, pizza tradicional com molho de tomate da casa, muçarela, salmão, cream cheese, mix de gergelim, cebolinha e teriyaki.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":59,\"name\":\"Hey Crepe\",\"description\":\"Doceria no Palmeiras, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Crepe da Vó Fausta, crepe de massa fina recheada com costela bovina desfiada, catupiry, abacaxi in natura e molho barbecue.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":60,\"name\":\"Boteco Seu Osmar\",\"description\":\"Bar no Palmeiras, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato A fraldinha que cheira a infância, fraldinha defumada desfiada, com aligot de aipim finalizado com molho agridoce.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":61,\"name\":\"Japa do Seu Osmar\",\"description\":\"Bar no Palmeiras, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Hot do Seu Osmar, hot roll empanado recheado com salmão e cream cheese, envolto em arroz e alga nori, com casquinha crocante e molho especial no push pop.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":62,\"name\":\"Limoeiro Bar e Quitutes\",\"description\":\"Bar no Palmeiras, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Abraço de Domingo, croquete de carne de panela e especiarias, acompanhado de molho da casa.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":63,\"name\":\"Faella Bistrô\",\"description\":\"Restaurante no Palmeiras, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Sabores da Memória, talharim ao creme de alho-poró e limão siciliano, lascas de salmão finalizado com camarões em crosta de pistache.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":64,\"name\":\"Tucas Empório Bistrô\",\"description\":\"Restaurante no Palmeiras, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Vulcão Sertanejo, bolinho de risoto de pernil com parmesao, recheado com pernil cozido lentamente na cerveja e catupiry! Empanado na panco na cama de parmesão e geleia de rapadura picante.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":65,\"name\":\"Pizza 55\",\"description\":\"Pizzaria no Parque Burle, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato A Lenda Marins, pizza com massa de beterraba de longa fermentação, molho da casa, muçarela, ricota, queijo parmesão, cream cheese e bacon de pernil, finalizada com creme de goiaba e orégano.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":66,\"name\":\"Nina Pasta e Basta\",\"description\":\"Restaurante italiano no Portinho, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Rigatone All’Amatriciana, massa seca italiana, rigatone, molho de tomate da casa, cebola roxa, pimenta calabresa a gosto e guanciale. Finalizado com parmesão ralado.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":67,\"name\":\"Garota Beer\",\"description\":\"Pub no Palmeiras, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Boeuf Bourguignon, carne bovina cozida por 4 horas no vinho, bacon, cenoura e cogumelos, acompanha polenta cremosa e cebola crispy.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":68,\"name\":\"Paelo Hamburgueria\",\"description\":\"Hamburgueria no Portinho, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Velho Smoke, cheeseburguer defumado com aioli de picles e cebola roxa, servido de demi glace de carne, acompanhado de batata crisscut.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":69,\"name\":\"Showrrasquinho Gourmet\",\"description\":\"Restaurante no Portinho, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Brasa e Raízes, cupim casquerado, 8 horas de fogo, com aipim artesanal coberto com parmesão maçaricado, acompanhado de molho à campanha, farofa de cebola e molho chimichurri da casa.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":70,\"name\":\"Gunther Hamburgueria\",\"description\":\"Hamburgueria no Parque Burle, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Fritz, pão pretzel artesanal, burguer 180g, chucrute, carne suína desfiada, purê rústico de batata, molho à base de ketchup, curry e especiarias.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":71,\"name\":\"Bazar Bakery\",\"description\":\"Padaria no Portinho, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Encontro da Tarde, pão de milho artesanal, molho especial de camarão, alho poró, cream cheese, alfafa e rúcula, burrata de búfala, queijo parmesão, molho pesto, presunto royale, finalizado com azeite.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"},{\"position\":72,\"name\":\"Âncora Restaurante\",\"description\":\"Restaurante no Peró, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Raízes da Memória, picanha grelhada com mousseline de baroa, farofa crocante de panko e bacon na manteiga, finalizada com pesto de manjericão.\",\"audios\":[],\"hasContent\":true,\"alsoPositions\":[],\"defaultLang\":\"pt-br\"}]}]\n13:[\"$\",\"$L1e\",null,{\"items\":[{\"question\":\"Quanto tempo dura este roteiro?\",\"answer\":\"Cerca de 1h 55min de áudio em 72 paradas, cobrindo aproximadamente 55,4 km. No seu ritmo — o áudio toca automaticamente enquanto você se desloca.\"},{\"question\":\"Em quais idiomas está disponível?\",\"answer\":\"Este roteiro está disponível em: Português.\"},{\"question\":\"Preciso de conexão com a internet?\",\"answer\":\"Não. Baixe o roteiro no app Tuggi e ouça offline — o áudio é ativado pela sua localização, sem precisar usar as mãos.\"},{\"question\":\"Dá para fazer a pé ou de carro?\",\"answer\":\"Esta rota foi pensada para um trajeto Fácil. O áudio se adapta ao seu ritmo.\"}]}]\n20:T51f,M55.4 41.7L54.8 41.5L51.2 44.4L51.1 47.4L49.4 46.8L49.4 45.9L47.5 46.1L47 44.9L44 43.8L39.5 47.2L36.7 46.8L35.5 47.6L36 46.9L35.4 47.6L34.1 47L34 45.8L33.2 45.9L32.7 43L33.4 43.6L32.6 43.1L33.2 45.9L34 45.8L34.1 47L36.9 48.6L37.8 49.9L38.7 53L37.8 53.6L38.6 53.6L39.5 55.5L40.7 54.9L41.3 55.4L40.7 54.9L39.5 55.5L38.6 53.6L37.8 53.7L38.7 53L37.8 49.9L36.9 48.6L35.6 48.3L35.6 47.6L28.4 51.4L25 51.9L25.3 53.2L24.2 54.9L20.9 56.8L20.4 57L19.5 55.4L18 54.8L19.5 55.4L20.4 57L20.9 56.8L24.2 54.9L25.3 53.2L25 51.9L28.4 51.4L35.6 47.7L34.1 47L34 45.8L33.1 45.6L32 41.5L32.3 38.9L31.3 36.5L27.3 35.1L28.2 33.1L26.6 31.9L26.8 30.9L25.9 29.7L27.3 28.4L27.4 30.3L27.3 27.6L28.7 27.9L29.7 26.6L31.4 27.4L33.6 29.6L37.4 29.8L41.6 28.3L42.7 29.4L44.4 29.2L45.8 27.5L46.7 27.5L46.2 27L47.9 23.8L49.7 23.2L50.1 21.7L51.5 21.1L52.3 19L53.4 19.5L53.7 18.8L55.8 18.3L60 18.4L62.5 14.9L61.4 14.3L61.6 13.8L62.6 14.8L63.2 13.4L64.9 13L66.8 13.4L66.9 14.1L65.9 14.5L66.9 14.1L66.8 13.5L64.9 13.2L64.2 11.7L65.9 7.8L67 6.9L66 5L67 6.9L65.9 7.8L63.4 13.1L66.8 13.4L67.2 14.9L68.5 14.7L69 15.6L70.2 15.8L71.9 18.1L75.8 16.8L78.2 16.8L78.9 17.3L77.7 18.7L78 19.3L80.3 21.1L81.3 20.6L82 21.4L72.4 30.2L69.4 31.6L69 32.1L70 31.9L70.3 33.6L69.5 34.7L70.3 33.6L69.6 32.6L68.6 33.5L67.8 33.4L66.7 37.3L67.5 38.2L67.3 39.6L66 40.9L67.3 41.421:T5f1,M54.3 36.8L53 37L53.3 36.2L54.1 36.3L52.3 35.7L51.7 33.5L50.