itude\":-41.98595}}}]}},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.tuggi.app/pt/tours/brazil/rota-do-festival-sabores-de-cabo-frio-2026#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"TUGGI\",\"item\":\"https://www.tuggi.app\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Roteiros de Áudio\",\"item\":\"https://www.tuggi.app/pt/tours\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Brasil\",\"item\":\"https://www.tuggi.app/pt/tours/brazil\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Rota do Festival Sabores de Cabo Frio 2026\",\"item\":\"https://www.tuggi.app/pt/tours/brazil/rota-do-festival-sabores-de-cabo-frio-2026\"}]},{\"@type\":\"FAQPage\",\"@id\":\"https://www.tuggi.app/pt/tours/brazil/rota-do-festival-sabores-de-cabo-frio-2026#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Quanto tempo dura este roteiro?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Cerca de 1h 55min de áudio em 72 paradas, cobrindo aproximadamente 55,4 km. No seu ritmo — o áudio toca automaticamente enquanto você se desloca.\"}},{\"@type\":\"Question\",\"name\":\"Em quais idiomas está disponível?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Este roteiro está disponível em: Português.\"}},{\"@type\":\"Question\",\"name\":\"Preciso de conexão com a internet?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Não. Baixe o roteiro no app Tuggi e ouça offline — o áudio é ativado pela sua localização, sem precisar usar as mãos.\"}},{\"@type\":\"Question\",\"name\":\"Dá para fazer a pé ou de carro?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Esta rota foi pensada para um trajeto Fácil. O áudio se adapta ao seu ritmo.\"}}]}]}</script><nav aria-label=\"Trilha de navegação\" class=\"bg-white border-b border-gray-100\"><div class=\"page-shell py-3 text-sm text-tuggi-slate flex flex-wrap gap-2\"><a class=\"hover:text-tuggi-primary-text\" href=\"/pt/tours\">Roteiros de Áudio</a><span aria-hidden=\"true\">›</span><a class=\"hover:text-tuggi-primary-text\" href=\"/pt/tours/brazil\">Brasil</a><span aria-hidden=\"true\">›</span><span class=\"text-tuggi-dark font-semibold line-clamp-1\">Rota do Festival Sabores de Cabo Frio 2026</span></div></nav><section id=\"route-hero\" class=\"relative pt-8 lg:pt-28 pb-12 bg-white overflow-hidden\"><div class=\"absolute top-0 left-1/2 -translate-x-1/2 w-full h-full pointer-events-none opacity-5\"><div class=\"absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-tuggi-primary blur-[120px]\"></div></div><div class=\"page-shell relative z-10\"><span class=\"inline-block px-4 py-1.5 mb-5 text-sm font-bold tracking-wider text-tuggi-primary-text uppercase bg-tuggi-primary/5 rounded-full\">Roteiro de Áudio Autoguiado</span><h1 class=\"text-4xl md:text-6xl font-black text-tuggi-dark mb-4 leading-tight\">Rota do Festival Sabores de Cabo Frio 2026</h1><p class=\"text-lg text-tuggi-slate\">Roteiro de áudio autoguiado · Cabo Frio</p><div class=\"mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] xl:grid-cols-[minmax(0,1fr)_minmax(0,32rem)] lg:gap-12 lg:items-start\"><div class=\"order-1 lg:order-2\"><div class=\"max-w-lg lg:max-w-none rounded-3xl border border-gray-100 bg-tuggi-bg p-6 shadow-sm\"><dl class=\"grid grid-cols-3 gap-4\"><div class=\"flex flex-col-reverse\"><dt class=\"mt-1 text-[11px] font-bold uppercase tracking-wider text-tuggi-slate\">Duração</dt><dd class=\"text-xl font-black text-tuggi-dark leading-none\">1h 55min</dd></div><div class=\"flex flex-col-reverse\"><dt class=\"mt-1 text-[11px] font-bold uppercase tracking-wider text-tuggi-slate\">Distância</dt><dd class=\"text-xl font-black text-tuggi-dark leading-none\">55,4 km</dd></div><div class=\"flex flex-col-reverse\"><dt class=\"mt-1 text-[11px] font-bold uppercase tracking-wider text-tuggi-slate\">Paradas</dt><dd class=\"text-xl font-black text-tuggi-dark leading-none\">72</dd></div></dl><dl class=\"mt-5 border-t border-gray-200/70\"><div class=\"flex items-baseline justify-between gap-4 border-b border-gray-200/70 py-2.5 last:border-b-0\"><dt class=\"inline-flex items-center gap-2 shrink-0 text-sm text-tuggi-slate\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-car w-4 h-4 text-tuggi-slate/70 shrink-0\" aria-hidden=\"true\"><path d=\"M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2\"></path><circle cx=\"7\" cy=\"17\" r=\"2\"></circle><path d=\"M9 17h6\"></path><circle cx=\"17\" cy=\"17\" r=\"2\"></circle></svg>Dificuldade</dt><dd class=\"text-sm font-semibold text-tuggi-dark text-right\">Fácil</dd></div><div class=\"flex items-baseline justify-between gap-4 border-b border-gray-200/70 py-2.5 last:border-b-0\"><dt class=\"inline-flex items-center gap-2 shrink-0 text-sm text-tuggi-slate\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sun w-4 h-4 text-tuggi-slate/70 shrink-0\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2\"></path><path d=\"M12 20v2\"></path><path d=\"m4.93 4.93 1.41 1.41\"></path><path d=\"m17.66 17.66 1.41 1.41\"></path><path d=\"M2 12h2\"></path><path d=\"M20 12h2\"></path><path d=\"m6.34 17.66-1.41 1.41\"></path><path d=\"m19.07 4.93-1.41 1.41\"></path></svg>Melhor horário</dt><dd class=\"text-sm font-semibold text-tuggi-dark text-right\">Tarde · Noite</dd></div><div class=\"flex items-baseline justify-between gap-4 border-b border-gray-200/70 py-2.5 last:border-b-0\"><dt class=\"inline-flex items-center gap-2 shrink-0 text-sm text-tuggi-slate\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe w-4 h-4 text-tuggi-slate/70 shrink-0\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg>Idiomas</dt><dd class=\"text-sm font-semibold text-tuggi-dark text-right\">Português</dd></div></dl><div class=\"mt-6 flex flex-col gap-3\"><a href=\"/d/tuggi\" class=\"inline-flex items-center justify-center gap-2 px-6 py-4 bg-tuggi-primary text-tuggi-dark font-black rounded-2xl shadow-lg shadow-tuggi-primary/20 hover:shadow-xl hover:-translate-y-0.5 transition-all\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-headphones w-5 h-5\" aria-hidden=\"true\"><path d=\"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3\"></path></svg>Ouvir no app Tuggi</a><a href=\"#route-map\" class=\"inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-white text-tuggi-dark font-bold rounded-2xl border border-gray-200 hover:bg-gray-50 transition-all\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-5 h-5 text-tuggi-primary\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Ver o mapa</a></div></div></div><p class=\"order-2 lg:order-1 text-lg text-tuggi-slate leading-relaxed whitespace-pre-line\">Roteiro que liga os 72 endereços participantes da 12ª edição do Festival Sabores de Cabo Frio, de 4 de setembro a 4 de outubro de 2026. A ordem sai da Passagem, passa por Ogiva, São Bento e Centro, sobe para o Braga, atravessa Palmeiras e Portinho e termina no Peró. Cada parada serve um prato exclusivo criado para o tema Receitas de Família, com preço definido pela própria casa.</p></div></div></section><section id=\"route-map\" class=\"py-16 bg-white\" aria-labelledby=\"itinerary-heading\"><div class=\"page-shell\"><h2 id=\"itinerary-heading\" class=\"text-3xl md:text-4xl font-black text-tuggi-dark mb-3\">O que você vai ver e ouvir</h2><p class=\"text-tuggi-slate\">As paradas deste roteiro, em ordem — com prévias de áudio quando disponíveis.</p><div class=\"mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] xl:grid-cols-[minmax(0,1fr)_minmax(0,32rem)] lg:gap-12 lg:items-start\"><div class=\"lg:order-2 lg:sticky lg:top-24\"><div class=\"rounded-3xl overflow-hidden border border-gray-100 shadow-sm h-[340px] sm:h-[420px] lg:h-[min(30rem,calc(100vh-16rem))]\"><div style=\"width:100%;height:100%;min-height:320px\" role=\"application\" aria-label=\"Mapa interativo do roteiro\"></div></div><ul class=\"mt-3 flex flex-wrap gap-x-5 gap-y-2 text-xs text-tuggi-slate\"><li class=\"inline-flex items-center gap-2\"><span class=\"w-3 h-3 rounded-full bg-tuggi-primary shadow-sm\"></span>Com áudio e história</li></ul><a href=\"/d/tuggi\" class=\"hidden md:inline-flex items-center gap-2 mt-6 px-6 py-3.5 bg-tuggi-primary text-tuggi-dark font-black rounded-2xl shadow-lg shadow-tuggi-primary/20 hover:shadow-xl hover:-translate-y-0.5 transition-all\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-headphones w-5 h-5\" aria-hidden=\"true\"><path d=\"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3\"></path></svg>Ouvir no app Tuggi</a></div><div class=\"lg:order-1\"><ol class=\"relative border-l-2 border-tuggi-primary/20 ml-3\"><li id=\"stop-1\" data-position=\"1\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">1</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-primary shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Nonna Tiva Bistrô</h3><p class=\"mt-2 text-tuggi-slate leading-relaxed\">Restaurante na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Arantella, risoto de costela em formato de bolinho crocante, servido com aioli defumado de páprica e pesto de agrião.</p></div></li><li id=\"stop-2\" data-position=\"2\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">2</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-primary shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Pão do Edu — Passagem</h3><p class=\"mt-2 text-tuggi-slate leading-relaxed\">Padaria na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Uai Dog, sanduiche de linguiça mineira artesanal com creme de queijo meia cura, rúcula, pesto de ora-pro-nobis, no pão brioche de bacon, queijo e ervas.</p></div></li><li id=\"stop-3\" data-position=\"3\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">3</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-primary shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Felicitá Gelato Artesanal</h3><p class=\"mt-2 text-tuggi-slate leading-relaxed\">Doceria na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Cookie Cremoso Biscoff, cookie cremoso recheado com creme de biscoff, finalizado com gelato de flor de latte e farofa de biscoff.</p></div></li><li id=\"stop-4\" data-position=\"4\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">4</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-primary shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Ateliê Cafeteria e Confeitaria</h3><p class=\"mt-2 text-tuggi-slate leading-relaxed\">Cafeteria na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Delicatto, mousse de chocolate belga meio amargo com avelãs in natura, brownie, cápsula de chocolate recheado com creme de vanilla french, acompanhado de calda meia amarga e avelãs tostados.</p></div></li><li id=\"stop-5\" data-position=\"5\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">5</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-primary shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Escritório do Chef</h3><p class=\"mt-2 text-tuggi-slate leading-relaxed\">Restaurante na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Panelas da Memória, nacos de filé mignon de panela, envolvidas em molho com toque de vinho, lascas de aipim frito na manteiga de ervas e mini cebolas glaceadas.</p></div></li><li id=\"stop-6\" data-position=\"6\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">6</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-primary shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Restaurante O Pescador</h3><p class=\"mt-2 text-tuggi-slate leading-relaxed\">Restaurante na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Memórias do Cais, lascas de peixe branco grelhadas em azeite de ervas, com purê de batata-baroa, toque de queijo coalho e farofa de camarão.</p></div></li><li id=\"stop-7\" data-position=\"7\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">7</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-primary shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>José Bakery</h3><p class=\"mt-2 text-tuggi-slate leading-relaxed\">Cafeteria na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Pavê da Dona Leda, massa sablée, creme diplomata, brigadeiro, biscoito champagne e glaçagem chocolate branco.</p></div></li><li id=\"stop-8\" data-position=\"8\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">8</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-primary shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Borogodó Nordestino</h3><p class=\"mt-2 text-tuggi-slate leading-relaxed\">Restaurante na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato As Nordestinas, cocada cremosa quente com sorvete de tapioca ou paçoca, finalizado com castanha granulada e melaço de cana.</p></div></li><li id=\"stop-9\" data-position=\"9\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">9</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-primary shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Quintal Restaurante</h3><p class=\"mt-2 text-tuggi-slate leading-relaxed\">Restaurante na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Bifanas Portuguesas, finas fatias de pernil de porco marinadas em vinho branco, alho e especiarias, cozidas lentamente até ficarem extremamente macias. Servidas no pão crocante, envolvidas no seu molho típico e finalizadas com queijo prato derretido.</p></div></li><li id=\"stop-10\" data-position=\"10\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">10</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-primary shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>The Duck Rock Pub</h3><p class=\"mt-2 text-tuggi-slate leading-relaxed\">Pub na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Raizes do Mar, bobo de camarão com arroz de castanhas e farofa de coco.</p></div></li><li id=\"stop-11\" data-position=\"11\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">11</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-primary shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>San Lorenzo Gelateria</h3><p class=\"mt-2 text-tuggi-slate leading-relaxed\">Gelateria na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Sabor de Infância, bolo de chocolate com calda de brigadeiro quente e sorbet de morango, finalizado com granulado ao leite e disco de biscoito de vanilla artesanal.</p></div></li><li id=\"stop-12\" data-position=\"12\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">12</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-primary shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Arcos do Canal</h3><p class=\"mt-2 text-tuggi-slate leading-relaxed\">Restaurante mediterrâneo na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Costela de herança, costela prensada ao molho de agrião com nhoques de aipim.</p></div></li><li id=\"stop-13\" data-position=\"13\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">13</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-primary shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Pizza da Mari</h3><p class=\"mt-2 text-tuggi-slate leading-relaxed\">Pizzaria na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Sicilia al Mare, pizza de longa fermentação com molho branco de limão siciliano, mussarela de búfala, camarão salteado e coentro.</p></div></li><li id=\"stop-14\" data-position=\"14\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">14</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-primary shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Giulietta Gelato</h3><p class=\"mt-2 text-tuggi-slate leading-relaxed\">Gelateria na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Doce Abraço da Giulietta, tarte de Baunilha com praliné artesanal. Massa sablée amanteigada, creme de baunilha, praliné artesanal de castanha de caju, amêndoas e amendoim, servida com gelato de bala de manteiga e toffee.</p></div></li><li id=\"stop-15\" data-position=\"15\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">15</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-primary shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Baires Bistrô</h3><p class=\"mt-2 text-tuggi-slate leading-relaxed\">Bistrô na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Pérolas da Vovó, nhoque de rúcula recheado com gorgonzola. Molho de tomate fresco e manjericão.</p></div></li><li id=\"stop-16\" data-position=\"16\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">16</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-primary shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Fornalha Nobre Pizzeria</h3><p class=\"mt-2 text-tuggi-slate leading-relaxed\">Pizzaria na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Minas Gerais, massa de fermentação longa, com muçarela, frango assado defumado e requeijão de corte, finalizado com azeite, orégano siciliano e broto.</p></div></li><li id=\"stop-17\" data-position=\"17\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">17</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-primary shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Paelo &amp; Parrilla</h3><p class=\"mt-2 text-tuggi-slate leading-relaxed\">Restaurante na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Dona Chica, feijão Tropeiro preparado na brasa com farinha de milho e crocante de panko com banana, linguiça mineira artesanal e panceta, finalizado com couve selada na parrilla, acompanhado de costelinha suína defumada lentamente e glaceada com rapadura, cachaça e limão.</p></div></li><li id=\"stop-18\" data-position=\"18\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">18</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-primary shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Armazém da Passagem</h3><p class=\"mt-2 text-tuggi-slate leading-relaxed\">Restaurante na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Açorda da Vó, açorda de camarões salteados no pão artesanal umedecido em um caldo intenso de camarão, coroado com ovo pochê.</p></div></li><li id=\"stop-19\" data-position=\"19\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">19</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-primary shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Bamba</h3><p class=\"mt-2 text-tuggi-slate leading-relaxed\">Bar na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Rolê da Vó Dina, pão rústico com rolé bovino, rúcula, queijo canastra e molho pomodoro.</p></div></li><li id=\"stop-20\" data-position=\"20\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">20</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-primary shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>José Restaurante</h3><p class=\"mt-2 text-tuggi-slate leading-relaxed\">Restaurante mediterrâneo na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Brasas de Família, coxa e sobrecoxa cozido lentamente no sous vide e finalizadas na brasa, batata assada e redução de laranja.</p></div></li><li id=\"stop-21\" data-position=\"21\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">21</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-primary shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Casa Kanaloa</h3><p class=\"mt-2 text-tuggi-slate leading-relaxed\">Restaurante tailandês na Passagem, em Cabo Frio. Leva ao Festival Sabores de Cabo Frio 2026 o prato Arroz Thai, arroz Thai frito ao mar e terra com vegetais e curry.</p></div></li><li id=\"stop-22\" data-position=\"22\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">22</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\">