tuggi.app/pt/tours\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Brasil\",\"item\":\"https://www.tuggi.app/pt/tours/brazil\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Rota do Festival Sabores de Cabo Frio 2026\",\"item\":\"https://www.tuggi.app/pt/tours/brazil/rota-do-festival-sabores-de-cabo-frio-2026\"}]},{\"@type\":\"FAQPage\",\"@id\":\"https://www.tuggi.app/pt/tours/brazil/rota-do-festival-sabores-de-cabo-frio-2026#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Quanto tempo dura este roteiro?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Cerca de 1h 55min de áudio em 72 paradas, cobrindo aproximadamente 55,4 km. No seu ritmo — o áudio toca automaticamente enquanto você se desloca.\"}},{\"@type\":\"Question\",\"name\":\"Em quais idiomas está disponível?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Este roteiro está disponível em: Português.\"}},{\"@type\":\"Question\",\"name\":\"Preciso de conexão com a internet?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Não. Baixe o roteiro no app Tuggi e ouça offline — o áudio é ativado pela sua localização, sem precisar usar as mãos.\"}},{\"@type\":\"Question\",\"name\":\"Dá para fazer a pé ou de carro?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Esta rota foi pensada para um trajeto Fácil. O áudio se adapta ao seu ritmo.\"}}]}]}0:{\"buildId\":\"sgcYRXgj6Q_bI4KL2gAqo\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"article\",null,{\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2\"}}],\"$L3\",\"$L4\",\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\"]}],[\"$La\",\"$Lb\"],\"$Lc\"]}],\"loading\":null,\"isPartial\":false}\n3:[\"$\",\"nav\",null,{\"aria-label\":\"Trilha de navegação\",\"className\":\"bg-white border-b border-gray-100\",\"children\":[\"$\",\"div\",null,{\"className\":\"page-shell py-3 text-sm text-tuggi-slate flex flex-wrap gap-2\",\"children\":[[\"$\",\"$Ld\",null,{\"href\":\"/pt/tours\",\"c