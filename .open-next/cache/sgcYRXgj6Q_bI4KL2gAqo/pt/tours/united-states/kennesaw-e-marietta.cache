 e no seu idioma.\\\",\\\"url\\\":\\\"https://www.tuggi.app\\\",\\\"downloadUrl\\\":[\\\"https://apps.apple.com/app/tuggi-drive/id6744379818\\\",\\\"https://play.google.com/store/apps/details?id=com.tuggidrive.app\\\"],\\\"installUrl\\\":\\\"https://apps.apple.com/app/tuggi-drive/id6744379818\\\",\\\"sameAs\\\":[\\\"https://apps.apple.com/app/tuggi-drive/id6744379818\\\",\\\"https://play.google.com/store/apps/details?id=com.tuggidrive.app\\\"],\\\"screenshot\\\":\\\"https://www.tuggi.app/images/og-image-tuggi.jpg\\\",\\\"featureList\\\":[\\\"Self-guided audio stories that trigger automatically by GPS location\\\",\\\"Screen-off playback while you drive, walk, or cycle\\\",\\\"Works offline — download routes in advance, no roaming\\\",\\\"Audio in 10 languages with synchronized closed captions\\\",\\\"Free to start; optional Tuggi Passes of 10, 25 or 45 hours of use that do not expire\\\"],\\\"offers\\\":{\\\"@type\\\":\\\"Offer\\\",\\\"price\\\":\\\"0.00\\\",\\\"priceCurrency\\\":\\\"USD\\\"},\\\"publisher\\\":{\\\"@id\\\":\\\"https://www.tuggi.app/#organization\\\"}}\"])</script><script>self.__next_f.push([1,\"27:[[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"{\\\\\\\"@context\\\\\\\":\\\\\\\"https://schema.org\\\\\\\",\\\\\\\"@type\\\\\\\":\\\\\\\"Organization\\\\\\\",\\\\\\\"@id\\\\\\\":\\\\\\\"https://www.tuggi.app/#organization\\\\\\\",\\\\\\\"name\\\\\\\":\\\\\\\"TUGGI\\\\\\\",\\\\\\\"url\\\\\\\":\\\\\\\"https://www.tuggi.app\\\\\\\",\\\\\\\"logo\\\\\\\":\\\\\\\"https://www.tuggi.app/images/logo_tuggi_full.png\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"O TUGGI conta a história de um lugar em voz alta assim que você chega perto. Funciona offline, em 10 idiomas, grátis para começar no iOS e no Android.\\\\\\\",\\\\\\\"contactPoint\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"ContactPoint\\\\\\\",\\\\\\\"contactType\\\\\\\":\\\\\\\"customer support\\\\\\\",\\\\\\\"email\\\\\\\":\\\\\\\"supo