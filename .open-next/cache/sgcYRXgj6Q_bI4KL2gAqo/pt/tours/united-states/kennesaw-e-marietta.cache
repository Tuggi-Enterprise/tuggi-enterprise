name\":\"Dá para fazer a pé ou de carro?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Esta rota foi pensada para um trajeto Fácil. O áudio se adapta ao seu ritmo.\"}}]}]}</script><nav aria-label=\"Trilha de navegação\" class=\"bg-white border-b border-gray-100\"><div class=\"page-shell py-3 text-sm text-tuggi-slate flex flex-wrap gap-2\"><a class=\"hover:text-tuggi-primary-text\" href=\"/pt/tours\">Roteiros de Áudio</a><span aria-hidden=\"true\">›</span><a class=\"hover:text-tuggi-primary-text\" href=\"/pt/tours/united-states\">Estados Unidos</a><span aria-hidden=\"true\">›</span><span class=\"text-tuggi-dark font-semibold line-clamp-1\">Kennesaw e Marietta</span></div></nav><section id=\"route-hero\" class=\"relative pt-8 lg:pt-28 pb-12 bg-white overflow-hidden\"><div class=\"absolute top-0 left-1/2 -translate-x-1/2 w-full h-full pointer-events-none opacity-5\"><div class=\"absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-tuggi-primary blur-[120px]\"></div></div><div class=\"page-shell relative z-10\"><span class=\"inline-block px-4 py-1.5 mb-5 text-sm font-bold tracking-wider text-tuggi-primary-text uppercase bg-tuggi-primary/5 rounded-full\">Roteiro de Áudio Autoguiado</span><h1 class=\"text-4xl md:text-6xl font-black text-tuggi-dark mb-4 leading-tight\">Kennesaw e Marietta</h1><p class=\"text-lg text-tuggi-slate\">Roteiro de áudio autoguiado · North Georgia</p><div class=\"mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] xl:grid-cols-[minmax(0,1fr)_minmax(0,32rem)] lg:gap-12 lg:items-start\"><div class=\"order-1 lg:order-2\"><div class=\"max-w-lg lg:max-w-none rounded-3xl border border-gray-100 bg-tuggi-bg p-6 shadow-sm\"><dl class=\"grid grid-cols-3 gap-4\"><div class=\"flex flex-col-reverse\"><dt class=\"mt-1 text-[11px] font-bold uppercase tracking-wider text-tuggi-slate\">Duração</dt><dd class=\"text-xl font-black text-tuggi-dark leading-none\">1h 40min</dd></div><div class=\"flex flex-col-reverse\"><dt class=\"mt-1 text-[