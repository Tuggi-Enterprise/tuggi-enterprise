norte#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"¿Cuánto dura este recorrido?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Unos 31 min de audio en 12 paradas, cubriendo aproximadamente 13 km. A tu propio ritmo — el audio se reproduce automáticamente mientras avanzas.\"}},{\"@type\":\"Question\",\"name\":\"¿Es accesible este recorrido?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Esta ruta está clasificada como: Accesible. Consulta cada parada para más detalles de acceso.\"}},{\"@type\":\"Question\",\"name\":\"¿En qué idiomas está disponible?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Este recorrido está disponible en: English, Español, Português, Italiano.\"}},{\"@type\":\"Question\",\"name\":\"¿Necesito conexión a internet?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Descarga el recorrido en la app Tuggi y escúchalo sin conexión — el audio se activa según tu ubicación, sin usar las manos.\"}}]}]}6:[\"$\",\"article\",null,{\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$f\"}}],\"$L10\",\"$L11\",\"$L12\",\"$L13\",\"$L14\",\"$L15\",\"$L16\"]}]\n5:[\"$\",\"html\",null,{\"lang\":\"es\",\"className\":\"inter_fa93af41-module__0D_jrq__className\",\"children\":[\"$\",\"body\",null,{\"className\":\"bg-white text-[#0B1220] antialiased\",\"children\":[[\"$\",\"a\",null,{\"href\":\"#main-content\",\"className\":\"sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-6 focus:py-3 focus:bg-tuggi-primary focus:text-tuggi-dark focus:font-bold focus:rounded-xl focus:shadow-2xl focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2\",\"children\":\"Ir al contenido principal\"}],\"$L17\",[\"$\",\"$L18\",null,{\"gaId\":\"G-LFFNJDG7TJ\"}],[\"$\",\"$L19\",null,{\"appId\":\"69a093d7a5444f000d2d36d6\"}],[\"$\",\"$L1a\",null,{\"id\":\"vmjex394bg\"}]]}]}]\n1b:I[522016,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/