\"containedInPlace\":{\"@type\":\"Place\",\"name\":\"New York\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":40.7974,\"longitude\":-73.9524}}}]}},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.tuggi.app/es/tours/united-states/central-park-do-sul-ao-norte#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"TUGGI\",\"item\":\"https://www.tuggi.app\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Audioguías\",\"item\":\"https://www.tuggi.app/es/tours\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Estados Unidos\",\"item\":\"https://www.tuggi.app/es/tours/united-states\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Parque Central, de Sur a Norte\",\"item\":\"https://www.tuggi.app/es/tours/united-states/central-park-do-sul-ao-norte\"}]},{\"@type\":\"FAQPage\",\"@id\":\"https://www.tuggi.app/es/tours/united-states/central-park-do-sul-ao-norte#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"¿Cuánto dura este recorrido?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Unos 31 min de audio en 12 paradas, cubriendo aproximadamente 13 km. A tu propio ritmo — el audio se reproduce automáticamente mientras avanzas.\"}},{\"@type\":\"Question\",\"name\":\"¿Es accesible este recorrido?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Esta ruta está clasificada como: Accesible. Consulta cada parada para más detalles de acceso.\"}},{\"@type\":\"Question\",\"name\":\"¿En qué idiomas está disponible?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Este recorrido está disponible en: English, Español, Português, Italiano.\"}},{\"@type\":\"Question\",\"name\":\"¿Necesito conexión a internet?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Descarga el recorrido en la app Tuggi y escúchalo sin conexión — el audio se activa según tu ubicación, sin usar las manos.\"}}]}]}</script><nav aria-label=\"Ruta de navegación\" class=\"bg-white border-b border-gray-100\"><div class=\"page-shell py-3 text-sm text-tuggi-slate flex flex-wrap gap-2\"><a class=\"hover:text-tuggi-primary-text\" href=\"/es/tours\">Audioguías</a><span aria-hidden=\"true\">›</span><a class=\"hover:text-tuggi-primary-text\" href=\"/es/tours/united-states\">Estados Unidos</a><span aria-hidden=\"true\">›</span><span class=\"text-tuggi-dark font-semibold line-clamp-1\">Parque Central, de Sur a Norte</span></div></nav><section id=\"route-hero\" class=\"relative pt-8 lg:pt-28 pb-12 bg-white overflow-hidden\"><div class=\"absolute top-0 left-1/2 -translate-x-1/2 w-full h-full pointer-events-none opacity-5\"><div class=\"absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-tuggi-primary blur-[120px]\"></div></div><div class=\"page-shell relative z-10\"><span class=\"inline-block px-4 py-1.5 mb-5 text-sm font-bold tracking-wider text-tuggi-primary-text uppercase bg-tuggi-primary/5 rounded-full\">Audioguía Autoguiada</span><h1 class=\"text-4xl md:text-6xl font-black text-tuggi-dark mb-4 leading-tight\">Parque Central, de Sur a Norte</h1><p class=\"text-lg text-tuggi-slate\">Audioguía autoguiada · New York</p><div class=\"mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] xl:grid-cols-[minmax(0,1fr)_minmax(0,32rem)] lg:gap-12 lg:items-start\"><div class=\"order-1 lg:order-2\"><div class=\"max-w-lg lg:max-w-none rounded-3xl border border-gray-100 bg-tuggi-bg p-6 shadow-sm\"><dl class=\"grid grid-cols-3 gap-4\"><div class=\"flex flex-col-reverse\"><dt class=\"mt-1 text-[11px] font-bold uppercase tracking-wider text-tuggi-slate\">Duración</dt><dd class=\"text-xl font-black text-tuggi-dark leading-none\">31 min</dd></div><div class=\"flex flex-col-reverse\"><dt class=\"mt-1 text-[11px] font-bold uppercase tracking-wider text-tuggi-slate\">Distancia</dt><dd class=\"text-xl font-black text-tuggi-dark leading-none\">13 km</dd></div><div class=\"flex flex-col-reverse\"><dt class=\"mt-1 text-[11px] font-bold uppercase tracking-wider text-tuggi-slate\">Paradas</dt><dd class=\"text-xl font-black text-tuggi-dark leading-none\">12</dd></div></dl><dl class=\"mt-5 border-t border-gray-200/70\"><div class=\"flex items-baseline justify-between gap-4 border-b border-gray-200/70 py-2.5 last:border-b-0\"><dt class=\"inline-flex items-center gap-2 shrink-0 text-sm text-tuggi-slate\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-accessibility w-4 h-4 text-tuggi-slate/70 shrink-0\" aria-hidden=\"true\"><circle cx=\"16\" cy=\"4\" r=\"1\"></circle><path d=\"m18 19 1-7-6 1\"></path><path d=\"m5 8 3-3 5.5 3-2.36 3.5\"></path><path d=\"M4.24 14.5a5 5 0 0 0 6.88 6\"></path><path d=\"M13.76 17.5a5 5 0 0 0-6.88-6\"></path></svg>Accesibilidad</dt><dd class=\"text-sm font-semibold text-tuggi-dark text-right\">Accesible</dd></div><div class=\"flex items-baseline justify-between gap-4 border-b border-gray-200/70 py-2.5 last:border-b-0\"><dt class=\"inline-flex items-center gap-2 shrink-0 text-sm text-tuggi-slate\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sun w-4 h-4 text-tuggi-slate/70 shrink-0\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><path d=\"M12 2v2\"></path><path d=\"M12 20v2\"></path><path d=\"m4.93 4.93 1.41 1.41\"></path><path d=\"m17.66 17.66 1.41 1.41\"></path><path d=\"M2 12h2\"></path><path d=\"M20 12h2\"></path><path d=\"m6.34 17.66-1.41 1.41\"></path><path d=\"m19.07 4.93-1.41 1.41\"></path></svg>Mejor momento</dt><dd class=\"text-sm font-semibold text-tuggi-dark text-right\">Mañana · Tarde · Atardecer</dd></div><div class=\"flex items-baseline justify-between gap-4 border-b border-gray-200/70 py-2.5 last:border-b-0\"><dt class=\"inline-flex items-center gap-2 shrink-0 text-sm text-tuggi-slate\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe w-4 h-4 text-tuggi-slate/70 shrink-0\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg>Idiomas</dt><dd class=\"text-sm font-semibold text-tuggi-dark text-right\">English · Español · Português · Italiano</dd></div></dl><div class=\"mt-6 flex flex-col gap-3\"><a href=\"/d/tuggi\" class=\"inline-flex items-center justify-center gap-2 px-6 py-4 bg-tuggi-primary text-tuggi-dark font-black rounded-2xl shadow-lg shadow-tuggi-primary/20 hover:shadow-xl hover:-translate-y-0.5 transition-all\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-headphones w-5 h-5\" aria-hidden=\"true\"><path d=\"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3\"></path></svg>Escuchar en la app Tuggi</a><a href=\"#route-map\" class=\"inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-white text-tuggi-dark font-bold rounded-2xl border border-gray-200 hover:bg-gray-50 transition-all\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-5 h-5 text-tuggi-primary\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Ver el mapa</a></div></div></div><p class=\"order-2 lg:order-1 text-lg text-tuggi-slate leading-relaxed whitespace-pre-line\">Son 843 acres en pleno Manhattan, y Central Park es un recorrido en sí mismo. La ruta va de punta a punta, del sur al norte, pasando por el Carrusel, la Fuente Bethesda y su terraza, el Puente Bow (el puente más fotografiado del parque), Strawberry Fields (el memorial de John Lennon), el Castillo Belvedere, el Embalse Jacqueline Kennedy Onassis y el tranquilo Harlem Meer, al norte. Se puede hacer a pie o en bicicleta.</p></div></div></section><section id=\"route-map\" class=\"py-16 bg-white\" aria-labelledby=\"itinerary-heading\"><div class=\"page-shell\"><h2 id=\"itinerary-heading\" class=\"text-3xl md:text-4xl font-black text-tuggi-dark mb-3\">Lo que verás y escucharás</h2><p class=\"text-tuggi-slate\">Las paradas de esta ruta, en orden — con vistas previas de audio cuando están disponibles.</p><div class=\"mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] xl:grid-cols-[minmax(0,1fr)_minmax(0,32rem)] lg:gap-12 lg:items-start\"><div class=\"lg:order-2 lg:sticky lg:top-24\"><div class=\"rounded-3xl overflow-hidden border border-gray-100 shadow-sm h-[340px] sm:h-[420px] lg:h-[min(30rem,calc(100vh-16rem))]\"><div style=\"width:100%;height:100%;min-height:320px\" role=\"application\" aria-label=\"Mapa interactivo de la ruta\"></div></div><ul class=\"mt-3 flex flex-wrap gap-x-5 gap-y-2 text-xs text-tuggi-slate\"><li class=\"inline-flex items-center gap-2\"><span class=\"w-3 h-3 rounded-full bg-tuggi-primary shadow-sm\"></span>Con audio e historia</li><li class=\"inline-flex items-center gap-2\"><span class=\"w-3 h-3 rounded-full bg-white border-2 border-tuggi-slate\"></span>Punto de paso</li></ul><a href=\"/d/tuggi\" class=\"hidden md:inline-flex items-center gap-2 mt-6 px-6 py-3.5 bg-tuggi-primary text-tuggi-dark font-black rounded-2xl shadow-lg shadow-tuggi-primary/20 hover:shadow-xl hover:-translate-y-0.5 transition-all\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-headphones w-5 h-5\" aria-hidden=\"true\"><path d=\"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3\"></path></svg>Escuchar en la app Tuggi</a></div><div class=\"lg:order-1\"><ol class=\"relative border-l-2 border-tuggi-primary/20 ml-3\"><li id=\"stop-1\" data-position=\"1\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">1</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-primary shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Clock</h3><p class=\"mt-2 text-tuggi-slate leading-relaxed\">La Grand Central Terminal es un emblemático edificio de Nueva York. Su construcción comenzó en 1903 y abrió sus puertas oficialmente el 2 de febrero de 1913. Cornelius Vanderbilt fue una figura clave en su desarrollo inicial. La terminal se construyó en el lugar de dos estaciones anteriores, la primera de ellas de 1871. Fue diseñada para ser la terminal ferroviaria más grande y grandiosa del mundo en su inauguración. Un dato sorprendente es que la Grand Central fue la primera terminal en utilizar rampas de forma extensiva para el flujo de pasajeros, eliminando en gran medida la necesidad de escaleras.</p><div class=\"mt-4\"><div class=\"flex items-center gap-2 mb-2 text-xs font-bold uppercase tracking-wider text-tuggi-primary-text\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-volume2 lucide-volume-2 w-4 h-4\" aria-hidden=\"true\"><path d=\"M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z\"></path><path d=\"M16 9a5 5 0 0 1 0 6\"></path><path d=\"M19.364 18.364a9 9 0 0 0 0-12.728\"></path></svg>Vista previa de audio</div><div class=\"flex flex-wrap gap-1.5 mb-2\" role=\"group\" aria-label=\"Idiomas del audio\"><button type=\"button\" aria-pressed=\"false\" class=\"px-3 py-1.5 text-xs font-bold rounded-full border transition-colors bg-tuggi-bg text-tuggi-slate border-gray-200 hover:border-tuggi-primary\">EN</button><button type=\"button\" aria-pressed=\"true\" class=\"px-3 py-1.5 text-xs font-bold rounded-full border transition-colors bg-tuggi-primary text-tuggi-dark border-tuggi-primary\">ES</button><button type=\"button\" aria-pressed=\"false\" class=\"px-3 py-1.5 text-xs font-bold rounded-full border transition-colors bg-tuggi-bg text-tuggi-slate border-gray-200 hover:border-tuggi-primary\">PT-BR</button></div><article class=\"flex flex-col gap-4 rounded-2xl border p-5 sm:flex-row sm:items-start bg-white border-gray-200\"><button type=\"button\" aria-label=\"Reproducir la historia de Clock\" class=\"grid h-14 w-14 shrink-0 place-items-center rounded-full bg-tuggi-primary text-tuggi-dark transition-transform duration-150 hover:scale-105 active:scale-95 motion-reduce:transition-none motion-reduce:hover:scale-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-play ml-0.5 h-6 w-6 fill-current\" aria-hidden=\"true\"><path d=\"M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z\"></path></svg></button><div class=\"flex min-w-0 flex-1 flex-col gap-2\"><div><p class=\"line-clamp-2 font-bold text-tuggi-dark\">Clock</p><p class=\"text-sm text-tuggi-slate\">español</p></div><input type=\"range\" min=\"0\" max=\"0\" step=\"0.1\" disabled=\"\" aria-label=\"Avanzar en la historia de Clock\" aria-valuetext=\"0:00\" class=\"h-6 w-full cursor-pointer accent-tuggi-primary-text disabled:cursor-default\" value=\"0\"/></div><audio preload=\"none\" src=\"https://tysnkzmljlmmqpbotkxv.supabase.co/storage/v1/object/public/travel-app-audios/master_audio/98f71c5d-8e58-5bec-9e74-4d340f3609e1/98f71c5d-8e58-5bec-9e74-4d340f3609e1-es-es-male.mp3\"></audio></article></div></div></li><li id=\"stop-2\" data-position=\"2\" class=\"ml-8 scroll-mt-28 mb-10\"><span class=\"absolute -left-[15px] flex items-center justify-center w-7 h-7 rounded-full text-xs font-black ring-4 ring-white transition-transform motion-reduce:transition-none bg-tuggi-primary text-tuggi-dark \" aria-hidden=\"true\">2</span><div class=\"rounded-2xl border bg-tuggi-bg p-5 shadow-sm transition-colors motion-reduce:transition-none border-gray-100\"><h3 class=\"flex flex-wrap items-center gap-2 text-lg font-bold text-tuggi-dark\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin w-4 h-4 text-tuggi-primary shrink-0\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>Hallett Nature Sanctuary</h3><p class=\"mt-2 text-tuggi-slate leading-relaxed\">Santuario Natural Hallett. Este lugar tan especial fue concebido inicialmente como &quot;The Promontory&quot; por Frederick Law Olmsted y Calvert Vaux, cuando crearon el parque en 1858. Fue cerrado oficialmente en 1934 por Robert Moses para ser un refugio seguro para las aves. En 1986, se le cambió el nombre en honor a George Hervey Hallett Jr., un dedicado observador de aves y líder cívico. El santuario fue restaurado y reabierto al público en 2016, ofreciendo un remanso de paz. ¡Quizás te sorprenda saber que la cascada que ves aquí tiene el agua bombeada para crear ese efecto!</p><div class=\"mt-4\"><div class=\"flex items-center gap-2 mb-2 text-xs font-bold uppercase tracking-wider text-tuggi-primary-text\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-volume2 lucide-volume-2 w-4 h-4\" aria-hidden=\"true\"><path d=\"M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z\"></path><path d=\"M16 9a5 5 0 0 1 0 6\"></path><path d=\"M19.364 18.364a9 9 0 0 0 0-12.728\"></path></svg>Vista previa de audio</div><div class=\"flex flex-wrap gap-1.5 mb-2\" role=\"group\" aria-label=\"Idiomas del audio\"><button type=\"button\" aria-pressed=\"false\" class=\"px-3 py-1.5 text-xs font-bold rounded-full border transition-colors bg-tuggi-bg text-tuggi-slate border-gray-200 hover:border-tuggi-primary\">EN</button><button type=\"button\" aria-pressed=\"true\" class=\"px-3 py-1.5 text-xs font-bold rounded-full border transition-colors bg-tuggi-primary text-tuggi-dark border-tuggi-primary\">ES</button><button type=\"button\" aria-pressed=