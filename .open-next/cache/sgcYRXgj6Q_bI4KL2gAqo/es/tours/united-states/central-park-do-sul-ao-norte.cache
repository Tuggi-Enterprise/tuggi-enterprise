ridos cerca\\\",\\\"stopsCount\\\":\\\"{count, plural, one {# parada} other {# paradas}}\\\",\\\"stopsMerged\\\":\\\"Paradas {from}–{to}\\\",\\\"breadcrumbTours\\\":\\\"Audioguías\\\",\\\"metaTitle\\\":\\\"{name} — Audioguía Autoguiada\\\",\\\"metaDescFallback\\\":\\\"Una audioguía autoguiada en {place} con Tuggi. Historias que se reproducen automáticamente mientras exploras.\\\",\\\"ctaTitle\\\":\\\"Escucha la historia completa\\\",\\\"ctaSubtitle\\\":\\\"Descarga la app Tuggi y deja que cada parada cobre vida — sin manos, sin conexión y en tu idioma.\\\",\\\"ctaButton\\\":\\\"Descargar la app Tuggi\\\",\\\"countryIn\\\":{\\\"BR\\\":\\\"en Brasil\\\",\\\"ES\\\":\\\"en España\\\",\\\"FR\\\":\\\"en Francia\\\",\\\"GB\\\":\\\"en el Reino Unido\\\",\\\"IT\\\":\\\"en Italia\\\",\\\"PT\\\":\\\"en Portugal\\\",\\\"US\\\":\\\"en Estados Unidos\\\"},\\\"countryMetaTitle\\\":\\\"Audioguías Autoguiadas {inCountry}\\\",\\\"countryMetaDesc\\\":\\\"Explora audioguías autoguiadas {inCountry} con Tuggi — mapas, vistas previas de audio reales e información práctica de cada ruta.\\\",\\\"countryTitle\\\":\\\"Audioguías Autoguiadas {inCountry}\\\",\\\"countrySubtitle\\\":\\\"{count, plural, one {# ruta seleccionada} other {# rutas seleccionadas}} {inCountry}, cada una con mapa, paradas y vistas previas de audio reales.\\\",\\\"hubMetaTitle\\\":\\\"Audioguías Autoguiadas\\\",\\\"hubMetaDesc\\\":\\\"Explora las audioguías autoguiadas de Tuggi por país — rutas seleccionadas con mapas, paradas y vistas previas de audio reales.\\\",\\\"hubTitle\\\":\\\"Audioguías Autoguiadas\\\",\\\"hubSubtitle\\\":\\\"Rutas seleccionadas que se reproducen automáticamente mientras exploras — por país.\\\",\\\"hubEmpty\\\":\\\"Esta lista está vacía en tu idioma. En la app, la narración sigue el idioma que usas — es tu recorrido el que crea el audio.\\\",\\\"viewAllInCountry\\\":\\\"Ver las {count}\\\",\\\"themes\\\":{\\\"historical\\\":\\\"Histórico\\\",\\\"urban\\\":\\\"Urbano\\\",\\\"nature\\\":\\\"Naturaleza\\\",\\\"panoramic\\\":\\\"Panorámico\\\",\\\"cultural\\\":\\\"Cultural\\\",\\\"scenic\\\":\\\"Escénico\\\",\\\"coastal\\\":\\\"Costero\\\",\\\"religious\\\":\\\"Religioso\\\",\\\"gastronomic\\\":\\\"Gastronómico\\\",\\\"rural\\\":\\\"Rural\\\"},\\\"languagesCount\\\":\\\"{count, plural, one {# idioma} other {# idiomas}}\\\",\\\"statesNavLabel\\\":\\\"Estados con rutas\\\",\\\"stateMetaTitle\\\":\\\"{state} — Audioguías Autoguiadas\\\",\\\"stateMetaDesc\\\":\\\"{count, plural, one {# audioguía autoguiada seleccionada} other {# audioguías autoguiadas seleccionadas}} — {state}, {country}. Mapas, paradas y vistas previas de audio reales.\\\",\\\"stateTitle\\\":\\\"{state}\\\",\\\"stateSubtitle\\\":\\\"{count, plural, one {# ruta seleccionada} other {# rutas seleccionadas}} — {country}. Cada una con mapa, paradas y vistas previas de audio reales.\\\",\\\"viewAllInState\\\":\\\"Ver todas las {count}\\\",\\\"audioLanguages\\\":\\\"Idiomas del audio\\\",\\\"legendWithAudio\\\":\\\"Con audio e historia\\\",\\\"legendPassThrough\\\":\\\"Punto de paso\\\",\\\"stickyText\\\":\\\"Escucha esta ruta sin usar las manos\\\",\\\"stickyCta\\\":\\\"Descargar la app\\\"},\\\"Languages\\\":{\\\"title\\\":\\\"Escucha en tu idioma\\\",\\\"subtitle\\\":\\\"Del portugués al coreano, con acentos distintos para que te sientas en casa. Encuentra el tuyo abajo.\\\",\\\"langs\\\":[\\\"Portugués (BR)\\\",\\\"Portugués (PT)\\\",\\\"Inglés (EE. UU.)\\\",\\\"Inglés (UK)\\\",\\\"Español\\\",\\\"Italiano\\\",\\\"Francés\\\",\\\"Alemán\\\",\\\"Mandarín\\\",\\\"Coreano\\\"]},\\\"A11y\\\":{\\\"openMenu\\\":\\\"Abrir menú\\\",\\\"closeMenu\\\":\\\"Cerrar menú\\\",\\\"menu\\\":\\\"Menú\\\",\\\"mainMenu\\\":\\\"Menú principal\\\",\\\"sitePages\\\":\\\"Páginas del sitio\\\",\\\"breadcrumb\\\":\\\"Ruta de navegación\\\",\\\"routeMap\\\":\\\"Mapa interactivo de la ruta\\\",\\\"toggleCaptions\\\":\\\"Activar o desactivar los subtítulos\\\",\\\"skipToContent\\\":\\\"Ir al contenido principal\\\",\\\"playAud