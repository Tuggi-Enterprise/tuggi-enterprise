ks/29d95b136dea432d.js\"/><script src=\"/_next/static/chunks/961311cbebbffb6d.js\" async=\"\"></script><script src=\"/_next/static/chunks/54583150ac621392.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-6e65cce314202413.js\" async=\"\"></script><script src=\"/_next/static/chunks/d96012bcfc98706a.js\" async=\"\"></script><script src=\"/_next/static/chunks/73e3194f06db260e.js\" async=\"\"></script><script src=\"/_next/static/chunks/36c9e5bc4f7460fd.js\" async=\"\"></script><script src=\"/_next/static/chunks/27a1237e2a9f6c6c.js\" async=\"\"></script><script src=\"/_next/static/chunks/66e164642a425c8a.js\" async=\"\"></script><script src=\"/_next/static/chunks/9c38e031aa827488.js\" async=\"\"></script><script src=\"/_next/static/chunks/00fc9bc083c08a18.js\" async=\"\"></script><script src=\"/_next/static/chunks/d98e2f61488237bc.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><meta name=\"theme-color\" content=\"#0B1220\"/><title>Audioguida di Viaggio — Storie che Partono Mentre Passi | TUGGI</title><meta name=\"description\" content=\"TUGGI ti racconta la storia di ogni luogo ad alta voce mentre passi, comunque tu viaggi. Un&#x27;audioguida di viaggio autoguidata, offline e nella tua lingua. Inizia gratis.\"/><link rel=\"manifest\" href=\"/site.webmanifest\"/><meta name=\"robots\" content=\"index, follow\"/><link rel=\"canonical\" href=\"https://www.tuggi.app/it\"/><link rel=\"alternate\" hrefLang=\"en\" href=\"https://www.tuggi.app/en\"/><link rel=\"alternate\" hrefLang=\"es\" href=\"https://www.tuggi.app/es\"/><link rel=\"alternate\" hrefLang=\"pt\" href=\"https://www.tuggi.app/pt\"/><link rel=\"alternate\" hrefLang=\"it\" href=\"https://www.tuggi.app/it\"/><link rel=\"alternate\" hrefLang=\"x-default\" href=\"https://www.tuggi.app/en\"/><meta property=\"og:title\" content=\"Audioguida di Viaggio — Storie che Partono Mentre Passi | TUGGI\"/><meta property=\"og:description\" content=\"TUGGI ti racconta la storia di ogni luog