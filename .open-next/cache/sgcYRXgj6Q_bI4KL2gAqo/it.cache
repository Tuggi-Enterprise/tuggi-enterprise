6012bcfc98706a.js\",\"/_next/static/chunks/73e3194f06db260e.js\"],\"OutletBoundary\"]\n19:\"$Sreact.suspense\"\n25:I[77105,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\",\"/_next/static/chunks/00fc9bc083c08a18.js\",\"/_next/static/chunks/d98e2f61488237bc.js\"],\"default\"]\n2:Tb12,{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Qual è la migliore app per audioguide autoguidate?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"TUGGI è un'audioguida di viaggio autoguidata per iOS e Android. Riproduce automaticamente racconti audio sui luoghi intorno a te, attivati dal GPS — a mani libere e a schermo spento — mentre guidi, cammini o pedali. Funziona offline, supporta 10 lingue con sottotitoli ed è gratis per iniziare.\"}},{\"@type\":\"Question\",\"name\":\"Esiste un'app di audioguida di viaggio gratuita?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sì. TUGGI è gratis da scaricare e inizia con storie ogni giorno. Per ascoltare senza limite giornaliero, un Pass Tuggi dà 10, 25 o 45 ore di utilizzo, con pagamento unico. Le ore non scadono e vedrai il prezzo nell'App Store o su Google Play.\"}},{\"@type\":\"Question\",\"name\":\"Qual è una buona app di viaggio per un on the road?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"TUGGI è stata creata per i viaggi in auto: funziona insieme al tuo navigatore e alla tua musica e racconta automaticamente i monumenti, le città e la storia che incontri — senza schermo, senza cercare. Scarica il percorso in anticipo per usarlo offline senza costi di roaming.\"}},{\"@type\":\"Question\",\"name\":\"Posso esplorare una città senza una guida turistica?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sì. TUGGI funziona come un'audioguida autoguidata, così puoi esplorare al tuo ritmo senza prenotare una guida umana o un tour fisso. I racconti partono automaticamente quando raggiungi ogni punto di interesse, a piedi o in auto.\"}},{\"@type\":\"Question\",\"name\":\"TUGGI funziona offline e nella mia lingua?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sì. Scarica un percorso in anticipo e ascolta senza segnale e senza costi di roaming. TUGGI offre audio in 10 lingue con sottotitoli sincronizzati per viaggiatori sordi e con difficoltà uditive.\"}},{\"@type\":\"Question\",\"name\":\"In cosa è diverso TUGGI da Google Maps o da una guida umana?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"TUGGI non è un'app di navigazione e non sostituisce il tuo GPS — funziona al suo fianco e aggiunge una narrazione audio autoguidata sui luoghi che attraversi. A differenza di una guida umana, è disponibile 24/7, in più lingue, a mani libere e gratis per iniziare.\"}},{\"@type\":\"Question\",\"name\":\"Per chi è pensato TUGGI?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Per chiunque ami esplorare in movimento: turisti, residenti curiosi, ciclisti, camminatori, passeggeri di autobus, treno o van, e anche automobilisti. Funziona in un viaggio in auto, in un city tour a piedi, in un giro in bici o monopattino e sui mezzi pubblici. Poiché l'audio è attivato dal GPS e funziona offline, l'esperienza è la stessa con qualsiasi mezzo di trasporto.\"}}]}0:{\"buildId\":\"sgcYRXgj6Q_bI4KL2gAqo\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2\"}}],[\"$\",\"$L3\",null,{\"children\":[[\"$\",\"$L4\",null,{}],[\"$\",\"$L5\",null,{}],[\"$\",\"section\",null,{\"data-block\":\"scene\",\"className\":\"bg-tuggi-dark py-24 lg:py-32\",\"children\":[\"$\",\"div\",null,{\"className\":\"page-shell\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-3xl\",\"children\":[[\"$\",\"p\",null,{\"className\":\"whitespace-pre-line text-2xl sm:text-3xl lg:text-4xl font-extrabold leading-tight tracking-tight t