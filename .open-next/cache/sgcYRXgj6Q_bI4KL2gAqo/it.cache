lse,false]},null,false,false],[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$La\",null,{\"children\":\"$Lb\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$Lc\",null,{\"children\":[\"$\",\"$8\",null,{\"name\":\"Next.Metadata\",\"children\":\"$Ld\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}],false]],\"m\":\"$undefined\",\"G\":[\"$e\",[]],\"S\":true}\n4:E{\"digest\":\"NEXT_REDIRECT;replace;/en;307;\"}\n10:I[395025,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\",\"/_next/static/chunks/00fc9bc083c08a18.js\",\"/_next/static/chunks/d98e2f61488237bc.js\"],\"HomeMotionConfig\"]\n11:I[54447,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\",\"/_next/static/chunks/00fc9bc083c08a18.js\",\"/_next/static/chunks/d98e2f61488237bc.js\"],\"HomeHero\"]\n12:I[693376,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\",\"/_next/static/chunks/00fc9bc083c08a18.js\",\"/_next/static/chunks/d98e2f61488237bc.js\"],\"HomeHowItWorks\"]\n15:I[573399,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\",\"/_next/static/chunks/00fc9bc083c08a18.js\",\"/_next/static/chunks/d98e2f61488237bc.js\"],\"HomeFeatureShowcase\"]\n18:I[931037,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\",\"/_next/static/chunks/00fc9bc083c08a18.js\",\"/_next/static/chunks/d98e2f61488237bc.js\"],\"HomeBusinessSection\"]\n1a:I[379529,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\",\"/_next/static/chunks/00fc9bc083c08a18.js\",\"/_next/static/chunks/d98e2f61488237bc.js\"],\"FaqSection\"]\nf:Tb12,{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Qual è la migliore app per audioguide autoguidate?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"TUGGI è un'audioguida di viaggio autoguidata per iOS e Android. Riproduce automaticamente racconti audio sui luoghi intorno a te, attivati dal GPS — a mani libere e a schermo spento — mentre guidi, cammini o pedali. Funziona offline, supporta 10 lingue con sottotitoli ed è gratis per iniziare.\"}},{\"@type\":\"Question\",\"name\":\"Esiste un'app di audioguida di viaggio gratuita?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sì. TUGGI è gratis da scaricare e inizia con storie ogni giorno. Per ascoltare senza limite giornaliero, un Pass Tuggi dà 10, 25 o 45 ore di utilizzo, con pagamento unico. Le ore non scadono e vedrai il prezzo nell'App Store o su Google Play.\"}},{\"@type\":\"Question\",\"name\":\"Qual è una buona app di viaggio per un on the road?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"TUGGI è stata creata per i viaggi in auto: funziona insieme al tuo navigatore e alla tua musica e racconta automaticamente i monumenti, le città e la storia che incontri — senza schermo, senza cercare. Scarica il percorso in anticipo per usarlo offline senza costi di roaming.\"}},{\"@type\":\"Question\",\"name\":\"Posso esplorare una città senza una guida turistica?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sì. TUGGI funziona come un'audioguida autoguidata, così puoi esplorare al tuo ritmo senza prenotare una guida umana o un tour fisso. I racconti partono automaticamente quando raggiungi ogni punto di interesse, a piedi o in auto.\"}},{\"@type\":\"Question\",\"name\":\"TUGGI funziona offline e nella mia lingua?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sì. Scarica un percorso in anticipo e ascolta senza segnale e senza costi di roaming. TUGGI offre audio in 10 lingue con sottotitoli sincronizzati per viaggiatori sordi e con difficoltà uditive.\"}},{\"@type\":\"Question\",\"name\":\"In cosa è diverso TUGGI da Google Maps o da una guida umana?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"TUGGI non è un'app di navigazione e non sostituisce il tuo GPS — funziona al suo fianco e aggiunge una narrazione audio autoguidata sui luoghi che attraversi. A differenza di una guida umana, è disponibile 24/7, in più lingue, a mani libere e gratis per iniziare.\"}},{\"@type\":\"Question\",\"name\":\"Per chi è pensato TUGGI?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Per chiunque ami esplorare in movimento: turisti, residenti curiosi, ciclisti, camminatori, passeggeri di autobus, treno o van, e anche automobilisti. Funziona in un viaggio in auto, in un city tour a piedi, in un giro in bici o monopattino e sui mezzi pubblici. Poiché l'audio è attivato dal GPS e funziona offline, l'esperienza è la stessa con qualsiasi mezzo di trasporto.\"}}]}6:[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$f\"}}],[\"$\",\"$L10\",null,{\"children\":[[\"$\",\"$L11\",null,{}],[\"$\",\"$L12\",null,{}],\"$L13\",\"$L14\",[\"$\",\"$L15\",null,{}],\"$L16\",\"$L17\",[\"$\",\"$L18\",null,{}],\"$L19\",[\"$\",\"$L1a\",null,{\"namespace\":\"Home.FAQ\",\"count\":7}]]}]]\n1c:I[140033,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\"],\"default\"]\n1d:I[755241,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\"],\"d