ua.\",\"url\":\"https://www.tuggi.app\",\"downloadUrl\":[\"https://apps.apple.com/app/tuggi-drive/id6744379818\",\"https://play.google.com/store/apps/details?id=com.tuggidrive.app\"],\"installUrl\":\"https://apps.apple.com/app/tuggi-drive/id6744379818\",\"sameAs\":[\"https://apps.apple.com/app/tuggi-drive/id6744379818\",\"https://play.google.com/store/apps/details?id=com.tuggidrive.app\"],\"screenshot\":\"https://www.tuggi.app/images/og-image-tuggi.jpg\",\"featureList\":[\"Self-guided audio stories that trigger automatically by GPS location\",\"Screen-off playback while you drive, walk, or cycle\",\"Works offline — download routes in advance, no roaming\",\"Audio in 10 languages with synchronized closed captions\",\"Free to start; optional Tuggi Passes of 10, 25 or 45 hours of use that do not expire\"],\"offers\":{\"@type\":\"Offer\",\"price\":\"0.00\",\"priceCurrency\":\"USD\"},\"publisher\":{\"@id\":\"https://www.tuggi.app/#organization\"}}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://www.tuggi.app/#website\",\"name\":\"TUGGI\",\"url\":\"https://www.tuggi.app/it\",\"description\":\"TUGGI ti racconta la storia di ogni luogo ad alta voce mentre passi, comunque tu viaggi. Un'audioguida di viaggio autoguidata, offline e nella tua lingua. Inizia gratis.\",\"publisher\":{\"@id\":\"https://www.tuggi.app/#organization\"}}</script><script src=\"/_next/static/chunks/29d95b136dea432d.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[339756,[\\\"/_next/static/chunks/d96012bcfc98706a.js\\\",\\\"/_next/static/chunks/73e3194f06db260e.js\\\"],\\\"default\\\"]\\n3:I[837457,[\\\"/_next/static/chunks/d96012bcfc98706a.js\\\",\\\"/_next/static/chunks/73e3194f06db260e.js\\\"],\\\"default\\\"]\\n7:I[897367,[\\\"/_next/static/chunks/d96012bcfc98706a.js\\\",\\\"/_next/static/chunks/73e3194f06db260e.js\\\