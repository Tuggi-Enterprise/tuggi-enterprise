5 7 7-7 7\"}],\"$undefined\"]}]]}]}]\n","/$d$locale":"1:\"$Sreact.fragment\"\n2:I[175696,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\"],\"default\"]\na:I[598819,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\"],\"AttributionGateProvider\"]\nb:I[502524,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\"],\"GlobalHeader\"]\nc:I[339756,[\"/_next/static/chunks/d96012bcfc98706a.js\",\"/_next/static/chunks/73e3194f06db260e.js\"],\"default\"]\nd:I[837457,[\"/_next/static/chunks/d96012bcfc98706a.js\",\"/_next/static/chunks/73e3194f06db260e.js\"],\"default\"]\ne:I[77105,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\",\"/_next/static/chunks/00fc9bc083c08a18.js\",\"/_next/static/chunks/d98e2f61488237bc.js\"],\"default\"]\nf:I[605500,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\"],\"Image\"]\n17:I[140033,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\"],\"default\"]\n18:I[755241,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\"],\"default\"]\n19:I[854097,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\"],\"default\"]\n1a:I[763725,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\"],\"FooterStoreBadges\"]\n1b:I[152538,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\"],\"CookieBanner\"]\n:HL[\"/_next/static/chunks/7f49250fef2b3bdc.css\",\"style\"]\n:HL[\"/_next/static/chunks/a824ce76f88b5f96.css\",\"style\"]\n3:T623,<strong>Dati della Proposta di Partnership:</strong> Esiste un modulo di proposta di partnership su questo sito, aperto a qualsiasi attività che voglia proporre una partnership. Chi lo compila ci manda due cose. Una è l'attività, con nome commerciale e ragione sociale, CNPJ, categoria, indirizzo completo con codice postale, quartiere, città e stato, orari di apertura, sito web e Instagram. L'altra è chi risponde per l'attività, con nome, ruolo, email e telefono, e questi sono dati di una persona. In un MEI o in una ditta individuale del Brasile, la ragione sociale porta il nome del titolare, e l'indirizzo può essere quello di casa sua, quindi trattiamo tutto quel modulo come dato personale. Usiamo quello che arriva lì per cinque cose: valutare la proposta, parlare con la persona di questa partnership, generare il contratto e inviarlo per la firma all'email indicata, contenere gli abusi sulla pagina, che è aperta a chiunque, e misurare dove il modulo crea difficoltà. Per contenere gli abusi contiamo quante proposte arrivano da ogni connessione. Per questo conteggio conserviamo un codice calcolato a partire dall'indirizzo IP, e non l'indirizzo. Quel codice non è anonimo, perché la stessa connessione produce sempre lo stesso codice. Per misurare dove il modulo crea difficoltà contiamo quante persone aprono ogni passo e a quale passo si fermano. Per questo conteggio non conserviamo il tuo nome, né l'indirizzo della tua connessione, né nulla di quello che hai scritto. Puoi chiederci di rimuovere questi dati, e la sezione 5 spiega come.4:T541,<strong>Visita alla Pagina di un Partner:</strong> Quando arrivi alla pagina di un partner su questo sito, con un Codice QR o con un suo link, registriamo quella visita. Se ti colleghi da un paese che non sia il Brasile o gli Stati Uniti, quel registro nasce solo dopo che accetti i cookie su questo sito. Finché non accetti, non conserviamo nulla di quella visita e non scriviamo cookie sul tuo dispositivo. Conserviamo l'indirizzo IP della tua connessione, l'identificazione che dichiara il browser, la lingua del browser e il fuso orario del dispositivo. Conserviamo anche quale partner hai visitato e l'ora. Insieme a questo scriviamo un cookie di questo stesso sito, chiamato tuggi_attr, che dura 30 giorni e conserva l'identificativo del partner, l'identificativo di quella visita e la data. Questo registro serve a una sola finalità, cioè sapere quale partner ti ha portato all'app, perché è così che paghiamo quel partner. Non alimenta pubblicità e non serve per il contatto. L'indirizzo IP e l'identificazione del browser escono da quel registro dopo 48 ore, e il registro intero viene cancellato dopo 30 giorni, con una routine che gira ogni giorno. Quando quel registro esiste e tocchi un pulsante che porta allo store, l'identificativo di quella visita viaggia dentro il link, e la sezione 3 racconta che cosa succede con lui.0:{\"buildId\":\"sgcYRXgj6Q_bI4KL2gAqo\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/7f49250fef2b3bdc.css\",\"precedence\":\"next\"}],[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/a824ce76f88b5f96.css\",\"precedence\":\"next\"}],[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"async\":true}],[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"async\":true}],[\"$\",\"script\",\"script-2\",{\"src\":\"/_next/static/chunks/66e164642a425c8a.js\",\"async\":true}],[\"$\",\"script\",\"script-3\",{\"src\":\"/_next/static/chunks/9c38e031aa827488.js\",\"async\":true}]],[\"$\",\"html\",null,{\"lang\":\"it\",\"className\":\"inter_fa93af41-module__0D_jrq__className\",\"children\":[\"$\",\"body\",null,{\"className\":\"bg-white text-[#0B1220] antialiased\",\"children\":[[\"$\",\"a\",null,{\"href\":\"#main-content\",\"className\":\"sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-6 focus:py-3 focus:bg-tuggi-primary focus:text-tuggi-dark focus:font-bold focus:rounded-xl focus:shadow-2xl focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2\",\"children\":\"Vai al contenuto principale\"}],[\"$\",\"$L2\",null,{\"locale\":\"it\",\"messages\":{\"Download\":{\"metaTitle\":\"Scarica TUGGI – Audioguida di Viaggio Autoguidata\",\"metaDesc\":\"Scarica l'app TUGGI: audioguide autoguidate, a mani libere e offline. Ascolta in {contentLanguages} lingue con sottotitoli. Gratis per iniziare.\",\"partnerBadge\":\"INVITO PARTNER TUGGI ATTIVATO\",\"heroWelcomeLabel\":\"Benvenuto\",\"heroWelcomeTitle\":\"Esperienza Tuggi\",\"heroTitle1\":\"La tua esperienza\",\"heroTitle2\":\"culturale\",\"heroTitle3\":\"è iniziata.\",\"heroSubtitle\":\"Stiamo preparando tutto per te. Tra un istante verrai reindirizzato allo store ufficiale.\",\"partnerVisitSite\":\"Visita il sito\",\"redirecting\":\"Reindirizzamento\",\"openingStore\":\"Apertura dello store...\",\"initializing\":\"Inizializzazione del download per\",\"cta\":\"SCOPRI DI PIÙ NELL'APP\",\"officialApp\":\"App Ufficiale\",\"trustFooter\":\"Connessione Sicura • Distribuzione App Ufficiale • Powered by Tuggi\",\"loading\":\"Caricamento...\",\"readMore\":\"DI PIÙ\",\"readLess\":\"MENO\",\"Campaign\":{\"headline\":\"Tra un piatto e l'altro, la regione racconta <accent>la propria storia</accent>.\",\"subtext\":\"Tu prosegui il viaggio. La narrazione ti segue.\",\"referredBy\":\"Consigliato da <partner>{name}</partner>\",\"stepsHeading\":\"Come funziona\",\"step1Title\":\"Aprila e dimenticala\",\"step1Text\":\"Avvia l'app all'inizio della gita e rimetti il telefono in tasca.\",\"step2Title\":\"L'audio parte da solo\",\"step2Text\":\"Quando ti avvicini a un luogo, la narrazione parte automaticamente.\",\"step3Title\":\"La strada è tua\",\"step3Text\":\"Una deviazione, una sosta, il ritorno lungo la spiaggia. Il contenuto è nel territorio, non in un itinerario fisso.\",\"bandTitle\":\"Scarica gratis\",\"bandSubtitle\":\"Provala ora!\"},\"Player\":{\"playing\":\"In riproduzione\",\"tapToPlay\":\"Tocca il pulsante play\",\"paused\":\"In pausa\"}},\"Header\":{\"navPartners\":\"Partner\",\"navDestinations\":\"Destinazioni\",\"navTech\":\"Tecnologia\",\"navPlans\":\"Pass\",\"navAudioGuides\":\"Audioguide\",\"navPurpose\":\"Il nostro scopo\",\"downloadApp\":\"Scarica l'App\"},\"Footer\":{\"tagline\":\"Connettiamo le persone al contesto del mondo fisico\",\"driveB2c\":\"TUGGI (B2C)\",\"appDownload\":\"Scarica l'App\",\"plans\":\"Pass\",\"enterprise\":\"Enterprise (B2B/B2G)\",\"destinations\":\"Destinazioni\",\"fleets\":\"Flotte\",\"technology\":\"Tecnologia\",\"institutional\":\"Istituzionale\",\"ourPurpose\":\"Il Nostro Scopo\",\"contact\":\"Contatti\",\"trustCenter\":\"Trust Center & Conformità\",\"terms\":\"Termini di Utilizzo\",\"privacy\":\"Informativa sulla Privacy\",\"accessibility\":\"Accessibilità\",\"security\":\"Sicurezza B2G\",\"coverage\":\"Copertura Globale\",\"updates\":\"Aggiornamenti\",\"audioTours\":\"Audioguide\",\"rights\":\"Tutti i diritti riservati.\"},\"Home\":{\"FAQ\":{\"title\":\"Domande Frequenti\",\"q1\":\"Qual è la migliore app per audioguide autoguidate?\",\"a1\":\"TUGGI è un'audioguida di viaggio autoguidata per iOS e Android. Riproduce automaticamente racconti audio sui luoghi intorno a te, attivati dal GPS — a mani libere e a schermo spento — mentre guidi, cammini o pedali. Funziona offline, supporta {contentLanguages} lingue con sottotitoli ed è gratis per iniziare.\",\"q2\":\"Esiste un'app di audioguida di viaggio gratuita?\",\"a2\":\"Sì. TUGGI è gratis da scaricare e inizia con storie ogni giorno. Per ascoltare senza limite giornaliero, un Pass Tuggi dà 10, 25 o 45 ore di utilizzo, con pagamento unico. Le ore non scadono e vedrai il prezzo nell'App Store o su Google Play.\",\"q3\":\"Qual è una buona app di viaggio per un on the road?\",\"a3\":\"TUGGI è stata creata per i viaggi in auto: funziona insieme al tuo navigatore e alla tua musica e racconta automaticamente i monumenti, le città e la storia che incontri — senza schermo, senza cercare. Scarica il percorso in anticipo per usarlo offline senza costi di roaming.\",\"q4\":\"Posso esplorare una città senza una guida turistica?\",\"a4\":\"Sì. TUGGI funziona come un'audioguida autoguidata, così puoi esplorare al tuo ritmo senza prenotare una guida umana o un tour fisso. I racconti partono automaticamente quando raggiungi ogni punto di interesse, a piedi o in auto.\",\"q5\":\"TUGGI funziona offline e nella mia lingua?\",\"a5\":\"Sì. Scarica un percorso in anticipo e ascolta senza segnale e senza costi di roaming. TUGGI offre audio in {contentLanguages} lingue con sottotitoli sincronizzati per viaggiatori sordi e con difficoltà uditive.\",\"q6\":\"In cosa è diverso TUGGI da Google Maps o da una guida umana?\",\"a6\":\"TUGGI non è un'app di navigazione e non sostituisce il tuo GPS — funziona al suo fianco e aggiunge una narrazione audio autoguidata sui luoghi che attraversi. A differenza di una guida umana, è disponibile 24/7, in più lingue, a mani libere e gratis per iniziare.\",\"q7\":\"Per chi è pensato TUGGI?\",\"a7\":\"Per chiunque ami esplorare in movimento: turisti, residenti curiosi, ciclisti, camminatori, passeggeri di autobus, treno o van, e anche automobilisti. Funziona in un viaggio in auto, in un city tour a piedi, in un giro in bici o monopattino e sui mezzi pubblici. Poiché l'audio è attivato dal GPS e funziona offline, l'esperienza è la stessa con qualsiasi mezzo di trasporto.\"},\"Hero\":{\"title\":\"Ti muovi e TUGGI racconta la storia di ogni luogo.\",\"subtitle\":\"Accendi TUGGI, mettiti in movimento e metti via il telefono. Con il GPS riconosce ogni punto di interesse lungo il percorso e ne racconta la storia ad alta voce. Va bene a piedi, in bici, in auto o sui mezzi pubblici, offline e nella tua lingua.\",\"trustLine\":\"Inizia gratis · Funziona offline · Audio in {contentLanguages} lingue\",\"appStoreAlt\":\"Scarica TUGGI sull'App Store\",\"playStoreAlt\":\"Scarica TUGGI su Google Play\",\"phoneAlt\":\"Scheda di un punto nell'app TUGGI, aperta sulla mappa: il nome del luogo, la distanza, l'inizio della storia e i pulsanti per ascoltare la storia o leggere la trascrizione.\"},\"Scene\":{\"lead\":\"Oggi sei passato davanti a quaranta storie.\\nNon ne hai ascoltata nessuna.\",\"body\":\"Il forte all'ingresso della città, la chiesa del Settecento, il crinale che ha un nome e una ragione. Tutto è passato dal finestrino in silenzio, perché nessuno accosta per cercare che cos'era.\"},\"HowItWorks\":{\"title\":\"Inizia ad ascoltare in un minuto\",\"step1\":\"Scarica l'app e scegli la tua lingua.\",\"step2\":\"Avvia la guida e metti via il telefono.\",\"step3\":\"Le storie partono da sole mentre passi accanto a ogni luogo.\"},\"Showcase\":{\"feat2Title\":\"Fermo, ti mostra. In movimento, parla.\",\"feat2Body\":\"Quando ti fermi, apri la mappa e vedi cosa hai intorno: punti di interesse, eventi e itinerari, ciascuno con la sua distanza. Riparti e TUGGI torna a raccontare: dice il nome del luogo e poi racconta la storia.\",\"feat2Alt\":\"Elenco \\\"esplora i dintorni\\\" di TUGGI con i punti di interesse vicini e le loro distanze\",\"feat3Title\":\"Scopri cosa succede in questo momento\",\"feat3Body\":\"Festival, fiere ed eventi della città compaiono sulla tua mappa con data e promemoria. Hai visto qualcosa che ti piace? Tocca \\\"portami lì\\\" e vai.\",\"feat3Alt\":\"Scheda di dettaglio evento di TUGGI con la data, un promemoria e un pulsante per portarti lì\",\"feat4Title\":\"C'è un itinerario pronto, ma comandi tu\",\"feat4Body\":\"Se ti va, segui un itinerario a tema, come la Rota Religiosa de Búzios, con le tappe e le storie già pronte. Se non ti va, lascia perdere l'itinerario: TUGGI racconta ovunque tu vada.\",\"feat4Alt\":\"Dettaglio itinerario di TUGGI con il percorso disegnato sulla mappa e le sue tappe\",\"feat5Title\":\"Ogni viaggio finisce nel tuo passaporto\",\"feat5Body\":\"L'app somma tutto: luoghi scoperti, città, chilometri percorsi e ore di audio. Diventa un diario dei tuoi viaggi da mostrare agli amici.\",\"feat5Alt\":\"Passaporto dell'esploratore in TUGGI con scoperte, città, chilometri e ore di audio\",\"feat6Title\":\"Fatto per andare ovunque\",\"feat6Body\":\"Scarica le mappe e usa tutto senza internet. Comanda la guida a voce con Siri o Google, senza tirare fuori il telefono dalla tasca. E ascolta in {contentLanguages} lingue, come preferisci.\",\"feat6AltTools\":\"Strumenti dell'esploratore in TUGGI, con mappe offline e comandi vocali\",\"feat6AltLanguages\":\"Selettore della lingua audio di TUGGI con inglese, spagnolo, italiano, portoghese e altro\"},\"AudioSample\":{\"title\":\"Ascolta TUGGI di persona\",\"subtitle\":\"Brevi storie, proprio come le sentiresti mentre esplori.\"},\"Business\":{\"title\":\"TUGGI per la tua azienda\",\"body\":\"Aziende di transfer, flotte a noleggio e destinazioni usano TUGGI per dare a ogni viaggiatore una guida locale.\",\"fleetsLink\":\"Per flotte e operatori\",\"cityOsLink\":\"Per destinazioni\"},\"Context\":{\"title\":\"Cos’è TUGGI\",\"p1\":\"TUGGI è una guida di viaggio audio autoguidata per iPhone e Android. Usa il GPS per riconoscere i luoghi che attraversi e racconta la storia di ciascuno ad alta voce, al momento giusto, senza che tu cerchi nulla sullo schermo. Funziona come viaggi: a piedi, in bici, in auto, in autobus o in metro.\",\"p2\":\"Le storie partono da sole quando ti avvicini a un punto di interesse. Poiché tutto funziona offline, scarichi la città prima di partire e ascolti senza internet e senza consumare dati in roaming. E dato che ogni storia ha i sottotitoli sincronizzati, i viaggiatori sordi o con problemi di udito la seguono sullo schermo.\",\"p3\":\"TUGGI non sostituisce la tua app di navigazione: funziona insieme a lei, senza intralciare la mappa o la musica, e aggiunge solo la narrazione culturale del percorso. Inizia gratis, scegli tra {contentLanguages} lingue e trasforma qualsiasi tragitto in un viaggio con una storia.\"}},\"AudioSample\":{\"play\":\"Riproduci la storia di {name}\",\"pause\":\"Metti in pausa la storia di {name}\",\"seek\":\"Scorri la storia di {name}\",\"transcriptShow\":\"Leggi la trascrizione\",\"transcriptHide\":\"Chiudi la trascrizione\",\"tagDirectional\":\"Direzionale\",\"tagStory\":\"Racconto\",\"error\":\"Non è stato possibile riprodurre questa storia ora. Riprova.\",\"sample1Name\":\"Walt Disney World Resort\",\"sample1City\":\"Orlando\",\"sample2Name\":\"Avenida Paulista\",\"sample2City\":\"San Paolo\",\"sample3Name\":\"Ponte di Rialto\",\"sample3City\":\"Venezia\"},\"Proof\":{\"points\":\"<strong>Oltre {mappedPointMillions} milioni</strong> di punti mappati, in {coverageCountries} paesi.\",\"guides\":\"<strong>Oltre {audioGuidesFloor, number}</strong> audioguide prodotte, con audio in {contentLanguages} lingue.\",\"since\":\"In attività dal {operatingSince}.\"},\"CityOS\":{\"Hero\":{\"title\":\"L'Infrastruttura Definitiva per le Destinazioni Turistiche Intelligenti (DTI).\",\"subtitle\":\"TUGGI City OS allinea la tua governance territoriale con i pilastri globali di Tecnologia, Sostenibilità, Accessibilità e Dati.\",\"cta\":\"Richiedi una Demo di City OS\"},\"Animator\":{\"geoTriggerActive\":\"GEO-TRIGGER ATTIVO\",\"newPoi\":\"Nuovo POI\",\"poiName\":\"Nome POI\",\"audio\":\"Audio\",\"coordinates\":\"Coordinate\",\"activationRadius\":\"Raggio di Attivazione\",\"deployButton\":\"Distribuisci sulla Griglia\",\"defaultPoiName\":\"Monumento Principale\"},\"Accessibility\":{\"title\":\"Accessibilità Universale\",\"desc\":\"L'Accessibilità Universale è il pilastro DTI più difficile. TUGGI abbatte entrambe le barriere sensoriali: esperienza guidata dall'audio, con la descrizione di ciò che sta intorno, per i turisti con disabilità visiva; e sottotitoli (Closed Captions) geolocalizzati per i passeggeri con disabilità uditiva. Progettiamo seguendo le WCAG 2.1 AA.\",\"Panel\":{\"title\":\"Modulo di Accessibilità\",\"feat1Title\":\"Esperienza guidata dall'audio\",\"feat1Desc\":\"Compatibile con VoiceOver e TalkBack\",\"feat2Title\":\"Contesto spaziale\",\"feat2Desc\":\"Audio immersivo\",\"feat3Title\":\"Sottotitoli dinamici\",\"feat3Desc\":\"Sottotitoli geolocalizzati\"}},\"Intelligence\":{\"title\":\"Intelligenza Turistica Basata sui Dati\",\"desc\":\"I governi sono di solito ciechi rispetto al flusso turistico. TUGGI fornisce telemetria anonimizzata: scopri esattamente quali percorsi vengono seguiti, a che ora e in quali lingue, abilitando campagne di marketing internazionale iper-mirate.\"}},\"Fleets\":{\"Hero\":{\"title\":\"De-commoditizza la tua Flotta.\",\"subtitle\":\"Trasforma un normale noleggio auto in un'Esperienza Culturale Premium.\",\"cta\":\"Diventa Partner di TUGGI\",\"eyebrow\":\"Per flotte e società di noleggio\"},\"Financial\":{\"col2Title\":\"Scalabilità Istantanea\",\"col2Desc\":\"Distribuisci sull'intera flotta nazionale tramite l'integrazione con codice QR al banco.\",\"col3Title\":\"Partecipazione ai Ricavi\",\"col3Desc\":\"Il turista che scarica Tuggi con il tuo QR Code viene attribuito a te. Gli acquisti che effettua entrano nel calcolo della tua partecipazione ai ricavi, con la percentuale definita nell'accordo commerciale.\"},\"ESG\":{\"title\":\"Distribuzione Digitale Senza Frizioni\",\"desc\":\"Coltiva i tuoi obiettivi ESG sostenendo l'economia creativa locale e decomprimendo l'overtourism con percorsi guidati.\",\"cta\":\"Richiedi una Demo B2B\"}},\"Partners\":{\"hero\":{\"eyebrow\":\"Per chi accoglie turisti\",\"title\":\"Fatti trovare dal turista che è già nella tua via\",\"subtitle\":\"La tua attività può far parte della storia di quella via: ogni turista di Tuggi trova e legge il tuo locale, e chi ha la guida accesa lo ascolta. Nessun piano di Tuggi ti nasconde al turista.\"},\"grid\":{\"title\":\"Scegli il tuo tipo di attività\",\"lead\":\"Ogni attività incontra il turista in un momento diverso della giornata. Trova la tua, e ne parliamo.\",\"actionOpen\":\"Scopri come funziona\"},\"mechanism\":{\"place\":\"il banco, la camera, l'auto\"},\"seo\":{\"primaryTerm\":\"programma partner\",\"title\":\"Programma partner per chi accoglie i turisti\",\"description\":\"Ristoranti, hotel, transfer e autonoleggi: scopri come la tua attività può apparire al turista che già usa Tuggi nella tua via, con qualsiasi piano abbia.\"},\"cta\":{\"action\":\"Voglio apparire su Tuggi\"},\"FAQ\":{\"title\":\"Le domande che ci fanno più spesso\",\"q1\":\"Quanto costa?\",\"a1\":\"Apparire su Tuggi non costa nulla: ti registri, ti approviamo, esponi il QR Code e, dopo la valutazione, il tuo locale viene pubblicato, trovato e letto da ogni turista. Tuggi non trattiene nemmeno una parte delle tue vendite, e tu non paghi l'accesso di nessuno. Chi paga Tuggi è il turista. C'è una parte della partnership a pagamento, fuori da quell'elenco, e ne parliamo con te.\",\"q2\":\"Devo cambiare qualcosa nel mio lavoro?\",\"a2\":\"Due cose. Metti il QR Code dove il turista già guarda — sul menù, alla reception, sul bancone, sullo schienale del sedile — e ci racconti la storia del tuo locale, una volta sola. A parte questo, la partnership non richiede integrazione con il tuo sistema, né attrezzature, né software da far usare al tuo staff.\",\"q3\":\"Il mio locale entra davvero su Tuggi?\",\"a3\":\"Non è automatico, e preferiamo dirlo subito. Dopo l'approvazione della partnership, il nostro team valuta il tuo locale. Entrano luoghi permanenti, aperti al pubblico e con una storia propria da raccontare. Non serve essere famosi né antichi. Se manca qualcosa, te lo diciamo, e puoi correggere e ripresentare.\",\"q4\":\"E se il mio locale non entra?\",\"a4\":\"Resti partner. Il tuo QR Code, il turista attribuito a te e la tua partecipazione ai ricavi non dipendono da questo. Niente di quello che hai già sparisce.\",\"q5\":\"E se il mio ospite non parla italiano?\",\"a5\":\"Tuggi parla {contentLanguages} lingue con il turista. Quando il tuo locale è pubblicato, viene letto nella lingua di chi arriva. E chi ha la guida accesa lo ascolta nella stessa lingua. Produciamo la narrazione nel momento in cui qualcuno la chiede in quella lingua.\",\"q6\":\"Quanto ci guadagno?\",\"a6\":\"Il turista scarica Tuggi con il tuo QR Code e viene attribuito a te. Da lì in poi, ogni acquisto che fa entra nel calcolo della tua partecipazione ai ricavi. La percentuale si definisce in un accordo commerciale, ed è di questo che parliamo quando lasci il tuo contatto qui sotto.\"},\"form\":{\"title\":\"Il primo passo è una conversazione\",\"body\":\"Lasciaci il tuo contatto e ti rispondiamo sul canale che scegli, con quello che la partnership fa nel tuo caso. Lasciare il contatto non costa nulla e non ti impegna a nulla.\",\"allRequired\":\"Tutti i campi sono obbligatori.\",\"name\":\"Il tuo nome\",\"business\":\"Nome della tua attività\",\"businessType\":\"Tipo di attività\",\"businessTypePlaceholder\":\"Seleziona un'opzione\",\"businessTypeOther\":\"Altro\",\"channelLegend\":\"Come preferisci che ti contattiamo?\",\"channelWhatsapp\":\"WhatsApp\",\"channelEmail\":\"Email\",\"whatsappLabel\":\"Il tuo WhatsApp\",\"whatsappHint\":\"Con prefisso internazionale. Esempio: +39 320 000 0000.\",\"emailLabel\":\"La tua email\",\"emailHint\":\"Può essere l'indirizzo che usi tutti i giorni.\",\"sending\":\"Invio in corso…\",\"consent\":\"Autorizzo Tuggi a conservare questi dati e a contattarmi per telefono, WhatsApp o email — solo riguardo a questa partnership. Leggi l''<policy>Informativa sulla Privacy</policy>.\",\"consentLinkNewTab\":\"si apre in una nuova scheda\",\"errorSummary\":\"Controlla i campi segnalati qui sotto prima di inviare.\",\"errorName\":\"Scrivi il tuo nome.\",\"errorBusiness\":\"Scrivi il nome della tua attività.\",\"errorBusinessType\":\"Scegli il tipo di attività.\",\"errorWhatsapp\":\"Scrivi il numero con il prefisso internazionale — per esempio, +39 320 000 0000.\",\"errorEmail\":\"Scrivi un'email con @ e dominio — per esempio, nome@esempio.com.\",\"errorConsent\":\"Spunta l'autorizzazione perché possiamo contattarti.\",\"errorSend\":\"Non è stato possibile inviare adesso. Riprova tra poco: quello che hai scritto è ancora qui.\",\"successTitle\":\"Abbiamo ricevuto il tuo contatto.\",\"successBody\":\"Ti contattiamo sul canale che hai scelto, per capire come il turista arriva alla tua attività. La registrazione come partner vera e propria si fa dopo, dentro l'app Tuggi — e ti mostriamo come.\",\"noscript\":\"Senza JavaScript l'invio non funziona. Scrivi a {email} e ti rispondiamo.\"}},\"Segments\":{\"commercial\":{\"title\":\"Come funziona la tua partecipazione ai ricavi\",\"lead\":\"Offri Tuggi al tuo cliente. Quando acquista, una parte della vendita torna a te.\",\"note\":\"La percentuale è definita nell'accordo commerciale.\"},\"steps\":{\"title\":\"Come funziona la partnership\",\"s1Title\":\"Ti registri e noi approviamo\",\"s1Body\":\"La registrazione si fa nell'app Tuggi. Il nostro team verifica i dati e approva la partnership.\",\"s2Title\":\"Esponi il tuo QR Code\",\"s2Body\":\"Una volta approvato, ricevi il tuo QR Code e lo metti dove il turista si trova già: {place}. Chi scarica Tuggi con quel codice viene attribuito a te.\",\"s3Title\":\"La tua partecipazione ai ricavi\",\"s3Body\":\"Ogni acquisto del turista attribuito a te conta per la tua partecipazione ai ricavi. La percentuale è definita nell'accordo commerciale.\",\"s4Title\":\"Il tuo locale può entrare in Tuggi\",\"s4Body\":\"Approvata la partnership, il nostro team valuta se registrare il tuo locale come punto di interesse. È una decisione editoriale di Tuggi, e non è automatica. Entro {partnerTriageHours} ore dall'approvazione hai l'esito. E il tuo QR Code e la tua partecipazione ai ricavi non dipendono da questo.\",\"lead\":\"Dalla tua parte sono due cose: esporre il QR Code e raccontarci la storia del tuo locale. Il resto succede sul telefono del turista.\"},\"cta\":{\"title\":\"Raccontaci come il turista arriva da te\",\"body\":\"Ti rispondiamo con quello che la partnership fa nel tuo caso, senza impegno.\",\"action\":\"Parla con Tuggi\"},\"car-rental\":{\"hub\":{\"cardTitle\":\"Autonoleggio\",\"cardBody\":\"Il turista ritira l'auto e porta con sé la guida. Il QR Code sta al banco o dentro il veicolo.\"}},\"lodging\":{\"hub\":{\"cardTitle\":\"Strutture ricettive\",\"cardBody\":\"L'ospite arriva senza sapere cosa fare in città. Il QR Code sta alla reception o in camera.\"}},\"transfer\":{\"hub\":{\"cardTitle\":\"Transfer e taxi\",\"cardBody\":\"Dall'aeroporto all'hotel è la prima mezz'ora di viaggio. Il QR Code sta sullo schienale o sul finestrino.\"}},\"motorhome\":{\"hub\":{\"cardTitle\":\"Camper\",\"cardBody\":\"Chi viaggia in camper passa la giornata in strada. Il QR Code va alla consegna del veicolo, insieme alle chiavi.\"}},\"restaurants\":{\"hub\":{\"cardTitle\":\"Ristoranti\",\"cardBody\":\"Chi si siede a tavola ha tempo di ascoltare. Il QR Code sta sul menù o sul conto.\"}},\"receptive\":{\"hub\":{\"cardTitle\":\"Tour operator ed escursioni\",\"cardBody\":\"Il passeggero passa la giornata con te e vuole sentire quello che sta vedendo. Il QR Code sta sul voucher o al punto d'incontro.\"}}},\"Technology\":{\"Hero\":{\"eyebrow\":\"Panoramica dell'architettura\",\"title\":\"Infrastruttura di Audio Spaziale di Livello Enterprise.\",\"subtitle\":\"Costruita per scalabilità e resilienza.\"},\"Comparison\":{\"title\":\"Essere vicino non è averlo davanti\",\"subtitle\":\"Due modi di decidere quando comincia la storia. La differenza sta nella direzione in cui ti muovi.\",\"radiusLabel\":\"Raggio di prossimità\",\"radiusBody\":\"È lo standard del settore. Tutto ciò che rientra nel raggio conta allo stesso modo, compreso quello che ti sei già lasciato alle spalle. Il risultato è un elenco di ciò che esiste intorno a te.\",\"coneLabel\":\"Direzione del movimento\",\"coneBody\":\"È quello che fa Tuggi. La direzione in cui ti muovi sceglie un solo luogo: quello che hai davanti agli occhi. È la sua storia che ascolti, nel momento in cui compare.\"},\"Data\":{\"col2Title\":\"Serverless e Pronta per i Grandi Eventi.\",\"col2Desc\":\"Supportata da CDN globali e da un'architettura di edge computing, pronta a gestire enormi picchi di traffico durante eventi come i Mondiali o le Olimpiadi.\"}},\"Drive\":{\"Hero\":{\"title\":\"Audioguide Autoguidate, a Mani Libere.\",\"subtitle\":\"Niente scroll. Niente ricerche. Imposta la tua lingua e TUGGI riproduce racconti audio autoguidati su ogni luogo che attraversi — in auto, a piedi o in bici. A mani libere, offline, occhi sul paesaggio.\",\"downloadApp\":\"Scarica sull'App Store\",\"downloadPlay\":\"Scarica su Google Play\",\"animatorLabel\":\"In riproduzione\",\"animatorPoi\":\"Miradouro da Serra\",\"animatorAhead\":\"Alla tua destra\",\"stopGuide\":\"Ferma la Guida\",\"startGuide\":\"Avvia la Guida\",\"ccText\":\"Il Miradouro da Serra, a 847 metri sul livello del mare, offre una delle viste più mozzafiato della regione montana, con un panorama a 360° sulle valli e le vette circostanti...\"},\"Samples\":{\"tag\":\"Curatela Premium\",\"title\":\"Ascolta cosa sblocchi\",\"subtitle\":\"Ogni viaggio in auto, tour a piedi o percorso in bici prende vita con racconti che non troveresti mai da solo. Nessun itinerario fisso — la tua audioguida autoguidata parte automaticamente, esattamente a ogni punto di interesse.\"},\"Features\":{\"title\":\"Incluso in tutti i pass\",\"feat1Title\":\"Modalità 100% Offline\",\"feat1Desc\":\"Scarica il pacchetto della città in hotel. Zero costi di roaming dati in viaggio.\",\"feat3Title\":\"Audio Multilingue\",\"feat3Desc\":\"Narrazione ad alta fedeltà in {contentLanguages} lingue native.\"},\"Pricing\":{\"kicker\":\"Pass Tuggi\",\"title\":\"Consumi solo con la guida accesa.\",\"subtitle\":\"Le tue ore non scadono. Spegni la guida quando vuoi e riprendi al prossimo viaggio.\",\"anchor\":\"Meno di un singolo tour guidato — e racconta tutto il tuo viaggio.\",\"chip2\":\"Pagamento unico\",\"chip3\":\"Senza rinnovo automatico\",\"recommended\":\"CONSIGLIATO\",\"pass1Title\":\"10 ore\",\"pass1Desc\":\"una gita di un giorno\",\"pass1Action\":\"Acquista 10 ore nell'app\",\"pass2Title\":\"25 ore\",\"pass2Desc\":\"un weekend\",\"pass2Action\":\"Acquista 25 ore nell'app\",\"pass3Title\":\"45 ore\",\"pass3Desc\":\"un viaggio intero\",\"pass3Action\":\"Acquista 45 ore nell'app\",\"priceInStore\":\"Prezzo nello store\",\"passesNote\":\"Pagamento unico. Le ore di pass diversi si sommano.\",\"storeNoteWithPrice\":\"L'acquisto si fa dentro l'app. Questi sono i prezzi che l'App Store e Google Play applicano qui, e li confermi prima di pagare.\",\"storeNoteNoPrice\":\"L'acquisto si fa dentro l'app. Ogni paese ha il suo prezzo sull'App Store e su Google Play. Vedi l'importo esatto, nella tua valuta, prima di confermare.\",\"freeTitle\":\"Esplora\",\"freePrice\":\"Gratis\",\"free1\":\"Inizia con la guida completa: la attivi tu nell'app\",\"free2\":\"Poi l'app resta gratis con storie ogni giorno\",\"free3\":\"Senza carta\",\"freeAction\":\"Inizia gratis\"},\"Conversion\":{\"title\":\"Ogni luogo ha una storia. Inizia ad ascoltare oggi.\",\"downloadApp\":\"Scarica sull'App Store\",\"downloadPlay\":\"Scarica su Google Play\",\"qrCaption\":\"Inquadra con la fotocamera per scaricare\"},\"FAQ\":{\"title\":\"Domande Frequenti\",\"q1\":\"TUGGI è gratis?\",\"a1\":\"Sì. Inizia gratis, con storie ogni giorno. Per ascoltare senza limite giornaliero, un Pass Tuggi ti dà 10, 25 o 45 ore di utilizzo — pagamento unico, e le ore scorrono solo con la guida accesa.\",\"q2\":\"TUGGI funziona offline?\",\"a2\":\"Sì. Scarica un percorso in anticipo e ascolta senza segnale — senza costi di roaming.\",\"q3\":\"In cosa è diverso TUGGI da Google Maps o da un GPS?\",\"a3\":\"TUGGI non è un'app di navigazione. Funziona insieme al tuo navigatore e alla tua musica e riproduce racconti audio autoguidati sui luoghi che attraversi — a mani libere, senza schermo.\",\"q4\":\"Quali lingue supporta TUGGI?\",\"a4\":\"Audio in {contentLanguages} lingue, con sottotitoli sincronizzati così i viaggiatori sordi e con difficoltà uditive possono seguire ogni racconto.\",\"q5\":\"Posso usare TUGGI camminando o in bici?\",\"a5\":\"Sì — viaggi in auto, tour a piedi, percorsi in bici e viaggi in famiglia funzionano tutti.\",\"q6\":\"Devo guardare il telefono?\",\"a6\":\"No. L'audio parte automaticamente in base alla posizione, a mani libere e a schermo spento.\"},\"Accessibility\":{\"title\":\"Accessibilità completa\",\"body\":\"I sottotitoli sincronizzati con l'audio permettono ai viaggiatori sordi o con problemi di udito di seguire ogni storia. E poiché TUGGI è prima di tutto audio, i viaggiatori ipovedenti esplorano senza dover leggere.\"},\"PlansHero\":{\"title\":\"Scegli il tuo pass\",\"subtitle\":\"Scarica e inizia senza carta e senza abbonarti a nulla. La guida completa la attivi tu, dentro l'app — e poi l'app resta gratis, con storie ogni giorno.\",\"appStoreAlt\":\"Scarica TUGGI sull'App Store\",\"playStoreAlt\":\"Scarica TUGGI su Google Play\"},\"Comparison\":{\"title\":\"Come si confronta TUGGI\",\"colGuide\":\"Guida privata\",\"colAudio\":\"Tour audio tradizionali\",\"colTuggi\":\"TUGGI\",\"rowCost\":\"Costo\",\"costGuide\":\"Tariffa giornaliera della guida\",\"costAudio\":\"Si paga per tour, per città\",\"costTuggi\":\"Un pass, tutto il viaggio\",\"rowLang\":\"Lingue\",\"langGuide\":\"La lingua della guida\",\"langAudio\":\"Poche per tour\",\"langTuggi\":\"{contentLanguages} lingue\",\"rowRoute\":\"Percorso\",\"routeGuide\":\"L'itinerario della guida\",\"routeAudio\":\"Un percorso fisso da seguire\",\"routeTuggi\":\"Qualsiasi strada tu scelga\",\"rowDrive\":\"Alla guida\",\"driveAudio\":\"Tocca lo schermo a ogni tappa\",\"driveTuggi\":\"Automatico, mani libere\",\"rowOffline\":\"Offline\",\"offlineAudio\":\"Varia\",\"offlineTuggi\":\"Sempre\",\"rowCaptions\":\"Sottotitoli sincronizzati\",\"captionsAudio\":\"Raro\",\"captionsTuggi\":\"In ogni storia\",\"notApplicable\":\"Non applicabile\",\"footnote\":\"TUGGI funziona insieme alla tua app di navigazione e alla tua musica.\"},\"Sticky\":{\"text\":\"Inizia gratis — senza carta\",\"cta\":\"Scarica\"},\"PlansExplainer\":{\"title\":\"Come funzionano i Pass Tuggi\",\"p1\":\"Puoi usare TUGGI gratis: lo scarichi e la guida completa la sblocchi tu, con un tocco, dentro l'app — senza carta e senza abbonarti a nulla. Dopo, l'app resta gratuita con un numero limitato di storie al giorno, così esplori con calma prima di decidere.\",\"p2\":\"Quando vuoi ascoltare senza limite giornaliero, scegli un pass: 10 ore per una gita di un giorno, 25 per un weekend, 45 per un viaggio intero. Sono ore di utilizzo, non giorni sul calendario — il tempo scorre solo con la guida accesa, e quello che avanza aspetta il prossimo viaggio. Pagamento unico, senza rinnovo automatico.\",\"p3\":\"Ogni pass include mappe e audio 100% offline, sottotitoli sincronizzati e tutte le {contentLanguages} lingue. I prezzi variano per paese e vedi il prezzo esatto sull’App Store o su Google Play prima di confermare. Non viene addebitato nulla senza la tua conferma nello store.\"}},\"Contact\":{\"Hero\":{\"title\":\"Parla con TUGGI.\",\"subtitle\":\"Seleziona come possiamo aiutarti oggi per essere indirizzato al team giusto.\"},\"Triage\":{\"card1Title\":\"Città / Governo\",\"card1Desc\":\"Rappresento un comune o un'autorità regionale.\",\"card2Title\":\"Noleggio Auto / Flotta\",\"card2Desc\":\"Rappresento una flotta aziendale o un'agenzia di noleggio.\",\"card3Title\":\"Turista / Utente App\",\"card3Desc\":\"Sono un conducente o passeggero che ha bisogno di supporto per l'app.\"},\"B2G\":{\"fullName\":\"Nome Completo\",\"role\":\"Posizione / Ruolo Ufficiale\",\"city\":\"Comune / Nome della Città\",\"email\":\"Email di Lavoro\",\"emailError\":\"Usa un indirizzo email governativo ufficiale.\",\"cta\":\"Richiedi una Demo di City OS\"},\"B2B\":{\"fullName\":\"Nome Completo\",\"company\":\"Nome dell'Azienda\",\"email\":\"Email di Lavoro\",\"fleetSize\":\"Dimensione Stimata della Flotta\",\"fleetTarget\":\"Seleziona la dimensione della flotta\",\"emailError\":\"Usa un indirizzo email aziendale.\",\"cta\":\"Contatta le Vendite B2B\"},\"B2C\":{\"desc\":\"Hai bisogno di aiuto con il tuo viaggio? Il nostro team di supporto è pronto ad assisterti.\",\"cta\":\"Scrivi al Team di Supporto\"},\"Sidebar\":{\"hqTitle\":\"Sede Centrale\",\"hqValue\":\"San Paolo, SP, Brasile\",\"slaTitle\":\"SLA Vendite\",\"slaValue\":\"I nostri esperti enterprise rispondono di solito entro 24 ore lavorative.\",\"pressTitle\":\"Stampa, Partnership e Supporto\",\"pressValue\":\"suporte@tuggi.app\"},\"Success\":{\"title\":\"Richiesta ricevuta.\",\"body\":\"Grazie per il tuo interesse. Un nostro specialista ti contatterà a breve alla tua email aziendale.\",\"again\":\"Invia un altro messaggio\"}},\"Legal\":{\"Sidebar\":{\"title\":\"Legale e Conformità\",\"terms\":\"Termini di Utilizzo\",\"privacy\":\"Informativa sulla Privacy\",\"deletion\":\"Cancellazione dei Dati\",\"security\":\"SLA di Sicurezza\",\"accessibility\":\"Accessibilità e Inclusione\"},\"Terms\":{\"title\":\"Termini di Utilizzo\",\"lastUpdated\":\"Febbraio 2026\",\"intro\":\"Benvenuto su TUGGI. Creando un account, accedendo tramite piattaforme partner o utilizzando la nostra app, accetti espressamente i termini descritti di seguito.\",\"s1Title\":\"1. Idoneità e Creazione dell'Account\",\"s1Item1\":\"<strong>Età Minima:</strong> TUGGI è un'applicazione culturale ed educativa. L'età minima per creare un account e usare il servizio come ascoltatore è di 13 anni.\",\"s1Item2\":\"<strong>Responsabilità alla Guida:</strong> Se sei il conducente del veicolo, dichiari e garantisci di essere maggiorenne e di possedere la patente necessaria richiesta dalle leggi del tuo paese o stato per guidare.\",\"s1Item3\":\"<strong>Accuratezza dei Dati:</strong> Accetti di non creare account per conto di terzi o di usare identità false.\",\"s2Title\":\"2. La Regola d'Oro: Esclusione di Responsabilità sul Traffico (La Sicurezza Prima di Tutto)\",\"s2Item1\":\"<strong>TUGGI è stato progettato rigorosamente per operare in background (a mani libere).</strong>\",\"s2Item2\":\"<strong>Sei l'unico responsabile della guida del veicolo.</strong> L'app non sostituisce la tua attenzione alla strada, alla segnaletica o alle condizioni del traffico.\",\"s2Item3\":\"TUGGI Technologies, così come i suoi partner governativi e aziendali, declinano ogni responsabilità per incidenti, danni materiali/fisici o multe stradali subite durante l'uso dell'applicazione. Rispetta sempre le leggi locali sul traffico.\",\"s3Title\":\"3. Limitazioni della Tecnologia (Intelligenza Artificiale e GPS)\",\"s3Item1\":\"<strong>Segnali di Posizione:</strong> Il nostro motore di trigger spaziale dipende da segnali GPS di terze parti e da mappatura collaborativa (come OpenStreetMap). Non garantiamo un'accuratezza assoluta dei trigger nelle aree d'ombra della rete, come tunnel o valli profonde.\",\"s3Item2\":\"<strong>Contenuti Assistiti dall'IA:</strong> I nostri racconti audio sono compilati e generati usando una combinazione di curatela manuale e modelli avanzati di Intelligenza Artificiale (IA). Il contenuto narrato è di natura culturale ed educativa. TUGGI fornisce il contenuto \\\"così com'è\\\" e non garantisce un'accuratezza accademica, storica o geografica assoluta, e non è responsabile per eventuali discrepanze fattuali.\",\"s4Title\":\"4. Segnalazione e Correzione dei Contenuti (Safe Harbor)\",\"s4Text\":\"Ci impegniamo a mantenere un ambiente culturale rispettoso e accurato. Se trovi informazioni errate, imprecisioni culturali o se sei il proprietario di un luogo e desideri richiedere la rimozione di un Punto di Interesse (POI), usa la nostra pagina Contatti, scegliendo il profilo che ti corrisponde. Il nostro team esamina tutti i feedback e si riserva il diritto di correggere, modificare o rimuovere i trigger a propria esclusiva discrezione.\",\"s5Title\":\"5. Condotta Civica e Uso Pubblico\",\"s5Text\":\"Quando usi l'applicazione sui mezzi pubblici, sui percorsi pedonali o su veicoli condivisi, ti chiediamo di usare le cuffie o di ottenere il previo consenso degli altri passeggeri.\",\"s6Title\":\"6. Abbonamenti, Travel Pass e Rimborsi\",\"s6Item1\":\"<strong>Travel Pass:</strong> TUGGI offre diversi livelli di accesso: (a) i Pass da 7 e 30 giorni sono acquisti digitali una tantum e non si rinnovano automaticamente; (b) i Pass Annuali sono abbonamenti a rinnovo automatico.\",\"s6Item2\":\"<strong>Abbonamenti tramite App Store (Piano Annuale):</strong> Per gli abbonamenti a rinnovo automatico, il pagamento sarà addebitato sul tuo account dello Store alla conferma dell'acquisto. L'abbonamento si rinnova automaticamente a meno che il rinnovo automatico non venga disattivato almeno 24 ore prima della fine del periodo in corso. Il tuo account sarà addebitato per il rinnovo entro 24 ore prima della fine del periodo in corso. Puoi gestire o disattivare il rinnovo automatico nelle Impostazioni del tuo Account in qualsiasi momento dopo l'acquisto.\",\"s6Item3\":\"<strong>Legislazione Locale:</strong> Rispettiamo il diritto di recesso di 7 giorni (Codice di Difesa del Consumatore brasiliano - CDC), applicabile solo quando l'acquisto è elaborato direttamente tramite i nostri sistemi web, e rigorosamente se il servizio digitale non è stato parzialmente o totalmente consumato (uso dei trigger audio).\",\"s7Title\":\"7. Giurisdizione e Foro Competente\",\"s7Text\":\"I presenti Termini di Utilizzo sono regolati dalle leggi della Repubblica Federativa del Brasile. I tribunali del Distretto di San Paolo, Stato di San Paolo, sono eletti per risolvere qualsiasi controversia derivante dall'uso di TUGGI, con espressa rinuncia a qualsiasi altro.\",\"s8Title\":\"8. Apple App Store e Google Play Store (Clausole Obbligatorie)\",\"s8Item1\":\"<strong>Riconoscimento:</strong> Riconosci che i presenti Termini sono conclusi solo tra te e TUGGI, e non con Apple o Google. TUGGI è l'unica responsabile dell'Applicazione e dei suoi contenuti.\",\"s8Item2\":\"<strong>Manutenzione e Supporto:</strong> Riconosci che Apple e Google non hanno alcun obbligo di fornire servizi di manutenzione e supporto in relazione all'Applicazione.\",\"s8Item3\":\"<strong>Garanzia e Rimborsi:</strong> In caso di mancata conformità dell'Applicazione a qualsiasi garanzia applicabile, l'unico obbligo di Apple/Google è il rimborso del prezzo di acquisto. Nella misura massima consentita dalla legge, Apple/Google non avranno alcun altro obbligo di garanzia.\",\"s8Item4\":\"<strong>Reclami sul Prodotto e Proprietà Intellettuale:</strong> TUGGI, e non Apple o Google, è responsabile della gestione di eventuali reclami relativi all'Applicazione (es. responsabilità per il prodotto, conformità legale) e dell'indagine, difesa, transazione e risoluzione di qualsiasi reclamo di terzi per violazione della proprietà intellettuale.\",\"s8Item5\":\"<strong>Conformità Legale:</strong> Dichiari e garantisci che (i) non ti trovi in un paese soggetto a un embargo del Governo degli Stati Uniti o designato come paese “che sostiene il terrorismo”; e (ii) non sei incluso in alcun elenco del Governo degli Stati Uniti di parti vietate o soggette a restrizioni.\",\"s8Item6\":\"<strong>Beneficiario Terzo:</strong> Riconosci e accetti che Apple e Google, e le loro controllate, sono beneficiari terzi dei presenti Termini e hanno il diritto di farli valere nei tuoi confronti.\",\"s9Title\":\"9. Informazioni di Contatto dello Sviluppatore\",\"s9Text\":\"TUGGI Technologies Ltda. San Paolo, SP, Brasile. Email: suporte@tuggi.app\"},\"Privacy\":{\"title\":\"Informativa sulla Privacy\",\"lastUpdated\":\"Agosto/2026\",\"intro\":\"TUGGI Technologies tiene alla tua privacy. La presente informativa descrive come raccogliamo, usiamo, proteggiamo e gestiamo i tuoi dati, nel pieno rispetto della Legge Generale sulla Protezione dei Dati (LGPD - Brasile) e del Regolamento Generale sulla Protezione dei Dati (GDPR - Unione Europea).\",\"s1Title\":\"1. Dati che Raccogliamo\",\"s1Intro\":\"Affinché TUGGI funzioni come il tuo copilota culturale, raccogliamo le informazioni qui sotto. L'elenco non si ferma all'app. Comprende anche i dati di chi contatta Tuggi per una partnership, anche senza aver mai avuto un account.\",\"s1Item1\":\"<strong>Dati di Account e Autenticazione:</strong> Quando crei un account tramite email o provider partner (Google, Apple, Facebook), riceviamo dati di profilo di base (Nome, Email e ID utente generato dalla nostra infrastruttura sicura Supabase).\",\"s1Item2\":\"<strong>Dati di Geolocalizzazione (GPS):</strong> TUGGI richiede l'accesso alla posizione in tempo reale (anche in background) per attivare l'audio esattamente quando attraversi un Punto di Interesse (POI).\",\"s1Item3\":\"<strong>Dati di Utilizzo e Telemetria:</strong> Raccogliamo informazioni sulle interazioni con l'applicazione, come quali audio sono stati riprodotti, le lingue selezionate e le metriche di stabilità del sistema.\",\"s1Item4\":\"<strong>Dati di Contatto Commerciale:</strong> Quando lasci un contatto nel modulo della pagina partnership di questo sito, conserviamo quello che hai scritto lì. Sono il tuo nome, il nome della tua attività, il tipo di attività e il canale che hai scelto, numero WhatsApp o email. Conserviamo anche la lingua in cui era la pagina. La città approssimativa arriva dalla tua connessione, e insieme al tuo contatto conserviamo quella città, non l'indirizzo IP. Usiamo questi dati per una sola finalità, che è parlare con te della partnership, con una telefonata o con un messaggio. Sono al massimo 4 tentativi di contatto, entro 14 giorni dall'invio. Il ciclo si chiude con quello che arriva prima, e dopo non usiamo più il tuo contatto per questo. Per riprendere, basta inviare di nuovo il modulo. Non usiamo mai questo contatto per newsletter, liste broadcast o campagne di marketing. Puoi chiederci di rimuoverlo quando vuoi, e la sezione 5 spiega come.\",\"s1Item5\":\"$3\",\"s1Item6\":\"<strong>La Storia del Luogo:</strong> In quello stesso modulo facciamo fino a quattro domande sulla storia del luogo, e le risposte sono testo libero. Non sono materiale interno e non sono riservate. Sono la materia prima del testo che l'app può raccontare a chi viaggia, riscritto da noi e tradotto nelle lingue dell'app. Quindi scrivi lì solo quello che accetti di vedere pubblicato, compreso il nome di qualcuno che citi.\",\"s1Item7\":\"<strong>Registro dell'Accettazione del Contratto:</strong> Quando qualcuno accetta il contratto di partnership sullo schermo, conserviamo il registro di quell'atto. Contiene il nome e il ruolo di chi ha accettato, l'email a cui abbiamo mandato il link, la data e l'ora del nostro server, l'indirizzo IP della connessione, l'identificazione che dichiara il browser, il codice del documento mostrato e la versione del modello. Qui l'indirizzo IP resta conservato così come è, e non trasformato in un codice, perché la finalità è un'altra. Questo registro serve a una cosa sola, cioè provare chi ha accettato il contratto, che cosa ha accettato, quando e da dove. Non alimenta nessuna metrica, non serve per il contatto, e resta conservato come prova del contratto.\",\"s1Item8\":\"$4\",\"s2Title\":\"2. Come Usiamo i Tuoi Dati (Telemetria Anonimizzata)\",\"s2Item1\":\"<strong>Funzionamento del Servizio:</strong> Usiamo la tua posizione esclusivamente per calcolare il vettore di direzione e la prossimità ai trigger culturali, garantendo la riproduzione dell'audio al momento giusto.\",\"s2Item2\":\"<strong>Intelligenza Territoriale (Lo Standard B2G):</strong> I dati di geolocalizzazione e di riproduzione audio sono <strong>scollegati dalla tua identità personale (anonimizzati)</strong> prima di essere archiviati per l'analisi dei flussi. Forniamo report aggregati a Governi e Società di Noleggio (es. \\\"Quante riproduzioni sono avvenute al monumento X oggi\\\") senza mai rivelare chi fosse l'utente. In quei report tracciamo i flussi culturali, non gli individui.\",\"s3Title\":\"3. Condivisione dei Dati\",\"s3Item1\":\"<strong>Non vendiamo i tuoi dati.</strong> TUGGI non commercia Informazioni di Identificazione Personale (PII) con data broker o reti pubblicitarie.\",\"s3Item2\":\"Oltre al caso descritto qui sotto, condividiamo i dati solo con i fornitori di infrastruttura strettamente necessari al funzionamento dell'app, come i servizi cloud sicuri (es. Supabase per database/autenticazione e Google Cloud per il motore Text-to-Speech). Questi partner operano sotto rigorosi accordi di riservatezza.\",\"s3Item3\":\"<strong>L'Identificativo della Visita al Partner:</strong> Su Android, quell'identificativo viaggia dentro il link di Google Play, quindi Google lo riceve quando vai a installare l'app dallo store. È un codice dalla nostra parte, e non porta il tuo nome né la tua email. Su iPhone quella strada non esiste. Lì copiamo lo stesso identificativo negli appunti del tuo dispositivo, nell'istante in cui tocchi il pulsante, perché l'app lo legga quando apre la prima volta.\",\"s4Title\":\"4. Sicurezza e Conservazione\",\"s4Item1\":\"Impieghiamo la crittografia end-to-end in transito e a riposo. L'accesso ai database aziendali e al dashboard City OS è protetto da Controllo degli Accessi Basato sui Ruoli (RBAC), garantendo l'isolamento dei dati.\",\"s4Item2\":\"Conserviamo i tuoi dati personali solo per il tempo necessario a fornire il servizio. I dati di telemetria anonimizzati possono essere conservati in modo permanente per il miglioramento del prodotto.\",\"s5Title\":\"5. I Tuoi Diritti (LGPD e GDPR)\",\"s5Intro\":\"Hai il pieno controllo sui tuoi dati. In qualsiasi momento, puoi richiedere:\",\"s5Item1\":\"L'accesso, la correzione o la portabilità delle tue informazioni.\",\"s5Item2\":\"La revoca del consenso all'uso del GPS (che renderà impossibile la funzionalità principale dell'app).\",\"s5ItemO1\":\"<strong>La cancellazione permanente del tuo account e dei tuoi dati personali.</strong> Per esercitare questo diritto, accedi alla nostra \",\"s5ItemO2\":\"Pagina di Cancellazione dei Dati\",\"s5ItemO3\":\" o usa la funzione nativa all'interno dell'app.\",\"s5ItemLead1\":\"<strong>La rimozione del contatto commerciale che hai lasciato in un modulo del sito</strong>, anche se non hai mai avuto un account nell'app. Scrivi a \",\"s5ItemLeadEmail\":\"suporte@tuggi.app\",\"s5ItemLead2\":\" chiedendo la rimozione: chiudiamo il contatto in corso e cancelliamo i tuoi dati dal nostro elenco di contatti commerciali. La pagina di cancellazione dei dati serve solo per gli account dell'app.\",\"s5ItemPartner1\":\"<strong>La rimozione dei dati che hai inviato in una proposta di partnership</strong>, per quello che non è necessario alla partnership in corso. Scrivi a \",\"s5ItemPartner2\":\" dicendo che cosa vuoi rimuovere. Se chiedi di non essere più contattato, il contatto si ferma subito. Il registro dell'accettazione di un contratto già firmato si conserva come prova, e una richiesta di rimozione del contatto non cancella quel registro.\",\"s6Title\":\"6. Contattare il Responsabile della Protezione dei Dati (DPO)\",\"s6P1\":\"Se hai domande su questa informativa o sul trattamento dei tuoi dati, contatta il nostro Responsabile della Protezione dei Dati (DPO) tramite la nostra pagina \",\"s6P2\":\"Contatti\",\"s6P3\":\", scegliendo il profilo che ti corrisponde.\",\"s7Title\":\"7. Privacy dei Minori\",\"s7Text\":\"TUGGI non raccoglie consapevolmente dati da bambini di età inferiore a 13 anni senza il consenso dei genitori. Se scopriamo di aver raccolto tali dati, adotteremo misure per cancellarli immediatamente.\"},\"DataDeletion\":{\"title\":\"Protocollo di Cancellazione dei Dati\",\"intro\":\"Hai il controllo assoluto sui tuoi dati di telemetria e sui record del tuo account. In TUGGI, garantiamo che il tuo diritto all'oblio sia rispettato su tutta la nostra infrastruttura.\",\"formTitle\":\"Richiedi la Cancellazione dell'Account\",\"formDesc\":\"Inserisci l'email del tuo account qui sotto. Il nostro team esaminerà la tua richiesta ed elaborerà la cancellazione entro 24-48 ore lavorative. Riceverai un'email di conferma una volta completato il processo.\",\"s1Title\":\"Cosa succede ai miei dati?\",\"s1Desc\":\"Quando esegui una richiesta di cancellazione:\",\"s1Item1\":\"Il profilo del tuo account e le credenziali di accesso vengono rimossi in modo permanente dal nostro provider di autenticazione.\",\"s1Item2\":\"Tutti gli identificatori dei dispositivi collegati alle tue sessioni precedenti vengono cancellati dal nostro database di telemetria.\",\"s1Item3\":\"Eventuali dati di flusso anonimizzati generati in precedenza rimangono nell'aggregato, ma non potranno mai essere ri-associati alla tua identità.\",\"Form\":{\"placeholder\":\"tua@email.com\",\"submit\":\"Richiedi la Cancellazione dei Dati\",\"success\":\"Richiesta Ricevuta - Ti contatteremo entro 48h\"}},\"Security\":{\"title\":\"Governance, Sicurezza e Disponibilità\",\"subtitle\":\"Un Impegno di Fiducia.\",\"s1Title\":\"1. Curatela Globale TUGGI\",\"s1Desc\":\"TUGGI mantiene la sua curatela standard tramite CMS, usando fonti verificate e intelligenza artificiale.\",\"s2Title\":\"2. Audit Log e Integrità (Sicurezza Istituzionale)\",\"s2Item1\":\"<strong>Custodia delle Informazioni:</strong> TUGGI agisce come custode tecnico della piattaforma. Ogni modifica a un trigger audio, sia fatta da TUGGI sia da un partner governativo, viene registrata in audit log immutabili (RBAC), rendendo possibile tracciare chi, quando e dove una narrazione è stata modificata.\",\"s3Title\":\"3. Affidabilità e Prestazioni (Per l'Utente B2C)\",\"s3Intro\":\"Per il viaggiatore, l'affidabilità si misura nell'uso. Con i contenuti già scaricati, l'audio parte da solo, anche dove il segnale non arriva:\",\"s3Item1\":\"<strong>Disponibilità Offline-First:</strong> Abbiamo progettato TUGGI per non dipendere dal cloud nel momento dell'attivazione. Una volta scaricato il pacchetto di viaggio, l'attivazione dell'audio è locale e immediata.\",\"s4Title\":\"4. Infrastruttura Globale\",\"s4Desc\":\"I nostri dati sono ospitati in data center di livello mondiale con crittografia AES-256 a riposo e TLS 1.3 in transito. Usiamo Supabase per la gestione dell'identità e Google Cloud per l'elaborazione audio.\"},\"Accessibility\":{\"title\":\"Accessibilità e Inclusione\",\"subtitle\":\"Impegno per l'Inclusione e il Design Universale.\",\"intro\":\"In TUGGI Technologies, crediamo che l'accesso alla cultura e alla storia locale non debba avere barriere. TUGGI è stato concepito secondo la premessa \\\"Audio-First\\\", trasformando l'esperienza di scoperta in qualcosa di puramente sensoriale e uditivo, che naturalmente avvantaggia gli utenti con diversi profili di accessibilità.\",\"s1Title\":\"1. Linee guida tecniche che seguiamo (WCAG 2.1)\",\"s1Intro\":\"Ci impegniamo a garantire che la nostra piattaforma digitale e la nostra app mobile seguano le Linee Guida per l'Accessibilità dei Contenuti Web (WCAG) 2.1, a Livello AA.\",\"s1Item1\":\"<strong>Design visivo:</strong> Abbiamo misurato la palette di questo sito rispetto al minimo di contrasto del livello AA delle WCAG 2.1, la soglia che mantiene il testo leggibile per chi ha ipovisione (audit: {a11ySiteAuditDate}). Sui colori del brand, testo e icone usano il colore scuro della palette, e il carattere tipografico è Inter.\",\"s1Item2\":\"<strong>Navigazione:</strong> La nostra interfaccia è strutturata per essere compatibile con i lettori di schermo (come VoiceOver su iOS e TalkBack su Android).\",\"s2Title\":\"2. Funzioni di Inclusione in TUGGI\",\"s2Intro\":\"Il nostro prodotto è progettato per essere accessibile sia ai conducenti sia ai passeggeri:\",\"s2Item1\":\"<strong>Esperienza Audio-First:</strong> Eliminiamo la necessità di interazione visiva o tattile con lo schermo durante il viaggio. I racconti partono automaticamente tramite geolocalizzazione, permettendo alle persone ipovedenti e a quelle con mobilità ridotta di godere dei contenuti in autonomia.\",\"s2Item2\":\"<strong>Sottotitoli:</strong> Per i passeggeri con difficoltà uditive, TUGGI offre una trascrizione sincronizzata in tempo reale. Mentre l'audio è in riproduzione, il testo della narrazione viene visualizzato sullo schermo, garantendo che nessuno perda il contesto culturale del percorso.\",\"s2Item3\":\"<strong>Accessibilità Linguistica:</strong> Offriamo supporto multilingue in {contentLanguages} lingue, garantendo che la barriera linguistica non sia un ostacolo alla conoscenza.\",\"s3Title\":\"3. Canale di Feedback e Miglioramento Continuo\",\"s3Intro\":\"L'accessibilità è un processo continuo. Riconosciamo che c'è sempre margine di miglioramento e siamo pronti ad ascoltare i nostri utenti.\",\"s4Title\":\"4. Inclusione Culturale e Impatto Sociale\",\"s4Desc\":\"Oltre all'accessibilità tecnica, TUGGI agisce come agente di inclusione sociale. Democratizziamo l'accesso alla cultura decentralizzando il turismo. Reindirizzando il flusso dalle aree sature verso le zone periferiche, sosteniamo l'economia creativa locale, dando voce agli storici, agli attori e alle guide locali che costruiscono i nostri racconti.\",\"s3Item1\":\"<strong>Segnala una Barriera:</strong> Se incontri difficoltà di accesso sul nostro sito web o nell'app, raccontaci in quale pagina o schermata è successo, che cosa stavi cercando di fare e con che cosa navighi, come screen reader, tastiera o ingrandimento.\",\"s3Item2\":\"<strong>Impegno:</strong> Analizziamo ogni segnalazione con priorità tecnica per garantire che TUGGI continui a essere il copilota culturale per tutti, senza eccezioni.\",\"contactIntro\":\"Per segnalare una barriera, scrivi a:\",\"contactEmail\":\"suporte@tuggi.app\"}},\"CookieBanner\":{\"text\":\"Usiamo i cookie per misurare il pubblico di questo sito, e anche per sapere quale partner ti ha portato all'app, perché è così che paghiamo quel partner. Cliccando su 'Accetta', dai il consenso a questi due usi.\",\"accept\":\"Accetta\",\"decline\":\"Rifiuta\"},\"Purpose\":{\"Hero\":{\"title\":\"Prima di vedere, ascoltiamo.\",\"body\":\"L'udito è il nostro senso più antico e fondamentale. Prima ancora di nascere, riconosciamo il mondo attraverso il suono della voce di nostra madre. Impariamo ad ascoltare prima di imparare a parlare, leggere o camminare. TUGGI è nato da questa verità biologica: il modo più naturale di assorbire il mondo intorno a noi non è fissare uno schermo, ma ascoltarlo.\"},\"Freedom\":{\"title\":\"La Libertà di Esplorare.\",\"body\":\"Il turismo è rimasto intrappolato in orari rigidi, autobus affollati e barriere linguistiche. Crediamo che l'esplorazione debba essere libertà assoluta. Non dovresti aspettare una guida turistica o tenere gli occhi incollati a un'app di mappe. Con TUGGI, guidi, cammini o pedali al tuo ritmo. I racconti ti trovano nell'esatto momento geografico in cui contano.\"},\"Values\":{\"title\":\"Le Fondamenta\",\"v2Title\":\"Semplicità Operativa.\",\"v2Desc\":\"Avvia il percorso e l'app pensa al resto.\",\"v3Title\":\"Rispetto Contestuale.\",\"v3Desc\":\"Racconti profondamente connessi al percorso fisico e alla coerenza narrativa.\",\"v4Title\":\"Precisione e Affidabilità.\",\"v4Desc\":\"Esecuzione geografica con tempismo perfetto.\",\"v5Title\":\"Curatela Culturale.\",\"v5Desc\":\"Saltiamo le banalità per offrire le gemme nascoste e la vera conoscenza locale.\",\"v6Title\":\"Accessibilità Universale.\",\"v6Desc\":\"Progettata per essere fruita da profili diversi e in lingue native.\"},\"Manifesto\":{\"quote\":\"“Il mondo è migliore quando smettiamo di guardarlo dal finestrino e cominciamo a sentirlo respirare.”\"}},\"NotFound\":{\"title\":\"Territorio Inesplorato\",\"subtitle\":\"Hai la totale libertà di andare ovunque e la nostra app funziona offline, ma sembra che tu abbia scoperto una pagina che non abbiamo ancora mappato.\",\"backHome\":\"Torna alla Civiltà\",\"support\":\"Segnala al Supporto\"},\"Metadata\":{\"rootTitle\":\"TUGGI — Audioguida di Viaggio\",\"rootDescription\":\"TUGGI ti racconta la storia di un luogo ad alta voce appena ti avvicini. Funziona offline, in {contentLanguages} lingue, gratis su iOS e Android.\",\"homeTitle\":\"Audioguida di Viaggio — Storie che Partono Mentre Passi | TUGGI\",\"homeDescription\":\"TUGGI ti racconta la storia di ogni luogo ad alta voce mentre passi, comunque tu viaggi. Un'audioguida di viaggio autoguidata, offline e nella tua lingua. Inizia gratis.\",\"driveTitle\":\"Pass Tuggi — ore di guida che non scadono\",\"driveDescription\":\"Inizia gratis, senza carta: la guida completa la attivi dentro l'app. Poi pass da 10, 25 o 45 ore di utilizzo — pagamento unico, e le ore non scadono.\",\"techTitle\":\"Come Funziona TUGGI - Audio Attivato dal GPS, Offline\",\"techDescription\":\"Dentro TUGGI: come il GPS attiva ogni storia, come capisce da che lato stai passando e come continua a suonare offline su iOS e Android.\",\"purposeTitle\":\"Il Nostro Scopo\",\"purposeDescription\":\"Abbiamo creato TUGGI con un'idea sola: ogni luogo ha una storia che vale la pena ascoltare, e tutti dovrebbero poterlo fare, nella propria lingua e senza mani.\",\"contactTitle\":\"Contattaci\",\"contactDescription\":\"Una domanda sull'app, una flotta, una destinazione o la stampa? Il team di TUGGI è qui per aiutarti.\",\"trustCenterTitle\":\"Trust Center\",\"trustCenterDescription\":\"Legale e Conformità\",\"termsTitle\":\"Termini di Utilizzo\",\"termsDescription\":\"Termini e condizioni dei nostri servizi\",\"privacyTitle\":\"Informativa sulla Privacy\",\"privacyDescription\":\"Come trattiamo i tuoi dati\",\"deletionTitle\":\"Cancellazione dei Dati\",\"deletionDescription\":\"Richiedi la cancellazione dei tuoi dati\",\"securityTitle\":\"SLA di Sicurezza\",\"securityDescription\":\"I nostri impegni sulla sicurezza\",\"accessibilityTitle\":\"Accessibilità e Inclusione\",\"accessibilityDescription\":\"Politiche di accessibilità\",\"homeOgImageAlt\":\"TUGGI: audioguida di viaggio autoguidata\"},\"SEO_CITY_OS\":{\"title\":\"Audioguide Multilingue per Destinazioni Intelligenti\",\"description\":\"Ogni visitatore ascolta le storie della tua destinazione, nella sua lingua, mentre esplora. Accessibile, in tutto il territorio.\",\"ogTitle\":\"TUGGI City OS: La Tua Destinazione, Narrata per Ogni Visitatore\",\"ogImageAlt\":\"TUGGI City OS: infrastruttura per destinazioni turistiche intelligenti\"},\"SEO_FLEETS\":{\"title\":\"Audioguide a Bordo per Flotte di Noleggio e Transfer\",\"description\":\"Trasforma noleggi e transfer in un viaggio da ricordare. Il passeggero ascolta una guida locale nella sua lingua, senza installare nulla.\",\"ogTitle\":\"TUGGI Flotte: Un'Audioguida per Ogni Passeggero\",\"ogImageAlt\":\"TUGGI Flotte: partecipazione ai ricavi per autonoleggi e transfer\"},\"SEO_PURPOSE\":{\"title\":\"Il Nostro Scopo — Perché Ogni Luogo Merita di Essere Ascoltato\",\"description\":\"Abbiamo creato TUGGI con un'idea sola: ogni luogo ha una storia che vale la pena ascoltare, e tutti dovrebbero poterlo fare, nella propria lingua e senza mani.\",\"ogTitle\":\"TUGGI: Perché Ogni Luogo Merita di Essere Ascoltato\",\"ogImageAlt\":\"TUGGI: il manifesto dell'audio\"},\"SEO_COVERAGE\":{\"title\":\"Destinazioni Attive — Scegli Dove Esplorare\",\"description\":\"TUGGI è attivo in {coverageCountries} paesi e oltre {mappedPointMillions} milioni di punti di interesse — Italia, Spagna, Portogallo, Brasile, Cile, USA e altro ancora. I racconti audio partono automaticamente nel momento in cui inizi a esplorare.\",\"ogTitle\":\"TUGGI Attivo in {coverageCountries} Paesi — Oltre {mappedPointMillions} Milioni di Punti Mappati\",\"ogImageAlt\":\"Mappa di copertura globale di TUGGI: punti mappati in tutto il mondo\",\"ogEyebrow\":\"Copertura globale\",\"ogHeadline\":\"Punti mappati in tutto il mondo\",\"ogStatCountries\":\"Paesi\",\"ogStatRegions\":\"Regioni\",\"ogCountryList\":\"Copertura per paese\"},\"Coverage\":{\"Hero\":{\"tag\":\"Destinazioni Live\",\"title\":\"Scegli una destinazione. I tuoi racconti sono pronti.\",\"subtitle\":\"TUGGI è attivo in {coverageCountries} paesi — Italia, Spagna, Portogallo, Brasile, Cile, USA e altro ancora. Seleziona un paese qui sotto — l'audio parte automaticamente nel momento in cui inizi a esplorare.\"},\"Stats\":{\"countries\":\"Paesi Attivi\",\"points\":\"Punti Mappati\",\"regions\":\"Regioni Coperte\"},\"Density\":{\"sectionTitle\":\"Dove TUGGI è già presente\",\"sectionSubtitle\":\"Più l'area è chiara, maggiore è la densità di punti mappati in quella regione.\",\"filterAll\":\"Tutti i paesi\",\"legendTitle\":\"Densità di copertura\",\"legend\":{\"lowest\":\"Copertura iniziale\",\"low\":\"Copertura moderata\",\"high\":\"Copertura alta\",\"highest\":\"Copertura più densa\"},\"listTitle\":\"Tutte le destinazioni, regione per regione\",\"listIntro\":\"L'elenco completo di ciò che la mappa disegna — e le regioni che restano fuori dall'inquadratura. Dove esiste già un itinerario audio, il nome della regione porta a quello.\",\"countryListTitle\":\"Controlla se la tua destinazione è già sulla mappa\",\"countryListIntro\":\"L'elenco completo, regione per regione, è nella pagina di copertura.\",\"countryListCta\":\"Vedi la copertura completa\",\"group\":{\"americas\":\"Americhe\",\"europe\":\"Europa\",\"other\":\"Altre destinazioni\"},\"outOfFrame\":\"Fuori dall'inquadratura della mappa: {regions}.\"},\"CTA\":{\"title\":\"Porta TUGGI nella tua città.\",\"description\":\"Collaboriamo con città, destinazioni e aziende di viaggio in tutto il mondo. Se la tua regione non è ancora sulla mappa — cambiamo le cose.\",\"button\":\"CONTATTACI\"}},\"Coupon\":{\"block_title\":\"Regalo speciale\",\"block_subtitle\":\"Ricevi {days} giorni di Tuggi Premium gratis\",\"code_label\":\"Il tuo codice\",\"copy\":\"Copia il codice\",\"copied\":\"Codice copiato!\",\"open_app\":\"Riscatta nell'app\",\"desktop_hint\":\"Non hai ancora l'app? Usa i pulsanti qui sotto per installarla e riscattare.\"},\"Tours\":{\"heroTag\":\"Audioguida Autoguidata\",\"heroSubtitle\":\"Audioguida autoguidata · {place}\",\"heroCtaPrimary\":\"Ascolta nell'app Tuggi\",\"heroCtaSecondary\":\"Vedi la mappa\",\"facts\":{\"duration\":\"Durata\",\"distance\":\"Distanza\",\"stops\":\"Tappe\",\"drivability\":\"Difficoltà\",\"accessibility\":\"Accessibilità\",\"bestTime\":\"Periodo migliore\",\"languages\":\"Lingue\",\"varies\":\"Variabile\"},\"drivability\":{\"easy\":\"Facile\",\"moderate\":\"Moderata\",\"demanding\":\"Impegnativa\",\"unknown\":\"—\"},\"accessibility\":{\"accessible\":\"Accessibile\",\"partial\":\"Parzialmente accessibile\",\"not_accessible\":\"Non accessibile\",\"unknown\":\"—\"},\"bestTime\":{\"morning\":\"Mattina\",\"afternoon\":\"Pomeriggio\",\"sunset\":\"Tramonto\",\"evening\":\"Sera\",\"night\":\"Notte\",\"anytime\":\"Qualsiasi ora\"},\"itineraryTitle\":\"Cosa vedrai e ascolterai\",\"itinerarySubtitle\":\"Le tappe di questo percorso, in ordine — con anteprime audio dove disponibili.\",\"audioPreview\":\"Anteprima audio\",\"faqTitle\":\"Domande frequenti\",\"faq\":{\"duration\":{\"q\":\"Quanto dura questo tour?\",\"a\":\"Circa {duration} di audio in {stops} tappe, coprendo all'incirca {distance}. Vai al tuo ritmo — l'audio parte automaticamente mentre ti muovi.\"},\"accessibility\":{\"q\":\"Questo tour è accessibile?\",\"a\":\"Questo percorso è classificato come: {level}. Controlla ogni tappa per i dettagli specifici di accesso.\"},\"languages\":{\"q\":\"In quali lingue è disponibile?\",\"a\":\"Questo tour è disponibile in: {languages}.\"},\"offline\":{\"q\":\"Mi serve una connessione internet?\",\"a\":\"No. Scarica il tour nell'app Tuggi e ascolta offline — l'audio si attiva in base alla tua posizione, a mani libere.\"},\"mode\":{\"q\":\"Posso farlo a piedi o in auto?\",\"a\":\"Questo percorso è pensato per un viaggio {level}. L'audio si adatta al tuo ritmo.\"}},\"relatedTitle\":\"Altri tour nelle vicinanze\",\"stopsCount\":\"{count, plural, one {# tappa} other {# tappe}}\",\"stopsMerged\":\"Tappe {from}–{to}\",\"breadcrumbTours\":\"Audioguide\",\"metaTitle\":\"{name} — Audioguida Autoguidata\",\"metaDescFallback\":\"Un'audioguida autoguidata a {place} con Tuggi. Racconti che partono automaticamente mentre esplori.\",\"ctaTitle\":\"Ascolta tutta la storia\",\"ctaSubtitle\":\"Scarica l'app Tuggi e lascia che ogni tappa prenda vita — a mani libere, offline, nella tua lingua.\",\"ctaButton\":\"Scarica l'app Tuggi\",\"countryIn\":{\"BR\":\"in Brasile\",\"ES\":\"in Spagna\",\"FR\":\"in Francia\",\"GB\":\"nel Regno Unito\",\"IT\":\"in Italia\",\"PT\":\"in Portogallo\",\"US\":\"negli Stati Uniti\"},\"countryMetaTitle\":\"Audioguide Autoguidate {inCountry}\",\"countryMetaDesc\":\"Esplora audioguide autoguidate {inCountry} con Tuggi — mappe, anteprime audio reali e info pratiche per ogni percorso.\",\"countryTitle\":\"Audioguide Autoguidate {inCountry}\",\"countrySubtitle\":\"{count, plural, one {# percorso selezionato} other {# percorsi selezionati}} {inCountry}, ognuno con mappa, tappe e anteprime audio reali.\",\"hubMetaTitle\":\"Audioguide Autoguidate\",\"hubMetaDesc\":\"Sfoglia le audioguide autoguidate di Tuggi per paese — percorsi selezionati con mappe, tappe e anteprime audio reali.\",\"hubTitle\":\"Audioguide Autoguidate\",\"hubSubtitle\":\"Percorsi selezionati che partono automaticamente mentre esplori — sfoglia per paese.\",\"hubEmpty\":\"Questa lista è vuota nella tua lingua. Nell'app, la narrazione segue la lingua che usi — è il tuo percorso a creare l'audio.\",\"viewAllInCountry\":\"Vedi tutti i {count}\",\"themes\":{\"historical\":\"Storico\",\"urban\":\"Urbano\",\"nature\":\"Natura\",\"panoramic\":\"Panoramico\",\"cultural\":\"Culturale\",\"scenic\":\"Scenico\",\"coastal\":\"Costiero\",\"religious\":\"Religioso\",\"gastronomic\":\"Gastronomia\",\"rural\":\"Campagna\"},\"languagesCount\":\"{count, plural, one {# lingua} other {# lingue}}\",\"statesNavLabel\":\"Stati con percorsi\",\"stateMetaTitle\":\"{state} — Audioguide Autoguidate\",\"stateMetaDesc\":\"{count, plural, one {# audioguida autoguidata selezionata} other {# audioguide autoguidate selezionate}} — {state}, {country}. Mappe, tappe e anteprime audio reali.\",\"stateTitle\":\"{state}\",\"stateSubtitle\":\"{count, plural, one {# percorso selezionato} other {# percorsi selezionati}} — {country}. Ognuno con mappa, tappe e anteprime audio reali.\",\"viewAllInState\":\"Vedi tutti i {count}\",\"audioLanguages\":\"Lingue dell'audio\",\"legendWithAudio\":\"Con audio e racconto\",\"legendPassThrough\":\"Punto di passaggio\",\"stickyText\":\"Ascolta questo percorso a mani libere\",\"stickyCta\":\"Scarica l'app\"},\"Languages\":{\"title\":\"Ascolta nella tua lingua\",\"subtitle\":\"Dal portoghese al coreano, con accenti diversi per sentirti a casa. Trova la tua qui sotto.\",\"langs\":[\"Portoghese (BR)\",\"Portoghese (PT)\",\"Inglese (USA)\",\"Inglese (UK)\",\"Spagnolo\",\"Italiano\",\"Francese\",\"Tedesco\",\"Mandarino\",\"Coreano\"]},\"A11y\":{\"openMenu\":\"Apri il menu\",\"closeMenu\":\"Chiudi il menu\",\"menu\":\"Menu\",\"mainMenu\":\"Menu principale\",\"sitePages\":\"Pagine del sito\",\"breadcrumb\":\"Percorso di navigazione\",\"routeMap\":\"Mappa interattiva dell'itinerario\",\"toggleCaptions\":\"Attiva o disattiva i sottotitoli\",\"skipToContent\":\"Vai al contenuto principale\",\"playAudio\":\"Riproduci audio\",\"pauseAudio\":\"Metti in pausa\"},\"Updates\":{\"seo\":{\"title\":\"Aggiornamenti e note di rilascio\",\"description\":\"Che cosa è cambiato nell'app, quando è cambiato e che cosa succede a ciò che hai già comprato.\",\"ogImageAlt\":\"Immagine di condivisione della sezione aggiornamenti di Tuggi.\"},\"title\":\"Aggiornamenti\",\"subtitle\":\"Note di rilascio e notizie di prodotto, dalla più recente alla più vecchia.\",\"readMore\":\"Leggi\",\"cta\":{\"button\":\"Scarica l'app\",\"body\":\"Le tue ore di benvenuto ti aspettano nell'app.\"},\"rail\":{\"title\":\"Scopri Tuggi\"},\"backToSection\":\"Torna agli aggiornamenti\",\"empty\":{\"body\":\"Non c'è ancora nessuna pubblicazione in questa lingua.\",\"link\":\"Leggi in inglese\"},\"type\":{\"release\":\"Nota di rilascio\",\"news\":\"Notizia\"},\"filter\":{\"label\":\"Filtra per tipo\",\"all\":\"Tutto\"},\"pager\":{\"label\":\"Altri aggiornamenti\",\"previous\":\"Precedente\",\"next\":\"Successivo\"},\"priceTable\":{\"caption\":\"Pass a ore\",\"columnPass\":\"Pass\",\"columnPrice\":\"Prezzo\",\"note\":\"Acquisto una tantum. Non si rinnova. Le ore di pass diversi si sommano.\"}}},\"timeZone\":\"America/Sao_Paulo\",\"children\":[\"$L5\",\"$L6\"]}],\"$L7\",\"$L8\",\"$L9\"]}]}]]}],\"loading\":null,\"isPartial\":false}\n5:[\"$\",\"$La\",null,{\"children\":[[\"$\",\"$Lb\",null,{\"currentLocale\":\"it\"}],[\"$\",\"main\",null,{\"id\":\"main-content\",\"className\":\"min-h-screen bg-tuggi-bg\",\"children\":[\"$\",\"$Lc\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$Ld\",null,{}],\"notFound\":[[\"$\",\"div\",null,{\"className\":\"min-h-screen flex items-center justify-center bg-white px-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-md w-full text-center space-y-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex justify-center flex-col items-center\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-24 h-24 bg-tuggi-slate/5 rounded-full flex items-center justify