e\",\"name\":\"Orlando\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":28.443,\"longitude\":-81.479}}},{\"@type\":\"ListItem\",\"position\":6,\"item\":{\"@type\":\"TouristAttraction\",\"name\":\"Target — Sand Lake Road\",\"containedInPlace\":{\"@type\":\"Place\",\"name\":\"Orlando\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":28.4416,\"longitude\":-81.463}}},{\"@type\":\"ListItem\",\"position\":7,\"item\":{\"@type\":\"TouristAttraction\",\"name\":\"The Mall at Millenia — Luxury (Neiman Marcus, Bloomingdale's)\",\"containedInPlace\":{\"@type\":\"Place\",\"name\":\"Orlando\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":28.4842,\"longitude\":-81.4375}}},{\"@type\":\"ListItem\",\"position\":8,\"item\":{\"@type\":\"TouristAttraction\",\"name\":\"The Florida Mall — 8001 S Orange Blossom Trail\",\"containedInPlace\":{\"@type\":\"Place\",\"name\":\"Orlando\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":28.446,\"longitude\":-81.402}}},{\"@type\":\"ListItem\",\"position\":9,\"item\":{\"@type\":\"TouristAttraction\",\"name\":\"Lake Buena Vista Factory Stores (SR-535)\",\"containedInPlace\":{\"@type\":\"Place\",\"name\":\"Orlando\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":28.3837,\"longitude\":-81.5047}}},{\"@type\":\"ListItem\",\"position\":10,\"item\":{\"@type\":\"TouristAttraction\",\"name\":\"Disney Springs — Shopping + Lazer Grátis\",\"containedInPlace\":{\"@type\":\"Place\",\"name\":\"Orlando\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":28.3694,\"longitude\":-81.5157}}},{\"@type\":\"ListItem\",\"position\":11,\"item\":{\"@type\":\"TouristAttraction\",\"name\":\"Orlando Vineland Premium Outlets\",\"containedInPlace\":{\"@type\":\"Place\",\"name\":\"Orlando\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":28.3872,\"longitude\":-81.4925}}},{\"@type\":\"ListItem\",\"position\":12,\"item\":{\"@type\":\"TouristAttraction\",\"name\":\"Marshalls + HomeGoods — I-Drive Corridor\",\"containedInPlace\":{\"@type\":\"Place\",\"name\":\"Orlando\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":28.435,\"longitude\":-81.455}}}]}},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.tuggi.app/it/tours/united-states/compras-em-orlando#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"TUGGI\",\"item\":\"https://www.tuggi.app\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Audioguide\",\"item\":\"https://www.tuggi.app/it/tours\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Stati Uniti\",\"item\":\"https://www.tuggi.app/it/tours/united-states\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Shopping a Orlando\",\"item\":\"https://www.tuggi.app/it/tours/united-states/compras-em-orlando\"}]},{\"@type\":\"FAQPage\",\"@id\":\"https://www.tuggi.app/it/tours/united-states/compras-em-orlando#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Quanto dura questo tour?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Circa 1h 53min di audio in 12 tappe, coprendo all'incirca 82 km. Vai al tuo ritmo — l'audio parte automaticamente mentre ti muovi.\"}},{\"@type\":\"Question\",\"name\":\"Questo tour è accessibile?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Questo percorso è classificato come: Accessibile. Controlla ogni tappa per i dettagli specifici di accesso.\"}},{\"@type\":\"Question\",\"name\":\"In quali lingue è disponibile?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Questo tour è disponibile in: English, Español, Português, Italiano.\"}},{\"@type\":\"Question\",\"name\":\"Mi serve una connessione internet?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Scarica il tour nell'app Tuggi e ascolta offline — l'audio si attiva in base alla tua posizione, a mani libere.\"}},{\"@type\":\"Question\",\"name\":\"Posso farlo a piedi o in auto?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Questo percorso è pensato per un viaggio Facile. L'audio si adatta al tuo ritmo.\"}}]}]}6:[\"$\",\"article\",null,{\"children\":[[\"$