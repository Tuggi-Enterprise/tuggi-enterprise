em\":\"https://www.tuggi.app\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Audioguide\",\"item\":\"https://www.tuggi.app/it/tours\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Stati Uniti\",\"item\":\"https://www.tuggi.app/it/tours/united-states\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Shopping a Orlando\",\"item\":\"https://www.tuggi.app/it/tours/united-states/compras-em-orlando\"}]},{\"@type\":\"FAQPage\",\"@id\":\"https://www.tuggi.app/it/tours/united-states/compras-em-orlando#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Quanto dura questo tour?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Circa 1h 53min di audio in 12 tappe, coprendo all'incirca 82 km. Vai al tuo ritmo — l'audio parte automaticamente mentre ti muovi.\"}},{\"@type\":\"Question\",\"name\":\"Questo tour è accessibile?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Questo percorso è classificato come: Accessibile. Controlla ogni tappa per i dettagli specifici di accesso.\"}},{\"@type\":\"Question\",\"name\":\"In quali lingue è disponibile?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Questo tour è disponibile in: English, Español, Português, Italiano.\"}},{\"@type\":\"Question\",\"name\":\"Mi serve una connessione internet?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Scarica il tour nell'app Tuggi e ascolta offline — l'audio si attiva in base alla tua posizione, a mani libere.\"}},{\"@type\":\"Question\",\"name\":\"Posso farlo a piedi o in auto?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Questo percorso è pensato per un viaggio Facile. L'audio si adatta al tuo ritmo.\"}}]}]}6:[\"$\",\"article\",null,{\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$f\"}}],\"$L10\",\"$L11\",\"$L12\",\"$L13\",\"$L14\",\"$L15\",\"$L16\"]}]\n5:[\"$\",\"html\",null,{\"lang\":\"it\",\"className\":\"inter_fa93af41-module__0D_jrq__className\",\"children\":[\"$\",\"body\",nu