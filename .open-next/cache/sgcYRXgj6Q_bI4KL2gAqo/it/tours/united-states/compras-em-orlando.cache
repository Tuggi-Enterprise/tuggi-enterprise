ornata senza lasciare la zona centrale.\",\"durationStr\":\"1h 53min\",\"distanceStr\":\"82 km\",\"stopsCount\":12,\"drivability\":\"easy\",\"accessibility\":\"accessible\",\"bestTime\":[\"morning\",\"afternoon\"],\"languageLabels\":[\"English\",\"Español\",\"Português\",\"Italiano\"]}]\n12:[\"$\",\"$L1d\",null,{\"line\":[[-81.45047,28.4727],[-81.45047,28.47252],[-81.45046,28.47227],[-81.45046,28.47212],[-81.45046,28.47185],[-81.45047,28.4713],[-81.45047,28.47105],[-81.45047,28.47084],[-81.45046,28.47048],[-81.45047,28.4702],[-81.45047,28.46945],[-81.45047,28.46891],[-81.45047,28.46871],[-81.45047,28.46808],[-81.45047,28.46732],[-81.45048,28.46689],[-81.45048,28.46669],[-81.45048,28.46608],[-81.45048,28.46509],[-81.45048,28.46415],[-81.45049,28.46399],[-81.45053,28.46375],[-81.45059,28.4636],[-81.45072,28.46334],[-81.45085,28.46316],[-81.4511,28.46292],[-81.45138,28.46271],[-81.45167,28.46258],[-81.45198,28.46248],[-81.45218,28.46244],[-81.45228,28.46222],[-81.45228,28.46187],[-81.45228,28.46132],[-81.45227,28.4605],[-81.45226,28.4601],[-81.45226,28.45975],[-81.45226,28.45948],[-81.45225,28.45906],[-81.45225,28.45882],[-81.45225,28.45863],[-81.45224,28.45787],[-81.45224,28.45738],[-81.45222,28.45586],[-81.45222,28.45553],[-81.45212,28.45527],[-81.45181,28.45506],[-81.45162,28.45481],[-81.45159,28.45395],[-81.45158,28.45349],[-81.45157,28.45314],[-81.45156,28.45241],[-81.45156,28.45225],[-81.45157,28.45203],[-81.45162,28.45185],[-81.45183,28.45158],[-81.4517,28.45142],[-81.4515,28.45114],[-81.45141,28.45097],[-81.45136,28.45077],[-81.45136,28.45039],[-81.45175,28.45048],[-81.45288,28.45076],[-81.45406,28.45101],[-81.45511,28.45116],[-81.45581,28.45124],[-81.45624,28.45132],[-81.45657,28.45135],[-81.45691,28.45138],[-81.45742,28.45139],[-81.45775,28.4514],[-81.45802,28.4514],[-81.45824,28.4514],[-81.4584,28.45139],[-81.45879,28.45138],[-81.45911,28.45136],[-81.45974,28.45132],[-81.4601,28.45128],[-81.46056,28.45123],[-81.4613,28.4511],[-81.46214,28.45097],[-81.46314,2