ic/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\",\"/_next/static/chunks/00fc9bc083c08a18.js\",\"/_next/static/chunks/d98e2f61488237bc.js\"],\"HomeFeatureShowcase\"]\n18:I[931037,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\",\"/_next/static/chunks/00fc9bc083c08a18.js\",\"/_next/static/chunks/d98e2f61488237bc.js\"],\"HomeBusinessSection\"]\n1a:I[379529,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\",\"/_next/static/chunks/00fc9bc083c08a18.js\",\"/_next/static/chunks/d98e2f61488237bc.js\"],\"FaqSection\"]\nf:Tae8,{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Qual é o melhor app de áudio-guia autoguiado?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"O TUGGI é um áudio-guia de viagem autoguiado para iOS e Android. Ele toca histórias em áudio sobre os lugares ao seu redor automaticamente, ativadas por GPS — sem usar as mãos e sem olhar a tela — enquanto você dirige, caminha ou pedala. Funciona offline, tem 10 idiomas com legendas e é grátis para começar.\"}},{\"@type\":\"Question\",\"name\":\"Existe um app de áudio-guia de viagem grátis?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sim. O TUGGI é grátis para baixar e já começa com histórias todo dia. Para ouvir sem limite diário, um Passe Tuggi dá 10, 25 ou 45 horas de uso, com pagamento único. As horas não expiram e você vê o preço na App Store ou no Google Play.\"}},{\"@type\":\"Question\",\"name\":\"Qual é um bom app de viagem para road trip?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"O TUGGI foi feito para road trips: roda junto com a sua navegação e música e narra automaticamente os pontos, as cidades e a história por onde você passa — sem tela, sem procurar nada. Baixe a rota antes e use offline, sem roaming.\"}},{\"@type\":\"Question\",\"name\":\"Dá para explorar uma cidade sem guia turístico?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sim. O TUGGI funciona como um áudio-guia autoguiado para você explorar no seu ritmo, sem contratar guia humano nem tour fixo. As histórias tocam sozinhas ao chegar em cada ponto de interesse, a pé ou de carro.\"}},{\"@type\":\"Question\",\"name\":\"O TUGGI funciona offline e no meu idioma?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sim. Baixe a rota antes e ouça sem sinal e sem custo de roaming. O TUGGI oferece áudio em 10 idiomas com legendas sincronizadas para viajantes surdos e com deficiência auditiva.\"}},{\"@type\":\"Question\",\"name\":\"Como o TUGGI é diferente do Google Maps ou de um guia humano?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"O TUGGI não é um app de navegação e não substitui o seu GPS — ele roda junto e adiciona narração em áudio autoguiada sobre os lugares por onde você passa. Diferente de um guia humano, está disponível 24/7, em vários idiomas, sem usar as mãos e grátis para começar.\"}},{\"@type\":\"Question\",\"name\":\"Para quem o TUGGI é indicado?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Para qualquer pessoa que gosta de explorar em movimento: turistas, moradores curiosos, ciclistas, caminhantes, passageiros de ônibus, trem ou van e também motoristas. Funciona em roteiro de carro, no city tour a pé, no passeio de bike ou de patinete e no transporte público. Como o áudio é acionado por GPS e roda offline, a experiência é a mesma em qualquer meio de transporte.\"}}]}6:[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$f\"}}],[\"$\",\"$L10\",null,{\"children\":[[\"$\",\"$L11\",null,{}],[\"$\",\"$L12\",null,{}],\"$L13\",\"$L14\",[\"$\",\"$L15\",null,{}],\"$L16\",\"$L17\",[\"$\",\"$L18\",null,{}],\"$L19\",[\"$\",\"$L1a\",null,{\"namespace\":\"Home.FAQ\",\"count\":7}]]}]]\n1c:I[140033,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\"],\"default\"]\n1d:I[755241,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\"],\"default\"]\n1e:I[854097,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\"],\"default\"]\n5:[\"$\",\"html\",null,{\"lang\":\"pt\",\"className\":\"inter_fa93af41-module__0D_jrq__className\",\"children\":[\"$\",\"body\",null,{\"className\":\"bg-white text-[#0B1220] antialiased\",\"children\":[[\"$\",\"a\",null,{\"href\":\"#main-content\",\"className\":\"sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-6 focus:py-3 focus:bg-tuggi-primary focus:text-tuggi-dark focus:font-bold focus:rounded-xl focus:shadow-2xl focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2\",\"children\":\"Ir para o conteúdo principal\"}],\"$L1b\",[\"$\",\"$L1c\",null,{\"gaId\":\"G-LFFNJDG7TJ\"}],[\"$\",\"$L1d\",null,{\"appId\":\"69a093d7a5444f000d2d36d6\"}],[\"$\",\"$L1e\",null,{\"id\":\"vmjex394bg\"}]]}]}]\n1f:I[162285,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\",\"/_next/static/chunks/00fc9bc083c08a18.js\",\"/_next/static/chunks/d98e2f61488237bc.js\"],\"AudioSampleCard\"]\n13:[\"$\",\"section\",null,{\"data-block\":\"scene\",\"className\":\"bg-tuggi-dark py-24 lg:py-32\",\"children\":[\"$\",\"div\",null,{\"className\":\"page-shell\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-3xl\",\"children\":[[\"$\",\"p\",null,{\"className\":\"whitespace-pre-line text-2xl sm:text-3xl lg:text-4xl font-extrabold leading-tight tracking-tight text-white\",\"children\":\"Hoje você passou por quarenta histórias.\\nOuviu nenhuma.\"}],[\"$\",\"p\",null,{\"className\":\"mt-8 text-lg leading-relaxed text-white\",\"children\":\"O forte na entrada da cidade, a igreja do século XVIII, a serra que tem nome e motivo. Tudo passou pela janela calado, porque ninguém para no acostamento pra pesquisar sobre o que acabou de passar.\"}]]}]}]}]\n14:[\"$\",\"section\",null,{\"className\":\"bg-white py-20 lg:py-24 border-t border-gray-100\",\"children\":[\"$\",\"div\",null,{\"className\":\"page-shell text-center\",\"children\":[[\"$\",\"div\",null,{\"className\":\"max-w-3xl mx-auto\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-3xl sm:text-4xl font-extrabold text-tuggi-dark tracking-tight mb-3\",\"children\":\"Ouça o TUGGI na prática\"}],[\"$\",\"p\",null,{\"className\":\"text-lg text-tuggi-slate mb-10\",\"children\":\"Histórias curtas, do jeito que você ouve enquanto explora.\"}]]}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 text-left grid-cols-1 sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"$L1f\",\"sample2\",{\"sample\":{\"id\":\"sample2\",\"countryCode\":\"BR\",\"transcript\":null,\"clips\":[{\"src\":\"/audio/sample2-desc.mp3\",\"part\":\"story\",\"audioLang\":null}],\"placeName\":\"Avenida Paulista\",\"city\":\"São Paulo\",\"tags\":[\"story\"]},\"surface\":\"light\",\"preload\":\"metadata\"}],[\"$\",\"$L1f\",\"sample3\",{\"sample\":{\"id\":\"sample3\",\"countryCode\":\"IT\",\"transcript\":null,\"clips\":[{\"src\":\"/audio/sample3-desc.mp3\",\"part\":\"story\",\"audioLang\":null}],\"placeName\":\"Ponte de Rialto\",\"city\":\"Veneza\",\"tags\":[\"story\"]},\"surface\":\"light\",\"preload\":\"metadata\"}],[\"$\",\"$L1f\",\"sample1\",{\"sample\":{\"id\":\"sample1\",\"countryCode\":\"US\",\"transcript\":null,\"clips\":[{\"src\":\"/audio/sample1-desc.mp3\",\"part\":\"story\",\"audioLang\":null}],\"placeName\":\"Walt Disney World Resort\",\"city\":\"Orlando\",\"tags\":[\"story\"]},\"surface\":\"light\",\"preload\":\"metadata\"}]]}]]}]}]\n16:[\"$\",\"section\",null,{\"className\":\"w-full py-20 bg-white\",\"data-proof-block\":\"light\",\"children\":[\"$\",\"div\",null,{\"className\":\"page-shell\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-3xl space-y-6 sm:mx-auto text-left sm:text-center\",\"children\":[[\"$\",\"p\",\"points\",{\"data-proof-line\":\"points\",\"className\":\"text-lg sm:text-xl leading-relaxed text-tuggi-slate\",\"children\":[[\"$\",\"strong\",\"strong0\",{\"className\":\"block sm:inline text-4xl sm:text-5xl font-extrabold leading-none text-tuggi-dark\",\"children\":[\"Mais de 2 milhões\"]}],\" de pontos mapeados, em 48 países.\"]}],[\"$\",\"p\",\"guides\",{\"data-proof-line\":\"guides\",\"className\":\"text-lg leading-relaxed text-tuggi-slate\",\"children\":[[\"$\",\"strong\",\"strong0\",{\"className\":\"block sm:inline text-2xl font-bold leading-tight text-tuggi-dark\",\"children\":[\"Mais de 16.000\"]}],\" áudio-guias produzidos, com áudio em 10 idiomas.\"]}],[\"$\",\"p\",\"since\",{\"data-proof-line\":\"since\",\"className\":\"text-base leading-relaxed text-tuggi-slate\",\"children\":\"Operando desde 2025.\"}]]}]}]}]\n19:[\"$\",\"section\",null,{\"className\":\"bg-white py-16 lg:py-20 border-t border-gray-100\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-bold text-tuggi-dark tracking-tight mb-6\",\"children\":\"O que é o TUGGI\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4 text-tuggi-slate leading-relaxed\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":\"O TUGGI é um áudio-guia de viagem autoguiado para iPhone e Android. Ele usa o GPS para reconhecer os lugares por onde você passa e conta a história de cada um em voz alta, na hora certa, sem você precisar procurar nada na tela. Funciona do jeito que você viaja: a pé, de bike, de carro, de ônibus ou no metrô.\"}],[\"$\",\"p\",\"1\",{\"children\":\"As histórias tocam sozinhas quando você se aproxima de um ponto turístico. Como tudo funciona offline, você baixa a cidade antes de sair e ouve sem internet e sem gastar dados em roaming. E como o áudio vem com legenda sincronizada, viajantes surdos ou com baixa audição acompanham cada história pela tela.\"}],[\"$\",\"p\",\"2\",{\"children\":\"O TUGGI não substitui o seu GPS de navegação: ele roda junto, sem atrapalhar o mapa nem a música, e só adiciona a narração cultural do caminho. Comece grátis, escolha entre 10 idiomas e transforme qualquer trajeto em uma viagem com história.\"}]]}]]}]}]\n20:I[239810,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\",\"/_next/static/chunks/00fc9bc083c08a18.js\",\"/_next/static/chunks/d98e2f61488237bc.js\"],\"CoverageDensityCanvas\"]\n17:[[\"$\",\"section\",null,{\"data-block\":\"coverage-density\",\"className\":\"py-20 bg-tuggi-dark relative overflow-hidden\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute inset-0 opacity-10\",\"style\":{\"backgroundImage\":\"radial-gradient(var(--color-tuggi-slate) 1px, transparent 1px)\",\"backgroundSize\":\"30px 30px\"}}],[\"$\",\"div\",null,{\"className\":\"container mx-auto px-6 relative z-10\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-center mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-3xl md:text-5xl font-black text-white mb-3\",\"children\":\"Onde o TUGGI já está\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-300 text-base max-w-xl mx-auto\",\"children\":\"Quanto mais clara a área, maior a densidade de pontos mapeados naquela região.\"}]]}],[\"$\",\"$L20\",null,{\"states\":[{\"state\":\"Bayern\",\"country\":\"Germany\",\"activeCount\":57835,\"comingSoonCount\":0},{\"state\":\"Québec\",\"country\":\"Canada\",\"activeCount\":57744,\"comingSoonCou