8\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl sm:text-3xl font-bold text-tuggi-dark tracking-tight mb-6\\\",\\\"children\\\":\\\"O que é o TUGGI\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-4 text-tuggi-slate leading-relaxed\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"children\\\":\\\"O TUGGI é um áudio-guia de viagem autoguiado para iPhone e Android. Ele usa o GPS para reconhecer os lugares por onde você passa e conta a história de cada um em voz alta, na hora certa, sem você precisar procurar nada na tela. Funciona do jeito que você viaja: a pé, de bike, de carro, de ônibus ou no metrô.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"children\\\":\\\"As histórias tocam sozinhas quando você se aproxima de um ponto turístico. Como tudo funciona offline, você baixa a cidade antes de sair e ouve sem internet e sem gastar dados em roaming. E como o áudio vem com legenda sincronizada, viajantes surdos ou com baixa audição acompanham cada história pela tela.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"2\\\",{\\\"children\\\":\\\"O TUGGI não substitui o seu GPS de navegação: ele roda junto, sem atrapalhar o mapa nem a música, e só adiciona a narração cultural do caminho. Comece grátis, escolha entre 10 idiomas e transforme qualquer trajeto em uma viagem com história.\\\"}]]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"20:I[239810,[\\\"/_next/static/chunks/36c9e5bc4f7460fd.js\\\",\\\"/_next/static/chunks/27a1237e2a9f6c6c.js\\\",\\\"/_next/static/chunks/66e164642a425c8a.js\\\",\\\"/_next/static/chunks/9c38e031aa827488.js\\\",\\\"/_next/static/chunks/00fc9bc083c08a18.js\\\",\\\"/_next/static/chunks/d98e2f61488237bc.js\\\"],\\\"CoverageDensityCanvas\\\"]\\n\"])</script><script>self.__next_f.push([1,\"17:[[\\\"$\\\",\\\"section\\\",null,{\\\"data-block\\\":\\\"coverage-density\\\",\\\"className\\\":\\\"py-20 bg-tuggi-dark relative overflow-hidden\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\