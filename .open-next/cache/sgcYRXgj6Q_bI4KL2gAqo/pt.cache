xt/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\",\"/_next/static/chunks/00fc9bc083c08a18.js\",\"/_next/static/chunks/d98e2f61488237bc.js\"],\"FaqSection\"]\nf:Tae8,{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Qual é o melhor app de áudio-guia autoguiado?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"O TUGGI é um áudio-guia de viagem autoguiado para iOS e Android. Ele toca histórias em áudio sobre os lugares ao seu redor automaticamente, ativadas por GPS — sem usar as mãos e sem olhar a tela — enquanto você dirige, caminha ou pedala. Funciona offline, tem 10 idiomas com legendas e é grátis para começar.\"}},{\"@type\":\"Question\",\"name\":\"Existe um app de áudio-guia de viagem grátis?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sim. O TUGGI é grátis para baixar e já começa com histórias todo dia. Para ouvir sem limite diário, um Passe Tuggi dá 10, 25 ou 45 horas de uso, com pagamento único. As horas não expiram e você vê o preço na App Store ou no Google Play.\"}},{\"@type\":\"Question\",\"name\":\"Qual é um bom app de viagem para road trip?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"O TUGGI foi feito para road trips: roda junto com a sua navegação e música e narra automaticamente os pontos, as cidades e a história por onde você passa — sem tela, sem procurar nada. Baixe a rota antes e use offline, sem roaming.\"}},{\"@type\":\"Question\",\"name\":\"Dá para explorar uma cidade sem guia turístico?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sim. O TUGGI funciona como um áudio-guia autoguiado para você explorar no seu ritmo, sem contratar guia humano nem tour fixo. As histórias tocam sozinhas ao chegar em cada ponto de interesse, a pé ou de carro.\"}},{\"@type\":\"Question\",\"name\":\"O TUGGI funciona offline e no meu idioma?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sim. Baixe a rota antes e ouça sem sinal e sem custo de roaming. O TUGGI oferece áudio em 10 idiomas com legendas sincronizadas para viajantes surdos e com deficiência auditiva.\"}},{\"@type\":\"Question\",\"name\":\"Como o TUGGI é diferente do Google Maps ou de um guia humano?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"O TUGGI não é um app de navegação e não substitui o seu GPS — ele roda junto e adiciona narração em áudio autoguiada sobre os lugares por onde você passa. Diferente de um guia humano, está disponível 24/7, em vários idiomas, sem usar as mãos e grátis para começar.\"}},{\"@type\":\"Question\",\"name\":\"Para quem o TUGGI é indicado?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Para qualquer pessoa que gosta de explorar em movimento: turistas, moradores curiosos, ciclistas, caminhantes, passageiros de ônibus, trem ou van e também motoristas. Funciona em roteiro de carro, no city tour a pé, no passeio de bike ou de patinete e no transporte público. Como o áudio é acionado por GPS e roda offline, a experiência é a mesma em qualquer meio de transporte.\"}}]}6:[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$f\"}}],[\"$\",\"$L10\",null,{\"children\":[[\"$\",\"$L11\",null,{}],[\"$\",\"$L12\",null,{}],\"$L13\",\"$L14\",[\"$\",\"$L15\",null,{}],\"$L16\",\"$L17\",[\"$\",\"$L18\",null,{}],\"$L19\",[\"$\",\"$L1a\",null,{\"namespace\":\"Home.FAQ\",\"count\":7}]]}]]\n1c:I[140033,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\"],\"default\"]\n1d:I[755241,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\"],\"default\"]\n1e:I[854097,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/