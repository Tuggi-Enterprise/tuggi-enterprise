"className\\\":\\\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\\\",\\\"children\\\":\\\"Itália\\\"}],[\\\"$\\\",\\\"li\\\",\\\"Spain\\\",{\\\"className\\\":\\\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\\\",\\\"children\\\":\\\"Espanha\\\"}],[\\\"$\\\",\\\"li\\\",\\\"United Kingdom\\\",{\\\"className\\\":\\\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\\\",\\\"children\\\":\\\"Reino Unido\\\"}],[\\\"$\\\",\\\"li\\\",\\\"Belgium\\\",{\\\"className\\\":\\\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\\\",\\\"children\\\":\\\"Bélgica\\\"}],[\\\"$\\\",\\\"li\\\",\\\"Ireland\\\",{\\\"className\\\":\\\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\\\",\\\"children\\\":\\\"Irlanda\\\"}],[\\\"$\\\",\\\"li\\\",\\\"Portugal\\\",{\\\"className\\\":\\\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\\\",\\\"children\\\":\\\"Portugal\\\"}],[\\\"$\\\",\\\"li\\\",\\\"Switzerland\\\",{\\\"className\\\":\\\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\\\",\\\"children\\\":\\\"Suíça\\\"}],[\\\"$\\\",\\\"li\\\",\\\"Austria\\\",{\\\"className\\\":\\\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\\\",\\\"children\\\":\\\"Áustria\\\"}],[\\\"$\\\",\\\"li\\\",\\\"Slovenia\\\",{\\\"className\\\":\\\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\\\",\\\"children\\\":\\\"Eslovênia\\\"}],[\\\"$\\\",\\\"li\\\",\\\"Luxembourg\\\",{\\\"className\\\":\\\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\\\",\\\"children\\\":\\\"Luxemburgo\\\"}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"2b:[\\\"$\\\",\\\"div\\\",\\\"other\\\",{\\\"className\\\":\\\"mb-10 last:mb-0\\\",\\\"children\\\":[[\\\"$\\\",\\\"h4\\\",null,{\\\"className\\\":\\\"text-xs font-bold uppercase tracking-widest text-tuggi-slate mb-5 pb-2 border-b border-gray-200\\\",\\\"children\\\":\\\"Outros destinos\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"flex flex-wrap gap-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"Netherlands\\\",{\\\"className\\\":\\\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\\\",\\\"children\\\":\\\"Netherlands\\\"}],[\\\"$\\\",\\\"li\\\",\\\"Poland\\\",{\\\"className\\\":\\\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\\\",\\\"children\\\":\\\"Poland\\\"}],[\\\"$\\\",\\\"li\\\",\\\"Czech Republic\\\",{\\\"className\\\":\\\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\\\",\\\"children\\\":\\\"Czech Republic\\\"}],[\\\"$\\\",\\\"li\\\",\\\"Morocco\\\",{\\\"className\\\":\\\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\\\",\\\"children\\\":\\\"Marrocos\\\"}]]}]]}]\\n2c:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-10 text-center\\\",\\\"children\\\":\\\"$L2d\\\"}]\\n\"])</script><script>self.__next_f.push([1,\"2e:I[175696,[\\\"/_next/static/chunks/36c9e5bc4f7460fd.js\\\",\\\"/_next/static/chunks/27a1237e2a9f6c6c.js\\\",\\\"/_next/static/chunks/66e164642a425c8a.js\\\",\\\"/_next/static/chunks/9c38e031aa827488.js\\\"],\\\"default\\\"]\\n33:I[77105,[\\\"/_next/static/chunks/36c9e5bc4f7460fd.js\\\",\\\"/_next/static/chunks/27a1237e2a9f6c6c.js\\\",\\\"/_next/static/chunks/66e164642a425c8a.js\\\",\\\"/_next/static/chunks/9c38e031aa827488.js\\\",\\\"/_next/static/chunks/00fc9bc083c08a18.js\\\",\\\"/_next/static/chunks/d98e2f61488237bc.js\\\"],\\\"default\\\"]\\n2f:T5cf,\"])</script><script>self.__next_f.push([1,\"\\u003cstrong\\u003eDados da Proposta de Parceria:\\u003c/strong\\u003e Existe um formulário de proposta de parceria neste site, aberto a qualquer estabelecimento que queira propor uma parceria. Quem preenche esse formulário nos manda duas coisas. Uma é o estabelecimento, com nome fantasia e razão social, CNPJ, categoria, endereço completo com CEP, bairro, cidade e estado, horário de funcionamento, site e Instagram. A outra é quem responde pelo estabelecimento, com nome, cargo, e-mail e telefone, e esses são dados de uma pessoa. Em MEI e empresário individual, a razão social carrega o nome do dono, e o endereço pode ser o da casa dele, então tratamos esse formulário todo como dado pessoal. Usamos o que chega ali para cinco coisas: avaliar a proposta, falar com a pessoa sobre esta parceria, gerar o contrato e enviá-lo para assinatura no e-mail informado, conter abuso na página, que é aberta a qualquer pessoa, e medir onde o formulário atrapalha. Para conter abuso contamos quantas propostas vêm de cada conexão. Para essa contagem guardamos um código calculado a partir do endereço de IP, e não o endereço. Esse código não é anônimo, porque a mesma conexão sempre produz o mesmo código. Para medir onde o formulário atrapalha contamos quantas pessoas abrem cada passo e em qual passo param. Para essa contagem não guardamos o seu nome, nem o endereço da sua conexão, nem nada do que você escreveu. Você pode pedir a remoção desses dados, e a seção 5 diz como.\"])</script><script>self.__next_f.push([1,\"30:T51b,\\u003cstrong\\u003eVisita à Página de um Parceiro:\\u003c/strong\\u003e Quando você chega a uma página de parceiro deste site, por um Código QR ou por um link dele, registramos essa visita. Se você acessa de fora do Brasil e dos Estados Unidos, esse registro só é criado depois que você aceita os cookies neste site. Enquanto você não aceitar, não guardamos nada dessa visita nem gravamos cookie no seu aparelho. Guardamos o endereço de IP da sua conexão, a identificação que o navegador declara, o idioma do navegador e o fuso horário do aparelho. Guardamos também qual parceiro você visitou e a hora. Junto disso gravamos um cookie deste próprio site, chamado tuggi_attr, que dura 30 dias e guarda o identificador do parceiro, o identificador dessa visita e a data. Esse registro serve para uma finalidade só, que é saber qual parceiro levou você até o aplicativo, porque é assim que remuneramos esse parceiro. Ele não alimenta anúncio e não serve para contato. O endereço de IP e a identificação do navegador saem desse registro depois de 48 horas, e o registro inteiro é apagado depois de 30 dias, por uma rotina que roda todo dia. Quando existe esse registro e você toca num botão que leva à loja, o identificador dessa visita vai dentro do link, e a seção 3 conta o que acontece com ele.\"])</script><script>self.__next_f.push([1,\"1b:[\\\"$\\\",\\\"$L2e\\\",null,{\\\"formats\\\":\\\"$undefined\\\",\\\"locale\\\":\\\"pt\\\",\\\"messages\\\":{\\\"Download\\\":{\\\"metaTitle\\\":\\\"Baixar TUGGI – Guia de Viagem em Áudio Autoguiado\\\",\\\"metaDesc\\\":\\\"Baixe o TUGGI: guias de viagem em áudio autoguiados, mãos-livres e offline. Ouça em {contentLanguages} idiomas com legendas. Grátis para começar.\\\",\\\"partnerBadge\\\":\\\"CONVITE PARCEIRO TUGGI ATIVADO\\\",\\\"heroWelcomeLabel\\\":\\\"Boas-vindas\\\",\\\"heroWelcomeTitle\\\":\\\"Experiência Tuggi\\\",\\\"heroTitle1\\\":\\\"Sua experiência\\\",\\\"heroTitle2\\\":\\\"cultural\\\",\\\"heroTitle3\\\":\\\"já começou.\\\",\\\"heroSubtitle\\\":\\\"Estamos preparando tudo para você. Você será redirecionado para a loja oficial em instantes.\\\",\\\"partnerVisitSite\\\":\\\"Visitar site\\\",\\\"redirecting\\\":\\\"Redirecionando\\\",\\\"openingStore\\\":\\\"Abrindo loja...\\\",\\\"initializing\\\":\\\"Iniciando download para\\\",\\\"cta\\\":\\\"DESCUBRA MAIS NO APP\\\",\\\"officialApp\\\":\\\"App Oficial\\\",\\\"trustFooter\\\":\\\"Conexão Segura • Distribuição Oficial • Powered by Tuggi\\\",\\\"loading\\\":\\\"Carregando...\\\",\\\"readMore\\\":\\\"MAIS\\\",\\\"readLess\\\":\\\"MENOS\\\",\\\"Campaign\\\":{\\\"headline\\\":\\\"Entre um prato e outro, a região conta a \\u003caccent\\u003eprópria história\\u003c/accent\\u003e.\\\",\\\"subtext\\\":\\\"Você segue viagem. A narração acompanha.\\\",\\\"referredBy\\\":\\\"Indicado por \\u003cpartner\\u003e{name}\\u003c/partner\\u003e\\\",\\\"stepsHeading\\\":\\\"Como funciona\\\",\\\"step1Title\\\":\\\"Abra e esqueça\\\",\\\"step1Text\\\":\\\"Ligue o app no começo do passeio e guarde o celular no bolso.\\\",\\\"step2Title\\\":\\\"O áudio começa sozinho\\\",\\\"step2Text\\\":\\\"Ao se aproximar de um lugar, a narração entra automaticamente.\\\",\\\"step3Title\\\":\\\"O caminho é seu\\\",\\\"step3Text\\\":\\\"Desvio, parada, volta pela praia. O conteúdo está no território, não em um roteiro fixo.\\\",\\\"bandTitle\\\":\\\"Baixe grátis\\\",\\\"bandSubtitle\\\":\\\"Teste agora!\\\"},\\\"Player\\\":{\\\"playing\\\":\\\"Reproduzindo\\\",\\\"tapToPlay\\\":\\\"Toque no play\\\",\\\"paused\\\":\\\"Pausado\\\"}},\\\"Header\\\":{\\\"navPartners\\\":\\\"Parcerias\\\",\\\"navDestinations\\\":\\\"Destinos\\\",\\\"navTech\\\":\\\"Tecnologia\\\",\\\"navPlans\\\":\\\"Passes\\\",\\\"navAudioGuides\\\":\\\"Áudio-guias\\\",\\\"navPurpose\\\":\\\"Propósito\\\",\\\"downloadApp\\\":\\\"Baixar App\\\"},\\\"Footer\\\":{\\\"tagline\\\":\\\"Conectando pessoas ao contexto do mundo físico\\\",\\\"driveB2c\\\":\\\"TUGGI (B2C)\\\",\\\"appDownload\\\":\\\"Baixar Aplicativo\\\",\\\"plans\\\":\\\"Passes\\\",\\\"enterprise\\\":\\\"Enterprise (B2B/B2G)\\\",\\\"destinations\\\":\\\"Destinos\\\",\\\"fleets\\\":\\\"Frotas\\\",\\\"technology\\\":\\\"Tecnologia\\\",\\\"institutional\\\":\\\"Institucional\\\",\\\"ourPurpose\\\":\\\"Nosso Propósito\\\",\\\"contact\\\":\\\"Contato\\\",\\\"trustCenter\\\":\\\"Central de Confiança e Conformidade\\\",\\\"terms\\\":\\\"Termos de Uso\\\",\\\"privacy\\\":\\\"Política de Privacidade\\\",\\\"accessibility\\\":\\\"Acessibilidade\\\",\\\"security\\\":\\\"Segurança B2G\\\",\\\"coverage\\\":\\\"Cobertura Global\\\",\\\"updates\\\":\\\"Novidades\\\",\\\"audioTours\\\":\\\"Roteiros de Áudio\\\",\\\"rights\\\":\\\"Todos os direitos reservados.\\\"},\\\"Home\\\":{\\\"FAQ\\\":{\\\"title\\\":\\\"Perguntas frequentes\\\",\\\"q1\\\":\\\"Qual é o melhor app de áudio-guia autoguiado?\\\",\\\"a1\\\":\\\"O TUGGI é um áudio-guia de viagem autoguiado para iOS e Android. Ele toca histórias em áudio sobre os lugares ao seu redor automaticamente, ativadas por GPS — sem usar as mãos e sem olhar a tela — enquanto você dirige, caminha ou pedala. Funciona offline, tem {contentLanguages} idiomas com legendas e é grátis para começar.\\\",\\\"q2\\\":\\\"Existe um app de áudio-guia de viagem grátis?\\\",\\\"a2\\\":\\\"Sim. O TUGGI é grátis para baixar e já começa com histórias todo dia. Para ouvir sem limite diário, um Passe Tuggi dá 10, 25 ou 45 horas de uso, com pagamento único. As horas não expiram e você vê o preço na App Store ou no Google Play.\\\",\\\"q3\\\":\\\"Qual é um bom app de viagem para road trip?\\\",\\\"a3\\\":\\\"O TUGGI foi feito para road trips: roda junto com a sua navegação e música e narra automaticamente os pontos, as cidades e a história por onde você passa — sem tela, sem procurar nada. Baixe a rota antes e use offline, sem roaming.\\\",\\\"q4\\\":\\\"Dá para explorar uma cidade sem guia turístico?\\\",\\\"a4\\\":\\\"Sim. O TUGGI funciona como um áudio-guia autoguiado para você explorar no seu ritmo, sem contratar guia humano nem tour fixo. As histórias tocam sozinhas ao chegar em cada ponto de interesse, a pé ou de carro.\\\",\\\"q5\\\":\\\"O TUGGI funciona offline e no meu idioma?\\\",\\\"a5\\\":\\\"Sim. Baixe a rota antes e ouça sem sinal e sem custo de roaming. O TUGGI oferece áudio em {contentLanguages} idiomas com legendas sincronizadas para viajantes surdos e com deficiência auditiva.\\\",\\\"q6\\\":\\\"Como o TUGGI é diferente do Google Maps ou de um guia humano?\\\",\\\"a6\\\":\\\"O TUGGI não é um app de navegação e não substitui o seu GPS — ele roda junto e adiciona narração em áudio autoguiada sobre os lugares por onde você passa. Diferente de um guia humano, está disponível 24/7, em vários idiomas, sem usar as mãos e grátis para começar.\\\",\\\"q7\\\":\\\"Para quem o TUGGI é indicado?\\\",\\\"a7\\\":\\\"Para qualquer pessoa que gosta de explorar em movimento: turistas, moradores curiosos, ciclistas, caminhantes, passageiros de ônibus, trem ou van e também motoristas. Funciona em roteiro de carro, no city tour a pé, no passeio de bike ou de patinete e no transporte público. Como o áudio é acionado por GPS e roda offline, a experiência é a mesma em qualquer meio de transporte.\\\"},\\\"Hero\\\":{\\\"title\\\":\\\"Você se move, o TUGGI conta a história de cada lugar.\\\",\\\"subtitle\\\":\\\"Ligue o TUGGI, comece a se mover e guarde o celular. Pelo GPS ele reconhece cada ponto turístico do caminho e conta a história em voz alta. Vale a pé, de bike, de carro ou no transporte público, offline e no seu idioma.\\\",\\\"trustLine\\\":\\\"Comece grátis · Funciona offline · Áudio em {contentLanguages} idiomas\\\",\\\"appStoreAlt\\\":\\\"Baixe o TUGGI na App Store\\\",\\\"playStoreAlt\\\":\\\"Baixe o TUGGI no Google Play\\\",\\\"phoneAlt\\\":\\\"Ficha de um ponto no app TUGGI, aberta sobre o mapa: o nome do lugar, a distância, o começo da história e os botões para ouvir a história ou ler a transcrição.\\\"},\\\"Scene\\\":{\\\"lead\\\":\\\"Hoje você passou por quarenta histórias.\\\\nOuviu nenhuma.\\\",\\\"body\\\":\\\"O forte na entrada da cidade, a igreja do século XVIII, a serra que tem nome e motivo. Tudo passou pela janela calado, porque ninguém para no acostamento pra pesquisar sobre o que acabou de passar.\\\"},\\\"HowItWorks\\\":{\\\"title\\\":\\\"Comece a ouvir em um minuto\\\",\\\"step1\\\":\\\"Baixe o app e escolha seu idioma.\\\",\\\"step2\\\":\\\"Inicie o guia e guarde o celular.\\\",\\\"step3\\\":\\\"As histórias tocam sozinhas conforme você passa por cada lugar.\\\"},\\\"Showcase\\\":{\\\"feat2Title\\\":\\\"Parado, ele mostra. Em movimento, ele fala.\\\",\\\"feat2Body\\\":\\\"Quando você para, abre o mapa e vê o que tem por perto: pontos turísticos, eventos e trilhas, com a distância de cada um. Voltou a se mover? O TUGGI volta a narrar: diz o nome do lugar e então conta a história.\\\",\\\"feat2Alt\\\":\\\"Lista \\\\\\\"explorar ao redor\\\\\\\" do TUGGI com pontos de interesse próximos e suas distâncias\\\",\\\"feat3Title\\\":\\\"Saiba o que está rolando agora\\\",\\\"feat3Body\\\":\\\"Festivais, feiras e eventos da cidade aparecem no seu mapa com data e lembrete. Achou algo que te interessa? Toca em \\\\\\\"me leva até lá\\\\\\\" e segue.\\\",\\\"feat3Alt\\\":\\\"Cartão de detalhe de evento do TUGGI com a data, um lembrete e o botão \\\\\\\"me leva até lá\\\\\\\"\\\",\\\"feat4Title\\\":\\\"Tem roteiro pronto, mas quem manda é você\\\",\\\"feat4Body\\\":\\\"Se quiser, siga uma trilha montada por tema, tipo a Rota Religiosa de Búzios, com as paradas e as histórias já no lugar. Se não quiser, esquece o roteiro: o TUGGI narra por onde você for.\\\",\\\"feat4Alt\\\":\\\"Detalhe de trilha do TUGGI com a rota desenhada no mapa e suas paradas\\\",\\\"feat5Title\\\":\\\"Cada viagem fica registrada no seu passaporte\\\",\\\"feat5Body\\\":\\\"O app soma tudo: lugares descobertos, cidades, quilômetros percorridos e horas de áudio. Vira um histórico das suas viagens que dá pra mostrar pros amigos.\\\",\\\"feat5Alt\\\":\\\"Passaporte do explorador no TUGGI com descobertas, cidades, quilômetros e horas de áudio\\\",\\\"feat6Title\\\":\\\"Feito pra levar pra qualquer lugar\\\",\\\"feat6Body\\\":\\\"Baixe os mapas e use tudo sem internet. Controle o guia por voz com a Siri ou o Google, sem tirar o celular do bolso. E ouça em {contentLanguages} idiomas, do jeito que for melhor pra você.\\\",\\\"feat6AltTools\\\":\\\"Ferramentas do explorador no TUGGI, incluindo mapas offline e comandos de voz\\\",\\\"feat6AltLanguages\\\":\\\"Seletor de idioma de áudio do TUGGI com inglês, espanhol, italiano, português e mais\\\"},\\\"AudioSample\\\":{\\\"title\\\":\\\"Ouça o TUGGI na prática\\\",\\\"subtitle\\\":\\\"Histórias curtas, do jeito que você ouve enquanto explora.\\\"},\\\"Business\\\":{\\\"title\\\":\\\"TUGGI para o seu negócio\\\",\\\"body\\\":\\\"Empresas de transfer, frotas de aluguel e destinos usam o TUGGI para dar a cada viajante um guia local.\\\",\\\"fleetsLink\\\":\\\"Para frotas e operadores\\\",\\\"cityOsLink\\\":\\\"Para destinos\\\"},\\\"Context\\\":{\\\"title\\\":\\\"O que é o TUGGI\\\",\\\"p1\\\":\\\"O TUGGI é um áudio-guia de viagem autoguiado para iPhone e Android. Ele usa o GPS para reconhecer os lugares por onde você passa e conta a história de cada um em voz alta, na hora certa, sem você precisar procurar nada na tela. Funciona do jeito que você viaja: a pé, de bike, de carro, de ônibus ou no metrô.\\\",\\\"p2\\\":\\\"As histórias tocam sozinhas quando você se aproxima de um ponto turístico. Como tudo funciona offline, você baixa a cidade antes de sair e ouve sem internet e sem gastar dados em roaming. E como o áudio vem com legenda sincronizada, viajantes surdos ou com baixa audição acompanham cada história pela tela.\\\",\\\"p3\\\":\\\"O TUGGI não substitui o seu GPS de navegação: ele roda junto, sem atrapalhar o mapa nem a música, e só adiciona a narração cultural do caminho. Comece grátis, escolha entre {contentLanguages} idiomas e transforme qualquer trajeto em uma viagem com história.\\\"}},\\\"AudioSample\\\":{\\\"play\\\":\\\"Tocar a história de {name}\\\",\\\"pause\\\":\\\"Pausar a história de {name}\\\",\\\"seek\\\":\\\"Avançar na história de {name}\\\",\\\"transcriptShow\\\":\\\"Ler a transcrição\\\",\\\"transcriptHide\\\":\\\"Fechar a transcrição\\\",\\\"tagDirectional\\\":\\\"Direcional\\\",\\\"tagStory\\\":\\\"História\\\",\\\"error\\\":\\\"Não foi possível tocar esta história agora. Tente de novo.\\\",\\\"sample1Name\\\":\\\"Walt Disney World Resort\\\",\\\"sample1City\\\":\\\"Orlando\\\",\\\"sample2Name\\\":\\\"Avenida Paulista\\\",\\\"sample2City\\\":\\\"São Paulo\\\",\\\"sample3Name\\\":\\\"Ponte de Rialto\\\",\\\"sample3City\\\":\\\"Veneza\\\"},\\\"Proof\\\":{\\\"points\\\":\\\"\\u003cstrong\\u003eMais de {mappedPointMillions} milhões\\u003c/strong\\u003e de pontos mapeados, em {coverageCountries} países.\\\",\\\"guides\\\":\\\"\\u003cstrong\\u003eMais de {audioGuidesFloor, number}\\u003c/strong\\u003e áudio-guias produzidos, com áudio em {contentLanguages} idiomas.\\\",\\\"since\\\":\\\"Operando desde {operatingSince}.\\\"},\\\"CityOS\\\":{\\\"Hero\\\":{\\\"title\\\":\\\"A Infraestrutura Definitiva para Destinos Turísticos Inteligentes (DTI).\\\",\\\"subtitle\\\":\\\"O TUGGI City OS alinha sua governança territorial com os pilares globais de Tecnologia, Sustentabilidade, Acessibilidade e Dados.\\\",\\\"cta\\\":\\\"Solicitar Demonstração do City OS\\\"},\\\"Animator\\\":{\\\"geoTriggerActive\\\":\\\"GEO-TRIGGER ATIVO\\\",\\\"newPoi\\\":\\\"Novo POI\\\",\\\"poiName\\\":\\\"Nome do POI\\\",\\\"audio\\\":\\\"Áudio\\\",\\\"coordinates\\\":\\\"Coordenadas\\\",\\\"activationRadius\\\":\\\"Raio de Ativação\\\",\\\"deployButton\\\":\\\"Publicar no Grid\\\",\\\"defaultPoiName\\\":\\\"Monumento Central\\\"},\\\"Accessibility\\\":{\\\"title\\\":\\\"Acessibilidade Universal\\\",\\\"desc\\\":\\\"Acessibilidade Universal é o pilar DTI mais difícil. O TUGGI derruba as duas barreiras sensoriais: experiência guiada por áudio, com descrição do entorno, para turistas com deficiência visual; e legendas (Closed Captions) geolocalizadas para passageiros com deficiência auditiva. Projetamos seguindo as WCAG 2.1 AA.\\\",\\\"Panel\\\":{\\\"title\\\":\\\"Módulo de Acessibilidade\\\",\\\"feat1Title\\\":\\\"Experiência guiada por áudio\\\",\\\"feat1Desc\\\":\\\"Compatível com VoiceOver e TalkBack\\\",\\\"feat2Title\\\":\\\"Contexto espacial\\\",\\\"feat2Desc\\\":\\\"Áudio imersivo\\\",\\\"feat3Title\\\":\\\"Legendas dinâmicas\\\",\\\"feat3Desc\\\":\\\"Legendas geolocalizadas\\\"}},\\\"Intelligence\\\":{\\\"title\\\":\\\"Inteligência de Turismo Baseada em Dados\\\",\\\"desc\\\":\\\"Os governos geralmente são cegos ao fluxo turístico. O TUGGI fornece telemetria anonimizada: saiba exatamente quais rotas são feitas, em quais horários e em quais idiomas, permitindo campanhas de marketing internacional hiper-direcionadas.\\\"}},\\\"Fleets\\\":{\\\"Hero\\\":{\\\"title\\\":\\\"Descomoditize sua Frota.\\\",\\\"subtitle\\\":\\\"Transforme um aluguel de veículo padrão em uma Experiência Cultural Premium.\\\",\\\"cta\\\":\\\"Seja Parceiro da TUGGI\\\",\\\"eyebrow\\\":\\\"Para frotas e locadoras\\\"},\\\"Financial\\\":{\\\"col2Title\\\":\\\"Escalabilidade Instantânea\\\",\\\"col2Desc\\\":\\\"Implante em toda a sua frota nacional via integração com QR Code no balcão.\\\",\\\"col3Title\\\":\\\"Participação na Receita\\\",\\\"col3Desc\\\":\\\"O turista que baixa o Tuggi pelo seu QR Code fica atribuído a você. As compras que ele fizer entram na apuração da sua participação na receita, com o percentual definido em acordo comercial.\\\"},\\\"ESG\\\":{\\\"title\\\":\\\"Implementação Digital Transparente\\\",\\\"desc\\\":\\\"Cultive suas metas ESG fomentando a economia criativa local e descomprimindo o excesso de turismo através de rotas guiadas.\\\",\\\"cta\\\":\\\"Solicitar Demonstração B2B\\\"}},\\\"Partners\\\":{\\\"hero\\\":{\\\"eyebrow\\\":\\\"Para quem recebe turista\\\",\\\"title\\\":\\\"Apareça para o turista que já está na sua rua\\\",\\\"subtitle\\\":\\\"O seu negócio pode fazer parte da história dessa rua: todo turista do Tuggi encontra e lê o seu local, e quem está com o guia ligado ouve. Nenhum plano do Tuggi esconde você do turista.\\\"},\\\"grid\\\":{\\\"title\\\":\\\"Escolha o seu tipo de negócio\\\",\\\"lead\\\":\\\"Cada negócio pega o turista num momento diferente do dia. Ache o seu, e a gente fala sobre ele.\\\",\\\"actionOpen\\\":\\\"Ver como funciona\\\"},\\\"mechanism\\\":{\\\"place\\\":\\\"o balcão, o quarto, o carro\\\"},\\\"seo\\\":{\\\"primaryTerm\\\":\\\"programa de parceria\\\",\\\"title\\\":\\\"Programa de parceria para quem recebe turista\\\",\\\"description\\\":\\\"Restaurantes, hotéis, transfers e locadoras: veja como o seu negócio pode aparecer para o turista que já usa o Tuggi na sua rua, em qualquer plano dele.\\\"},\\\"cta\\\":{\\\"action\\\":\\\"Quero aparecer no Tuggi\\\"},\\\"FAQ\\\":{\\\"title\\\":\\\"As perguntas que a gente mais ouve\\\",\\\"q1\\\":\\\"Quanto custa?\\\",\\\"a1\\\":\\\"Aparecer no Tuggi não custa nada: você se cadastra, a gente aprova, você expõe o QR Code e, depois da avaliação, o seu local é publicado, encontrado e lido por todo turista. A Tuggi também não fica com parte das suas vendas, e você não paga pelo acesso de ninguém. Quem paga pelo Tuggi é o turista. Existe uma parte paga na parceria, fora dessa lista, e a gente conversa sobre ela com você.\\\",\\\"q2\\\":\\\"Vou precisar mudar alguma coisa na minha operação?\\\",\\\"a2\\\":\\\"Duas coisas. Você põe o QR Code onde o turista já olha — no cardápio, na recepção, no balcão, no encosto do banco — e conta a história do seu lugar para a gente, uma vez só. Fora isso, a parceria não exige integração com o seu sistema, nem equipamento, nem software para a sua equipe operar.\\\",\\\"q3\\\":\\\"O meu lugar entra mesmo no Tuggi?\\\",\\\"a3\\\":\\\"Não é automático, e a gente prefere dizer isso agora. Depois que a parceria é aprovada, o nosso time avalia o seu local. Entram lugares permanentes, abertos ao público e com história própria para contar. Não precisa ser famoso nem antigo. Se faltar alguma coisa, a gente diz o que foi, e você pode corrigir e apresentar de novo.\\\",\\\"q4\\\":\\\"E se o meu local não entrar?\\\",\\\"a4\\\":\\\"Você continua parceiro. O seu QR Code, o turista atribuído a você e a sua participação na receita não dependem disso. Nada do que você já tem some.\\\",\\\"q5\\\":\\\"E se o meu hóspede não fala português?\\\",\\\"a5\\\":\\\"O Tuggi fala {contentLanguages} idiomas com o turista. Quando o seu local está publicado, ele é lido no idioma de quem chegar. E quem está com o guia ligado ouve no mesmo idioma. A gente produz a narração na hora em que alguém pede naquele idioma.\\\",\\\"q6\\\":\\\"Quanto eu ganho com isso?\\\",\\\"a6\\\":\\\"O turista baixa o Tuggi pelo seu QR Code e fica atribuído a você. A partir daí, toda compra que ele faz entra na apuração da sua participação na receita. O percentual é definido em acordo comercial, e é sobre isso que a gente conversa quando você deixa o seu contato aqui embaixo.\\\"},\\\"form\\\":{\\\"title\\\":\\\"O primeiro passo é uma conversa\\\",\\\"body\\\":\\\"Deixe o seu contato e a gente responde pelo canal que você escolher, com o que a parceria faz no seu caso. Deixar o contato não custa nada e não compromete você a nada.\\\",\\\"allRequired\\\":\\\"Todos os campos são obrigatórios.\\\",\\\"name\\\":\\\"Seu nome\\\",\\\"business\\\":\\\"Nome do seu negócio\\\",\\\"businessType\\\":\\\"Tipo de negócio\\\",\\\"businessTypePlaceholder\\\":\\\"Selecione uma opção\\\",\\\"businessTypeOther\\\":\\\"Outro\\\",\\\"channelLegend\\\":\\\"Como você prefere que a gente fale com você?\\\",\\\"channelWhatsapp\\\":\\\"WhatsApp\\\",\\\"channelEmail\\\":\\\"E-mail\\\",\\\"whatsappLabel\\\":\\\"Seu WhatsApp\\\",\\\"whatsappHint\\\":\\\"Com código do país e DDD. Exemplo: +55 21 90000-0000.\\\",\\\"emailLabel\\\":\\\"Seu e-mail\\\",\\\"emailHint\\\":\\\"Pode ser o e-mail que você já usa no dia a dia.\\\",\\\"sending\\\":\\\"Enviando…\\\",\\\"consent\\\":\\\"Autorizo a Tuggi a guardar estes dados e a entrar em contato comigo por ligação, WhatsApp ou e-mail — só sobre esta parceria. Leia a \\u003cpolicy\\u003ePolítica de Privacidade\\u003c/policy\\u003e.\\\",\\\"consentLinkNewTab\\\":\\\"abre em uma nova aba\\\",\\\"errorSummary\\\":\\\"Confira os campos marcados abaixo antes de enviar.\\\",\\\"errorName\\\":\\\"Escreva o seu nome.\\\",\\\"errorBusiness\\\":\\\"Escreva o nome do seu negócio.\\\",\\\"errorBusinessType\\\":\\\"Escolha o tipo de negócio.\\\",\\\"errorWhatsapp\\\":\\\"Escreva o número com código do país e DDD — por exemplo, +55 21 90000-0000.\\\",\\\"errorEmail\\\":\\\"Escreva um e-mail com @ e domínio — por exemplo, nome@exemplo.com.\\\",\\\"errorConsent\\\":\\\"Marque a autorização para a gente poder entrar em contato.\\\",\\\"errorSend\\\":\\\"Não deu para enviar agora. Tente de novo em alguns instantes — o que você escreveu continua aqui.\\\",\\\"successTitle\\\":\\\"Recebemos o seu contato.\\\",\\\"successBody\\\":\\\"A gente fala com você pelo canal que você escolheu, para entender como o turista chega até o seu negócio. O cadastro de parceiro em si é feito depois, dentro do aplicativo do Tuggi — e a gente te mostra o caminho.\\\",\\\"noscript\\\":\\\"Sem JavaScript o envio não funciona. Escreva para {email} e a gente responde.\\\",\\\"proposalBridge\\\":\\\"Já conversou com alguém da Tuggi sobre a sua parceria? Então o seu passo é outro: \\u003cproposal\\u003eenvie a proposta do seu estabelecimento\\u003c/proposal\\u003e, com CNPJ, endereço e a história do lugar.\\\"}},\\\"Segments\\\":{\\\"commercial\\\":{\\\"title\\\":\\\"Como funciona a sua participação na receita\\\",\\\"lead\\\":\\\"Você oferece o Tuggi ao seu cliente. Quando ele compra, uma parte da venda volta para você.\\\",\\\"note\\\":\\\"O percentual é definido em acordo comercial.\\\"},\\\"steps\\\":{\\\"title\\\":\\\"Como funciona a parceria\\\",\\\"s1Title\\\":\\\"Você se cadastra e a gente aprova\\\",\\\"s1Body\\\":\\\"O cadastro é feito no aplicativo do Tuggi. A nossa equipe confere os dados e aprova a parceria.\\\",\\\"s2Title\\\":\\\"Você exibe o seu QR Code\\\",\\\"s2Body\\\":\\\"Depois de aprovado, você recebe o seu QR Code e o coloca onde o turista já está: {place}. Quem baixa o Tuggi por esse código fica atribuído a você.\\\",\\\"s3Title\\\":\\\"A sua participação na receita\\\",\\\"s3Body\\\":\\\"Toda compra feita pelo turista atribuído a você conta para a sua participação na receita. O percentual é definido em acordo comercial.\\\",\\\"s4Title\\\":\\\"O seu local pode entrar no Tuggi\\\",\\\"s4Body\\\":\\\"Aprovada a parceria, o nosso time avalia se cadastra o seu local como ponto de interesse. É uma decisão editorial da Tuggi, e não é automática. Em até {partnerTriageHours} horas após a aprovação você tem o desfecho. E o seu QR Code e a sua participação na receita não dependem dele.\\\",\\\"lead\\\":\\\"Do seu lado são duas coisas: exibir o QR Code e nos contar a história do seu lugar. O resto acontece no celular do turista.\\\"},\\\"cta\\\":{\\\"title\\\":\\\"Conte como o turista chega até você\\\",\\\"body\\\":\\\"A gente responde com o que a parceria faz no seu caso, sem compromisso.\\\",\\\"action\\\":\\\"Falar com a Tuggi\\\"},\\\"car-rental\\\":{\\\"hub\\\":{\\\"cardTitle\\\":\\\"Locadoras de carro\\\",\\\"cardBody\\\":\\\"O turista retira o carro e já leva o guia com ele. O QR Code fica no balcão ou dentro do veículo.\\\"}},\\\"lodging\\\":{\\\"hub\\\":{\\\"cardTitle\\\":\\\"Hotéis e pousadas\\\",\\\"cardBody\\\":\\\"O hóspede chega sem saber o que fazer na cidade. O QR Code fica na recepção ou no quarto.\\\"}},\\\"transfer\\\":{\\\"hub\\\":{\\\"cardTitle\\\":\\\"Transfer e táxi\\\",\\\"cardBody\\\":\\\"Do aeroporto ao hotel é a primeira meia hora de viagem. O QR Code fica no encosto do banco ou na janela.\\\"}},\\\"motorhome\\\":{\\\"hub\\\":{\\\"cardTitle\\\":\\\"Motorhome\\\",\\\"cardBody\\\":\\\"Quem viaja de motorhome passa o dia na estrada. O QR Code vai na entrega do veículo, junto com as chaves.\\\"}},\\\"restaurants\\\":{\\\"hub\\\":{\\\"cardTitle\\\":\\\"Restaurantes\\\",\\\"cardBody\\\":\\\"Quem senta para comer tem tempo de ouvir. O QR Code fica no cardápio ou na conta.\\\"}},\\\"receptive\\\":{\\\"hub\\\":{\\\"cardTitle\\\":\\\"Receptivos e passeios\\\",\\\"cardBody\\\":\\\"O passageiro passa o dia com você e quer ouvir sobre o que está vendo. O QR Code fica no voucher ou no ponto de encontro.\\\"}}},\\\"Technology\\\":{\\\"Hero\\\":{\\\"eyebrow\\\":\\\"Visão geral da arquitetura\\\",\\\"title\\\":\\\"Infraestrutura de Áudio Espacial Enterprise-Grade.\\\",\\\"subtitle\\\":\\\"Construída para escala e resiliência.\\\"},\\\"Comparison\\\":{\\\"title\\\":\\\"Estar perto não é estar de frente\\\",\\\"subtitle\\\":\\\"Dois jeitos de decidir quando a história começa. A diferença está na direção em que você se move.\\\",\\\"radiusLabel\\\":\\\"Raio de proximidade\\\",\\\"radiusBody\\\":\\\"É o padrão do mercado. Tudo o que está dentro do raio conta igual, inclusive o que já ficou para trás. O resultado é uma lista do que existe ao seu redor.\\\",\\\"coneLabel\\\":\\\"Direção do movimento\\\",\\\"coneBody\\\":\\\"É o que o Tuggi faz. A direção em que você se move escolhe um lugar só: o que está diante dos seus olhos. É a história dele que você ouve, na hora em que ele aparece.\\\"},\\\"Data\\\":{\\\"col2Title\\\":\\\"Serverless e Pronto para Mega-Eventos.\\\",\\\"col2Desc\\\":\\\"Apoiado por CDNs globais e arquitetura de edge computing, pronto para lidar com picos massivos de tráfego durante eventos como Copa do Mundo ou Olimpíadas.\\\"}},\\\"Drive\\\":{\\\"Hero\\\":{\\\"title\\\":\\\"Guias de Viagem em Áudio Autoguiados, Mãos-Livres.\\\",\\\"subtitle\\\":\\\"Sem rolar a tela. Sem pesquisar. Defina seu idioma e o TUGGI toca guias de viagem em áudio autoguiados sobre cada lugar que você passa — de carro, a pé ou de bike. Mãos-livres, offline, olhos na paisagem.\\\",\\\"downloadApp\\\":\\\"Baixar na App Store\\\",\\\"downloadPlay\\\":\\\"Disponível no Google Play\\\",\\\"animatorLabel\\\":\\\"Reproduzindo\\\",\\\"animatorPoi\\\":\\\"Miradouro da Serra\\\",\\\"animatorAhead\\\":\\\"À sua direita\\\",\\\"stopGuide\\\":\\\"Parar Guia\\\",\\\"startGuide\\\":\\\"Iniciar Guia\\\",\\\"ccText\\\":\\\"Miradouro da Serra, a 847 metros de altitude, oferece uma das vistas mais deslumbrantes da região serrana, com uma panorâmica de 360° para os vales e montanhas ao redor...\\\"},\\\"Samples\\\":{\\\"tag\\\":\\\"Curadoria Premium\\\",\\\"title\\\":\\\"Ouça o que você desbloqueia\\\",\\\"subtitle\\\":\\\"Cada viagem de carro, caminhada ou passeio de bike ganha vida com histórias que você nunca encontraria sozinho. Sem roteiros fixos — seu guia em áudio autoguiado toca automaticamente, exatamente em cada ponto.\\\"},\\\"Features\\\":{\\\"title\\\":\\\"Incluído em todos os passes\\\",\\\"feat1Title\\\":\\\"Modo 100% Offline\\\",\\\"feat1Desc\\\":\\\"Baixe o pacote da cidade no seu hotel. Zero cobranças de roaming de dados na estrada.\\\",\\\"feat3Title\\\":\\\"Áudio Multilíngue\\\",\\\"feat3Desc\\\":\\\"Narrativas de alta fidelidade em {contentLanguages} idiomas nativos.\\\"},\\\"Pricing\\\":{\\\"kicker\\\":\\\"Passes Tuggi\\\",\\\"title\\\":\\\"Você só gasta com o guia ligado.\\\",\\\"subtitle\\\":\\\"Suas horas não expiram. Desligue o guia quando quiser e continue na próxima viagem.\\\",\\\"anchor\\\":\\\"Menos que um único tour guiado — e narra a viagem inteira.\\\",\\\"chip2\\\":\\\"Pagamento único\\\",\\\"chip3\\\":\\\"Sem renovação automática\\\",\\\"recommended\\\":\\\"RECOMENDADO\\\",\\\"pass1Title\\\":\\\"10 horas\\\",\\\"pass1Desc\\\":\\\"um bate e volta\\\",\\\"pass1Action\\\":\\\"Comprar 10 horas no app\\\",\\\"pass2Title\\\":\\\"25 horas\\\",\\\"pass2Desc\\\":\\\"um fim de semana\\\",\\\"pass2Action\\\":\\\"Comprar 25 horas no app\\\",\\\"pass3Title\\\":\\\"45 horas\\\",\\\"pass3Desc\\\":\\\"uma viagem inteira\\\",\\\"pass3Action\\\":\\\"Comprar 45 horas no app\\\",\\\"priceInStore\\\":\\\"Preço na loja\\\",\\\"passesNote\\\":\\\"Pagamento único. As horas de passes diferentes se somam.\\\",\\\"storeNoteWithPrice\\\":\\\"A compra é feita dentro do app. Estes são os preços que a App Store e o Google Play cobram aqui, e você confirma antes de pagar.\\\",\\\"storeNoteNoPrice\\\":\\\"A compra é feita dentro do app. Cada país tem o seu preço na App Store e no Google Play. Você vê o valor exato, na sua moeda, antes de confirmar.\\\",\\\"freeTitle\\\":\\\"Explorar\\\",\\\"freePrice\\\":\\\"Grátis\\\",\\\"free1\\\":\\\"Comece com o guia completo, ativado por você no app\\\",\\\"free2\\\":\\\"Depois, o app segue grátis com histórias todo dia\\\",\\\"free3\\\":\\\"Sem cartão\\\",\\\"freeAction\\\":\\\"Começar grátis\\\"},\\\"Conversion\\\":{\\\"title\\\":\\\"Todo lugar tem uma história. Comece a ouvir hoje.\\\",\\\"downloadApp\\\":\\\"Baixar na App Store\\\",\\\"downloadPlay\\\":\\\"Disponível no Google Play\\\",\\\"qrCaption\\\":\\\"Aponte a câmera para baixar\\\"},\\\"FAQ\\\":{\\\"title\\\":\\\"Perguntas Frequentes\\\",\\\"q1\\\":\\\"O TUGGI é gratuito?\\\",\\\"a1\\\":\\\"Sim. Comece de graça, com histórias todo dia. Para ouvir sem limite diário, um Passe Tuggi dá 10, 25 ou 45 horas de uso — pagamento único, e as horas só correm com o guia ligado.\\\",\\\"q2\\\":\\\"O TUGGI funciona offline?\\\",\\\"a2\\\":\\\"Sim. Baixe a rota com antecedência e ouça sem sinal — sem cobranças de roaming.\\\",\\\"q3\\\":\\\"Qual a diferença entre o TUGGI e o Google Maps ou um GPS?\\\",\\\"a3\\\":\\\"O TUGGI não é um app de navegação. Ele roda junto com seu navegador e sua música, e toca guias de viagem em áudio autoguiados sobre os lugares que você passa — mãos-livres, sem olhar para a tela.\\\",\\\"q4\\\":\\\"Quais idiomas o TUGGI suporta?\\\",\\\"a4\\\":\\\"Áudio em {contentLanguages} idiomas, com legendas sincronizadas para que viajantes com deficiência auditiva acompanhem cada história.\\\",\\\"q5\\\":\\\"Posso usar o TUGGI caminhando ou de bike?\\\",\\\"a5\\\":\\\"Sim — viagens de carro, passeios a pé, ciclismo e viagens em família, tudo funciona.\\\",\\\"q6\\\":\\\"Preciso olhar para o celular?\\\",\\\"a6\\\":\\\"Não. O áudio é acionado automaticamente pela localização, mãos-livres e com a tela desligada.\\\"},\\\"Accessibility\\\":{\\\"title\\\":\\\"Acessibilidade completa\\\",\\\"body\\\":\\\"Legendas sincronizadas com o áudio permitem que viajantes surdos ou com baixa audição acompanhem cada história. E como o TUGGI é áudio em primeiro lugar, viajantes com baixa visão exploram sem precisar ler.\\\"},\\\"PlansHero\\\":{\\\"title\\\":\\\"Escolha o seu passe\\\",\\\"subtitle\\\":\\\"Baixe e comece sem cartão e sem assinar nada. O guia completo é você quem ativa, dentro do app — e depois o app continua grátis, com histórias todo dia.\\\",\\\"appStoreAlt\\\":\\\"Baixe o TUGGI na App Store\\\",\\\"playStoreAlt\\\":\\\"Baixe o TUGGI no Google Play\\\"},\\\"Comparison\\\":{\\\"title\\\":\\\"Como o TUGGI se compara\\\",\\\"colGuide\\\":\\\"Guia particular\\\",\\\"colAudio\\\":\\\"Tours de áudio tradicionais\\\",\\\"colTuggi\\\":\\\"TUGGI\\\",\\\"rowCost\\\":\\\"Custo\\\",\\\"costGuide\\\":\\\"Diária de guia\\\",\\\"costAudio\\\":\\\"Pago por tour, por cidade\\\",\\\"costTuggi\\\":\\\"Um passe, a viagem inteira\\\",\\\"rowLang\\\":\\\"Idiomas\\\",\\\"langGuide\\\":\\\"O idioma do guia\\\",\\\"langAudio\\\":\\\"Poucos por tour\\\",\\\"langTuggi\\\":\\\"{contentLanguages} idiomas\\\",\\\"rowRoute\\\":\\\"Caminho\\\",\\\"routeGuide\\\":\\\"O roteiro do guia\\\",\\\"routeAudio\\\":\\\"Rota fixa a seguir\\\",\\\"routeTuggi\\\":\\\"Qualquer caminho que você escolher\\\",\\\"rowDrive\\\":\\\"Ao volante\\\",\\\"driveAudio\\\":\\\"Toque na tela a cada parada\\\",\\\"driveTuggi\\\":\\\"Automático, mãos-livres\\\",\\\"rowOffline\\\":\\\"Offline\\\",\\\"offlineAudio\\\":\\\"Varia\\\",\\\"offlineTuggi\\\":\\\"Sempre\\\",\\\"rowCaptions\\\":\\\"Legendas sincronizadas\\\",\\\"captionsAudio\\\":\\\"Raro\\\",\\\"captionsTuggi\\\":\\\"Em todas as histórias\\\",\\\"notApplicable\\\":\\\"Não se aplica\\\",\\\"footnote\\\":\\\"O TUGGI roda junto com seu app de navegação e sua música.\\\"},\\\"Sticky\\\":{\\\"text\\\":\\\"Comece grátis — sem cartão\\\",\\\"cta\\\":\\\"Baixar\\\"},\\\"PlansExplainer\\\":{\\\"title\\\":\\\"Como funcionam os Passes Tuggi\\\",\\\"p1\\\":\\\"Dá pra usar o TUGGI de graça: você baixa, e o guia completo é liberado por você mesmo, com um toque, dentro do app — sem cartão e sem assinar nada. Depois, o app continua gratuito com um número limitado de histórias por dia, então você explora no seu ritmo antes de decidir.\\\",\\\"p2\\\":\\\"Quando quiser ouvir sem limite diário, escolha um passe: 10 horas para um bate e volta, 25 para um fim de semana, 45 para uma viagem inteira. São horas de uso, não dias no calendário — o tempo só corre com o guia ligado, e o que sobrar fica esperando a próxima viagem. Pagamento único, sem renovação automática.\\\",\\\"p3\\\":\\\"Todos os passes incluem mapas e áudio 100% offline, legendas sincronizadas e os {contentLanguages} idiomas. Os valores variam por país e você vê o preço exato na App Store ou no Google Play antes de confirmar. Nada é cobrado sem a sua confirmação na loja.\\\"}},\\\"Contact\\\":{\\\"Hero\\\":{\\\"title\\\":\\\"Fale com o TUGGI.\\\",\\\"subtitle\\\":\\\"Selecione como podemos ajudar você hoje para ser direcionado à equipe certa.\\\"},\\\"Triage\\\":{\\\"card1Title\\\":\\\"Cidade / Governo\\\",\\\"card1Desc\\\":\\\"Eu represento um município ou autoridade regional.\\\",\\\"card2Title\\\":\\\"Frotas / Locadoras\\\",\\\"card2Desc\\\":\\\"Eu represento uma frota corporativa ou agência de aluguel.\\\",\\\"card3Title\\\":\\\"Turista / Usuário do App\\\",\\\"card3Desc\\\":\\\"Eu sou um motorista ou passageiro precisando de suporte.\\\"},\\\"B2G\\\":{\\\"fullName\\\":\\\"Nome Completo\\\",\\\"role\\\":\\\"Cargo Oficial / Função\\\",\\\"city\\\":\\\"Município / Nome da Cidade\\\",\\\"email\\\":\\\"E-mail Profissional\\\",\\\"emailError\\\":\\\"Por favor, use um e-mail governamental oficial.\\\",\\\"cta\\\":\\\"Solicitar Demo City OS\\\"},\\\"B2B\\\":{\\\"fullName\\\":\\\"Nome Completo\\\",\\\"company\\\":\\\"Nome da Empresa\\\",\\\"email\\\":\\\"E-mail Profissional\\\",\\\"fleetSize\\\":\\\"Tamanho Estimado da Frota\\\",\\\"fleetTarget\\\":\\\"Selecione o tamanho da frota\\\",\\\"emailError\\\":\\\"Por favor, use um e-mail corporativo.\\\",\\\"cta\\\":\\\"Contatar Vendas B2B\\\"},\\\"B2C\\\":{\\\"desc\\\":\\\"Precisa de ajuda com a sua viagem? Nossa equipe de suporte está pronta para ajudar.\\\",\\\"cta\\\":\\\"Enviar E-mail para o Suporte\\\"},\\\"Sidebar\\\":{\\\"hqTitle\\\":\\\"Sede Corporativa\\\",\\\"hqValue\\\":\\\"São Paulo, SP, Brasil\\\",\\\"slaTitle\\\":\\\"SLA de Vendas\\\",\\\"slaValue\\\":\\\"Nossos especialistas corporativos geralmente respondem em até 24 horas úteis.\\\",\\\"pressTitle\\\":\\\"Imprensa, Parcerias e Suporte\\\",\\\"pressValue\\\":\\\"suporte@tuggi.app\\\"},\\\"Success\\\":{\\\"title\\\":\\\"Solicitação recebida.\\\",\\\"body\\\":\\\"Obrigado pelo seu interesse. Um especialista entra em contato pelo seu e-mail corporativo em breve.\\\",\\\"again\\\":\\\"Enviar outra mensagem\\\"}},\\\"Legal\\\":{\\\"Sidebar\\\":{\\\"title\\\":\\\"Legal e Compliance\\\",\\\"terms\\\":\\\"Termos de Uso\\\",\\\"privacy\\\":\\\"Política de Privacidade\\\",\\\"deletion\\\":\\\"Exclusão de Dados\\\",\\\"security\\\":\\\"SLA de Segurança\\\",\\\"accessibility\\\":\\\"Acessibilidade e Inclusão\\\"},\\\"Terms\\\":{\\\"title\\\":\\\"Termos de Uso\\\",\\\"lastUpdated\\\":\\\"Fevereiro 2026\\\",\\\"intro\\\":\\\"Bem-vindo ao TUGGI. Ao criar uma conta, fazer login via plataformas parceiras ou utilizar nosso aplicativo, você concorda expressamente com os termos descritos abaixo.\\\",\\\"s1Title\\\":\\\"1. Elegibilidade e Criação de Conta\\\",\\\"s1Item1\\\":\\\"\\u003cstrong\\u003eIdade Mínima:\\u003c/strong\\u003e O TUGGI é um aplicativo cultural e educativo. A idade mínima para criar uma conta e utilizar o serviço como ouvinte é de 13 anos.\\\",\\\"s1Item2\\\":\\\"\\u003cstrong\\u003eResponsabilidade ao Volante:\\u003c/strong\\u003e Se você for o condutor do veículo, você declara e garante que possui a idade legal e a habilitação necessária exigidas pelas leis do seu país ou estado para dirigir.\\\",\\\"s1Item3\\\":\\\"\\u003cstrong\\u003eVeracidade dos Dados:\\u003c/strong\\u003e Você concorda em não criar contas em nome de terceiros ou usar identidades falsas.\\\",\\\"s2Title\\\":\\\"2. A Regra de Ouro: Isenção de Responsabilidade no Trânsito (Safety First)\\\",\\\"s2Item1\\\":\\\"\\u003cstrong\\u003eO TUGGI foi estritamente projetado para operar em segundo plano (hands-free).\\u003c/strong\\u003e\\\",\\\"s2Item2\\\":\\\"\\u003cstrong\\u003eVocê é o único responsável pela condução do veículo.\\u003c/strong\\u003e O aplicativo não substitui sua atenção à via, às placas de sinalização ou às condições do tráfego.\\\",\\\"s2Item3\\\":\\\"A TUGGI Technologies, bem como seus parceiros governamentais e corporativos, isentam-se integralmente de qualquer responsabilidade por acidentes, danos materiais/físicos, ou multas de trânsito incorridas durante o uso do aplicativo. Respeite sempre as leis de trânsito locais.\\\",\\\"s3Title\\\":\\\"3. Limitações da Tecnologia (Inteligência Artificial e GPS)\\\",\\\"s3Item1\\\":\\\"\\u003cstrong\\u003eSinais de Localização:\\u003c/strong\\u003e Nosso motor de gatilhos espaciais depende de sinais de GPS de terceiros e mapeamento colaborativo (como o OpenStreetMap). Não garantimos a precisão absoluta do gatilho em áreas de sombra de rede, como túneis ou vales profundos.\\\",\\\"s3Item2\\\":\\\"\\u003cstrong\\u003eConteúdo Assistido por IA:\\u003c/strong\\u003e Nossas narrativas em áudio são compiladas e geradas usando uma combinação de curadoria manual e modelos avançados de Inteligência Artificial (IA). O conteúdo narrado possui caráter cultural e de entretenimento. A TUGGI fornece o conteúdo \\\\\\\"no estado em que se encontra\\\\\\\" (as-is) e não garante precisão acadêmica, histórica ou geográfica absoluta, não se responsabilizando por divergências factuais.\\\",\\\"s4Title\\\":\\\"4. Reporte de Conteúdo e Correções (Safe Harbor)\\\",\\\"s4Text\\\":\\\"Estamos comprometidos em manter um ambiente cultural respeitoso e preciso. Caso encontre informações incorretas, imprecisões culturais, ou caso seja o proprietário de um local e deseje solicitar a remoção de um Ponto de Interesse (POI), fale conosco pela página de Contato, escolhendo o perfil que descreve você. Nossa equipe analisa todos os feedbacks e reserva-se o direito de corrigir, alterar ou remover gatilhos a nosso exclusivo critério.\\\",\\\"s5Title\\\":\\\"5. Conduta Cívica e Uso em Público\\\",\\\"s5Text\\\":\\\"Ao utilizar o aplicativo em transporte público, vias de pedestres ou veículos compartilhados, solicitamos o uso de fones de ouvido ou o consentimento prévio dos demais passageiros.\\\",\\\"s6Title\\\":\\\"6. Assinaturas, Passes de Viagem e Reembolsos\\\",\\\"s6Item1\\\":\\\"\\u003cstrong\\u003ePasses de Viagem:\\u003c/strong\\u003e O TUGGI oferece diferentes níveis de acesso: (a) Passes de 7 e 30 dias são compras únicas e não possuem renovação automática; (b) O Passe Anual é uma assinatura com renovação automática.\\\",\\\"s6Item2\\\":\\\"\\u003cstrong\\u003eAssinaturas na App Store (Plano Anual):\\u003c/strong\\u003e Para assinaturas de renovação automática, o pagamento será cobrado na sua Conta da Loja na confirmação da compra. A assinatura é renovada automaticamente, a menos que a renovação automática seja desativada pelo menos 24 horas antes do final do período atual. Sua conta será cobrada pela renovação dentro de 24 horas antes do final do período atual. Você pode gerenciar ou desativar a renovação automática nas Configurações da sua Conta a qualquer momento após a compra.\\\",\\\"s6Item3\\\":\\\"\\u003cstrong\\u003eLegislação Local:\\u003c/strong\\u003e Respeitamos o Direito de Arrependimento de 7 dias (CDC), aplicável apenas quando a compra for processada diretamente por nossos sistemas web, e estritamente se o serviço digital não houver sido parcial ou totalmente consumido (utilização dos gatilhos de áudio).\\\",\\\"s7Title\\\":\\\"7. Jurisdição e Foro\\\",\\\"s7Text\\\":\\\"Estes Termos de Uso são regidos pelas leis da República Federativa do Brasil. Fica eleito o foro da Comarca de São Paulo, Estado de São Paulo, para dirimir quaisquer controvérsias oriundas da utilização do TUGGI, com renúncia expressa a qualquer outro.\\\",\\\"s8Title\\\":\\\"8. Apple App Store e Google Play Store (Cláusulas Obrigatórias)\\\",\\\"s8Item1\\\":\\\"\\u003cstrong\\u003eReconhecimento:\\u003c/strong\\u003e Você reconhece que estes Termos são celebrados entre você e a TUGGI apenas, e não com a Apple ou o Google. A TUGGI é a única responsável pelo Aplicativo e seu conteúdo.\\\",\\\"s8Item2\\\":\\\"\\u003cstrong\\u003eManutenção e Suporte:\\u003c/strong\\u003e Você reconhece que a Apple e o Google não têm qualquer obrigação de fornecer serviços de manutenção e suporte para o Aplicativo.\\\",\\\"s8Item3\\\":\\\"\\u003cstrong\\u003eGarantia e Reembolsos:\\u003c/strong\\u003e Em caso de falha do Aplicativo em conformar-se com qualquer garantia aplicável, a única obrigação da Apple/Google é reembolsar o preço de compra. Na extensão máxima permitida por lei, a Apple/Google não terá qualquer outra obrigação de garantia.\\\",\\\"s8Item4\\\":\\\"\\u003cstrong\\u003eReivindicações de Produto e Propriedade Intelectual:\\u003c/strong\\u003e A TUGGI, não a Apple ou o Google, é responsável por lidar com quaisquer reivindicações relacionadas ao Aplicativo (ex: responsabilidade pelo produto, conformidade legal) e pela investigação, defesa, liquidação e quitação de quaisquer reivindicações de violação de propriedade intelectual de terceiros.\\\",\\\"s8Item5\\\":\\\"\\u003cstrong\\u003eConformidade Legal:\\u003c/strong\\u003e Você declara e garante que (i) não está localizado em um país sujeito a embargo do governo dos EUA ou designado como país apoiador de terroristas; e (ii) não consta em nenhuma lista de partes proibidas ou restritas do governo dos EUA.\\\",\\\"s8Item6\\\":\\\"\\u003cstrong\\u003eBeneficiário Terceiro:\\u003c/strong\\u003e Você reconhece e concorda que a Apple e o Google, e suas subsidiárias, são beneficiários terceiros destes Termos e têm o direito de fazer cumprir estes Termos contra você.\\\",\\\"s9Title\\\":\\\"9. Informações de Contato do Desenvolvedor\\\",\\\"s9Text\\\":\\\"TUGGI Technologies Ltda. São Paulo, SP, Brasil. E-mail: suporte@tuggi.app\\\"},\\\"Privacy\\\":{\\\"title\\\":\\\"Política de Privacidade\\\",\\\"lastUpdated\\\":\\\"Agosto/2026\\\",\\\"intro\\\":\\\"A TUGGI Technologies valoriza a sua privacidade. Esta política descreve como coletamos, usamos, protegemos e tratamos os seus dados, em estrita conformidade com a Lei Geral de Proteção de Dados (LGPD - Brasil) e o Regulamento Geral sobre a Proteção de Dados (GDPR - União Europeia).\\\",\\\"s1Title\\\":\\\"1. Dados que Coletamos\\\",\\\"s1Intro\\\":\\\"Para que o TUGGI funcione como seu copiloto cultural, coletamos as informações abaixo. A lista não para no aplicativo. Ela inclui também os dados de quem procura a Tuggi para fazer uma parceria, mesmo sem nunca ter tido conta.\\\",\\\"s1Item1\\\":\\\"\\u003cstrong\\u003eDados de Conta e Autenticação:\\u003c/strong\\u003e Ao criar uma conta via e-mail ou provedores parceiros (Google, Apple, Facebook), recebemos dados básicos de perfil (Nome, E-mail e ID de usuário gerado pela nossa infraestrutura segura do Supabase).\\\",\\\"s1Item2\\\":\\\"\\u003cstrong\\u003eDados de Geolocalização (GPS):\\u003c/strong\\u003e O TUGGI necessita de acesso à sua localização em tempo real (inclusive em segundo plano) para acionar os gatilhos de áudio no momento exato em que você cruza um Ponto de Interesse (POI).\\\",\\\"s1Item3\\\":\\\"\\u003cstrong\\u003eDados de Uso e Telemetria:\\u003c/strong\\u003e Coletamos informações sobre interações no aplicativo, como quais áudios foram reproduzidos, idiomas selecionados e métricas de estabilidade do sistema.\\\",\\\"s1Item4\\\":\\\"\\u003cstrong\\u003eDados de Contato Comercial:\\u003c/strong\\u003e Quando você deixa um contato no formulário da página de parcerias deste site, guardamos o que você escreveu ali. São o seu nome, o nome do seu negócio, o tipo de negócio e o canal que você escolheu, WhatsApp ou e-mail. Guardamos também o idioma em que a página estava. A cidade aproximada vem da sua conexão, e junto com o seu contato guardamos essa cidade, não o endereço de IP. Usamos esses dados para uma finalidade só, que é falar com você sobre a parceria, por ligação telefônica ou por mensagem. São no máximo 4 tentativas de contato, dentro de 14 dias corridos a partir do envio. O ciclo termina no que vier primeiro, e depois dele não usamos mais o seu contato para isso. Para retomar, basta enviar o formulário de novo. Nunca usamos esse contato para newsletter, lista de transmissão ou campanha de marketing. Você pode pedir a remoção quando quiser, e a seção 5 diz como.\\\",\\\"s1Item5\\\":\\\"$2f\\\",\\\"s1Item6\\\":\\\"\\u003cstrong\\u003eA História do Lugar:\\u003c/strong\\u003e Nesse mesmo formulário fazemos até quatro perguntas sobre a história do lugar, e as respostas são texto livre. Elas não são material interno e não são confidenciais. Elas são o insumo do texto que o aplicativo pode narrar ao turista, reescrito por nós e traduzido para os idiomas do aplicativo. Então escreva ali só o que você aceita ver publicado, inclusive o nome de alguém que você cite.\\\",\\\"s1Item7\\\":\\\"\\u003cstrong\\u003eRegistro do Aceite do Contrato:\\u003c/strong\\u003e Quando alguém aceita o contrato de parceria na tela, guardamos o registro desse ato. Ele tem o nome e o cargo de quem aceitou, o e-mail para onde enviamos o link, a data e a hora do nosso servidor, o endereço de IP da conexão, a identificação que o navegador declara, o código do documento exibido e a versão do modelo. Aqui o endereço de IP fica guardado como está, e não transformado em código, porque a finalidade é outra. Esse registro serve para uma coisa só, que é provar quem aceitou o contrato, o que ele aceitou, quando e de onde. Ele não alimenta métrica, não serve para contato, e fica guardado como prova do contrato.\\\",\\\"s1Item8\\\":\\\"$30\\\",\\\"s2Title\\\":\\\"2. Como Usamos os Seus Dados (Telemetria Anonimizada)\\\",\\\"s2Item1\\\":\\\"\\u003cstrong\\u003eOperação do Serviço:\\u003c/strong\\u003e Utilizamos a sua localização estritamente para calcular o vetor de direção e a proximidade aos gatilhos culturais, garantindo a entrega do áudio no timing correto.\\\",\\\"s2Item2\\\":\\\"\\u003cstrong\\u003eInteligência Territorial (O Padrão B2G):\\u003c/strong\\u003e Os dados de geolocalização e reprodução de áudio são \\u003cstrong\\u003edesvinculados da sua identidade pessoal (anonimizados)\\u003c/strong\\u003e antes de serem armazenados para análises de fluxo. Fornecemos relatórios agregados para Governos e Locadoras (ex: \\\\\\\"Quantas reproduções ocorreram no monumento X hoje\\\\\\\") sem nunca expor quem foi o usuário. Nesses relatórios rastreamos fluxos culturais, não indivíduos.\\\",\\\"s3Title\\\":\\\"3. Compartilhamento de Dados\\\",\\\"s3Item1\\\":\\\"\\u003cstrong\\u003eNão vendemos seus dados.\\u003c/strong\\u003e A TUGGI não comercializa Dados Pessoais Identificáveis (PII) com corretores de dados (data brokers) ou redes de anúncios.\\\",\\\"s3Item2\\\":\\\"Além do caso descrito abaixo, compartilhamos dados só com fornecedores de infraestrutura estritamente necessários para o funcionamento do app, como serviços de nuvem seguros (ex: Supabase para banco de dados/autenticação e Google Cloud para o motor de Text-to-Speech). Estes parceiros operam sob rigorosos acordos de confidencialidade.\\\",\\\"s3Item3\\\":\\\"\\u003cstrong\\u003eO Identificador da Visita ao Parceiro:\\u003c/strong\\u003e No Android, esse identificador viaja dentro do link da Google Play, então o Google o recebe quando você vai instalar o aplicativo pela loja. Ele é um código do nosso lado, e não leva o seu nome nem o seu e-mail. No iPhone esse caminho não existe. Lá copiamos o mesmo identificador para a área de transferência do seu aparelho, no instante em que você toca no botão, para o aplicativo ler quando abrir pela primeira vez.\\\",\\\"s4Title\\\":\\\"4. Segurança e Retenção\\\",\\\"s4Item1\\\":\\\"Empregamos criptografia de ponta a ponta em trânsito e em repouso. O acesso aos bancos de dados corporativos e do painel City OS é protegido por Controle de Acesso Baseado em Funções (RBAC), assegurando o isolamento dos dados.\\\",\\\"s4Item2\\\":\\\"Retemos seus dados pessoais apenas pelo tempo necessário para fornecer o serviço. Dados anonimizados de telemetria podem ser retidos permanentemente para aprimoramento do produto.\\\",\\\"s5Title\\\":\\\"5. Os Seus Direitos (LGPD e GDPR)\\\",\\\"s5Intro\\\":\\\"Você tem controle total sobre os seus dados. A qualquer momento, você pode solicitar:\\\",\\\"s5Item1\\\":\\\"Acesso, correção ou portabilidade das suas informações.\\\",\\\"s5Item2\\\":\\\"A revogação do consentimento de uso do GPS (o que impossibilitará o funcionamento principal do aplicativo).\\\",\\\"s5ItemO1\\\":\\\"\\u003cstrong\\u003eA exclusão definitiva da sua conta e dos seus dados pessoais.\\u003c/strong\\u003e Para exercer este direito, acesse nossa \\\",\\\"s5ItemO2\\\":\\\"Página de Exclusão de Dados\\\",\\\"s5ItemO3\\\":\\\" ou utilize a função nativa dentro do aplicativo.\\\",\\\"s5ItemLead1\\\":\\\"\\u003cstrong\\u003eA remoção do contato comercial que você deixou num formulário do site\\u003c/strong\\u003e, mesmo que você nunca tenha tido uma conta no aplicativo. Escreva para \\\",\\\"s5ItemLeadEmail\\\":\\\"suporte@tuggi.app\\\",\\\"s5ItemLead2\\\":\\\" pedindo a remoção: encerramos o contato em andamento e apagamos os seus dados da nossa lista de contatos comerciais. A página de exclusão de dados serve só para contas do aplicativo.\\\",\\\"s5ItemPartner1\\\":\\\"\\u003cstrong\\u003eA remoção dos dados que você mandou numa proposta de parceria\\u003c/strong\\u003e, no que não for necessário à parceria em andamento. Escreva para \\\",\\\"s5ItemPartner2\\\":\\\" dizendo o que você quer remover. Se você pedir para não ser mais contatado, o contato para na hora. O registro do aceite de um contrato já assinado continua guardado como prova dele, e um pedido de remoção de contato não apaga esse registro.\\\",\\\"s6Title\\\":\\\"6. Contato do Encarregado de Dados (DPO)\\\",\\\"s6P1\\\":\\\"Se você tiver dúvidas sobre esta política ou sobre o tratamento dos seus dados, entre em contato com o nosso Data Protection Officer (DPO) através da nossa página de \\\",\\\"s6P2\\\":\\\"Contato\\\",\\\"s6P3\\\":\\\", escolhendo o perfil que descreve você.\\\",\\\"s7Title\\\":\\\"7. Privacidade Infantil\\\",\\\"s7Text\\\":\\\"O TUGGI não coleta intencionalmente dados de crianças menores de 13 anos sem o consentimento dos pais ou responsáveis. Se descobrirmos que coletamos tais dados, tomaremos medidas para excluí-los imediatamente.\\\"},\\\"DataDeletion\\\":{\\\"title\\\":\\\"Protocolo de Exclusão de Dados\\\",\\\"intro\\\":\\\"Você possui controle absoluto sobre sua telemetria e registros de conta. No TUGGI, garantimos que o seu direito ao esquecimento seja respeitado em toda a nossa infraestrutura.\\\",\\\"formTitle\\\":\\\"Solicitar Exclusão de Conta\\\",\\\"formDesc\\\":\\\"Insira o e-mail da sua conta abaixo. Nossa equipe revisará sua solicitação e processará a exclusão em até 24-48 horas úteis. Você receberá um e-mail de confirmação assim que o processo for concluído.\\\",\\\"s1Title\\\":\\\"O que acontece com os meus dados?\\\",\\\"s1Desc\\\":\\\"Quando você executa uma solicitação de exclusão:\\\",\\\"s1Item1\\\":\\\"Seu perfil de conta e credenciais de login são permanentemente removidos do nosso provedor de Autenticação.\\\",\\\"s1Item2\\\":\\\"Todos os identificadores de dispositivo vinculados às suas sessões anteriores são apagados do nosso banco de dados de telemetria.\\\",\\\"s1Item3\\\":\\\"Quaisquer dados de fluxo anonimizados gerados anteriormente permanecem no agregado, mas jamais poderão ser reassociados à sua identidade.\\\",\\\"Form\\\":{\\\"placeholder\\\":\\\"seu@email.com\\\",\\\"submit\\\":\\\"Solicitar Exclusão de Dados\\\",\\\"success\\\":\\\"Recebido - Retornamos em 48h\\\"}},\\\"Security\\\":{\\\"title\\\":\\\"Governança, Segurança e Disponibilidade\\\",\\\"subtitle\\\":\\\"Compromisso de Confiança.\\\",\\\"s1Title\\\":\\\"1. Curadoria Global TUGGI\\\",\\\"s1Desc\\\":\\\"A TUGGI mantém sua curadoria padrão via CMS, utilizando fontes verificadas e inteligência artificial.\\\",\\\"s2Title\\\":\\\"2. Logs de Auditoria e Integridade (Segurança Institucional)\\\",\\\"s2Item1\\\":\\\"\\u003cstrong\\u003eCustódia da Informação:\\u003c/strong\\u003e O TUGGI atua como o custodiante técnico da plataforma. Cada alteração em um gatilho de áudio, seja ela feita pela TUGGI ou por um parceiro governamental, é registrada em logs de auditoria imutáveis (RBAC), permitindo rastrear quem, quando e onde uma narrativa foi alterada.\\\",\\\"s3Title\\\":\\\"3. Confiabilidade e Performance (Para o Usuário B2C)\\\",\\\"s3Intro\\\":\\\"Para o viajante, confiabilidade se mede no uso. Com o conteúdo já baixado, o áudio começa sozinho, inclusive onde o sinal não chega:\\\",\\\"s3Item1\\\":\\\"\\u003cstrong\\u003eDisponibilidade Offline-First:\\u003c/strong\\u003e Projetamos o TUGGI para não depender da nuvem no momento do disparo. Uma vez baixado o pacote de viagem, o acionamento do áudio é local e imediato.\\\",\\\"s4Title\\\":\\\"4. Infraestrutura Global\\\",\\\"s4Desc\\\":\\\"Nossos dados são hospedados em centros de dados de classe mundial com criptografia AES-256 em repouso e TLS 1.3 em trânsito. Utilizamos o Supabase para gestão de identidade e Google Cloud para processamento de áudio.\\\"},\\\"Accessibility\\\":{\\\"title\\\":\\\"Acessibilidade e Inclusão\\\",\\\"subtitle\\\":\\\"Compromisso com a Inclusão e o Design Universal.\\\",\\\"intro\\\":\\\"Na TUGGI Technologies, acreditamos que o acesso à cultura e à história local não deve ter barreiras. O TUGGI foi concebido sob a premissa \\\\\\\"Audio-First\\\\\\\", transformando a experiência de descoberta em algo puramente sensorial e auditivo, o que beneficia nativamente usuários com diferentes perfis de acessibilidade.\\\",\\\"s1Title\\\":\\\"1. Diretrizes técnicas que seguimos (WCAG 2.1)\\\",\\\"s1Intro\\\":\\\"Estamos empenhados em garantir que nossa plataforma digital e aplicativo móvel sigam as Diretrizes de Acessibilidade para Conteúdo Web (WCAG) 2.1, no nível AA.\\\",\\\"s1Item1\\\":\\\"\\u003cstrong\\u003eDesign visual:\\u003c/strong\\u003e Medimos a paleta deste site contra o mínimo de contraste do nível AA das WCAG 2.1, que existe para facilitar a leitura de quem tem baixa visão (auditoria: {a11ySiteAuditDate}). Sobre as cores de marca, texto e ícones usam a cor escura da paleta, e a tipografia é a Inter.\\\",\\\"s1Item2\\\":\\\"\\u003cstrong\\u003eNavegação:\\u003c/strong\\u003e Nossa interface é estruturada para ser compatível com leitores de tela (como VoiceOver no iOS e TalkBack no Android).\\\",\\\"s2Title\\\":\\\"2. Recursos de Inclusão no TUGGI\\\",\\\"s2Intro\\\":\\\"Nosso produto é desenhado para ser acessível tanto para quem dirige quanto para quem acompanha a viagem:\\\",\\\"s2Item1\\\":\\\"\\u003cstrong\\u003eExperiência Audio-First:\\u003c/strong\\u003e Eliminamos a necessidade de interação visual ou tátil com a tela durante o trajeto. As histórias são disparadas automaticamente via geolocalização, permitindo que deficientes visuais e pessoas com mobilidade reduzida desfrutem do conteúdo de forma autônoma.\\\",\\\"s2Item2\\\":\\\"\\u003cstrong\\u003eClosed Captions (Legendas):\\u003c/strong\\u003e Para passageiros com deficiência auditiva, o TUGGI oferece a funcionalidade de transcrição sincronizada em tempo real. Enquanto o áudio toca, o texto da narrativa é exibido na tela, garantindo que ninguém perca o contexto cultural da rota.\\\",\\\"s2Item3\\\":\\\"\\u003cstrong\\u003eAcessibilidade Linguística:\\u003c/strong\\u003e Oferecemos suporte multilíngue em {contentLanguages} idiomas, garantindo que a barreira do idioma não seja um impedimento para o conhecimento.\\\",\\\"s3Title\\\":\\\"3. Canal de Feedback e Melhoria Contínua\\\",\\\"s3Intro\\\":\\\"A acessibilidade é um processo contínuo. Reconhecemos que sempre há espaço para melhorias e estamos prontos para ouvir nossos usuários.\\\",\\\"s4Title\\\":\\\"4. Inclusão Cultural e Impacto Social\\\",\\\"s4Desc\\\":\\\"Além da acessibilidade técnica, o TUGGI atua como um agente de inclusão social. Nós democratizamos o acesso à cultura descentralizando o turismo. Ao redirecionar o fluxo de áreas saturadas para zonas periféricas, fomentamos a economia criativa local, dando voz aos historiadores, atores e guias nativos que constroem nossas narrativas.\\\",\\\"s3Item1\\\":\\\"\\u003cstrong\\u003eReportar Barreira:\\u003c/strong\\u003e Se você encontrar dificuldade de acesso no nosso site ou no aplicativo, conte para nós em que página ou tela aconteceu, o que você tentou fazer e com o que você navega, como leitor de tela, teclado ou ampliação.\\\",\\\"s3Item2\\\":\\\"\\u003cstrong\\u003eCompromisso:\\u003c/strong\\u003e Analisamos cada reporte com prioridade técnica para garantir que o TUGGI continue sendo o copiloto cultural de todos, sem exceção.\\\",\\\"contactIntro\\\":\\\"Para reportar uma barreira, escreva para:\\\",\\\"contactEmail\\\":\\\"suporte@tuggi.app\\\"}},\\\"CookieBanner\\\":{\\\"text\\\":\\\"Usamos cookies para medir o público deste site, e também para saber qual parceiro levou você até o aplicativo, que é como remuneramos esse parceiro. Ao clicar em 'Aceitar', você concorda com os dois usos.\\\",\\\"accept\\\":\\\"Aceitar\\\",\\\"decline\\\":\\\"Recusar\\\"},\\\"Purpose\\\":{\\\"Hero\\\":{\\\"title\\\":\\\"Antes de ver, nós ouvimos.\\\",\\\"body\\\":\\\"A audição é o nosso sentido mais antigo e fundamental. Antes de nascer, reconhecemos o mundo através do som da voz de nossa mãe. Aprendemos a ouvir antes de aprender a falar, ler ou caminhar. O TUGGI nasceu desta verdade biológica: a maneira mais natural de absorver o mundo ao nosso redor não é olhando para uma tela, mas ouvindo-o.\\\"},\\\"Freedom\\\":{\\\"title\\\":\\\"A Liberdade de Explorar.\\\",\\\"body\\\":\\\"O turismo está preso a horários rígidos, ônibus lotados e barreiras linguísticas. Acreditamos que a exploração deve ser liberdade absoluta. Você não deveria ter que esperar por um guia turístico ou manter os olhos grudados em um aplicativo de mapas. Com o TUGGI, você dirige, caminha ou pedala no seu próprio ritmo. As histórias encontram você no exato momento geográfico em que importam.\\\"},\\\"Values\\\":{\\\"title\\\":\\\"O Alicerce\\\",\\\"v2Title\\\":\\\"Simplicidade Operacional.\\\",\\\"v2Desc\\\":\\\"Basta iniciar a rota e o app cuida do resto.\\\",\\\"v3Title\\\":\\\"Respeito Contextual.\\\",\\\"v3Desc\\\":\\\"Histórias profundamente conectadas à rota física e coerência narrativa.\\\",\\\"v4Title\\\":\\\"Precisão e Confiabilidade.\\\",\\\"v4Desc\\\":\\\"Execução geográfica com timing perfeito.\\\",\\\"v5Title\\\":\\\"Curadoria Cultural.\\\",\\\"v5Desc\\\":\\\"Pulamos o básico para entregar as joias escondidas e o verdadeiro conhecimento local.\\\",\\\"v6Title\\\":\\\"Acessibilidade Universal.\\\",\\\"v6Desc\\\":\\\"Projetado para ser consumido em diferentes perfis e idiomas nativos.\\\"},\\\"Manifesto\\\":{\\\"quote\\\":\\\"“O mundo fica melhor quando deixamos de olhá-lo pela janela e passamos a ouvi-lo respirar.”\\\"}},\\\"NotFound\\\":{\\\"title\\\":\\\"Território Inexplorado\\\",\\\"subtitle\\\":\\\"Você tem liberdade total para ir a qualquer lugar e nosso app funciona offline, mas parece que você descobriu uma página que nós ainda não mapeamos.\\\",\\\"backHome\\\":\\\"Voltar à Civilização\\\",\\\"support\\\":\\\"Relatar ao Suporte\\\"},\\\"Metadata\\\":{\\\"rootTitle\\\":\\\"TUGGI — Guia de Viagem em Áudio\\\",\\\"rootDescription\\\":\\\"O TUGGI conta a história de um lugar em voz alta assim que você chega perto. Funciona offline, em {contentLanguages} idiomas, grátis para começar no iOS e no Android.\\\",\\\"homeTitle\\\":\\\"Guia de Viagem em Áudio - Histórias que Tocam Enquanto Você Passa | TUGGI\\\",\\\"homeDescription\\\":\\\"O TUGGI conta a história de cada lugar em voz alta enquanto você passa, viaje como viajar. Áudio-guia de viagem autoguiado, offline e no seu idioma. Comece grátis.\\\",\\\"driveTitle\\\":\\\"Passes Tuggi — horas de guia que não expiram\\\",\\\"driveDescription\\\":\\\"Comece grátis, sem cartão: o guia completo você ativa dentro do app. Depois, passes de 10, 25 ou 45 horas de uso — pagamento único, e as horas não expiram.\\\",\\\"techTitle\\\":\\\"Como o TUGGI Funciona - Áudio Acionado por GPS, Offline\\\",\\\"techDescription\\\":\\\"Por dentro do TUGGI: como o GPS dispara cada história, como ele sabe de que lado você está passando e como continua tocando offline no iOS e no Android.\\\",\\\"purposeTitle\\\":\\\"Nosso Propósito\\\",\\\"purposeDescription\\\":\\\"Criamos o TUGGI com uma ideia só: todo lugar tem uma história que vale a pena ouvir, e todo mundo deveria poder escutá-la, no seu idioma e sem usar as mãos.\\\",\\\"contactTitle\\\":\\\"Fale Conosco\\\",\\\"contactDescription\\\":\\\"Dúvida sobre o app, uma frota, um destino ou imprensa? O time do TUGGI está aqui para ajudar.\\\",\\\"trustCenterTitle\\\":\\\"Central de Confiança\\\",\\\"trustCenterDescription\\\":\\\"Legal e Conformidade\\\",\\\"termsTitle\\\":\\\"Termos de Uso\\\",\\\"termsDescription\\\":\\\"Termos e condições dos nossos serviços\\\",\\\"privacyTitle\\\":\\\"Política de Privacidade\\\",\\\"privacyDescription\\\":\\\"Como processamos seus dados\\\",\\\"deletionTitle\\\":\\\"Exclusão de Dados\\\",\\\"deletionDescription\\\":\\\"Solicite a exclusão de seus dados\\\",\\\"securityTitle\\\":\\\"SLA de Segurança\\\",\\\"securityDescription\\\":\\\"Nossos compromissos de segurança\\\",\\\"accessibilityTitle\\\":\\\"Acessibilidade e Inclusão\\\",\\\"accessibilityDescription\\\":\\\"Políticas de acessibilidade\\\",\\\"homeOgImageAlt\\\":\\\"TUGGI: guia de viagem em áudio autoguiado\\\"},\\\"SEO_CITY_OS\\\":{\\\"title\\\":\\\"Áudio-guias Multilíngues para Destinos Inteligentes\\\",\\\"description\\\":\\\"Cada visitante ouve as histórias do seu destino, no idioma dele, enquanto explora. Acessível, em todo o território.\\\",\\\"ogTitle\\\":\\\"TUGGI City OS: Seu Destino, Narrado para Cada Visitante\\\",\\\"ogImageAlt\\\":\\\"TUGGI City OS: infraestrutura para destinos turísticos inteligentes\\\"},\\\"SEO_FLEETS\\\":{\\\"title\\\":\\\"Áudio-guias a Bordo para Frotas de Locação e Transfer\\\",\\\"description\\\":\\\"Transforme locações e transfers numa viagem que fica na memória. O passageiro ouve um guia local no idioma dele, sem instalar nada.\\\",\\\"ogTitle\\\":\\\"TUGGI Frotas: Um Guia de Áudio para Cada Passageiro\\\",\\\"ogImageAlt\\\":\\\"TUGGI Frotas: participação na receita para locadoras e transfers\\\"},\\\"SEO_PURPOSE\\\":{\\\"title\\\":\\\"Nosso Propósito — Por que Todo Lugar Merece Ser Ouvido\\\",\\\"description\\\":\\\"Criamos o TUGGI com uma ideia só: todo lugar tem uma história que vale a pena ouvir, e todo mundo deveria poder escutá-la, no seu idioma e sem usar as mãos.\\\",\\\"ogTitle\\\":\\\"TUGGI: Por que Todo Lugar Merece Ser Ouvido\\\",\\\"ogImageAlt\\\":\\\"TUGGI: o manifesto do áudio\\\"},\\\"SEO_COVERAGE\\\":{\\\"title\\\":\\\"Destinos Ativos — Escolha Onde Explorar\\\",\\\"description\\\":\\\"O TUGGI está ativo em {coverageCountries} países e mais de {mappedPointMillions} milhões de pontos de interesse — Itália, Espanha, Portugal, Brasil, Chile, EUA e mais. Histórias em áudio tocam automaticamente assim que você começa a explorar.\\\",\\\"ogTitle\\\":\\\"TUGGI Ativo em {coverageCountries} Países — Mais de {mappedPointMillions} Milhões de Pontos Mapeados\\\",\\\"ogImageAlt\\\":\\\"Mapa de cobertura global do TUGGI: pontos mapeados pelo mundo\\\",\\\"ogEyebrow\\\":\\\"Cobertura global\\\",\\\"ogHeadline\\\":\\\"Pontos mapeados no mundo todo\\\",\\\"ogStatCountries\\\":\\\"Países\\\",\\\"ogStatRegions\\\":\\\"Regiões\\\",\\\"ogCountryList\\\":\\\"Cobertura por país\\\"},\\\"Coverage\\\":{\\\"Hero\\\":{\\\"tag\\\":\\\"Destinos Ativos\\\",\\\"title\\\":\\\"Escolha o destino. As histórias já estão te esperando.\\\",\\\"subtitle\\\":\\\"O TUGGI está ativo em {coverageCountries} países — Itália, Espanha, Portugal, Brasil, Chile, EUA e mais. Selecione um país abaixo — o áudio toca automaticamente assim que você começa a explorar.\\\"},\\\"Stats\\\":{\\\"countries\\\":\\\"Países com Cobertura\\\",\\\"points\\\":\\\"Pontos Mapeados\\\",\\\"regions\\\":\\\"Regiões Cobertas\\\"},\\\"Density\\\":{\\\"sectionTitle\\\":\\\"Onde o TUGGI já está\\\",\\\"sectionSubtitle\\\":\\\"Quanto mais clara a área, maior a densidade de pontos mapeados naquela região.\\\",\\\"filterAll\\\":\\\"Todos os países\\\",\\\"legendTitle\\\":\\\"Densidade de cobertura\\\",\\\"legend\\\":{\\\"lowest\\\":\\\"Cobertura inicial\\\",\\\"low\\\":\\\"Cobertura moderada\\\",\\\"high\\\":\\\"Cobertura alta\\\",\\\"highest\\\":\\\"Cobertura mais densa\\\"},\\\"listTitle\\\":\\\"Todos os destinos, região por região\\\",\\\"listIntro\\\":\\\"A lista completa do que o mapa desenha — e as regiões que ficam fora do enquadramento. Onde já existe roteiro de áudio, o nome da região leva até ele.\\\",\\\"countryListTitle\\\":\\\"Veja se o seu destino já está no mapa\\\",\\\"countryListIntro\\\":\\\"A lista completa, região por região, está na página de cobertura.\\\",\\\"countryListCta\\\":\\\"Ver cobertura completa\\\",\\\"group\\\":{\\\"americas\\\":\\\"Américas\\\",\\\"europe\\\":\\\"Europa\\\",\\\"other\\\":\\\"Outros destinos\\\"},\\\"outOfFrame\\\":\\\"Fora do enquadramento do mapa: {regions}.\\\"},\\\"CTA\\\":{\\\"title\\\":\\\"Leve o TUGGI para a sua cidade.\\\",\\\"description\\\":\\\"Fazemos parcerias com cidades, destinos e empresas de viagem no mundo todo. Se a sua região ainda não está no mapa — vamos colocá-la.\\\",\\\"button\\\":\\\"ENTRAR EM CONTATO\\\"}},\\\"Coupon\\\":{\\\"block_title\\\":\\\"Presente especial\\\",\\\"block_subtitle\\\":\\\"Você ganha {days} dias de Tuggi Premium grátis\\\",\\\"code_label\\\":\\\"Seu código\\\",\\\"copy\\\":\\\"Copiar código\\\",\\\"copied\\\":\\\"Código copiado!\\\",\\\"open_app\\\":\\\"Resgatar no app\\\",\\\"desktop_hint\\\":\\\"Sem o app? Use os botões abaixo para instalar e resgatar.\\\"},\\\"Tours\\\":{\\\"heroTag\\\":\\\"Roteiro de Áudio Autoguiado\\\",\\\"heroSubtitle\\\":\\\"Roteiro de áudio autoguiado · {place}\\\",\\\"heroCtaPrimary\\\":\\\"Ouvir no app Tuggi\\\",\\\"heroCtaSecondary\\\":\\\"Ver o mapa\\\",\\\"facts\\\":{\\\"duration\\\":\\\"Duração\\\",\\\"distance\\\":\\\"Distância\\\",\\\"stops\\\":\\\"Paradas\\\",\\\"drivability\\\":\\\"Dificuldade\\\",\\\"accessibility\\\":\\\"Acessibilidade\\\",\\\"bestTime\\\":\\\"Melhor horário\\\",\\\"languages\\\":\\\"Idiomas\\\",\\\"varies\\\":\\\"Variável\\\"},\\\"drivability\\\":{\\\"easy\\\":\\\"Fácil\\\",\\\"moderate\\\":\\\"Moderada\\\",\\\"demanding\\\":\\\"Exigente\\\",\\\"unknown\\\":\\\"—\\\"},\\\"accessibility\\\":{\\\"accessible\\\":\\\"Acessível\\\",\\\"partial\\\":\\\"Parcialmente acessível\\\",\\\"not_accessible\\\":\\\"Não acessível\\\",\\\"unknown\\\":\\\"—\\\"},\\\"bestTime\\\":{\\\"morning\\\":\\\"Manhã\\\",\\\"afternoon\\\":\\\"Tarde\\\",\\\"sunset\\\":\\\"Pôr do sol\\\",\\\"evening\\\":\\\"Noite\\\",\\\"night\\\":\\\"Noite\\\",\\\"anytime\\\":\\\"Qualquer hora\\\"},\\\"itineraryTitle\\\":\\\"O que você vai ver e ouvir\\\",\\\"itinerarySubtitle\\\":\\\"As paradas deste roteiro, em ordem — com prévias de áudio quando disponíveis.\\\",\\\"audioPreview\\\":\\\"Prévia de áudio\\\",\\\"faqTitle\\\":\\\"Perguntas frequentes\\\",\\\"faq\\\":{\\\"duration\\\":{\\\"q\\\":\\\"Quanto tempo dura este roteiro?\\\",\\\"a\\\":\\\"Cerca de {duration} de áudio em {stops} paradas, cobrindo aproximadamente {distance}. No seu ritmo — o áudio toca automaticamente enquanto você se desloca.\\\"},\\\"accessibility\\\":{\\\"q\\\":\\\"Este roteiro é acessível?\\\",\\\"a\\\":\\\"Esta rota é classificada como: {level}. Confira cada parada para detalhes específicos de acesso.\\\"},\\\"languages\\\":{\\\"q\\\":\\\"Em quais idiomas está disponível?\\\",\\\"a\\\":\\\"Este roteiro está disponível em: {languages}.\\\"},\\\"offline\\\":{\\\"q\\\":\\\"Preciso de conexão com a internet?\\\",\\\"a\\\":\\\"Não. Baixe o roteiro no app Tuggi e ouça offline — o áudio é ativado pela sua localização, sem precisar usar as mãos.\\\"},\\\"mode\\\":{\\\"q\\\":\\\"Dá para fazer a pé ou de carro?\\\",\\\"a\\\":\\\"Esta rota foi pensada para um trajeto {level}. O áudio se adapta ao seu ritmo.\\\"}},\\\"relatedTitle\\\":\\\"Mais roteiros por perto\\\",\\\"stopsCount\\\":\\\"{count, plural, one {# parada} other {# paradas}}\\\",\\\"stopsMerged\\\":\\\"Paradas {from}–{to}\\\",\\\"breadcrumbTours\\\":\\\"Roteiros de Áudio\\\",\\\"metaTitle\\\":\\\"{name} — Roteiro de Áudio Autoguiado\\\",\\\"metaDescFallback\\\":\\\"Um roteiro de áudio autoguiado em {place} com a Tuggi. Histórias que tocam automaticamente enquanto você explora.\\\",\\\"ctaTitle\\\":\\\"Ouça a história completa\\\",\\\"ctaSubtitle\\\":\\\"Baixe o app Tuggi e deixe cada parada ganhar vida — sem usar as mãos, offline e no seu idioma.\\\",\\\"ctaButton\\\":\\\"Baixar o app Tuggi\\\",\\\"countryIn\\\":{\\\"BR\\\":\\\"no Brasil\\\",\\\"ES\\\":\\\"na Espanha\\\",\\\"FR\\\":\\\"na França\\\",\\\"GB\\\":\\\"no Reino Unido\\\",\\\"IT\\\":\\\"na Itália\\\",\\\"PT\\\":\\\"em Portugal\\\",\\\"US\\\":\\\"nos Estados Unidos\\\"},\\\"countryMetaTitle\\\":\\\"Roteiros de Áudio Autoguiados {inCountry}\\\",\\\"countryMetaDesc\\\":\\\"Explore roteiros de áudio autoguiados {inCountry} com a Tuggi — mapas, prévias de áudio reais e informações práticas de cada rota.\\\",\\\"countryTitle\\\":\\\"Roteiros de Áudio Autoguiados {inCountry}\\\",\\\"countrySubtitle\\\":\\\"{count, plural, one {# rota selecionada} other {# rotas selecionadas}} {inCountry}, cada uma com mapa, paradas e prévias de áudio reais.\\\",\\\"hubMetaTitle\\\":\\\"Roteiros de Áudio Autoguiados\\\",\\\"hubMetaDesc\\\":\\\"Navegue pelos roteiros de áudio autoguiados da Tuggi por país — rotas selecionadas com mapas, paradas e prévias de áudio reais.\\\",\\\"hubTitle\\\":\\\"Roteiros de Áudio Autoguiados\\\",\\\"hubSubtitle\\\":\\\"Rotas selecionadas que tocam automaticamente enquanto você explora — por país.\\\",\\\"hubEmpty\\\":\\\"Esta lista está vazia no seu idioma. No app, a narração segue o idioma que você usa — é o seu percurso que cria o áudio.\\\",\\\"viewAllInCountry\\\":\\\"Ver todas as {count}\\\",\\\"themes\\\":{\\\"historical\\\":\\\"Histórico\\\",\\\"urban\\\":\\\"Urbano\\\",\\\"nature\\\":\\\"Natureza\\\",\\\"panoramic\\\":\\\"Panorâmico\\\",\\\"cultural\\\":\\\"Cultural\\\",\\\"scenic\\\":\\\"Cênico\\\",\\\"coastal\\\":\\\"Litorâneo\\\",\\\"religious\\\":\\\"Religioso\\\",\\\"gastronomic\\\":\\\"Gastronômico\\\",\\\"rural\\\":\\\"Rural\\\"},\\\"languagesCount\\\":\\\"{count, plural, one {# idioma} other {# idiomas}}\\\",\\\"statesNavLabel\\\":\\\"Estados com roteiros\\\",\\\"stateMetaTitle\\\":\\\"{state} — Roteiros de Áudio Autoguiados\\\",\\\"stateMetaDesc\\\":\\\"{count, plural, one {# roteiro de áudio autoguiado selecionado} other {# roteiros de áudio autoguiados selecionados}} — {state}, {country}. Mapas, paradas e prévias de áudio reais.\\\",\\\"stateTitle\\\":\\\"{state}\\\",\\\"stateSubtitle\\\":\\\"{count, plural, one {# rota selecionada} other {# rotas selecionadas}} — {country}. Cada uma com mapa, paradas e prévias de áudio reais.\\\",\\\"viewAllInState\\\":\\\"Ver todas as {count}\\\",\\\"audioLanguages\\\":\\\"Idiomas do áudio\\\",\\\"legendWithAudio\\\":\\\"Com áudio e história\\\",\\\"legendPassThrough\\\":\\\"Ponto de passagem\\\",\\\"stickyText\\\":\\\"Ouça este roteiro sem usar as mãos\\\",\\\"stickyCta\\\":\\\"Baixar o app\\\"},\\\"Languages\\\":{\\\"title\\\":\\\"Ouça no seu idioma\\\",\\\"subtitle\\\":\\\"Do português ao coreano, com sotaques diferentes pra você se sentir em casa. Ache o seu abaixo.\\\",\\\"langs\\\":[\\\"Português (BR)\\\",\\\"Português (PT)\\\",\\\"Inglês (EUA)\\\",\\\"Inglês (UK)\\\",\\\"Espanhol\\\",\\\"Italiano\\\",\\\"Francês\\\",\\\"Alemão\\\",\\\"Mandarim\\\",\\\"Coreano\\\"]},\\\"A11y\\\":{\\\"openMenu\\\":\\\"Abrir menu\\\",\\\"closeMenu\\\":\\\"Fechar menu\\\",\\\"menu\\\":\\\"Menu\\\",\\\"mainMenu\\\":\\\"Menu principal\\\",\\\"sitePages\\\":\\\"Páginas do site\\\",\\\"breadcrumb\\\":\\\"Trilha de navegação\\\",\\\"routeMap\\\":\\\"Mapa interativo do roteiro\\\",\\\"toggleCaptions\\\":\\\"Ativar ou desativar legendas\\\",\\\"skipToContent\\\":\\\"Ir para o conteúdo principal\\\",\\\"playAudio\\\":\\\"Tocar áudio\\\",\\\"pauseAudio\\\":\\\"Pausar áudio\\\"},\\\"PartnerProposal\\\":{\\\"title\\\":\\\"Proposta de parceria\\\",\\\"lede\\\":\\\"Este formulário é para quem já conversou com a Tuggi. Se você ainda não falou com a gente, comece por aqui: \\u003clp\\u003edeixe o seu contato na página de parcerias\\u003c/lp\\u003e.\\\",\\\"seo\\\":{\\\"title\\\":\\\"Proposta de parceria\\\",\\\"description\\\":\\\"O formulário que o estabelecimento preenche depois de conversar com a Tuggi, com os dados do negócio e a história do lugar.\\\"},\\\"progress\\\":\\\"Passo {current} de {total}\\\",\\\"charactersLeft\\\":\\\"{n, plural, one {resta # caractere} other {restam # caracteres}}\\\",\\\"actions\\\":{\\\"continue\\\":\\\"Continuar\\\",\\\"back\\\":\\\"Voltar\\\",\\\"submit\\\":\\\"Enviar para a Tuggi\\\",\\\"submitting\\\":\\\"Enviando…\\\",\\\"edit\\\":\\\"Editar\\\",\\\"restart\\\":\\\"Recomeçar do zero\\\",\\\"restartConfirm\\\":\\\"Isso apaga tudo o que você preencheu. Quer mesmo recomeçar?\\\",\\\"seeExample\\\":\\\"Ver um exemplo\\\",\\\"restartConfirmYes\\\":\\\"Sim, apagar tudo\\\",\\\"restartCancel\\\":\\\"Não, continuar preenchendo\\\"},\\\"step1\\\":{\\\"title\\\":\\\"O seu estabelecimento\\\",\\\"subtitle\\\":\\\"A gente começa pelo que está na fachada e no CNPJ.\\\"},\\\"step2\\\":{\\\"title\\\":\\\"Quem responde pelo estabelecimento\\\",\\\"subtitle\\\":\\\"Precisa ser quem pode assinar pelo CNPJ. É esta pessoa que vai receber o contrato.\\\"},\\\"step3\\\":{\\\"title\\\":\\\"A história do seu lugar\\\",\\\"subtitle\\\":\\\"Esta é a única parte que só você pode responder. O resto a gente encontra em documento. Isso aqui, não.\\\",\\\"titleMapOnly\\\":\\\"A sua escolha, e o material\\\",\\\"subtitleMapOnly\\\":\\\"É o último passo antes de você conferir tudo.\\\",\\\"intro\\\":\\\"O Tuggi conta histórias em voz alta para quem está viajando. Para contar a do seu lugar, a gente precisa de um fato que seja só seu: uma data, um nome, alguma coisa que dê para ver aí dentro. Não precisa escrever bonito. Quem escreve o texto final somos nós.\\\",\\\"notHere\\\":\\\"Cardápio, preço, promoção, número de quartos e forma de pagamento não entram aqui. O horário também não, porque a gente já pediu no primeiro passo. Essas coisas importam para o seu negócio, mas não é isso que o turista escuta.\\\",\\\"exampleBadTitle\\\":\\\"Assim não dá:\\\",\\\"exampleBad\\\":\\\"Restaurante familiar, ambiente aconchegante e atendimento de primeira. Almoço executivo de segunda a sexta e rodízio de pizza aos sábados.\\\",\\\"exampleBadWhy\\\":\\\"Troque o nome pelo do vizinho e o texto continua verdadeiro. A segunda frase é cardápio.\\\",\\\"exampleGoodTitle\\\":\\\"Assim dá:\\\",\\\"exampleGood\\\":\\\"Meu avô, Antônio, abriu a casa em 1961, num galpão que era da fábrica de guarda-chuvas do bairro. O forno a lenha é o mesmo desde a inauguração. Foi feito pelo pedreiro que morava na esquina, e a gente nunca trocou o tijolo.\\\",\\\"exampleGoodWhy\\\":\\\"Tem um nome, tem uma data e tem uma coisa que só existe aí.\\\",\\\"exampleInnTitle\\\":\\\"Pousada, do mesmo jeito:\\\",\\\"exampleInn\\\":\\\"A casa era a sede de uma fazenda de café de 1897. O piso de peroba e a escada são os originais. Do terraço dá para ver o vale onde passava a linha de trem que fechou em 1971.\\\",\\\"substituteTestTitle\\\":\\\"Antes de continuar, faça este teste:\\\",\\\"substituteTest\\\":\\\"troque o nome do seu estabelecimento pelo do vizinho da mesma rua. Se o texto continuar verdadeiro, ele ainda não é sobre o seu lugar. É isso que a nossa curadoria vai olhar.\\\",\\\"curation\\\":\\\"Nem todo lugar entra no app. Quem decide é a nossa curadoria, e ela olha três coisas: se o lugar é permanente, se é aberto a visita e se tem história própria para contar. Se faltar alguma, a gente diz o que faltou e você pode mandar de novo.\\\",\\\"nudgeShort\\\":\\\"Isso ainda está curto. Um nome e um ano já ajudam muito.\\\",\\\"nudgeOffer\\\":\\\"Parece que você falou de cardápio, preço ou reserva. Isso a gente não usa aqui. Conte uma coisa que aconteceu no lugar.\\\"},\\\"step4\\\":{\\\"title\\\":\\\"Conferir e enviar\\\",\\\"subtitle\\\":\\\"Confira o que você escreveu. Dá para corrigir qualquer resposta antes de enviar.\\\",\\\"beforeSubmit\\\":\\\"Confira o e-mail e o telefone antes de enviar: é por eles que a gente fala com você.\\\",\\\"empty\\\":\\\"não preenchido\\\"},\\\"material\\\":{\\\"title\\\":\\\"O material que a gente manda para o seu estabelecimento\\\",\\\"help\\\":\\\"A gente produz e envia sem custo. Diga quanto precisa de cada um e deixe em branco o que não serve. Antes de produzir, a gente confirma a quantidade com você.\\\"},\\\"privacy\\\":{\\\"notice\\\":\\\"Os campos deste passo são de uma pessoa, não da empresa. O nome, o cargo, o e-mail e o telefone ficam guardados junto com a sua proposta, e a Tuggi os usa para falar com você sobre esta parceria e para gerar o contrato.\\\",\\\"link\\\":\\\"Como tratamos os seus dados\\\"},\\\"fields\\\":{\\\"trade_name\\\":{\\\"label\\\":\\\"Como as pessoas chamam o seu estabelecimento?\\\",\\\"help\\\":\\\"O nome que está na fachada.\\\",\\\"requiredError\\\":\\\"Preencha o nome do estabelecimento.\\\"},\\\"legal_name\\\":{\\\"label\\\":\\\"Razão social\\\",\\\"help\\\":\\\"O nome que está no CNPJ. Se for o mesmo da fachada, pode repetir.\\\",\\\"requiredError\\\":\\\"Preencha a razão social.\\\"},\\\"tax_id\\\":{\\\"label\\\":\\\"CNPJ\\\",\\\"help\\\":\\\"O CNPJ tem 14 caracteres. Desde 2026 ele pode ter letras. Se o seu tiver, digite normalmente.\\\",\\\"requiredError\\\":\\\"Preencha o CNPJ.\\\"},\\\"legal_status_declaration\\\":{\\\"label\\\":\\\"Documentação\\\",\\\"statement\\\":\\\"Declaro que o estabelecimento tem CNPJ ativo, alvará de funcionamento vigente e documento de constituição.\\\",\\\"help\\\":\\\"A Tuggi só assina contrato com estabelecimento legalizado.\\\",\\\"requiredError\\\":\\\"Sem a documentação em ordem não dá para seguir com a proposta. Fale com a gente antes de continuar.\\\"},\\\"category\\\":{\\\"label\\\":\\\"Que tipo de lugar é?\\\",\\\"requiredError\\\":\\\"Escolha o tipo de lugar.\\\"},\\\"address\\\":{\\\"label\\\":\\\"Rua e número\\\",\\\"requiredError\\\":\\\"Preencha a rua e o número.\\\"},\\\"address_complement\\\":{\\\"label\\\":\\\"Complemento\\\",\\\"help\\\":\\\"Sala, loja, andar.\\\"},\\\"district\\\":{\\\"label\\\":\\\"Bairro\\\",\\\"requiredError\\\":\\\"Preencha o bairro.\\\"},\\\"postal_code\\\":{\\\"label\\\":\\\"CEP\\\",\\\"requiredError\\\":\\\"Preencha o CEP.\\\"},\\\"city\\\":{\\\"label\\\":\\\"Cidade\\\",\\\"requiredError\\\":\\\"Preencha a cidade.\\\"},\\\"state\\\":{\\\"label\\\":\\\"Estado\\\",\\\"requiredError\\\":\\\"Escolha o estado.\\\"},\\\"instagram\\\":{\\\"label\\\":\\\"Instagram\\\",\\\"help\\\":\\\"Pode colar o link do perfil. A gente guarda só o @.\\\"},\\\"opening_hours\\\":{\\\"label\\\":\\\"Horário de funcionamento\\\",\\\"help\\\":\\\"Escreva do seu jeito. Por exemplo: terça a domingo, das 11h às 15h e das 18h às 23h. Fecha segunda.\\\"},\\\"website\\\":{\\\"label\\\":\\\"Site\\\",\\\"help\\\":\\\"Se tiver. Pode colar o endereço completo.\\\"},\\\"material_sticker_qty\\\":{\\\"label\\\":\\\"Adesivos\\\",\\\"help\\\":\\\"Ficam na porta, na vitrine ou no balcão. Quantos você quer?\\\"},\\\"material_table_display_qty\\\":{\\\"label\\\":\\\"Displays de mesa\\\",\\\"help\\\":\\\"Um por mesa. Conte só as mesas onde ele vai ficar.\\\"},\\\"material_counter_display_qty\\\":{\\\"label\\\":\\\"Displays de balcão\\\",\\\"help\\\":\\\"Para o balcão, a recepção ou o caixa. Quantos você quer?\\\"},\\\"representative_name\\\":{\\\"label\\\":\\\"Nome completo\\\",\\\"help\\\":\\\"Como está no documento de constituição.\\\",\\\"requiredError\\\":\\\"Preencha o nome completo de quem responde pelo estabelecimento.\\\"},\\\"representative_role\\\":{\\\"label\\\":\\\"Cargo no estabelecimento\\\",\\\"help\\\":\\\"Sócio, sócia-administradora, proprietário, procurador.\\\",\\\"requiredError\\\":\\\"Preencha o cargo no estabelecimento.\\\"},\\\"representative_email\\\":{\\\"label\\\":\\\"E-mail\\\",\\\"help\\\":\\\"É para este endereço que o contrato vai. Confira com calma.\\\",\\\"requiredError\\\":\\\"Preencha o e-mail de quem responde pelo estabelecimento.\\\"},\\\"representative_phone\\\":{\\\"label\\\":\\\"Telefone com WhatsApp\\\",\\\"help\\\":\\\"Com DDD. Por exemplo: 21 90000-0000. A gente usa esse número para falar sobre a parceria. Ele não entra em lista de mensagens.\\\",\\\"requiredError\\\":\\\"Preencha o telefone com WhatsApp.\\\"},\\\"story_founder\\\":{\\\"label\\\":\\\"Quem começou este lugar e em que ano?\\\",\\\"help\\\":\\\"O nome da pessoa e o ano. Se foi você, escreva o seu nome. Se você comprou de alguém, conte quem começou e quando você assumiu. Por exemplo: Meu pai, Sebastião, abriu em 1978. Assumi em 2009.\\\",\\\"requiredError\\\":\\\"Conte quem começou o lugar e quando.\\\"},\\\"story_before\\\":{\\\"label\\\":\\\"O que tinha neste endereço antes do seu negócio?\\\",\\\"help\\\":\\\"Casa de família, oficina, armazém, cinema, terreno vazio. Se você sabe de que ano é o prédio, escreva. Por exemplo: Era uma serralheria. O prédio é de 1932. Está escrito na fachada.\\\"},\\\"story_unique\\\":{\\\"label\\\":\\\"O que existe aí dentro que não existe em outro lugar?\\\",\\\"help\\\":\\\"Vale coisa que dá para ver, tocar ou provar. Um forno, um móvel, uma foto na parede, uma receita que veio de alguém da família. Elogio não vale. Aconchegante e atendimento familiar servem para qualquer lugar. Por exemplo: O balcão de mármore é o original da confeitaria que funcionava aqui. A gente só lixou.\\\"},\\\"story_event\\\":{\\\"label\\\":\\\"Aconteceu alguma coisa aqui que o pessoal do bairro conta até hoje?\\\",\\\"help\\\":\\\"Uma visita, uma enchente, um jogo, uma festa que começou aqui, alguém conhecido que era freguês. Por exemplo: em 1994, a rua inteira assistiu à final aqui na calçada.\\\"},\\\"plan_choice\\\":{\\\"label\\\":\\\"O que o Tuggi vai dizer sobre o seu lugar\\\",\\\"requiredError\\\":\\\"Escolha uma das duas opções.\\\"}},\\\"categories\\\":{\\\"restaurant\\\":\\\"Restaurante\\\",\\\"bar_cafe\\\":\\\"Bar ou café\\\",\\\"hotel\\\":\\\"Hotel\\\",\\\"inn\\\":\\\"Pousada\\\",\\\"shop\\\":\\\"Loja\\\",\\\"attraction\\\":\\\"Atração ou passeio\\\",\\\"other\\\":\\\"Outro\\\"},\\\"plans\\\":{\\\"map_and_description\\\":\\\"Contar a minha história\\\",\\\"map_only\\\":\\\"Só aparecer\\\"},\\\"consentConfirmed\\\":\\\"Confirmado\\\",\\\"errors\\\":{\\\"summary\\\":\\\"{count, plural, one {Falta # resposta neste passo.} other {Faltam # respostas neste passo.}}\\\",\\\"email_malformed\\\":\\\"Este e-mail não parece completo. Confira antes de continuar.\\\",\\\"phone_short\\\":\\\"Escreva o telefone com DDD.\\\",\\\"cnpj_incomplete\\\":\\\"O CNPJ tem 14 caracteres. {n, plural, one {Falta # caractere} other {Faltam # caracteres}}.\\\",\\\"cnpj_invalid\\\":\\\"Este CNPJ não confere. Confira os 14 caracteres, inclusive as letras, se o seu tiver.\\\",\\\"postal_code\\\":\\\"O CEP tem 8 números.\\\",\\\"too_long\\\":\\\"Você passou de {max} caracteres. Tire {over} para continuar.\\\",\\\"quantity_invalid\\\":\\\"Escreva só o número, de 1 a 9999. Por exemplo: 12.\\\",\\\"material_none\\\":\\\"Escolha ao menos um: adesivo, display de mesa ou display de balcão. É ele que leva o turista até o app.\\\"},\\\"states\\\":{\\\"draftResumed\\\":\\\"O que você preencheu em {date} ficou guardado neste aparelho. Continue de onde parou.\\\",\\\"offlineTitle\\\":\\\"Você está sem internet.\\\",\\\"offlineBody\\\":\\\"O que você escrever fica guardado neste aparelho. Quando a conexão voltar, é só tocar em enviar.\\\",\\\"submitErrorTitle\\\":\\\"Não conseguimos enviar agora.\\\",\\\"submitErrorBody\\\":\\\"Tente enviar de novo. Se continuar dando erro, escreva para {email}. O que você preencheu continua guardado neste aparelho.\\\",\\\"successTitle\\\":\\\"Recebemos os seus dados.\\\",\\\"successBody\\\":\\\"A gente confere e volta a falar com você por este e-mail: {email}. Enviar o formulário ainda não fecha a parceria. O contrato é o passo seguinte.\\\",\\\"tooManyTitle\\\":\\\"Chegaram muitos envios desta mesma rede.\\\",\\\"tooManyBody\\\":\\\"Não é nada que você tenha feito de errado. Em internet compartilhada, os envios contam juntos. Tente de novo mais tarde. O que você preencheu continua guardado neste aparelho. Se precisar resolver hoje, escreva para {email}.\\\",\\\"unavailableTitle\\\":\\\"O envio está fora do ar agora.\\\",\\\"unavailableBody\\\":\\\"É um problema nosso, e esperar não resolve. Escreva para {email} que a gente recebe a sua proposta por lá. O que você preencheu continua guardado neste aparelho.\\\",\\\"postalCodeFilled\\\":\\\"A gente preencheu a rua, o bairro, a cidade e o estado. Confira e ajuste se precisar.\\\",\\\"postalCodeLooking\\\":\\\"Buscando o endereço deste CEP… aguarde um instante antes de preencher a cidade.\\\"},\\\"savedOnDevice\\\":\\\"O que você escrever fica guardado neste aparelho por 24 horas, até você enviar.\\\",\\\"alreadyPartner\\\":\\\"Se o seu estabelecimento já é parceiro e você quer atualizar os dados, não preencha de novo: \\u003cmail\\u003efale com a gente por e-mail\\u003c/mail\\u003e.\\\",\\\"planSamples\\\":{\\\"map_and_description\\\":\\\"“À sua direita, a Cantina do Antônio. A casa abriu em 1961 num galpão que era da fábrica de guarda-chuvas do bairro, e o forno a lenha é o mesmo desde então.”\\\",\\\"map_only\\\":\\\"“À sua direita, Cantina do Antônio.”\\\"},\\\"planSamplesIntro\\\":\\\"O turista ouve e lê:\\\",\\\"planCost\\\":\\\"Só a primeira tem custo, e o valor vocês combinam no contrato. Nada é cobrado até a sua história estar no ar.\\\"},\\\"Updates\\\":{\\\"seo\\\":{\\\"title\\\":\\\"Novidades e notas de versão\\\",\\\"description\\\":\\\"O que mudou no aplicativo, quando mudou e o que acontece com o que você já comprou.\\\",\\\"ogImageAlt\\\":\\\"Cartão de compartilhamento da seção de novidades do Tuggi.\\\"},\\\"title\\\":\\\"Novidades\\\",\\\"subtitle\\\":\\\"Notas de versão e notícias de produto, da mais recente para a mais antiga.\\\",\\\"readMore\\\":\\\"Ler\\\",\\\"cta\\\":{\\\"button\\\":\\\"Baixar o aplicativo\\\",\\\"body\\\":\\\"Suas horas de boas-vindas já estão no app.\\\"},\\\"rail\\\":{\\\"title\\\":\\\"Conheça o Tuggi\\\"},\\\"backToSection\\\":\\\"Voltar para Novidades\\\",\\\"empty\\\":{\\\"body\\\":\\\"Ainda não há publicação neste idioma.\\\",\\\"link\\\":\\\"Ler em inglês\\\"},\\\"type\\\":{\\\"release\\\":\\\"Nota de versão\\\",\\\"news\\\":\\\"Notícia\\\"},\\\"filter\\\":{\\\"label\\\":\\\"Filtrar por tipo\\\",\\\"all\\\":\\\"Tudo\\\"},\\\"pager\\\":{\\\"label\\\":\\\"Mais novidades\\\",\\\"previous\\\":\\\"Anterior\\\",\\\"next\\\":\\\"Próximo\\\"},\\\"priceTable\\\":{\\\"caption\\\":\\\"Passes de horas\\\",\\\"columnPass\\\":\\\"Passe\\\",\\\"columnPrice\\\":\\\"Preço\\\",\\\"note\\\":\\\"Compra única. Não renova. As horas de passes diferentes se somam.\\\"}}},\\\"now\\\":\\\"$undefined\\\",\\\"timeZone\\\":\\\"America/Sao_Paulo\\\",\\\"children\\\":[\\\"$L31\\\",\\\"$L32\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"2d:[\\\"$\\\",\\\"$L33\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"href\\\":\\\"/pt/coverage\\\",\\\"locale\\\":\\\"$undefined\\\",\\\"localeCookie\\\":{\\\"name\\\":\\\"NEXT_LOCALE\\\",\\\"sameSite\\\":\\\"lax\\\"},\\\"className\\\":\\\"inline-flex items-center gap-2 font-semibold text-tuggi-primary-text hover:text-tuggi-primary transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-