w-2xl transition-transform duration-300 ease-in-out lg:hidden flex flex-col h-full -translate-x-full\"><div class=\"p-6 border-b border-gray-100 flex items-center justify-between bg-white shrink-0\"><a class=\"flex items-center\" href=\"/pt\"><img alt=\"TUGGI Logo\" width=\"86\" height=\"28\" decoding=\"async\" data-nimg=\"1\" class=\"h-7 w-auto\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Flogo_tuggi_full.png&amp;w=96&amp;q=75 1x, /_next/image?url=%2Fimages%2Flogo_tuggi_full.png&amp;w=256&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2Flogo_tuggi_full.png&amp;w=256&amp;q=75\"/></a><button class=\"p-2 text-slate-400 hover:text-slate-900 transition-colors rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text\" aria-label=\"Fechar menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-x w-6 h-6\" aria-hidden=\"true\"><path d=\"M18 6 6 18\"></path><path d=\"m6 6 12 12\"></path></svg></button></div><div class=\"flex-1 overflow-y-auto bg-white py-4\"><nav data-nav-scope=\"mobile\" class=\"flex flex-col\" aria-label=\"Páginas do site\"><a data-nav-item=\"navPartners\" class=\"flex items-center justify-between px-6 py-5 text-[15px] font-semibold text-slate-700 hover:bg-slate-50 border-b border-slate-50 transition-colors\" href=\"/pt/parcerias\"><span>Parcerias</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-slate-300 -rotate-90\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></a><a data-nav-item=\"navDestinations\" class=\"flex items-center justify-between px-6 py-5 text-[15px] font-semibold text-slate-700 hover:bg-slate-50 border-b border-slate-50 transition-colors\" href=\"/pt/destinos\"><span>Destinos</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-slate-300 -rotate-90\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></a><a data-nav-item=\"navTech\" class=\"flex items-center justify-between px-6 py-5 text-[15px] font-semibold text-slate-700 hover:bg-slate-50 border-b border-slate-50 transition-colors\" href=\"/pt/tecnologia\"><span>Tecnologia</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-slate-300 -rotate-90\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></a><a data-nav-item=\"navPlans\" class=\"flex items-center justify-between px-6 py-5 text-[15px] font-semibold text-slate-700 hover:bg-slate-50 border-b border-slate-50 transition-colors\" href=\"/pt/drive\"><span>Passes</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-slate-300 -rotate-90\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></a><a data-nav-item=\"navAudioGuides\" class=\"flex items-center justify-between px-6 py-5 text-[15px] font-semibold text-slate-700 hover:bg-slate-50 border-b border-slate-50 transition-colors\" href=\"/pt/tours\"><span>Áudio-guias</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-slate-300 -rotate-90\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></a><a data-nav-item=\"navPurpose\" class=\"flex items-center justify-between px-6 py-5 text-[15px] font-semibold text-slate-700 hover:bg-slate-50 border-b border-slate-50 transition-colors\" href=\"/pt/purpose\"><span>Propósito</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-slate-300 -rotate-90\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></a></nav></div><div class=\"p-6 bg-slate-50 border-t border-gray-100 shrink-0\"><a data-download-cta=\"header-drawer\" class=\"flex items-center justify-center gap-2 bg-tuggi-secondary text-tuggi-dark font-bold rounded-xl px-6 py-4 text-sm transition-all hover:bg-tuggi-secondary-hover shadow-lg shadow-orange-500/10 active:scale-[0.98]\" href=\"/pt/d/tuggi\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-smartphone w-4 h-4\" aria-hidden=\"true\"><rect width=\"14\" height=\"20\" x=\"5\" y=\"2\" rx=\"2\" ry=\"2\"></rect><path d=\"M12 18h.01\"></path></svg>Baixar App</a></div></div><main id=\"main-content\" class=\"min-h-screen bg-tuggi-bg\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Qual é o melhor app de áudio-guia autoguiado?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"O TUGGI é um áudio-guia de viagem autoguiado para iOS e Android. Ele toca histórias em áudio sobre os lugares ao seu redor automaticamente, ativadas por GPS — sem usar as mãos e sem olhar a tela — enquanto você dirige, caminha ou pedala. Funciona offline, tem 10 idiomas com legendas e é grátis para começar.\"}},{\"@type\":\"Question\",\"name\":\"Existe um app de áudio-guia de viagem grátis?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sim. O TUGGI é grátis para baixar e já começa com histórias todo dia. Para ouvir sem limite diário, um Passe Tuggi dá 10, 25 ou 45 horas de uso, com pagamento único. As horas não expiram e você vê o preço na App Store ou no Google Play.\"}},{\"@type\":\"Question\",\"name\":\"Qual é um bom app de viagem para road trip?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"O TUGGI foi feito para road trips: roda junto com a sua navegação e música e narra automaticamente os pontos, as cidades e a história por onde você passa — sem tela, sem procurar nada. Baixe a rota antes e use offline, sem roaming.\"}},{\"@type\":\"Question\",\"name\":\"Dá para explorar uma cidade sem guia turístico?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sim. O TUGGI funciona como um áudio-guia autoguiado para você explorar no seu ritmo, sem contratar guia humano nem tour fixo. As histórias tocam sozinhas ao chegar em cada ponto de interesse, a pé ou de carro.\"}},{\"@type\":\"Question\",\"name\":\"O TUGGI funciona offline e no meu idioma?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sim. Baixe a rota antes e ouça sem sinal e sem custo de roaming. O TUGGI oferece áudio em 10 idiomas com legendas sincronizadas para viajantes surdos e com deficiência auditiva.\"}},{\"@type\":\"Question\",\"name\":\"Como o TUGGI é diferente do Google Maps ou de um guia humano?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"O TUGGI não é um app de navegação e não substitui o seu GPS — ele roda junto e adiciona narração em áudio autoguiada sobre os lugares por onde você passa. Diferente de um guia humano, está disponível 24/7, em vários idiomas, sem usar as mãos e grátis para começar.\"}},{\"@type\":\"Question\",\"name\":\"Para quem o TUGGI é indicado?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Para qualquer pessoa que gosta de explorar em movimento: turistas, moradores curiosos, ciclistas, caminhantes, passageiros de ônibus, trem ou van e também motoristas. Funciona em roteiro de carro, no city tour a pé, no passeio de bike ou de patinete e no transporte público. Como o áudio é acionado por GPS e roda offline, a experiência é a mesma em qualquer meio de transporte.\"}}]}</script><section class=\"bg-tuggi-bg pt-28 pb-20 lg:pt-32 lg:pb-28 overflow-hidden\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"grid grid-cols-1 lg:grid-cols-2 gap-14 lg:gap-16 items-center\"><div class=\"max-w-2xl mx-auto lg:mx-0 text-center lg:text-left\"><h1 class=\"text-4xl sm:text-5xl lg:text-6xl font-extrabold text-tuggi-dark tracking-tight mb-6 leading-[1.1]\">Você se move, o TUGGI conta a história de cada lugar.</h1><p class=\"text-lg sm:text-xl text-tuggi-slate mb-8 leading-relaxed\">Ligue o TUGGI, comece a se mover e guarde o celular. Pelo GPS ele reconhece cada ponto turístico do caminho e conta a história em voz alta. Vale a pé, de bike, de carro ou no transporte público, offline e no seu idioma.</p><div class=\"flex flex-row flex-wrap gap-4 items-center justify-center lg:justify-start\"><a href=\"https://apps.apple.com/app/tuggi-drive/id6744379818\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"hover:-translate-y-0.5 hover:opacity-90 active:scale-[0.97] transition-[transform,opacity] duration-150 motion-reduce:hover:translate-y-0 motion-reduce:active:scale-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2 rounded-xl shrink-0\"><img alt=\"Baixe o TUGGI na App Store\" loading=\"lazy\" width=\"140\" height=\"42\" decoding=\"async\" data-nimg=\"1\" class=\"h-11 w-auto\" style=\"color:transparent\" src=\"/images/badges/app-store-badge.svg\"/></a><a href=\"https://play.google.com/store/apps/details?id=com.tuggidrive.app\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"hover:-translate-y-0.5 hover:opacity-90 active:scale-[0.97] transition-[transform,opacity] duration-150 motion-reduce:hover:translate-y-0 motion-reduce:active:scale-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2 rounded-xl shrink-0\"><img alt=\"Baixe o TUGGI no Google Play\" loading=\"lazy\" width=\"140\" height=\"42\" decoding=\"async\" data-nimg=\"1\" class=\"h-11 w-auto\" style=\"color:transparent\" src=\"/images/badges/google-play-badge.svg\"/></a></div><p class=\"mt-6 text-sm font-medium text-tuggi-slate\">Comece grátis · Funciona offline · Áudio em 10 idiomas</p></div><div class=\"flex justify-center lg:justify-end\"><div class=\"relative w-full max-w-[280px] sm:max-w-[300px] lg:max-w-[320px]\"><span aria-hidden=\"true\" class=\"tuggi-gps-ring pointer-events-none absolute left-1/2 top-[42%] h-28 w-28 rounded-full border border-tuggi-primary/40\"></span><span aria-hidden=\"true\" class=\"tuggi-gps-ring tuggi-gps-ring--delayed pointer-events-none absolute left-1/2 top-[42%] h-28 w-28 rounded-full border border-tuggi-primary/40\"></span><div class=\"relative\" style=\"transform:translateY(24px)\"><div class=\"mx-auto max-w-none w-full\"><div class=\"rounded-[2.5rem] bg-tuggi-dark p-2.5 shadow-[0_30px_60px_-15px_rgba(11,18,32,0.35)] ring-1 ring-black/5\"><div class=\"overflow-hidden rounded-[2rem] bg-black\"><img alt=\"Ficha de um ponto no app TUGGI, aberta sobre o mapa: o nome do lugar, a distância, o começo da história e os botões para ouvir a história ou ler a transcrição.\" width=\"780\" height=\"1689\" decoding=\"async\" data-nimg=\"1\" class=\"block h-auto w-full\" style=\"color:transparent\" sizes=\"(max-width: 1024px) 70vw, 320px\" srcSet=\"/_next/image?url=%2Fimages%2Fapp%2Fpoi-story.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fapp%2Fpoi-story.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fapp%2Fpoi-story.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fapp%2Fpoi-story.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fapp%2Fpoi-story.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fapp%2Fpoi-story.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fapp%2Fpoi-story.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fapp%2Fpoi-story.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fapp%2Fpoi-story.jpg&amp;w=3840&amp;q=75\"/></div></div></div></div></div></div></div></div></section><section class=\"bg-white py-20 lg:py-24 border-t border-gray-100\"><div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8\"><h2 class=\"text-3xl sm:text-4xl font-extrabold text-tuggi-dark tracking-tight text-center mb-14\">Comece a ouvir em um minuto</h2><div class=\"relative\"><svg aria-hidden=\"true\" class=\"hidden md:block absolute left-[16.6%] right-[16.6%] top-7 h-2 w-auto overflow-visible text-tuggi-primary/30\" viewBox=\"0 0 100 2\" preserveAspectRatio=\"none\"><line x1=\"0\" y1=\"1\" x2=\"100\" y2=\"1\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" vector-effect=\"non-scaling-stroke\" pathLength=\"1\" stroke-dashoffset=\"0\" stroke-dasharray=\"0 1\"></line></svg><ol class=\"grid grid-cols-1 md:grid-cols-3 gap-10\"><li class=\"flex flex-col items-center text-center\" style=\"transform:translateY(16px)\"><div class=\"relative mb-6\"><div class=\"relative z-10 w-16 h-16 rounded-2xl bg-tuggi-bg text-tuggi-primary flex items-center justify-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-download w-8 h-8\" aria-hidden=\"true\"><path d=\"M12 15V3\"></path><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path><path d=\"m7 10 5 5 5-5\"></path></svg></div><span class=\"absolute z-20 -top-2 -right-2 w-7 h-7 rounded-full bg-tuggi-primary text-tuggi-dark text-sm font-bold flex items-center justify-center\" aria-hidden=\"true\" style=\"transform:scale(0.8)\">1</span></div><p class=\"text-lg text-tuggi-slate leading-relaxed max-w-xs\">Baixe o app e escolha seu idioma.</p></li><li class=\"flex flex-col items-center text-center\" style=\"transform:translateY(16px)\"><div class=\"relative mb-6\"><div class=\"relative z-10 w-16 h-16 rounded-2xl bg-tuggi-bg text-tuggi-primary flex items-center justify-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-compass w-8 h-8\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m16.24 7.76-1.804 5.411a2 2 0 0 1-1.265 1.265L7.76 16.24l1.804-5.411a2 2 0 0 1 1.265-1.265z\"></path></svg></div><span class=\"absolute z-20 -top-2 -right-2 w-7 h-7 rounded-full bg-tuggi-primary text-tuggi-dark text-sm font-bold flex items-center justify-center\" aria-hidden=\"true\" style=\"transform:scale(0.8)\">2</span></div><p class=\"text-lg text-tuggi-slate leading-relaxed max-w-xs\">Inicie o guia e guarde o celular.</p></li><li class=\"flex flex-col items-center text-center\" style=\"transform:translateY(16px)\"><div class=\"relative mb-6\"><div class=\"relative z-10 w-16 h-16 rounded-2xl bg-tuggi-bg text-tuggi-primary flex items-center justify-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-volume2 lucide-volume-2 w-8 h-8\" aria-hidden=\"true\"><path d=\"M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z\"></path><path d=\"M16 9a5 5 0 0 1 0 6\"></path><path d=\"M19.364 18.364a9 9 0 0 0 0-12.728\"></path></svg></div><span class=\"absolute z-20 -top-2 -right-2 w-7 h-7 rounded-full bg-tuggi-primary text-tuggi-dark text-sm font-bold flex items-center justify-center\" aria-hidden=\"true\" style=\"transform:scale(0.8)\">3</span></div><p class=\"text-lg text-tuggi-slate leading-relaxed max-w-xs\">As histórias tocam sozinhas conforme você passa por cada lugar.</p></li></ol></div></div></section><section data-block=\"scene\" class=\"bg-tuggi-dark py-24 lg:py-32\"><div class=\"page-shell\"><div class=\"max-w-3xl\"><p class=\"whitespace-pre-line text-2xl sm:text-3xl lg:text-4xl font-extrabold leading-tight tracking-tight text-white\">Hoje você passou por quarenta histórias.\nOuviu nenhuma.</p><p class=\"mt-8 text-lg leading-relaxed text-white\">O forte na entrada da cidade, a igreja do século XVIII, a serra que tem nome e motivo. Tudo passou pela janela calado, porque ninguém para no acostamento pra pesquisar sobre o que acabou de passar.</p></div></div></section><section class=\"bg-white py-20 lg:py-24 border-t border-gray-100\"><div class=\"page-shell text-center\"><div class=\"max-w-3xl mx-auto\"><h2 class=\"text-3xl sm:text-4xl font-extrabold text-tuggi-dark tracking-tight mb-3\">Ouça o TUGGI na prática</h2><p class=\"text-lg text-tuggi-slate mb-10\">Histórias curtas, do jeito que você ouve enquanto explora.</p></div><div class=\"grid gap-4 text-left grid-cols-1 sm:grid-cols-2 lg:grid-cols-3\"><article class=\"flex flex-col gap-4 rounded-2xl border p-5 sm:flex-row sm:items-start bg-white border-gray-200\"><button type=\"button\" aria-label=\"Tocar a história de Avenida Paulista\" class=\"grid h-14 w-14 shrink-0 place-items-center rounded-full bg-tuggi-primary text-tuggi-dark transition-transform duration-150 hover:scale-105 active:scale-95 motion-reduce:transition-none motion-reduce:hover:scale-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-play ml-0.5 h-6 w-6 fill-current\" aria-hidden=\"true\"><path d=\"M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z\"></path></svg></button><div class=\"flex min-w-0 flex-1 flex-col gap-2\"><div><p class=\"line-clamp-2 font-bold text-tuggi-dark\">Avenida Paulista</p><p class=\"text-sm text-tuggi-slate\">São Paulo, Brasil</p></div><ul class=\"flex flex-wrap gap-1.5\"><li class=\"flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-semibold bg-tuggi-bg text-tuggi-slate border-gray-200\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-volume2 lucide-volume-2 h-3 w-3\" aria-hidden=\"true\"><path d=\"M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z\"></path><path d=\"M16 9a5 5 0 0 1 0 6\"></path><path d=\"M19.364 18.364a9 9 0 0 0 0-12.728\"></path></svg>História</li></ul><input type=\"range\" min=\"0\" max=\"0\" step=\"0.1\" disabled=\"\" aria-label=\"Avançar na história de Avenida Paulista\" aria-valuetext=\"0:00\" class=\"h-6 w-full cursor-pointer accent-tuggi-primary-text disabled:cursor-default\" value=\"0\"/></div><audio preload=\"metadata\" src=\"/audio/sample2-desc.mp3\"></audio></article><article class=\"flex flex-col gap-4 rounded-2xl border p-5 sm:flex-row sm:items-start bg-white border-gray-200\"><button type=\"button\" aria-label=\"Tocar a história de Ponte de Rialto\" class=\"grid h-14 w-14 shrink-0 place-items-center rounded-full bg-tuggi-primary text-tuggi-dark transition-transform duration-150 hover:scale-105 active:scale-95 motion-reduce:transition-none motion-reduce:hover:scale-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-play ml-0.5 h-6 w-6 fill-current\" aria-hidden=\"true\"><path d=\"M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z\"></path></svg></button><div class=\"flex min-w-0 flex-1 flex-col gap-2\"><div><p class=\"line-clamp-2 font-bold text-tuggi-dark\">Ponte de Rialto</p><p class=\"text-sm text-tuggi-slate\">Veneza, Itália</p></div><ul class=\"flex flex-wrap gap-1.5\"><li class=\"flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-semibold bg-tuggi-bg text-tuggi-slate border-gray-200\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-volume2 lucide-volume-2 h-3 w-3\" aria-hidden=\"true\"><path d=\"M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z\"></path><path d=\"M16 9a5 5 0 0 1 0 6\"></path><path d=\"M19.364 18.364a9 9 0 0 0 0-12.728\"></path></svg>História</li></ul><input type=\"range\" min=\"0\" max=\"0\" step=\"0.1\" disabled=\"\" aria-label=\"Avançar na história de Ponte de Rialto\" aria-valuetext=\"0:00\" class=\"h-6 w-full cursor-pointer accent-tuggi-primary-text disabled:cursor-default\" value=\"0\"/></div><audio preload=\"metadata\" src=\"/audio/sample3-desc.mp3\"></audio></article><article class=\"flex flex-col gap-4 rounded-2xl border p-5 sm:flex-row sm:items-start bg-white border-gray-200\"><button type=\"button\" aria-label=\"Tocar a história de Walt Disney World Resort\" class=\"grid h-14 w-14 shrink-0 place-items-center rounded-full bg-tuggi-primary text-tuggi-dark transition-transform duration-150 hover:scale-105 active:scale-95 motion-reduce:transition-none motion-reduce:hover:scale-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-play ml-0.5 h-6 w-6 fill-current\" aria-hidden=\"true\"><path d=\"M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z\"></path></svg></button><div class=\"flex min-w-0 flex-1 flex-col gap-2\"><div><p class=\"line-clamp-2 font-bold text-tuggi-dark\">Walt Disney World Resort</p><p class=\"text-sm text-tuggi-slate\">Orlando, Estados Unidos</p></div><ul class=\"flex flex-wrap gap-1.5\"><li class=\"flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-semibold bg-tuggi-bg text-tuggi-slate border-gray-200\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-volume2 lucide-volume-2 h-3 w-3\" aria-hidden=\"true\"><path d=\"M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z\"></path><path d=\"M16 9a5 5 0 0 1 0 6\"></path><path d=\"M19.364 18.364a9 9 0 0 0 0-12.728\"></path></svg>História</li></ul><input type=\"range\" min=\"0\" max=\"0\" step=\"0.1\" disabled=\"\" aria-label=\"Avançar na história de Walt Disney World Resort\" aria-valuetext=\"0:00\" class=\"h-6 w-full cursor-pointer accent-tuggi-primary-text disabled:cursor-default\" value=\"0\"/></div><audio preload=\"metadata\" src=\"/audio/sample1-desc.mp3\"></audio></article></div></div></section><section class=\"bg-tuggi-bg py-20 lg:py-28\"><div class=\"page-shell flex flex-col gap-20 lg:gap-28\"><div class=\"grid lg:grid-cols-2 gap-10 lg:gap-16 items-center\"><div class=\"max-w-xl mx-auto lg:mx-0 text-center lg:text-left lg:order-1\" style=\"transform:translateY(16px)\"><h3 class=\"text-2xl sm:text-3xl font-bold text-tuggi-dark tracking-tight mb-4 leading-snug\">Parado, ele mostra. Em movimento, ele fala.</h3><p class=\"text-lg text-tuggi-slate leading-relaxed\">Quando você para, abre o mapa e vê o que tem por perto: pontos turísticos, eventos e trilhas, com a distância de cada um. Voltou a se mover? O TUGGI volta a narrar: diz o nome do lugar e então conta a história.</p></div><div class=\"lg:order-2\"><div style=\"transform:translateY(16px)\"><div class=\"mx-auto w-full max-w-[300px]\"><div class=\"rounded-[2.5rem] bg-tuggi-dark p-2.5 shadow-[0_30px_60px_-15px_rgba(11,18,32,0.35)] ring-1 ring-black/5\"><div class=\"overflow-hidden rounded-[2rem] bg-black\"><img alt=\"Lista &quot;explorar ao redor&quot; do TUGGI com pontos de interesse próximos e suas distâncias\" loading=\"lazy\" width=\"780\" height=\"1689\" decoding=\"async\" data-nimg=\"1\" class=\"block h-auto w-full\" style=\"color:transparent\" sizes=\"(max-width: 1024px) 70vw, 300px\" srcSet=\"/_next/image?url=%2Fimages%2Fapp%2Fexplore-nearby.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fapp%2Fexplore-nearby.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fapp%2Fexplore-nearby.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fapp%2Fexplore-nearby.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fapp%2Fexplore-nearby.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fapp%2Fexplore-nearby.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fapp%2Fexplore-nearby.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fapp%2Fexplore-nearby.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fapp%2Fexplore-nearby.jpg&amp;w=3840&amp;q=75\"/></div></div></div></div></div></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-12 items-stretch\" style=\"transform:translateY(16px)\"><div class=\"flex flex-col text-center\"><div class=\"mx-auto w-full max-w-[200px]\"><div class=\"rounded-[2.5rem] bg-tuggi-dark p-2.5 shadow-[0_30px_60px_-15px_rgba(11,18,32,0.35)] ring-1 ring-black/5\"><div class=\"overflow-hidden rounded-[2rem] bg-black\"><img alt=\"Cartão de detalhe de evento do TUGGI com a data, um lembrete e o botão &quot;me leva até lá&quot;\" loading=\"lazy\" width=\"780\" height=\"1689\" decoding=\"async\" data-nimg=\"1\" class=\"block h-auto w-full\" style=\"color:transparent\" sizes=\"(max-width: 768px) 55vw, 200px\" srcSet=\"/_next/image?url=%2Fimages%2Fapp%2Fevent-detail.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Fapp%2Fevent-detail.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fapp%2Fevent-detail.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fapp%2Fevent-detail.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fapp%2Fevent-detail.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fapp%2Fevent-detail.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fapp%2Fevent-detail.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fapp%2Fevent-detail.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fapp%2Fevent-detail.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fapp%2Fevent-detail.jpg&amp;w=3840&amp;q=75\"/></div></div></div><h3 class=\"mt-8 text-2xl font-bold text-tuggi-dark tracking-tight mb-3 leading-snug\">Saiba o que está rolando agora</h3><p class=\"text-lg text-tuggi-slate leading-relaxed max-w-md mx-auto\">Festivais, feiras e eventos da cidade aparecem no seu mapa com data e lembrete. Achou algo que te interessa? Toca em &quot;me leva até lá&quot; e segue.</p></div><div class=\"flex flex-col text-center\"><div class=\"mx-auto w-full max-w-[200px]\"><div class=\"rounded-[2.5rem] bg-tuggi-dark p-2.5 shadow-[0_30px_60px_-15px_rgba(11,18,32,0.35)] ring-1 ring-black/5\"><div class=\"overflow-hidden rounded-[2rem] bg-black\"><img alt=\"Detalhe de trilha do TUGGI com a rota desenhada no mapa e suas paradas\" loading=\"lazy\" width=\"780\" height=\"1689\" decoding=\"async\" data-nimg=\"1\" class=\"block h-auto w-full\" style=\"color:transparent\" sizes=\"(max-width: 768px) 55vw, 200px\" srcSet=\"/_next/image?url=%2Fimages%2Fapp%2Ftrail-detail.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Fapp%2Ftrail-detail.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fapp%2Ftrail-detail.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fapp%2Ftrail-detail.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fapp%2Ftrail-detail.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fapp%2Ftrail-detail.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fapp%2Ftrail-detail.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fapp%2Ftrail-detail.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fapp%2Ftrail-detail.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fapp%2Ftrail-detail.jpg&amp;w=3840&amp;q=75\"/></div></div></div><h3 class=\"mt-8 text-2xl font-bold text-tuggi-dark tracking-tight mb-3 leading-snug\">Tem roteiro pronto, mas quem manda é você</h3><p class=\"text-lg text-tuggi-slate leading-relaxed max-w-md mx-auto\">Se quiser, siga uma trilha montada por tema, tipo a Rota Religiosa de Búzios, com as paradas e as histórias já no lugar. Se não quiser, esquece o roteiro: o TUGGI narra por onde você for.</p></div></div><div class=\"grid lg:grid-cols-2 gap-10 lg:gap-16 items-center\"><div class=\"max-w-xl mx-auto lg:mx-0 text-center lg:text-left lg:order-2\" style=\"transform:translateY(16px)\"><h3 class=\"text-2xl sm:text-3xl font-bold text-tuggi-dark tracking-tight mb-4 leading-snug\">Feito pra levar pra qualquer lugar</h3><p class=\"text-lg text-tuggi-slate leading-relaxed\">Baixe os mapas e use tudo sem internet. Controle o guia por voz com a Siri ou o Google, sem tirar o celular do bolso. E ouça em 10 idiomas, do jeito que for melhor pra você.</p></div><div class=\"lg:order-1\"><div style=\"transform:translateY(16px)\"><div class=\"flex justify-center gap-4 sm:gap-6\"><div class=\"mx-auto w-1/2 max-w-[200px]\"><div class=\"rounded-[2.5rem] bg-tuggi-dark p-2.5 shadow-[0_30px_60px_-15px_rgba(11,18,32,0.35)] ring-1 ring-black/5\"><div class=\"overflow-hidden rounded-[2rem] bg-black\"><img alt=\"Ferramentas do explorador no TUGGI, incluindo mapas offline e comandos de voz\" loading=\"lazy\" width=\"780\" height=\"1689\" decoding=\"async\" data-nimg=\"1\" class=\"block h-auto w-full\" style=\"color:transparent\" sizes=\"(max-width: 640px) 42vw, 200px\" srcSet=\"/_next/image?url=%2Fimages%2Fapp%2Ftools.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Fapp%2Ftools.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fapp%2Ftools.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fapp%2Ftools.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fapp%2Ftools.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fapp%2Ftools.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fapp%2Ftools.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fapp%2Ftools.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fapp%2Ftools.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fapp%2Ftools.jpg&amp;w=3840&amp;q=75\"/></div></div></div><div class=\"mx-auto w-1/2 max-w-[200px] mt-10\"><div class=\"rounded-[2.5rem] bg-tuggi-dark p-2.5 shadow-[0_30px_60px_-15px_rgba(11,18,32,0.35)] ring-1 ring-black/5\"><div class=\"overflow-hidden rounded-[2rem] bg-black\"><img alt=\"Seletor de idioma de áudio do TUGGI com inglês, espanhol, italiano, português e mais\" loading=\"lazy\" width=\"780\" height=\"1689\" decoding=\"async\" data-nimg=\"1\" class=\"block h-auto w-full\" style=\"color:transparent\" sizes=\"(max-width: 640px) 42vw, 200px\" srcSet=\"/_next/image?url=%2Fimages%2Fapp%2Flanguages.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Fapp%2Flanguages.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fapp%2Flanguages.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fapp%2Flanguages.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fapp%2Flanguages.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fapp%2Flanguages.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fapp%2Flanguages.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fapp%2Flanguages.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fapp%2Flanguages.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fapp%2Flanguages.jpg&amp;w=3840&amp;q=75\"/></div></div></div></div></div></div></div><div class=\"grid lg:grid-cols-2 gap-10 lg:gap-16 items-center\"><div class=\"max-w-xl mx-auto lg:mx-0 text-center lg:text-left lg:order-1\" style=\"transform:translateY(16px)\"><h3 class=\"text-2xl sm:text-3xl font-bold text-tuggi-dark tracking-tight mb-4 leading-snug\">Cada viagem fica registrada no seu passaporte</h3><p class=\"text-lg text-tuggi-slate leading-relaxed\">O app soma tudo: lugares descobertos, cidades, quilômetros percorridos e horas de áudio. Vira um histórico das suas viagens que dá pra mostrar pros amigos.</p></div><div class=\"lg:order-2\"><div style=\"transform:translateY(16px)\"><div class=\"mx-auto w-full max-w-[300px]\"><div class=\"rounded-[2.5rem] bg-tuggi-dark p-2.5 shadow-[0_30px_60px_-15px_rgba(11,18,32,0.35)] ring-1 ring-black/5\"><div class=\"overflow-hidden rounded-[2rem] bg-black\"><img alt=\"Passaporte do explorador no TUGGI com descobertas, cidades, quilômetros e horas de áudio\" loading=\"lazy\" width=\"780\" height=\"1689\" decoding=\"async\" data-nimg=\"1\" class=\"block h-auto w-full\" style=\"color:transparent\" sizes=\"(max-width: 1024px) 70vw, 300px\" srcSet=\"/_next/image?url=%2Fimages%2Fapp%2Fpassport.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fapp%2Fpassport.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fapp%2Fpassport.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fapp%2Fpassport.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fapp%2Fpassport.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fapp%2Fpassport.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fapp%2Fpassport.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fapp%2Fpassport.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fapp%2Fpassport.jpg&amp;w=3840&amp;q=75\"/></div></div></div></div></div></div></div></section><section class=\"w-full py-20 bg-white\" data-proof-block=\"light\"><div class=\"page-shell\"><div class=\"max-w-3xl space-y-6 sm:mx-auto text-left sm:text-center\"><p data-proof-line=\"points\" class=\"text-lg sm:text-xl leading-relaxed text-tuggi-slate\"><strong class=\"block sm:inline text-4xl sm:text-5xl font-extrabold leading-none text-tuggi-dark\">Mais de 2 milhões</strong> de pontos mapeados, em 48 países.</p><p data-proof-line=\"guides\" class=\"text-lg leading-relaxed text-tuggi-slate\"><strong class=\"block sm:inline text-2xl font-bold leading-tight text-tuggi-dark\">Mais de 16.000</strong> áudio-guias produzidos, com áudio em 10 idiomas.</p><p data-proof-line=\"since\" class=\"text-base leading-relaxed text-tuggi-slate\">Operando desde 2025.</p></div></div></section><section data-block=\"coverage-density\" class=\"py-20 bg-tuggi-dark relative overflow-hidden\"><div class=\"absolute inset-0 opacity-10\" style=\"background-image:radial-gradient(var(--color-tuggi-slate) 1px, transparent 1px);background-size:30px 30px\"></div><div class=\"container mx-auto px-6 relative z-10\"><div class=\"text-center mb-10\"><h2 class=\"text-3xl md:text-5xl font-black text-white mb-3\">Onde o TUGGI já está</h2><p class=\"text-gray-300 text-base max-w-xl mx-auto\">Quanto mais clara a área, maior a densidade de pontos mapeados naquela região.</p></div><div data-part=\"map-frame\" class=\"relative w-full max-w-3xl mx-auto rounded-[40px] border border-white/5 overflow-hidden shadow-2xl\" style=\"aspect-ratio:800 / 757;background-color:color-mix(in srgb, var(--color-tuggi-slate) 8%, var(--color-tuggi-dark))\"></div><div class=\"mt-6\"><h3 class=\"text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-3 text-center\">Densidade de cobertura</h3><ul class=\"flex flex-wrap justify-center gap-x-6 gap-y-2\"><li class=\"flex items-center gap-2\"><span data-density-swatch=\"0\" aria-hidden=\"true\" class=\"w-4 h-3 rounded-[3px] shrink-0\" style=\"background-color:color-mix(in srgb, var(--color-tuggi-primary) 55%, var(--color-tuggi-dark));outline:1px solid color-mix(in srgb, var(--color-tuggi-bg) 40%, var(--color-tuggi-primary))\"></span><span class=\"text-xs font-semibold text-gray-300\">Cobertura inicial</span></li><li class=\"flex items-center gap-2\"><span data-density-swatch=\"1\" aria-hidden=\"true\" class=\"w-4 h-3 rounded-[3px] shrink-0\" style=\"background-color:color-mix(in srgb, var(--color-tuggi-primary) 80%, var(--color-tuggi-dark));outline:1px solid color-mix(in srgb, var(--color-tuggi-bg) 40%, var(--color-tuggi-primary))\"></span><span class=\"text-xs font-semibold text-gray-300\">Cobertura moderada</span></li><li class=\"flex items-center gap-2\"><span data-density-swatch=\"2\" aria-hidden=\"true\" class=\"w-4 h-3 rounded-[3px] shrink-0\" style=\"background-color:var(--color-tuggi-primary);outline:1px solid color-mix(in srgb, var(--color-tuggi-bg) 40%, var(--color-tuggi-primary))\"></span><span class=\"text-xs font-semibold text-gray-300\">Cobertura alta</span></li><li class=\"flex items-center gap-2\"><span data-density-swatch=\"3\" aria-hidden=\"true\" class=\"w-4 h-3 rounded-[3px] shrink-0\" style=\"background-color:color-mix(in srgb, var(--color-tuggi-bg) 40%, var(--color-tuggi-primary));outline:1px solid color-mix(in srgb, var(--color-tuggi-bg) 40%, var(--color-tuggi-primary))\"></span><span class=\"text-xs font-semibold text-gray-300\">Cobertura mais densa</span></li></ul></div></div></section><section data-block=\"coverage-list\" class=\"py-20 bg-white border-t border-gray-100\"><div class=\"container mx-auto px-6\"><div class=\"text-center mb-12\"><h3 class=\"text-3xl md:text-4xl font-black text-tuggi-dark mb-4\">Veja se o seu destino já está no mapa</h3><p class=\"text-tuggi-slate text-lg max-w-2xl mx-auto\">A lista completa, região por região, está na página de cobertura.</p></div><div class=\"mb-10 last:mb-0\"><h4 class=\"text-xs font-bold uppercase tracking-widest text-tuggi-slate mb-5 pb-2 border-b border-gray-200\">Américas</h4><ul class=\"flex flex-wrap gap-2\"><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Estados Unidos</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Canadá</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Brasil</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Argentina</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">México</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Peru</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Chile</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Colômbia</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Venezuela</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Equador</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Costa Rica</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Nicarágua</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Bolívia</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Guatemala</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Cuba</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Honduras</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">El Salvador</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Paraguai</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Panamá</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">República Dominicana</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Haiti</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Uruguai</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Belize</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Jamaica</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Guiana</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Suriname</li></ul></div><div class=\"mb-10 last:mb-0\"><h4 class=\"text-xs font-bold uppercase tracking-widest text-tuggi-slate mb-5 pb-2 border-b border-gray-200\">Europa</h4><ul class=\"flex flex-wrap gap-2\"><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Alemanha</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">França</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Itália</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Espanha</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Reino Unido</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Bélgica</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Irlanda</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Portugal</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Suíça</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Áustria</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Eslovênia</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Luxemburgo</li></ul></div><div class=\"mb-10 last:mb-0\"><h4 class=\"text-xs font-bold uppercase tracking-widest text-tuggi-slate mb-5 pb-2 border-b border-gray-200\">Outros destinos</h4><ul class=\"flex flex-wrap gap-2\"><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Netherlands</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Poland</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Czech Republic</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Marrocos</li></ul></div><div class=\"mt-10 text-center\"><a class=\"inline-flex items-center gap-2 font-semibold text-tuggi-primary-text hover:text-tuggi-primary transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2 rounded\" href=\"/pt/coverage\">Ver cobertura completa<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-4 h-4\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></section><section data-block=\"business\" class=\"bg-tuggi-bg py-20 lg:py-24\"><div class=\"page-shell\"><div class=\"max-w-2xl\"><h2 class=\"text-3xl sm:text-4xl font-extrabold text-tuggi-dark tracking-tight mb-4\">TUGGI para o seu negócio</h2><p class=\"text-lg text-tuggi-slate leading-relaxed\">Empresas de transfer, frotas de aluguel e destinos usam o TUGGI para dar a cada viajante um guia local.</p></div><div class=\"mt-10 grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch\"><a class=\"group flex items-center justify-between gap-6 rounded-3xl border border-gray-200 bg-white px-8 py-8 shadow-sm transition-transform duration-150 hover:-translate-y-1 motion-reduce:hover:translate-y-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2\" href=\"/pt/enterprise/fleets\"><span class=\"text-xl font-bold text-tuggi-dark leading-snug\">Para frotas e operadores</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-6 h-6 shrink-0 text-tuggi-primary-text transition-transform group-hover:translate-x-1 motion-reduce:group-hover:translate-x-0\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"group flex items-center justify-between gap-6 rounded-3xl border border-gray-200 bg-white px-8 py-8 shadow-sm transition-transform duration-150 hover:-translate-y-1 motion-reduce:hover:translate-y-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2\" href=\"/pt/destinos\"><span class=\"text-xl font-bold text-tuggi-dark leading-snug\">Para destinos</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-6 h-6 shrink-0 text-tuggi-primary-text transition-transform group-hover:translate-x-1 motion-reduce:group-hover:translate-x-0\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></section><section class=\"bg-white py-16 lg:py-20 border-t border-gray-100\"><div class=\"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8\"><h2 class=\"text-2xl sm:text-3xl font-bold text-tuggi-dark tracking-tight mb-6\">O que é o TUGGI</h2><div class=\"space-y-4 text-tuggi-slate leading-relaxed\"><p>O TUGGI é um áudio-guia de viagem autoguiado para iPhone e Android. Ele usa o GPS para reconhecer os lugares por onde você passa e conta a história de cada um em voz alta, na hora certa, sem você precisar procurar nada na tela. Funciona do jeito que você viaja: a pé, de bike, de carro, de ônibus ou no metrô.</p><p>As histórias tocam sozinhas quando você se aproxima de um ponto turístico. Como tudo funciona offline, você baixa a cidade antes de sair e ouve sem internet e sem gastar dados em roaming. E como o áudio vem com legenda sincronizada, viajantes surdos ou com baixa audição acompanham cada história pela tela.</p><p>O TUGGI não substitui o seu GPS de navegação: ele roda junto, sem atrapalhar o mapa nem a música, e só adiciona a narração cultural do caminho. Comece grátis, escolha entre 10 idiomas e transforme qualquer trajeto em uma viagem com história.</p></div></div></section><section data-block=\"faq\" class=\"py-24 bg-white border-t border-gray-100\"><div class=\"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8\"><h2 class=\"text-3xl sm:text-4xl font-extrabold text-tuggi-dark tracking-tight mb-12 text-center\">Perguntas frequentes</h2><dl class=\"flex flex-col gap-4\"><div class=\"rounded-2xl border transition-all duration-200 border-gray-200 bg-white hover:border-tuggi-primary/20\"><dt><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-answer-1\" class=\"w-full flex items-center justify-between gap-4 px-6 py-5 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2 rounded-2xl\"><span class=\"text-base font-bold text-tuggi-dark leading-snug\">Qual é o melhor app de áudio-guia autoguiado?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-5 h-5 flex-shrink-0 text-tuggi-primary transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></dt><dd id=\"faq-answer-1\" class=\"overflow-hidden transition-all duration-200 max-h-0\"><p class=\"px-6 pb-5 text-slate-600 leading-relaxed text-sm\">O TUGGI é um áudio-guia de viagem autoguiado para iOS e Android. Ele toca histórias em áudio sobre os lugares ao seu redor automaticamente, ativadas por GPS — sem usar as mãos e sem olhar a tela — enquanto você dirige, caminha ou pedala. Funciona offline, tem 10 idiomas com legendas e é grátis para começar.</p></dd></div><div class=\"rounded-2xl border transition-all duration-200 border-gray-200 bg-white hover:border-tuggi-primary/20\"><dt><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-answer-2\" class=\"w-full flex items-center justify-between gap-4 px-6 py-5 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2 rounded-2xl\"><span class=\"text-base font-bold text-tuggi-dark leading-snug\">Existe um app de áudio-guia de viagem grátis?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-5 h-5 flex-shrink-0 text-tuggi-primary transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></dt><dd id=\"faq-answer-2\" class=\"overflow-hidden transition-all duration-200 max-h-0\"><p class=\"px-6 pb-5 text-slate-600 leading-relaxed text-sm\">Sim. O TUGGI é grátis para baixar e já começa com histórias todo dia. Para ouvir sem limite diário, um Passe Tuggi dá 10, 25 ou 45 horas de uso, com pagamento único. As horas não expiram e você vê o preço na App Store ou no Google Play.</p></dd></div><div class=\"rounded-2xl border transition-all duration-200 border-gray-200 bg-white hover:border-tuggi-primary/20\"><dt><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-answer-3\" class=\"w-full flex items-center justify-between gap-4 px-6 py-5 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2 rounded-2xl\"><span class=\"text-base font-bold text-tuggi-dark leading-snug\">Qual é um bom app de viagem para road trip?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-5 h-5 flex-shrink-0 text-tuggi-primary transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></dt><dd id=\"faq-answer-3\" class=\"overflow-hidden transition-all duration-200 max-h-0\"><p class=\"px-6 pb-5 text-slate-600 leading-relaxed text-sm\">O TUGGI foi feito para road trips: roda junto com a sua navegação e música e narra automaticamente os pontos, as cidades e a história por onde você passa — sem tela, sem procurar nada. Baixe a rota antes e use offline, sem roaming.</p></dd></div><div class=\"rounded-2xl border transition-all duration-200 border-gray-200 bg-white hover:border-tuggi-primary/20\"><dt><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-answer-4\" class=\"w-full flex items-center justify-between gap-4 px-6 py-5 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2 rounded-2xl\"><span class=\"text-base font-bold text-tuggi-dark leading-snug\">Dá para explorar uma cidade sem guia turístico?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-5 h-5 flex-shrink-0 text-tuggi-primary transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></dt><dd id=\"faq-answer-4\" class=\"overflow-hidden transition-all duration-200 max-h-0\"><p class=\"px-6 pb-5 text-slate-600 leading-relaxed text-sm\">Sim. O TUGGI funciona como um áudio-guia autoguiado para você explorar no seu ritmo, sem contratar guia humano nem tour fixo. As histórias tocam sozinhas ao chegar em cada ponto de interesse, a pé ou de carro.</p></dd></div><div class=\"rounded-2xl border transition-all duration-200 border-gray-200 bg-white hover:border-tuggi-primary/20\"><dt><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-answer-5\" class=\"w-full flex items-center justify-between gap-4 px-6 py-5 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2 rounded-2xl\"><span class=\"text-base font-bold text-tuggi-dark leading-snug\">O TUGGI funciona offline e no meu idioma?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-5 h-5 flex-shrink-0 text-tuggi-primary transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></dt><dd id=\"faq-answer-5\" class=\"overflow-hidden transition-all duration-200 max-h-0\"><p class=\"px-6 pb-5 text-slate-600 leading-relaxed text-sm\">Sim. Baixe a rota antes e ouça sem sinal e sem custo de roaming. O TUGGI oferece áudio em 10 idiomas com legendas sincronizadas para viajantes surdos e com deficiência auditiva.</p></dd></div><div class=\"rounded-2xl border transition-all duration-200 border-gray-200 bg-white hover:border-tuggi-primary/20\"><dt><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-answer-6\" class=\"w-full flex items-center justify-between gap-4 px-6 py-5 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2 rounded-2xl\"><span class=\"text-base font-bold text-tuggi-dark leading-snug\">Como o TUGGI é diferente do Google Maps ou de um guia humano?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-5 h-5 flex-shrink-0 text-tuggi-primary transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></dt><dd id=\"faq-answer-6\" class=\"overflow-hidden transition-all duration-200 max-h-0\"><p class=\"px-6 pb-5 text-slate-600 leading-relaxed text-sm\">O TUGGI não é um app de navegação e não substitui o seu GPS — ele roda junto e adiciona narração em áudio autoguiada sobre os lugares por onde você passa. Diferente de um guia humano, está disponível 24/7, em vários idiomas, sem usar as mãos e grátis para começar.</p></dd></div><div class=\"rounded-2xl border transition-all duration-200 border-gray-200 bg-white hover:border-tuggi-primary/20\"><dt><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-answer-7\" class=\"w-full flex items-center justify-between gap-4 px-6 py-5 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2 rounded-2xl\"><span class=\"text-base font-bold text-tuggi-dark leading-snug\">Para quem o TUGGI é indicado?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-5 h-5 flex-shrink-0 text-tuggi-primary transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></dt><dd id=\"faq-answer-7\" class=\"overflow-hidden transition-all duration-200 max-h-0\"><p class=\"px-6 pb-5 text-slate-600 leading-relaxed text-sm\">Para qualquer pessoa que gosta de explorar em movimento: turistas, moradores curiosos, ciclistas, caminhantes, passageiros de ônibus, trem ou van e também motoristas. Funciona em roteiro de carro, no city tour a pé, no passeio de bike ou de patinete e no transporte público. Como o áudio é acionado por GPS e roda offline, a experiência é a mesma em qualquer meio de transporte.</p></dd></div></dl></div></section><!--$--><!--/$--></main><footer class=\"bg-tuggi-dark text-tuggi-slate border-t border-gray-800\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16\"><div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8\"><div class=\"lg:col-span-4 flex flex-col space-y-6 lg:pr-8\"><a class=\"inline-block focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text rounded-sm w-max\" href=\"/pt\"><img alt=\"TUGGI\" loading=\"lazy\" width=\"98\" height=\"32\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Flogo_tuggi_full_white.png&amp;w=128&amp;q=75 1x, /_next/image?url=%2Fimages%2Flogo_tuggi_full_white.png&amp;w=256&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2Flogo_tuggi_full_white.png&amp;w=256&amp;q=75\"/></a><p class=\"text-sm text-slate-400 max-w-xs leading-relaxed\">Conectando pessoas ao contexto do mundo físico</p></div><div class=\"lg:col-span-2 flex flex-col\"><h3 class=\"text-xs font-bold tracking-widest text-white uppercase mb-6\">TUGGI (B2C)</h3><a data-download-cta=\"footer\" class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/pt/d/tuggi\">Baixar Aplicativo</a><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/pt/drive\">Passes</a><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/pt/tours\">Roteiros de Áudio</a><div class=\"flex flex-col gap-3 mt-6\"><a href=\"https://apps.apple.com/app/tuggi-drive/id6744379818\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"hover:opacity-80 transition-opacity focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text rounded-lg w-max\"><img alt=\"Download on the App Store\" loading=\"lazy\" width=\"120\" height=\"35\" decoding=\"async\" data-nimg=\"1\" class=\"h-9 w-auto\" style=\"color:transparent\" src=\"/images/badges/app-store-badge.svg\"/></a><a href=\"https://play.google.com/store/apps/details?id=com.tuggidrive.app\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"hover:opacity-80 transition-opacity focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text rounded-lg w-max\"><img alt=\"Get it on Google Play\" loading=\"lazy\" width=\"120\" height=\"35\" decoding=\"async\" data-nimg=\"1\" class=\"h-9 w-auto\" style=\"color:transparent\" src=\"/images/badges/google-play-badge.svg\"/></a></div></div><div class=\"lg:col-span-2 flex flex-col\"><h3 class=\"text-xs font-bold tracking-widest text-white uppercase mb-6\">Enterprise (B2B/B2G)</h3><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/pt/destinos\">Destinos</a><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/pt/enterprise/fleets\">Frotas</a><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/pt/tecnologia\">Tecnologia</a></div><div class=\"lg:col-span-2 flex flex-col\"><h3 class=\"text-xs font-bold tracking-widest text-white uppercase mb-6\">Institucional</h3><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/pt/purpose\">Nosso Propósito</a><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/pt/contact\">Contato</a><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/pt/coverage\">Cobertura Global</a><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/pt/novidades\">Novidades</a></div><div class=\"lg:col-span-2 flex flex-col\"><h3 class=\"text-xs font-bold tracking-widest text-white uppercase mb-6\">Central de Confiança e Conformidade</h3><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/pt/trust-center/terms-of-use\">Termos de Uso</a><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/pt/trust-center/privacy-policy\">Política de Privacidade</a><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/pt/trust-center/accessibility\">Acessibilidade</a><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/pt/trust-center/security-sla\">Segurança B2G</a></div></div><div class=\"mt-16 pt-8 border-t border-slate-800 flex flex-col items-center sm:items-start space-y-4\"><p class=\"text-xs text-slate-400 text-center sm:text-left\">© <!-- -->2026<!-- --> TUGGI Technologies. <!-- -->Todos os direitos reservados.</p><div class=\"flex flex-col sm:flex-row gap-2 sm:gap-6 text-xs text-slate-400 font-medium text-center sm:text-left\"><p>CNPJ: 64.539.859/0001-56</p><p class=\"hidden sm:block text-slate-500\" aria-hidden=\"true\">•</p><p>Rua PAIS LEME, 215 - CONJ 1713 - Pinheiros - São Paulo, BR</p></div></div></div></footer><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"@id\":\"https://www.tuggi.app/#organization\",\"name\":\"TUGGI\",\"url\":\"https://www.tuggi.app\",\"logo\":\"https://www.tuggi.app/images/logo_tuggi_full.png\",\"description\":\"O TUGGI conta a história de um lugar em voz alta assim que você chega perto. Funciona offline, em 10 idiomas, grátis para começar no iOS e no Android.\",\"contactPoint\":{\"@type\":\"ContactPoint\",\"contactType\":\"customer support\",\"email\":\"suporte@tuggi.app\",\"availableLanguage\":[\"English\",\"Portuguese\",\"Spanish\"]},\"sameAs\":[\"https://www.linkedin.com/company/tuggi/\",\"https://www.instagram.com/tuggi_app\",\"https://www.tiktok.com/@tuggi_app\",\"https://www.facebook.com/people/Tuggi-Personal-tour-guide/61580839157589/\"]}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"SoftwareApplication\",\"name\":\"TUGGI\",\"operatingSystem\":\"iOS, Android\",\"applicationCategory\":\"TravelApplication\",\"description\":\"Ligue o TUGGI, comece a se mover e guarde o celular. Pelo GPS ele reconhece cada ponto turístico do caminho e conta a história em voz alta. Vale a pé, de bike, de carro ou no transporte público, offline e no seu idioma.\",\"url\":\"https://www.tuggi.app\",\"downloadUrl\":[\"https://apps.apple.com/app/tuggi-drive/id6744379818\",\"https://play.google.com/store/apps/details?id=com.tuggidrive.app\"],\"installUrl\":\"https://apps.apple.com/app/tuggi-drive/id6744379818\",\"sameAs\":[\"https://apps.apple.com/app/tuggi-drive/id6744379818\",\"https://play.google.com/store/apps/details?id=com.tuggidrive.app\"],\"screenshot\":\"h