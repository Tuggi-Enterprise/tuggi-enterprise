"activeCount\":57,\"comingSoonCount\":0},{\"state\":\"Paramaribo\",\"country\":\"Suriname\",\"activeCount\":54,\"comingSoonCount\":0},{\"state\":\"Koper\",\"country\":\"Slovenia\",\"activeCount\":53,\"comingSoonCount\":0},{\"state\":\"Merthyr Tydfil\",\"country\":\"United Kingdom\",\"activeCount\":52,\"comingSoonCount\":0},{\"state\":\"La Estrelleta\",\"country\":\"Dominican Republic\",\"activeCount\":51,\"comingSoonCount\":0},{\"state\":\"Valverde\",\"country\":\"Dominican Republic\",\"activeCount\":50,\"comingSoonCount\":0}],\"countryLabels\":{\"United States of America\":\"Estados Unidos\",\"Germany\":\"Alemanha\",\"France\":\"França\",\"Canada\":\"Canadá\",\"Italy\":\"Itália\",\"Spain\":\"Espanha\",\"United Kingdom\":\"Reino Unido\",\"Brazil\":\"Brasil\",\"Argentina\":\"Argentina\",\"Mexico\":\"México\",\"Belgium\":\"Bélgica\",\"Netherlands\":\"Netherlands\",\"Ireland\":\"Irlanda\",\"Peru\":\"Peru\",\"Chile\":\"Chile\",\"Colombia\":\"Colômbia\",\"Portugal\":\"Portugal\",\"Venezuela\":\"Venezuela\",\"Ecuador\":\"Equador\",\"Costa Rica\":\"Costa Rica\",\"Nicaragua\":\"Nicarágua\",\"Bolivia\":\"Bolívia\",\"Guatemala\":\"Guatemala\",\"Cuba\":\"Cuba\",\"Honduras\":\"Honduras\",\"El Salvador\":\"El Salvador\",\"Paraguay\":\"Paraguai\",\"Panama\":\"Panamá\",\"Dominican Republic\":\"República Dominicana\",\"Haiti\":\"Haiti\",\"Switzerland\":\"Suíça\",\"Uruguay\":\"Uruguai\",\"Austria\":\"Áustria\",\"Belize\":\"Belize\",\"Poland\":\"Poland\",\"Jamaica\":\"Jamaica\",\"Czech Republic\":\"Czech Republic\",\"Guyana\":\"Guiana\",\"Suriname\":\"Suriname\",\"Morocco\":\"Marrocos\",\"Slovenia\":\"Eslovênia\",\"Luxembourg\":\"Luxemburgo\"},\"showCountryFilter\":false}],\"$L13\"]}]]}],\"$L14\"]\na:[\"$\",\"$L15\",null,{}]\nb:[\"$\",\"section\",null,{\"className\":\"bg-white py-16 lg:py-20 border-t border-gray-100\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-bold text-tuggi-dark tracking-tight mb-6\",\"children\":\"O que é o TUGGI\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4 text-tuggi-slate leading-relaxed\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":\"O TUGGI é um áudio-guia de viagem autoguiado para iPhone e Android. Ele usa o GPS para reconhecer os lugares por onde você passa e conta a história de cada um em voz alta, na hora certa, sem você precisar procurar nada na tela. Funciona do jeito que você viaja: a pé, de bike, de carro, de ônibus ou no metrô.\"}],[\"$\",\"p\",\"1\",{\"children\":\"As histórias tocam sozinhas quando você se aproxima de um ponto turístico. Como tudo funciona offline, você baixa a cidade antes de sair e ouve sem internet e sem gastar dados em roaming. E como o áudio vem com legenda sincronizada, viajantes surdos ou com baixa audição acompanham cada história pela tela.\"}],[\"$\",\"p\",\"2\",{\"children\":\"O TUGGI não substitui o seu GPS de navegação: ele roda junto, sem atrapalhar o mapa nem a música, e só adiciona a narração cultural do caminho. Comece grátis, escolha entre 10 idiomas e transforme qualquer trajeto em uma viagem com história.\"}]]}]]}]}]\nc:[\"$\",\"$L16\",null,{\"namespace\":\"Home.FAQ\",\"count\":7}]\nd:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/00fc9bc083c08a18.js\",\"async\":true}]\ne:[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/d98e2f61488237bc.js\",\"async\":true}]\nf:[\"$\",\"$L17\",null,{\"children\":[\"$\",\"$18\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@19\"}]}]\n13:[\"$\",\"div\",null,{\"className\":\"mt-6\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-3 text-center\",\"children\":\"Densidade de cobertura\"}],[\"$\",\"ul\",null,{\"className\":\"flex flex-wrap justify-center gap-x-6 gap-y-2\",\"children\":[[\"$\",\"li\",\"lowest\",{\"className\":\"flex items-center gap-2\",\"children\":[[\"$\",\"span\",null,{\"data-density-swatch\":0,