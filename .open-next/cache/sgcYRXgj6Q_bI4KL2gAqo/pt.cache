 densa\"}]]}]]}]]}]\n22:[\"$\",\"section\",null,{\"data-block\":\"coverage-list\",\"className\":\"py-20 bg-white border-t border-gray-100\",\"children\":[\"$\",\"div\",null,{\"className\":\"container mx-auto px-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-center mb-12\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-3xl md:text-4xl font-black text-tuggi-dark mb-4\",\"children\":\"Veja se o seu destino já está no mapa\"}],[\"$\",\"p\",null,{\"className\":\"text-tuggi-slate text-lg max-w-2xl mx-auto\",\"children\":\"A lista completa, região por região, está na página de cobertura.\"}]]}],[[[\"$\",\"div\",\"americas\",{\"className\":\"mb-10 last:mb-0\",\"children\":[[\"$\",\"h4\",null,{\"className\":\"text-xs font-bold uppercase tracking-widest text-tuggi-slate mb-5 pb-2 border-b border-gray-200\",\"children\":\"Américas\"}],[\"$\",\"ul\",null,{\"className\":\"flex flex-wrap gap-2\",\"children\":[[\"$\",\"li\",\"United States of America\",{\"className\":\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\",\"children\":\"Estados Unidos\"}],[\"$\",\"li\",\"Canada\",{\"className\":\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\",\"children\":\"Canadá\"}],[\"$\",\"li\",\"Brazil\",{\"className\":\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\",\"children\":\"Brasil\"}],[\"$\",\"li\",\"Argentina\",{\"className\":\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\",\"children\":\"Argentina\"}],[\"$\",\"li\",\"Mexico\",{\"className\":\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\",\"children\":\"México\"}],[\"$\",\"li\",\"Peru\",{\"className\":\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\",\"children\":\"Peru\"}],[\"$\",\"li\",\"Chile\",{\"className\":\"round