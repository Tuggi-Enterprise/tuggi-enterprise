f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\",\"/_next/static/chunks/00fc9bc083c08a18.js\",\"/_next/static/chunks/d98e2f61488237bc.js\"],\"default\"]\n2:Tae8,{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Qual é o melhor app de áudio-guia autoguiado?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"O TUGGI é um áudio-guia de viagem autoguiado para iOS e Android. Ele toca histórias em áudio sobre os lugares ao seu redor automaticamente, ativadas por GPS — sem usar as mãos e sem olhar a tela — enquanto você dirige, caminha ou pedala. Funciona offline, tem 10 idiomas com legendas e é grátis para começar.\"}},{\"@type\":\"Question\",\"name\":\"Existe um app de áudio-guia de viagem grátis?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sim. O TUGGI é grátis para baixar e já começa com histórias todo dia. Para ouvir sem limite diário, um Passe Tuggi dá 10, 25 ou 45 horas de uso, com pagamento único. As horas não expiram e você vê o preço na App Store ou no Google Play.\"}},{\"@type\":\"Question\",\"name\":\"Qual é um bom app de viagem para road trip?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"O TUGGI foi feito para road trips: roda junto com a sua navegação e música e narra automaticamente os pontos, as cidades e a história por onde você passa — sem tela, sem procurar nada. Baixe a rota antes e use offline, sem roaming.\"}},{\"@type\":\"Question\",\"name\":\"Dá para explorar uma cidade sem guia turístico?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sim. O TUGGI funciona como um áudio-guia autoguiado para você explorar no seu ritmo, sem contratar guia humano nem tour fixo. As histórias tocam sozinhas ao chegar em cada ponto de interesse, a pé ou de carro.\"}},{\"@type\":\"Question\",\"name\":\"O TUGGI funciona offline e no meu idioma?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sim. Baixe a rota antes e ouça sem sinal e sem custo de roaming. O TUGGI oferece áudio em 10 idiomas com legendas sincronizadas para viajantes surdos e com deficiência auditiva.\"}},{\"@type\":\"Question\",\"name\":\"Como o TUGGI é diferente do Google Maps ou de um guia humano?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"O TUGGI não é um app de navegação e não substitui o seu GPS — ele roda junto e adiciona narração em áudio autoguiada sobre os lugares por onde você passa. Diferente de um guia humano, está disponível 24/7, em vários idiomas, sem usar as mãos e grátis para começar.\"}},{\"@type\":\"Question\",\"name\":\"Para quem o TUGGI é indicado?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Para qualquer pessoa que gosta de explorar em movimento: turistas, moradores curiosos, ciclistas, caminhantes, passageiros de ônibus, trem ou van e também motoristas. Funciona em roteiro de carro, no city tour a pé, no passeio de bike ou de patinete e no transporte público. Como o áudio é acionado por GPS e roda offline, a experiência é a mesma em qualquer meio de transporte.\"}}]}0:{\"buildId\":\"sgcYRXgj6Q_bI4KL2gAqo\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2\"}}],[\"$\",\"$L3\",null,{\"children\":[[\"$\",\"$L4\",null,{}],[\"$\",\"$L5\",null,{}],[\"$\",\"section\",null,{\"data-block\":\"scene\",\"className\":\"bg-tuggi-dark py-24 lg:py-32\",\"children\":[\"$\",\"div\",null,{\"className\":\"page-shell\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-3xl\",\"children\":[[\"$\",\"p\",null,{\"className\":\"whitespace-pre-line text-2xl sm:text-3xl lg:text-4xl font-extrabold leading-tight tracking-tight text-white\",\"children\":\"Hoje você passou por quarenta histórias.\\nOuviu nenhuma.\"}],[\"$\",\"p\",null,{\"className\":\"mt-8 text-lg leading-relaxed text-white\",\"children\":\"O forte na entrada da cidade, a igreja do século XVIII, a serra que tem nome e motivo. Tudo passou pela janela calado, porque ninguém para no acostamento pra pesquisar sobre o que acabou de passar.\"}]]}]}]}],\"$L6\",\"$L7\",\"$L8\",\"$L9\",\"$La\",\"$Lb\",\"$Lc\"]}]],[\"$Ld\",\"$Le\"],\"$Lf\"]}],\"loading\":null,\"isPartial\":false}\n6:[\"$\",\"section\",null,{\"className\":\"bg-white py-20 lg:py-24 border-t border-gray-100\",\"children\":[\"$\",\"div\",null,{\"className\":\"page-shell text-center\",\"children\":[[\"$\",\"div\",null,{\"className\":\"max-w-3xl mx-auto\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-3xl sm:text-4xl font-extrabold text-tuggi-dark tracking-tight mb-3\",\"children\":\"Ouça o TUGGI na prática\"}],[\"$\",\"p\",null,{\"className\":\"text-lg text-tuggi-slate mb-10\",\"children\":\"Histórias curtas, do jeito que você ouve enquanto explora.\"}]]}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 text-left grid-cols-1 sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"$L10\",\"sample2\",{\"sample\":{\"id\":\"sample2\",\"countryCode\":\"BR\",\"transcript\":null,\"clips\":[{\"src\":\"/audio/sample2-desc.mp3\",\"part\":\"story\",\"audioLang\":null}],\"placeName\":\"Avenida Paulista\",\"city\":\"São Paulo\",\"tags\":[\"story\"]},\"surface\":\"light\",\"preload\":\"metadata\"}],[\"$\",\"$L10\",\"sample3\",{\"sample\":{\"id\":\"sample3\",\"countryCode\":\"IT\",\"transcript\":null,\"clips\":[{\"src\":\"/audio/sample3-desc.mp3\",\"part\":\"story\",\"audioLang\":null}],\"placeName\":\"Ponte de Rialto\",\"city\":\"Veneza\",\"tags\":[\"story\"]},\"surface\":\"light\",\"preload\":\"metadata\"}],[\"$\",\"$L10\",\"sample1\",{\"sample\":{\"id\":\"sample1\",\"countryCode\":\"US\",\"transcript\":null,\"clips\":[{\"src\":\"/audio/sample1-desc.mp3\",\"part\":\"story\",\"audioLang\":null}],\"placeName\":\"Walt Disney World Resort\",\"city\":\"Orlando\",\"tags\":[\"story\"]},\"surface\":\"light\",\"preload\":\"metadata\"}]]}]]}]}]\n7:[\"$\",\"$L11\",null,{}]\n8:[\"$\",\"section\",null,{\"className\":\"w-full py