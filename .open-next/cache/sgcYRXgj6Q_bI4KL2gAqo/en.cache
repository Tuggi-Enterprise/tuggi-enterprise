xl transition-transform duration-300 ease-in-out lg:hidden flex flex-col h-full -translate-x-full\"><div class=\"p-6 border-b border-gray-100 flex items-center justify-between bg-white shrink-0\"><a class=\"flex items-center\" href=\"/en\"><img alt=\"TUGGI Logo\" width=\"86\" height=\"28\" decoding=\"async\" data-nimg=\"1\" class=\"h-7 w-auto\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Flogo_tuggi_full.png&amp;w=96&amp;q=75 1x, /_next/image?url=%2Fimages%2Flogo_tuggi_full.png&amp;w=256&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2Flogo_tuggi_full.png&amp;w=256&amp;q=75\"/></a><button class=\"p-2 text-slate-400 hover:text-slate-900 transition-colors rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text\" aria-label=\"Close menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-x w-6 h-6\" aria-hidden=\"true\"><path d=\"M18 6 6 18\"></path><path d=\"m6 6 12 12\"></path></svg></button></div><div class=\"flex-1 overflow-y-auto bg-white py-4\"><nav data-nav-scope=\"mobile\" class=\"flex flex-col\" aria-label=\"Site pages\"><a data-nav-item=\"navPartners\" class=\"flex items-center justify-between px-6 py-5 text-[15px] font-semibold text-slate-700 hover:bg-slate-50 border-b border-slate-50 transition-colors\" href=\"/en/partners\"><span>Partners</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-slate-300 -rotate-90\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></a><a data-nav-item=\"navDestinations\" class=\"flex items-center justify-between px-6 py-5 text-[15px] font-semibold text-slate-700 hover:bg-slate-50 border-b border-slate-50 transition-colors\" href=\"/en/destinations\"><span>Destinations</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-slate-300 -rotate-90\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></a><a data-nav-item=\"navTech\" class=\"flex items-center justify-between px-6 py-5 text-[15px] font-semibold text-slate-700 hover:bg-slate-50 border-b border-slate-50 transition-colors\" href=\"/en/technology\"><span>Technology</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-slate-300 -rotate-90\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></a><a data-nav-item=\"navPlans\" class=\"flex items-center justify-between px-6 py-5 text-[15px] font-semibold text-slate-700 hover:bg-slate-50 border-b border-slate-50 transition-colors\" href=\"/en/drive\"><span>Passes</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-slate-300 -rotate-90\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></a><a data-nav-item=\"navAudioGuides\" class=\"flex items-center justify-between px-6 py-5 text-[15px] font-semibold text-slate-700 hover:bg-slate-50 border-b border-slate-50 transition-colors\" href=\"/en/tours\"><span>Audio Guides</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-slate-300 -rotate-90\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></a><a data-nav-item=\"navPurpose\" class=\"flex items-center justify-between px-6 py-5 text-[15px] font-semibold text-slate-700 hover:bg-slate-50 border-b border-slate-50 transition-colors\" href=\"/en/purpose\"><span>Purpose</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 text-slate-300 -rotate-90\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></a></nav></div><div class=\"p-6 bg-slate-50 border-t border-gray-100 shrink-0\"><a data-download-cta=\"header-drawer\" class=\"flex items-center justify-center gap-2 bg-tuggi-secondary text-tuggi-dark font-bold rounded-xl px-6 py-4 text-sm transition-all hover:bg-tuggi-secondary-hover shadow-lg shadow-orange-500/10 active:scale-[0.98]\" href=\"/en/d/tuggi\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-smartphone w-4 h-4\" aria-hidden=\"true\"><rect width=\"14\" height=\"20\" x=\"5\" y=\"2\" rx=\"2\" ry=\"2\"></rect><path d=\"M12 18h.01\"></path></svg>Download App</a></div></div><main id=\"main-content\" class=\"min-h-screen bg-tuggi-bg\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is the best app for self-guided audio tours?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"TUGGI is a self-guided audio travel guide for iOS and Android. It plays audio stories about the places around you automatically, triggered by GPS — hands-free and screen-off — while you drive, walk, or cycle. It works offline, supports 10 languages with closed captions, and is free to start.\"}},{\"@type\":\"Question\",\"name\":\"Is there a free audio travel guide app?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. TUGGI is free to download and starts with stories every day. To listen without a daily limit, a Tuggi Pass gives you 10, 25 or 45 hours of use, with a one-time payment. The hours never expire, and you'll see the price in the App Store or Google Play.\"}},{\"@type\":\"Question\",\"name\":\"What's a good travel app for a road trip?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"TUGGI was built for road trips: it runs alongside your navigation and music and narrates the landmarks, towns, and history you pass automatically — no screen, no searching. Download your route in advance to use it offline with no roaming charges.\"}},{\"@type\":\"Question\",\"name\":\"Can I explore a city without a tour guide?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. TUGGI acts as a self-guided audio guide, so you can explore at your own pace without booking a human guide or a fixed tour. Stories play automatically as you reach each point of interest, on foot or by car.\"}},{\"@type\":\"Question\",\"name\":\"Does TUGGI work offline and in my language?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Download a route in advance and listen with no signal and no roaming charges. TUGGI offers audio in 10 languages with synchronized closed captions for deaf and hard-of-hearing travelers.\"}},{\"@type\":\"Question\",\"name\":\"How is TUGGI different from Google Maps or a human guide?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"TUGGI isn't a navigation app and doesn't replace your GPS — it runs alongside it and adds self-guided audio storytelling about the places you pass. Unlike a human guide, it's available 24/7, in multiple languages, hands-free, and free to start.\"}},{\"@type\":\"Question\",\"name\":\"Who is TUGGI for?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"For anyone who likes to explore on the move: tourists, curious locals, cyclists, walkers, passengers on a bus, train or van, and drivers too. It works on a road trip, on a walking city tour, on a bike or scooter ride, and on public transport. Because the audio is triggered by GPS and runs offline, the experience is the same in any mode of transport.\"}}]}</script><section class=\"bg-tuggi-bg pt-28 pb-20 lg:pt-32 lg:pb-28 overflow-hidden\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"grid grid-cols-1 lg:grid-cols-2 gap-14 lg:gap-16 items-center\"><div class=\"max-w-2xl mx-auto lg:mx-0 text-center lg:text-left\"><h1 class=\"text-4xl sm:text-5xl lg:text-6xl font-extrabold text-tuggi-dark tracking-tight mb-6 leading-[1.1]\">You move, TUGGI tells the story of every place.</h1><p class=\"text-lg sm:text-xl text-tuggi-slate mb-8 leading-relaxed\">Turn TUGGI on, start moving and put your phone away. It uses GPS to spot each point of interest along the way and reads its story out loud. Works on foot, by bike, by car or on public transport, offline and in your language.</p><div class=\"flex flex-row flex-wrap gap-4 items-center justify-center lg:justify-start\"><a href=\"https://apps.apple.com/app/tuggi-drive/id6744379818\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"hover:-translate-y-0.5 hover:opacity-90 active:scale-[0.97] transition-[transform,opacity] duration-150 motion-reduce:hover:translate-y-0 motion-reduce:active:scale-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2 rounded-xl shrink-0\"><img alt=\"Download TUGGI on the App Store\" loading=\"lazy\" width=\"140\" height=\"42\" decoding=\"async\" data-nimg=\"1\" class=\"h-11 w-auto\" style=\"color:transparent\" src=\"/images/badges/app-store-badge.svg\"/></a><a href=\"https://play.google.com/store/apps/details?id=com.tuggidrive.app\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"hover:-translate-y-0.5 hover:opacity-90 active:scale-[0.97] transition-[transform,opacity] duration-150 motion-reduce:hover:translate-y-0 motion-reduce:active:scale-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2 rounded-xl shrink-0\"><img alt=\"Get TUGGI on Google Play\" loading=\"lazy\" width=\"140\" height=\"42\" decoding=\"async\" data-nimg=\"1\" class=\"h-11 w-auto\" style=\"color:transparent\" src=\"/images/badges/google-play-badge.svg\"/></a></div><p class=\"mt-6 text-sm font-medium text-tuggi-slate\">Free to start · Works offline · Audio in 10 languages</p></div><div class=\"flex justify-center lg:justify-end\"><div class=\"relative w-full max-w-[280px] sm:max-w-[300px] lg:max-w-[320px]\"><span aria-hidden=\"true\" class=\"tuggi-gps-ring pointer-events-none absolute left-1/2 top-[42%] h-28 w-28 rounded-full border border-tuggi-primary/40\"></span><span aria-hidden=\"true\" class=\"tuggi-gps-ring tuggi-gps-ring--delayed pointer-events-none absolute left-1/2 top-[42%] h-28 w-28 rounded-full border border-tuggi-primary/40\"></span><div class=\"relative\" style=\"transform:translateY(24px)\"><div class=\"mx-auto max-w-none w-full\"><div class=\"rounded-[2.5rem] bg-tuggi-dark p-2.5 shadow-[0_30px_60px_-15px_rgba(11,18,32,0.35)] ring-1 ring-black/5\"><div class=\"overflow-hidden rounded-[2rem] bg-black\"><img alt=\"A point&#x27;s card in the TUGGI app, open over the map: the name of the place, the distance, the opening of the story, and the buttons to hear the story or read the transcript.\" width=\"780\" height=\"1689\" decoding=\"async\" data-nimg=\"1\" class=\"block h-auto w-full\" style=\"color:transparent\" sizes=\"(max-width: 1024px) 70vw, 320px\" srcSet=\"/_next/image?url=%2Fimages%2Fapp%2Fpoi-story.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fapp%2Fpoi-story.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fapp%2Fpoi-story.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fapp%2Fpoi-story.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fapp%2Fpoi-story.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fapp%2Fpoi-story.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fapp%2Fpoi-story.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fapp%2Fpoi-story.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fapp%2Fpoi-story.jpg&amp;w=3840&amp;q=75\"/></div></div></div></div></div></div></div></div></section><section class=\"bg-white py-20 lg:py-24 border-t border-gray-100\"><div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8\"><h2 class=\"text-3xl sm:text-4xl font-extrabold text-tuggi-dark tracking-tight text-center mb-14\">Start listening in one minute</h2><div class=\"relative\"><svg aria-hidden=\"true\" class=\"hidden md:block absolute left-[16.6%] right-[16.6%] top-7 h-2 w-auto overflow-visible text-tuggi-primary/30\" viewBox=\"0 0 100 2\" preserveAspectRatio=\"none\"><line x1=\"0\" y1=\"1\" x2=\"100\" y2=\"1\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" vector-effect=\"non-scaling-stroke\" pathLength=\"1\" stroke-dashoffset=\"0\" stroke-dasharray=\"0 1\"></line></svg><ol class=\"grid grid-cols-1 md:grid-cols-3 gap-10\"><li class=\"flex flex-col items-center text-center\" style=\"transform:translateY(16px)\"><div class=\"relative mb-6\"><div class=\"relative z-10 w-16 h-16 rounded-2xl bg-tuggi-bg text-tuggi-primary flex items-center justify-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-download w-8 h-8\" aria-hidden=\"true\"><path d=\"M12 15V3\"></path><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path><path d=\"m7 10 5 5 5-5\"></path></svg></div><span class=\"absolute z-20 -top-2 -right-2 w-7 h-7 rounded-full bg-tuggi-primary text-tuggi-dark text-sm font-bold flex items-center justify-center\" aria-hidden=\"true\" style=\"transform:scale(0.8)\">1</span></div><p class=\"text-lg text-tuggi-slate leading-relaxed max-w-xs\">Download the app and pick your language.</p></li><li class=\"flex flex-col items-center text-center\" style=\"transform:translateY(16px)\"><div class=\"relative mb-6\"><div class=\"relative z-10 w-16 h-16 rounded-2xl bg-tuggi-bg text-tuggi-primary flex items-center justify-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-compass w-8 h-8\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m16.24 7.76-1.804 5.411a2 2 0 0 1-1.265 1.265L7.76 16.24l1.804-5.411a2 2 0 0 1 1.265-1.265z\"></path></svg></div><span class=\"absolute z-20 -top-2 -right-2 w-7 h-7 rounded-full bg-tuggi-primary text-tuggi-dark text-sm font-bold flex items-center justify-center\" aria-hidden=\"true\" style=\"transform:scale(0.8)\">2</span></div><p class=\"text-lg text-tuggi-slate leading-relaxed max-w-xs\">Start the guide and put your phone away.</p></li><li class=\"flex flex-col items-center text-center\" style=\"transform:translateY(16px)\"><div class=\"relative mb-6\"><div class=\"relative z-10 w-16 h-16 rounded-2xl bg-tuggi-bg text-tuggi-primary flex items-center justify-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-volume2 lucide-volume-2 w-8 h-8\" aria-hidden=\"true\"><path d=\"M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z\"></path><path d=\"M16 9a5 5 0 0 1 0 6\"></path><path d=\"M19.364 18.364a9 9 0 0 0 0-12.728\"></path></svg></div><span class=\"absolute z-20 -top-2 -right-2 w-7 h-7 rounded-full bg-tuggi-primary text-tuggi-dark text-sm font-bold flex items-center justify-center\" aria-hidden=\"true\" style=\"transform:scale(0.8)\">3</span></div><p class=\"text-lg text-tuggi-slate leading-relaxed max-w-xs\">Stories play on their own as you pass each place.</p></li></ol></div></div></section><section data-block=\"scene\" class=\"bg-tuggi-dark py-24 lg:py-32\"><div class=\"page-shell\"><div class=\"max-w-3xl\"><p class=\"whitespace-pre-line text-2xl sm:text-3xl lg:text-4xl font-extrabold leading-tight tracking-tight text-white\">Today you drove past forty stories.\nYou heard none.</p><p class=\"mt-8 text-lg leading-relaxed text-white\">The fort at the edge of town, the eighteenth-century church, the ridge that has a name and a reason. All of it went by the window in silence, because nobody pulls over to look up what has just gone past.</p></div></div></section><section class=\"bg-white py-20 lg:py-24 border-t border-gray-100\"><div class=\"page-shell text-center\"><div class=\"max-w-3xl mx-auto\"><h2 class=\"text-3xl sm:text-4xl font-extrabold text-tuggi-dark tracking-tight mb-3\">Hear TUGGI for yourself</h2><p class=\"text-lg text-tuggi-slate mb-10\">Short stories, just the way you&#x27;d hear them while exploring.</p></div><div class=\"grid gap-4 text-left grid-cols-1 sm:grid-cols-2 lg:grid-cols-3\"><article class=\"flex flex-col gap-4 rounded-2xl border p-5 sm:flex-row sm:items-start bg-white border-gray-200\"><button type=\"button\" aria-label=\"Play the story of Paulista Avenue\" class=\"grid h-14 w-14 shrink-0 place-items-center rounded-full bg-tuggi-primary text-tuggi-dark transition-transform duration-150 hover:scale-105 active:scale-95 motion-reduce:transition-none motion-reduce:hover:scale-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-play ml-0.5 h-6 w-6 fill-current\" aria-hidden=\"true\"><path d=\"M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z\"></path></svg></button><div class=\"flex min-w-0 flex-1 flex-col gap-2\"><div><p class=\"line-clamp-2 font-bold text-tuggi-dark\">Paulista Avenue</p><p class=\"text-sm text-tuggi-slate\">São Paulo, Brazil</p></div><ul class=\"flex flex-wrap gap-1.5\"><li class=\"flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-semibold bg-tuggi-bg text-tuggi-slate border-gray-200\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-volume2 lucide-volume-2 h-3 w-3\" aria-hidden=\"true\"><path d=\"M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z\"></path><path d=\"M16 9a5 5 0 0 1 0 6\"></path><path d=\"M19.364 18.364a9 9 0 0 0 0-12.728\"></path></svg>Story</li></ul><input type=\"range\" min=\"0\" max=\"0\" step=\"0.1\" disabled=\"\" aria-label=\"Seek within the story of Paulista Avenue\" aria-valuetext=\"0:00\" class=\"h-6 w-full cursor-pointer accent-tuggi-primary-text disabled:cursor-default\" value=\"0\"/></div><audio preload=\"metadata\" src=\"/audio/sample2-desc.mp3\"></audio></article><article class=\"flex flex-col gap-4 rounded-2xl border p-5 sm:flex-row sm:items-start bg-white border-gray-200\"><button type=\"button\" aria-label=\"Play the story of Rialto Bridge\" class=\"grid h-14 w-14 shrink-0 place-items-center rounded-full bg-tuggi-primary text-tuggi-dark transition-transform duration-150 hover:scale-105 active:scale-95 motion-reduce:transition-none motion-reduce:hover:scale-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-play ml-0.5 h-6 w-6 fill-current\" aria-hidden=\"true\"><path d=\"M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z\"></path></svg></button><div class=\"flex min-w-0 flex-1 flex-col gap-2\"><div><p class=\"line-clamp-2 font-bold text-tuggi-dark\">Rialto Bridge</p><p class=\"text-sm text-tuggi-slate\">Venice, Italy</p></div><ul class=\"flex flex-wrap gap-1.5\"><li class=\"flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-semibold bg-tuggi-bg text-tuggi-slate border-gray-200\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-volume2 lucide-volume-2 h-3 w-3\" aria-hidden=\"true\"><path d=\"M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z\"></path><path d=\"M16 9a5 5 0 0 1 0 6\"></path><path d=\"M19.364 18.364a9 9 0 0 0 0-12.728\"></path></svg>Story</li></ul><input type=\"range\" min=\"0\" max=\"0\" step=\"0.1\" disabled=\"\" aria-label=\"Seek within the story of Rialto Bridge\" aria-valuetext=\"0:00\" class=\"h-6 w-full cursor-pointer accent-tuggi-primary-text disabled:cursor-default\" value=\"0\"/></div><audio preload=\"metadata\" src=\"/audio/sample3-desc.mp3\"></audio></article><article class=\"flex flex-col gap-4 rounded-2xl border p-5 sm:flex-row sm:items-start bg-white border-gray-200\"><button type=\"button\" aria-label=\"Play the story of Walt Disney World Resort\" class=\"grid h-14 w-14 shrink-0 place-items-center rounded-full bg-tuggi-primary text-tuggi-dark transition-transform duration-150 hover:scale-105 active:scale-95 motion-reduce:transition-none motion-reduce:hover:scale-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-play ml-0.5 h-6 w-6 fill-current\" aria-hidden=\"true\"><path d=\"M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z\"></path></svg></button><div class=\"flex min-w-0 flex-1 flex-col gap-2\"><div><p class=\"line-clamp-2 font-bold text-tuggi-dark\">Walt Disney World Resort</p><p class=\"text-sm text-tuggi-slate\">Orlando, United States</p></div><ul class=\"flex flex-wrap gap-1.5\"><li class=\"flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-semibold bg-tuggi-bg text-tuggi-slate border-gray-200\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-volume2 lucide-volume-2 h-3 w-3\" aria-hidden=\"true\"><path d=\"M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z\"></path><path d=\"M16 9a5 5 0 0 1 0 6\"></path><path d=\"M19.364 18.364a9 9 0 0 0 0-12.728\"></path></svg>Story</li></ul><input type=\"range\" min=\"0\" max=\"0\" step=\"0.1\" disabled=\"\" aria-label=\"Seek within the story of Walt Disney World Resort\" aria-valuetext=\"0:00\" class=\"h-6 w-full cursor-pointer accent-tuggi-primary-text disabled:cursor-default\" value=\"0\"/></div><audio preload=\"metadata\" src=\"/audio/sample1-desc.mp3\"></audio></article></div></div></section><section class=\"bg-tuggi-bg py-20 lg:py-28\"><div class=\"page-shell flex flex-col gap-20 lg:gap-28\"><div class=\"grid lg:grid-cols-2 gap-10 lg:gap-16 items-center\"><div class=\"max-w-xl mx-auto lg:mx-0 text-center lg:text-left lg:order-1\" style=\"transform:translateY(16px)\"><h3 class=\"text-2xl sm:text-3xl font-bold text-tuggi-dark tracking-tight mb-4 leading-snug\">Still, it shows you around. Moving, it speaks.</h3><p class=\"text-lg text-tuggi-slate leading-relaxed\">When you stop, open the map and see what&#x27;s around: points of interest, events and trails, each with its distance. Start moving again and TUGGI goes back to narrating: it says the name of the place, then tells the story.</p></div><div class=\"lg:order-2\"><div style=\"transform:translateY(16px)\"><div class=\"mx-auto w-full max-w-[300px]\"><div class=\"rounded-[2.5rem] bg-tuggi-dark p-2.5 shadow-[0_30px_60px_-15px_rgba(11,18,32,0.35)] ring-1 ring-black/5\"><div class=\"overflow-hidden rounded-[2rem] bg-black\"><img alt=\"TUGGI explore-around-you list of nearby points of interest with distances\" loading=\"lazy\" width=\"780\" height=\"1689\" decoding=\"async\" data-nimg=\"1\" class=\"block h-auto w-full\" style=\"color:transparent\" sizes=\"(max-width: 1024px) 70vw, 300px\" srcSet=\"/_next/image?url=%2Fimages%2Fapp%2Fexplore-nearby.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fapp%2Fexplore-nearby.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fapp%2Fexplore-nearby.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fapp%2Fexplore-nearby.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fapp%2Fexplore-nearby.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fapp%2Fexplore-nearby.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fapp%2Fexplore-nearby.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fapp%2Fexplore-nearby.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fapp%2Fexplore-nearby.jpg&amp;w=3840&amp;q=75\"/></div></div></div></div></div></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-12 items-stretch\" style=\"transform:translateY(16px)\"><div class=\"flex flex-col text-center\"><div class=\"mx-auto w-full max-w-[200px]\"><div class=\"rounded-[2.5rem] bg-tuggi-dark p-2.5 shadow-[0_30px_60px_-15px_rgba(11,18,32,0.35)] ring-1 ring-black/5\"><div class=\"overflow-hidden rounded-[2rem] bg-black\"><img alt=\"TUGGI event detail card with the date, a reminder and a take-me-there button\" loading=\"lazy\" width=\"780\" height=\"1689\" decoding=\"async\" data-nimg=\"1\" class=\"block h-auto w-full\" style=\"color:transparent\" sizes=\"(max-width: 768px) 55vw, 200px\" srcSet=\"/_next/image?url=%2Fimages%2Fapp%2Fevent-detail.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Fapp%2Fevent-detail.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fapp%2Fevent-detail.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fapp%2Fevent-detail.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fapp%2Fevent-detail.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fapp%2Fevent-detail.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fapp%2Fevent-detail.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fapp%2Fevent-detail.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fapp%2Fevent-detail.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fapp%2Fevent-detail.jpg&amp;w=3840&amp;q=75\"/></div></div></div><h3 class=\"mt-8 text-2xl font-bold text-tuggi-dark tracking-tight mb-3 leading-snug\">See what&#x27;s happening right now</h3><p class=\"text-lg text-tuggi-slate leading-relaxed max-w-md mx-auto\">Festivals, fairs and local events show up on your map with dates and reminders. Found something you like? Tap &quot;take me there&quot; and go.</p></div><div class=\"flex flex-col text-center\"><div class=\"mx-auto w-full max-w-[200px]\"><div class=\"rounded-[2.5rem] bg-tuggi-dark p-2.5 shadow-[0_30px_60px_-15px_rgba(11,18,32,0.35)] ring-1 ring-black/5\"><div class=\"overflow-hidden rounded-[2rem] bg-black\"><img alt=\"TUGGI trail detail with the route drawn on the map and its stops\" loading=\"lazy\" width=\"780\" height=\"1689\" decoding=\"async\" data-nimg=\"1\" class=\"block h-auto w-full\" style=\"color:transparent\" sizes=\"(max-width: 768px) 55vw, 200px\" srcSet=\"/_next/image?url=%2Fimages%2Fapp%2Ftrail-detail.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Fapp%2Ftrail-detail.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fapp%2Ftrail-detail.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fapp%2Ftrail-detail.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fapp%2Ftrail-detail.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fapp%2Ftrail-detail.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fapp%2Ftrail-detail.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fapp%2Ftrail-detail.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fapp%2Ftrail-detail.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fapp%2Ftrail-detail.jpg&amp;w=3840&amp;q=75\"/></div></div></div><h3 class=\"mt-8 text-2xl font-bold text-tuggi-dark tracking-tight mb-3 leading-snug\">There&#x27;s a route ready, but you&#x27;re in charge</h3><p class=\"text-lg text-tuggi-slate leading-relaxed max-w-md mx-auto\">If you feel like it, follow a themed trail, such as the Rota Religiosa de Búzios, with its stops and stories already in place. If you don&#x27;t, forget the route: TUGGI narrates wherever you go.</p></div></div><div class=\"grid lg:grid-cols-2 gap-10 lg:gap-16 items-center\"><div class=\"max-w-xl mx-auto lg:mx-0 text-center lg:text-left lg:order-2\" style=\"transform:translateY(16px)\"><h3 class=\"text-2xl sm:text-3xl font-bold text-tuggi-dark tracking-tight mb-4 leading-snug\">Made to go anywhere</h3><p class=\"text-lg text-tuggi-slate leading-relaxed\">Download the maps and use everything without internet. Control the guide by voice with Siri or Google, without taking your phone out of your pocket. And listen in 10 languages, whichever suits you.</p></div><div class=\"lg:order-1\"><div style=\"transform:translateY(16px)\"><div class=\"flex justify-center gap-4 sm:gap-6\"><div class=\"mx-auto w-1/2 max-w-[200px]\"><div class=\"rounded-[2.5rem] bg-tuggi-dark p-2.5 shadow-[0_30px_60px_-15px_rgba(11,18,32,0.35)] ring-1 ring-black/5\"><div class=\"overflow-hidden rounded-[2rem] bg-black\"><img alt=\"TUGGI explorer tools including offline maps and voice commands\" loading=\"lazy\" width=\"780\" height=\"1689\" decoding=\"async\" data-nimg=\"1\" class=\"block h-auto w-full\" style=\"color:transparent\" sizes=\"(max-width: 640px) 42vw, 200px\" srcSet=\"/_next/image?url=%2Fimages%2Fapp%2Ftools.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Fapp%2Ftools.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fapp%2Ftools.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fapp%2Ftools.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fapp%2Ftools.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fapp%2Ftools.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fapp%2Ftools.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fapp%2Ftools.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fapp%2Ftools.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fapp%2Ftools.jpg&amp;w=3840&amp;q=75\"/></div></div></div><div class=\"mx-auto w-1/2 max-w-[200px] mt-10\"><div class=\"rounded-[2.5rem] bg-tuggi-dark p-2.5 shadow-[0_30px_60px_-15px_rgba(11,18,32,0.35)] ring-1 ring-black/5\"><div class=\"overflow-hidden rounded-[2rem] bg-black\"><img alt=\"TUGGI audio language selector with English, Spanish, Italian, Portuguese and more\" loading=\"lazy\" width=\"780\" height=\"1689\" decoding=\"async\" data-nimg=\"1\" class=\"block h-auto w-full\" style=\"color:transparent\" sizes=\"(max-width: 640px) 42vw, 200px\" srcSet=\"/_next/image?url=%2Fimages%2Fapp%2Flanguages.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fimages%2Fapp%2Flanguages.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fapp%2Flanguages.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fapp%2Flanguages.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fapp%2Flanguages.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fapp%2Flanguages.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fapp%2Flanguages.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fapp%2Flanguages.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fapp%2Flanguages.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fapp%2Flanguages.jpg&amp;w=3840&amp;q=75\"/></div></div></div></div></div></div></div><div class=\"grid lg:grid-cols-2 gap-10 lg:gap-16 items-center\"><div class=\"max-w-xl mx-auto lg:mx-0 text-center lg:text-left lg:order-1\" style=\"transform:translateY(16px)\"><h3 class=\"text-2xl sm:text-3xl font-bold text-tuggi-dark tracking-tight mb-4 leading-snug\">Every trip lands in your passport</h3><p class=\"text-lg text-tuggi-slate leading-relaxed\">The app adds it all up: places discovered, cities, kilometers covered and hours of audio. It becomes a log of your travels you can show your friends.</p></div><div class=\"lg:order-2\"><div style=\"transform:translateY(16px)\"><div class=\"mx-auto w-full max-w-[300px]\"><div class=\"rounded-[2.5rem] bg-tuggi-dark p-2.5 shadow-[0_30px_60px_-15px_rgba(11,18,32,0.35)] ring-1 ring-black/5\"><div class=\"overflow-hidden rounded-[2rem] bg-black\"><img alt=\"TUGGI explorer passport showing discoveries, cities, kilometers and listening hours\" loading=\"lazy\" width=\"780\" height=\"1689\" decoding=\"async\" data-nimg=\"1\" class=\"block h-auto w-full\" style=\"color:transparent\" sizes=\"(max-width: 1024px) 70vw, 300px\" srcSet=\"/_next/image?url=%2Fimages%2Fapp%2Fpassport.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fapp%2Fpassport.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fapp%2Fpassport.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fapp%2Fpassport.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fapp%2Fpassport.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fapp%2Fpassport.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fapp%2Fpassport.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fapp%2Fpassport.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fapp%2Fpassport.jpg&amp;w=3840&amp;q=75\"/></div></div></div></div></div></div></div></section><section class=\"w-full py-20 bg-white\" data-proof-block=\"light\"><div class=\"page-shell\"><div class=\"max-w-3xl space-y-6 sm:mx-auto text-left sm:text-center\"><p data-proof-line=\"points\" class=\"text-lg sm:text-xl leading-relaxed text-tuggi-slate\"><strong class=\"block sm:inline text-4xl sm:text-5xl font-extrabold leading-none text-tuggi-dark\">More than 2 million</strong> mapped points, across 48 countries.</p><p data-proof-line=\"guides\" class=\"text-lg leading-relaxed text-tuggi-slate\"><strong class=\"block sm:inline text-2xl font-bold leading-tight text-tuggi-dark\">More than 16,000</strong> audio guides produced, with audio in 10 languages.</p><p data-proof-line=\"since\" class=\"text-base leading-relaxed text-tuggi-slate\">Operating since 2025.</p></div></div></section><section data-block=\"coverage-density\" class=\"py-20 bg-tuggi-dark relative overflow-hidden\"><div class=\"absolute inset-0 opacity-10\" style=\"background-image:radial-gradient(var(--color-tuggi-slate) 1px, transparent 1px);background-size:30px 30px\"></div><div class=\"container mx-auto px-6 relative z-10\"><div class=\"text-center mb-10\"><h2 class=\"text-3xl md:text-5xl font-black text-white mb-3\">Where TUGGI already is</h2><p class=\"text-gray-300 text-base max-w-xl mx-auto\">The lighter the area, the denser the mapped points in that region.</p></div><div data-part=\"map-frame\" class=\"relative w-full max-w-3xl mx-auto rounded-[40px] border border-white/5 overflow-hidden shadow-2xl\" style=\"aspect-ratio:800 / 757;background-color:color-mix(in srgb, var(--color-tuggi-slate) 8%, var(--color-tuggi-dark))\"></div><div class=\"mt-6\"><h3 class=\"text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-3 text-center\">Coverage density</h3><ul class=\"flex flex-wrap justify-center gap-x-6 gap-y-2\"><li class=\"flex items-center gap-2\"><span data-density-swatch=\"0\" aria-hidden=\"true\" class=\"w-4 h-3 rounded-[3px] shrink-0\" style=\"background-color:color-mix(in srgb, var(--color-tuggi-primary) 55%, var(--color-tuggi-dark));outline:1px solid color-mix(in srgb, var(--color-tuggi-bg) 40%, var(--color-tuggi-primary))\"></span><span class=\"text-xs font-semibold text-gray-300\">Early coverage</span></li><li class=\"flex items-center gap-2\"><span data-density-swatch=\"1\" aria-hidden=\"true\" class=\"w-4 h-3 rounded-[3px] shrink-0\" style=\"background-color:color-mix(in srgb, var(--color-tuggi-primary) 80%, var(--color-tuggi-dark));outline:1px solid color-mix(in srgb, var(--color-tuggi-bg) 40%, var(--color-tuggi-primary))\"></span><span class=\"text-xs font-semibold text-gray-300\">Moderate coverage</span></li><li class=\"flex items-center gap-2\"><span data-density-swatch=\"2\" aria-hidden=\"true\" class=\"w-4 h-3 rounded-[3px] shrink-0\" style=\"background-color:var(--color-tuggi-primary);outline:1px solid color-mix(in srgb, var(--color-tuggi-bg) 40%, var(--color-tuggi-primary))\"></span><span class=\"text-xs font-semibold text-gray-300\">High coverage</span></li><li class=\"flex items-center gap-2\"><span data-density-swatch=\"3\" aria-hidden=\"true\" class=\"w-4 h-3 rounded-[3px] shrink-0\" style=\"background-color:color-mix(in srgb, var(--color-tuggi-bg) 40%, var(--color-tuggi-primary));outline:1px solid color-mix(in srgb, var(--color-tuggi-bg) 40%, var(--color-tuggi-primary))\"></span><span class=\"text-xs font-semibold text-gray-300\">Densest coverage</span></li></ul></div></div></section><section data-block=\"coverage-list\" class=\"py-20 bg-white border-t border-gray-100\"><div class=\"container mx-auto px-6\"><div class=\"text-center mb-12\"><h3 class=\"text-3xl md:text-4xl font-black text-tuggi-dark mb-4\">See if your destination is already on the map</h3><p class=\"text-tuggi-slate text-lg max-w-2xl mx-auto\">The full list, region by region, is on the coverage page.</p></div><div class=\"mb-10 last:mb-0\"><h4 class=\"text-xs font-bold uppercase tracking-widest text-tuggi-slate mb-5 pb-2 border-b border-gray-200\">Americas</h4><ul class=\"flex flex-wrap gap-2\"><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">United States</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Canada</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Brazil</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Argentina</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Mexico</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Peru</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Chile</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Colombia</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Venezuela</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Ecuador</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Costa Rica</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Nicaragua</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Bolivia</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Guatemala</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Cuba</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Honduras</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">El Salvador</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Paraguay</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Panama</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Dominican Republic</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Haiti</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Uruguay</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Belize</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Jamaica</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Guyana</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Suriname</li></ul></div><div class=\"mb-10 last:mb-0\"><h4 class=\"text-xs font-bold uppercase tracking-widest text-tuggi-slate mb-5 pb-2 border-b border-gray-200\">Europe</h4><ul class=\"flex flex-wrap gap-2\"><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Germany</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">France</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Italy</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Spain</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">United Kingdom</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Belgium</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Ireland</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Portugal</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Switzerland</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Austria</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Slovenia</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Luxembourg</li></ul></div><div class=\"mb-10 last:mb-0\"><h4 class=\"text-xs font-bold uppercase tracking-widest text-tuggi-slate mb-5 pb-2 border-b border-gray-200\">Other destinations</h4><ul class=\"flex flex-wrap gap-2\"><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Netherlands</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Poland</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Czech Republic</li><li class=\"rounded-full border border-gray-200 bg-tuggi-bg px-4 py-2 text-sm font-semibold text-tuggi-dark\">Morocco</li></ul></div><div class=\"mt-10 text-center\"><a class=\"inline-flex items-center gap-2 font-semibold text-tuggi-primary-text hover:text-tuggi-primary transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2 rounded\" href=\"/en/coverage\">See full coverage<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-4 h-4\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></section><section data-block=\"business\" class=\"bg-tuggi-bg py-20 lg:py-24\"><div class=\"page-shell\"><div class=\"max-w-2xl\"><h2 class=\"text-3xl sm:text-4xl font-extrabold text-tuggi-dark tracking-tight mb-4\">TUGGI for your business</h2><p class=\"text-lg text-tuggi-slate leading-relaxed\">Transfer companies, rental fleets and destinations use TUGGI to give every traveler a local guide.</p></div><div class=\"mt-10 grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch\"><a class=\"group flex items-center justify-between gap-6 rounded-3xl border border-gray-200 bg-white px-8 py-8 shadow-sm transition-transform duration-150 hover:-translate-y-1 motion-reduce:hover:translate-y-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2\" href=\"/en/enterprise/fleets\"><span class=\"text-xl font-bold text-tuggi-dark leading-snug\">For fleets &amp; operators</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-6 h-6 shrink-0 text-tuggi-primary-text transition-transform group-hover:translate-x-1 motion-reduce:group-hover:translate-x-0\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"group flex items-center justify-between gap-6 rounded-3xl border border-gray-200 bg-white px-8 py-8 shadow-sm transition-transform duration-150 hover:-translate-y-1 motion-reduce:hover:translate-y-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2\" href=\"/en/destinations\"><span class=\"text-xl font-bold text-tuggi-dark leading-snug\">For destinations</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-6 h-6 shrink-0 text-tuggi-primary-text transition-transform group-hover:translate-x-1 motion-reduce:group-hover:translate-x-0\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div></div></section><section class=\"bg-white py-16 lg:py-20 border-t border-gray-100\"><div class=\"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8\"><h2 class=\"text-2xl sm:text-3xl font-bold text-tuggi-dark tracking-tight mb-6\">What is TUGGI</h2><div class=\"space-y-4 text-tuggi-slate leading-relaxed\"><p>TUGGI is a self-guided audio travel guide for iPhone and Android. It uses GPS to recognize the places you pass and tells the story of each one out loud, at the right moment, without you searching for anything on the screen. It works however you travel: on foot, by bike, by car, by bus or on the metro.</p><p>Stories start on their own as you get close to a point of interest. Because everything works offline, you download a city before you leave and listen with no internet and no roaming data. And since every story comes with synchronized captions, deaf and hard-of-hearing travelers follow along on screen.</p><p>TUGGI does not replace your navigation app: it runs alongside it, without getting in the way of your map or your music, and simply adds the cultural narration of the route. Start free, pick from 10 languages, and turn any trip into a journey with a story.</p></div></div></section><section data-block=\"faq\" class=\"py-24 bg-white border-t border-gray-100\"><div class=\"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8\"><h2 class=\"text-3xl sm:text-4xl font-extrabold text-tuggi-dark tracking-tight mb-12 text-center\">Frequently Asked Questions</h2><dl class=\"flex flex-col gap-4\"><div class=\"rounded-2xl border transition-all duration-200 border-gray-200 bg-white hover:border-tuggi-primary/20\"><dt><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-answer-1\" class=\"w-full flex items-center justify-between gap-4 px-6 py-5 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2 rounded-2xl\"><span class=\"text-base font-bold text-tuggi-dark leading-snug\">What is the best app for self-guided audio tours?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-5 h-5 flex-shrink-0 text-tuggi-primary transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></dt><dd id=\"faq-answer-1\" class=\"overflow-hidden transition-all duration-200 max-h-0\"><p class=\"px-6 pb-5 text-slate-600 leading-relaxed text-sm\">TUGGI is a self-guided audio travel guide for iOS and Android. It plays audio stories about the places around you automatically, triggered by GPS — hands-free and screen-off — while you drive, walk, or cycle. It works offline, supports 10 languages with closed captions, and is free to start.</p></dd></div><div class=\"rounded-2xl border transition-all duration-200 border-gray-200 bg-white hover:border-tuggi-primary/20\"><dt><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-answer-2\" class=\"w-full flex items-center justify-between gap-4 px-6 py-5 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2 rounded-2xl\"><span class=\"text-base font-bold text-tuggi-dark leading-snug\">Is there a free audio travel guide app?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-5 h-5 flex-shrink-0 text-tuggi-primary transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></dt><dd id=\"faq-answer-2\" class=\"overflow-hidden transition-all duration-200 max-h-0\"><p class=\"px-6 pb-5 text-slate-600 leading-relaxed text-sm\">Yes. TUGGI is free to download and starts with stories every day. To listen without a daily limit, a Tuggi Pass gives you 10, 25 or 45 hours of use, with a one-time payment. The hours never expire, and you&#x27;ll see the price in the App Store or Google Play.</p></dd></div><div class=\"rounded-2xl border transition-all duration-200 border-gray-200 bg-white hover:border-tuggi-primary/20\"><dt><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-answer-3\" class=\"w-full flex items-center justify-between gap-4 px-6 py-5 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2 rounded-2xl\"><span class=\"text-base font-bold text-tuggi-dark leading-snug\">What&#x27;s a good travel app for a road trip?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-5 h-5 flex-shrink-0 text-tuggi-primary transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></dt><dd id=\"faq-answer-3\" class=\"overflow-hidden transition-all duration-200 max-h-0\"><p class=\"px-6 pb-5 text-slate-600 leading-relaxed text-sm\">TUGGI was built for road trips: it runs alongside your navigation and music and narrates the landmarks, towns, and history you pass automatically — no screen, no searching. Download your route in advance to use it offline with no roaming charges.</p></dd></div><div class=\"rounded-2xl border transition-all duration-200 border-gray-200 bg-white hover:border-tuggi-primary/20\"><dt><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-answer-4\" class=\"w-full flex items-center justify-between gap-4 px-6 py-5 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2 rounded-2xl\"><span class=\"text-base font-bold text-tuggi-dark leading-snug\">Can I explore a city without a tour guide?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-5 h-5 flex-shrink-0 text-tuggi-primary transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></dt><dd id=\"faq-answer-4\" class=\"overflow-hidden transition-all duration-200 max-h-0\"><p class=\"px-6 pb-5 text-slate-600 leading-relaxed text-sm\">Yes. TUGGI acts as a self-guided audio guide, so you can explore at your own pace without booking a human guide or a fixed tour. Stories play automatically as you reach each point of interest, on foot or by car.</p></dd></div><div class=\"rounded-2xl border transition-all duration-200 border-gray-200 bg-white hover:border-tuggi-primary/20\"><dt><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-answer-5\" class=\"w-full flex items-center justify-between gap-4 px-6 py-5 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2 rounded-2xl\"><span class=\"text-base font-bold text-tuggi-dark leading-snug\">Does TUGGI work offline and in my language?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-5 h-5 flex-shrink-0 text-tuggi-primary transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></dt><dd id=\"faq-answer-5\" class=\"overflow-hidden transition-all duration-200 max-h-0\"><p class=\"px-6 pb-5 text-slate-600 leading-relaxed text-sm\">Yes. Download a route in advance and listen with no signal and no roaming charges. TUGGI offers audio in 10 languages with synchronized closed captions for deaf and hard-of-hearing travelers.</p></dd></div><div class=\"rounded-2xl border transition-all duration-200 border-gray-200 bg-white hover:border-tuggi-primary/20\"><dt><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-answer-6\" class=\"w-full flex items-center justify-between gap-4 px-6 py-5 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2 rounded-2xl\"><span class=\"text-base font-bold text-tuggi-dark leading-snug\">How is TUGGI different from Google Maps or a human guide?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-5 h-5 flex-shrink-0 text-tuggi-primary transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></dt><dd id=\"faq-answer-6\" class=\"overflow-hidden transition-all duration-200 max-h-0\"><p class=\"px-6 pb-5 text-slate-600 leading-relaxed text-sm\">TUGGI isn&#x27;t a navigation app and doesn&#x27;t replace your GPS — it runs alongside it and adds self-guided audio storytelling about the places you pass. Unlike a human guide, it&#x27;s available 24/7, in multiple languages, hands-free, and free to start.</p></dd></div><div class=\"rounded-2xl border transition-all duration-200 border-gray-200 bg-white hover:border-tuggi-primary/20\"><dt><button type=\"button\" aria-expanded=\"false\" aria-controls=\"faq-answer-7\" class=\"w-full flex items-center justify-between gap-4 px-6 py-5 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus-visible:ring-offset-2 rounded-2xl\"><span class=\"text-base font-bold text-tuggi-dark leading-snug\">Who is TUGGI for?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-5 h-5 flex-shrink-0 text-tuggi-primary transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></dt><dd id=\"faq-answer-7\" class=\"overflow-hidden transition-all duration-200 max-h-0\"><p class=\"px-6 pb-5 text-slate-600 leading-relaxed text-sm\">For anyone who likes to explore on the move: tourists, curious locals, cyclists, walkers, passengers on a bus, train or van, and drivers too. It works on a road trip, on a walking city tour, on a bike or scooter ride, and on public transport. Because the audio is triggered by GPS and runs offline, the experience is the same in any mode of transport.</p></dd></div></dl></div></section><!--$--><!--/$--></main><footer class=\"bg-tuggi-dark text-tuggi-slate border-t border-gray-800\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16\"><div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8\"><div class=\"lg:col-span-4 flex flex-col space-y-6 lg:pr-8\"><a class=\"inline-block focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text rounded-sm w-max\" href=\"/en\"><img alt=\"TUGGI\" loading=\"lazy\" width=\"98\" height=\"32\" decoding=\"async\" data-nimg=\"1\" class=\"h-8 w-auto\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fimages%2Flogo_tuggi_full_white.png&amp;w=128&amp;q=75 1x, /_next/image?url=%2Fimages%2Flogo_tuggi_full_white.png&amp;w=256&amp;q=75 2x\" src=\"/_next/image?url=%2Fimages%2Flogo_tuggi_full_white.png&amp;w=256&amp;q=75\"/></a><p class=\"text-sm text-slate-400 max-w-xs leading-relaxed\">Connecting people to the context of the physical world</p></div><div class=\"lg:col-span-2 flex flex-col\"><h3 class=\"text-xs font-bold tracking-widest text-white uppercase mb-6\">TUGGI (B2C)</h3><a data-download-cta=\"footer\" class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/en/d/tuggi\">App Download</a><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/en/drive\">Passes</a><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/en/tours\">Audio Tours</a><div class=\"flex flex-col gap-3 mt-6\"><a href=\"https://apps.apple.com/app/tuggi-drive/id6744379818\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"hover:opacity-80 transition-opacity focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text rounded-lg w-max\"><img alt=\"Download on the App Store\" loading=\"lazy\" width=\"120\" height=\"35\" decoding=\"async\" data-nimg=\"1\" class=\"h-9 w-auto\" style=\"color:transparent\" src=\"/images/badges/app-store-badge.svg\"/></a><a href=\"https://play.google.com/store/apps/details?id=com.tuggidrive.app\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"hover:opacity-80 transition-opacity focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text rounded-lg w-max\"><img alt=\"Get it on Google Play\" loading=\"lazy\" width=\"120\" height=\"35\" decoding=\"async\" data-nimg=\"1\" class=\"h-9 w-auto\" style=\"color:transparent\" src=\"/images/badges/google-play-badge.svg\"/></a></div></div><div class=\"lg:col-span-2 flex flex-col\"><h3 class=\"text-xs font-bold tracking-widest text-white uppercase mb-6\">Enterprise (B2B/B2G)</h3><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/en/destinations\">Destinations</a><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/en/enterprise/fleets\">Fleets</a><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/en/technology\">Technology</a></div><div class=\"lg:col-span-2 flex flex-col\"><h3 class=\"text-xs font-bold tracking-widest text-white uppercase mb-6\">Institutional</h3><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/en/purpose\">Our Purpose</a><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/en/contact\">Contact</a><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/en/coverage\">Global Coverage</a><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/en/updates\">Updates</a></div><div class=\"lg:col-span-2 flex flex-col\"><h3 class=\"text-xs font-bold tracking-widest text-white uppercase mb-6\">Trust Center &amp; Compliance</h3><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/en/trust-center/terms-of-use\">Terms of Use</a><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/en/trust-center/privacy-policy\">Privacy Policy</a><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/en/trust-center/accessibility\">Accessibility</a><a class=\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\" href=\"/en/trust-center/security-sla\">B2G Security</a></div></div><div class=\"mt-16 pt-8 border-t border-slate-800 flex flex-col items-center sm:items-start space-y-4\"><p class=\"text-xs text-slate-400 text-center sm:text-left\">© <!-- -->2026<!-- --> TUGGI Technologies. <!-- -->All rights reserved.</p><div class=\"flex flex-col sm:flex-row gap-2 sm:gap-6 text-xs text-slate-400 font-medium text-center sm:text-left\"><p>CNPJ: 64.539.859/0001-56</p><p class=\"hidden sm:block text-slate-500\" aria-hidden=\"true\">•</p><p>Rua PAIS LEME, 215 - CONJ 1713 - Pinheiros - São Paulo, BR</p></div></div></div></footer><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"@id\":\"https://www.tuggi.app/#organization\",\"name\":\"TUGGI\",\"url\":\"https://www.tuggi.app\",\"logo\":\"https://www.tuggi.app/images/logo_tuggi_full.png\",\"description\":\"TUGGI tells you a place's story out loud the moment you get near it. Works offline, in 10 languages, free to start on iOS and Android.\",\"contactPoint\":{\"@type\":\"ContactPoint\",\"contactType\":\"customer support\",\"email\":\"suporte@tuggi.app\",\"availableLanguage\":[\"English\",\"Portuguese\",\"Spanish\"]},\"sameAs\":[\"https://www.linkedin.com/company/tuggi/\",\"https://www.instagram.com/tuggi_app\",\"https://www.tiktok.com/@tuggi_app\",\"https://www.facebook.com/people/Tuggi-Personal-tour-guide/61580839157589/\"]}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"SoftwareApplication\",\"name\":\"TUGGI\",\"operatingSystem\":\"iOS, Android\",\"applicationCategory\":\"TravelApplication\",\"description\":\"Turn TUGGI on, start moving and put your phone away. It uses GPS to spot each point of interest along the way and reads its story out loud. Works on foot, by bike, by car or on public transport, offline and in your language.\",\"url\":\"https://www.tuggi.app\",\"downloadUrl\":[\"https://apps.apple.com/app/tuggi-drive/id6744379818\",\"https://play.google.com/store/apps/details?id=com.tuggidrive.app\"],\"installUrl\":\"https://apps.apple.com/app/tuggi-drive/id6744379818\",\"sameAs\":[\"https://apps.apple.com/app/tuggi-drive/id6744379818\",\"https://play.google.com/store/apps/details?id=com.tuggidrive.app\"],\"screenshot\":\"https://www.tuggi.app/images/og-image-tuggi.jpg\",\"featureList\":[\"Self-guided audio stories that trigger automatically by GPS location\",\"Screen-off playback while you drive, walk, or cycle\",\"Works offline — download routes in advance, no roaming\",\"Audio in 10 languages with synchronized closed captions\",\"Free to start; optional Tuggi Passes of 10, 25 or 45 hours of use that do not expire\"],\"offers\":{\"@type\":\"Offer\",\"price\":\"0.00\",\"priceCurrency\":\"USD\"},\"publisher\":{\"@id\":\"https://www.tuggi.app/#organization\"}}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://www.tuggi.app/#website\",\"name\":\"TUGGI\",\"url\":\"https://www.tuggi.app/en\",\"description\":\"TUGGI tells you each place's story out loud as you pass by, however you travel. A self-guided audio travel guide that works offline, in your language. Free to start.\",\"publisher\":{\"@id\":\"https://www.tuggi.app/#organization\"}}</script><script src=\"/_next/static/chunks/29d95b136dea432d.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[339756,[\\\"/_next/static/chunks/d96012bcfc98706a.js\\\",\\\"/_next/static/chunks/73e3194f06db260e.js\\\"],\\\"default\\\"]\\n3:I[837457,[\\\"/_next/static/chunks/d96012bcfc98706a.js\\\",\\\"/_next/static/chunks/73e3194f06db260e.js\\\"],\\\"default\\\"]\\n7:I[897367,[\\\"/_next/static/chunks/d96012bcfc98706a.js\\\",\\\"/_next/static/chunks/73e3194f06db260e.js\\\"],\\\"OutletBoundary\\\"]\\n8:\\\"$Sreact.suspense\\\"\\na:I[897367,[\\\"/_next/static/chunks/d96012bcfc98706a.js\\\",\\\"/_next/static/chunks/73e3194f06db260e.js\\\"],\\\"ViewportBoundary\\\"]\\nc:I[897367,[\\\"/_next/static/chunks/d96012bcfc98706a.js\\\",\\\"/_next/static/chunks/73e3194f06db260e.js\\\"],\\\"MetadataBoundary\\\"]\\ne:I[168027,[\\\"/_next/static/chunks/d96012bcfc98706a.js\\\",\\\"/_next/static/chunks/73e3194f06db260e.js\\\"],\\\"default\\\"]\\n:HL[\\\"/_next/static/chunks/7f49250fef2b3bdc.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/s