f\"}],[\"$\",\"p\",null,{\"className\":\"text-lg text-tuggi-slate mb-10\",\"children\":\"Short stories, just the way you'd hear them while exploring.\"}]]}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 text-left grid-cols-1 sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"$L1f\",\"sample2\",{\"sample\":{\"id\":\"sample2\",\"countryCode\":\"BR\",\"transcript\":null,\"clips\":[{\"src\":\"/audio/sample2-desc.mp3\",\"part\":\"story\",\"audioLang\":null}],\"placeName\":\"Paulista Avenue\",\"city\":\"São Paulo\",\"tags\":[\"story\"]},\"surface\":\"light\",\"preload\":\"metadata\"}],[\"$\",\"$L1f\",\"sample3\",{\"sample\":{\"id\":\"sample3\",\"countryCode\":\"IT\",\"transcript\":null,\"clips\":[{\"src\":\"/audio/sample3-desc.mp3\",\"part\":\"story\",\"audioLang\":null}],\"placeName\":\"Rialto Bridge\",\"city\":\"Venice\",\"tags\":[\"story\"]},\"surface\":\"light\",\"preload\":\"metadata\"}],[\"$\",\"$L1f\",\"sample1\",{\"sample\":{\"id\":\"sample1\",\"countryCode\":\"US\",\"transcript\":null,\"clips\":[{\"src\":\"/audio/sample1-desc.mp3\",\"part\":\"story\",\"audioLang\":null}],\"placeName\":\"Walt Disney World Resort\",\"city\":\"Orlando\",\"tags\":[\"story\"]},\"surface\":\"light\",\"preload\":\"metadata\"}]]}]]}]}]\n16:[\"$\",\"section\",null,{\"className\":\"w-full py-20 bg-white\",\"data-proof-block\":\"light\",\"children\":[\"$\",\"div\",null,{\"className\":\"page-shell\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-3xl space-y-6 sm:mx-auto text-left sm:text-center\",\"children\":[[\"$\",\"p\",\"points\",{\"data-proof-line\":\"points\",\"className\":\"text-lg sm:text-xl leading-relaxed text-tuggi-slate\",\"children\":[[\"$\",\"strong\",\"strong0\",{\"className\":\"block sm:inline text-4xl sm:text-5xl font-extrabold leading-none text-tuggi-dark\",\"children\":[\"More than 2 million\"]}],\" mapped points, across 48 countries.\"]}],[\"$\",\"p\",\"guides\",{\"data-proof-line\":\"guides\",\"className\":\"text-lg leading-relaxed text-tuggi-slate\",\"children\":[[\"$\",\"strong\",\"strong0\",{\"className\":\"block sm:inline text-2xl font-bold leading-tight text-tuggi-dark\",\"children\":[\"More than 16,000\"]}],\" audio guides produced, with audio in 10 languages.\"]}],[\"$\",\"p\",\"since\",{\"data-proof-line\":\"since\",\"className\":\"text-base leading-relaxed text-tuggi-slate\",\"children\":\"Operating since 2025.\"}]]}]}]}]\n19:[\"$\",\"section\",null,{\"className\":\"bg-white py-16 lg:py-20 border-t border-gray-100\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-bold text-tuggi-dark tracking-tight mb-6\",\"children\":\"What is TUGGI\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4 text-tuggi-slate leading-relaxed\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":\"TUGGI is a self-guided audio travel guide for iPhone and Android. It uses GPS to recognize the places you pass and tells the story of each one out loud, at the right moment, without you searching for anything on the screen. It works however you travel: on foot, by bike, by car, by bus or on the metro.\"}],[\"$\",\"p\",\"1\",{\"children\":\"Stories start on their own as you get close to a point of interest. Because everything works offline, you download a city before you leave and listen with no internet and no roaming data. And since every story comes with synchronized captions, deaf and hard-of-hearing travelers follow along on screen.\"}],[\"$\",\"p\",\"2\",{\"children\":\"TUGGI does not replace your navigation app: it runs alongside it, without getting in the way of your map or your music, and simply adds the cultural narration of the route. Start free, pick from 10 languages, and turn any trip into a journey with a story.\"}]]}]]}]}]\n20:I[239810,[\"/_next/static/chunks/36c9e5bc4f7460fd.js\",\"/_next/static/chunks/27a1237e2a9f6c6c.js\",\"/_next/static/chunks/66e164642a425c8a.js\",\"/_next/static/chunks/9c38e031aa827488.js\",\