der-gray-100\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-3xl mx-auto px-4 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-bold text-tuggi-dark tracking-tight mb-6\",\"children\":\"What is TUGGI\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4 text-tuggi-slate leading-relaxed\",\"children\":[[\"$\",\"p\",\"0\",{\"children\":\"TUGGI is a self-guided audio travel guide for iPhone and Android. It uses GPS to recognize the places you pass and tells the story of each one out loud, at the right moment, without you searching for anything on the screen. It works however you travel: on foot, by bike, by car, by bus or on the metro.\"}],[\"$\",\"p\",\"1\",{\"children\":\"Stories start on their own as you get close to a point of interest. Because everything works offline, you download a city before you leave and listen with no internet and no roaming data. And since every story comes with synchronized captions, deaf and hard-of-hearing travelers follow along on screen.\"}],[\"$\",\"p\",\"2\",{\"children\":\"TUGGI does not replace your navigation app: it runs alongside it, without getting in the way of your map or your music, and simply adds the cultural narration of the route. Start free, pick from 10 languages, and turn any trip into a journey with a story.\"}]]}]]}]}]\nc:[\"$\",\"$L16\",null,{\"namespace\":\"Home.FAQ\",\"count\":7}]\nd:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/00fc9bc083c08a18.js\",\"async\":true}]\ne:[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/d98e2f61488237bc.js\",\"async\":true}]\nf:[\"$\",\"$L17\",null,{\"children\":[\"$\",\"$18\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@19\"}]}]\n13:[\"$\",\"div\",null,{\"className\":\"mt-6\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-[11px] font-bold uppercase tracking-widest text-gray-400 mb-3 text-center\",\"children\":\"Coverage density\"}],[\"$\",\"ul\",null,{\"className\":\"flex flex-wrap