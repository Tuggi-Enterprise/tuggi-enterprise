is TUGGI\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-4 text-tuggi-slate leading-relaxed\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"children\\\":\\\"TUGGI is a self-guided audio travel guide for iPhone and Android. It uses GPS to recognize the places you pass and tells the story of each one out loud, at the right moment, without you searching for anything on the screen. It works however you travel: on foot, by bike, by car, by bus or on the metro.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"children\\\":\\\"Stories start on their own as you get close to a point of interest. Because everything works offline, you download a city before you leave and listen with no internet and no roaming data. And since every story comes with synchronized captions, deaf and hard-of-hearing travelers follow along on screen.\\\"}],[\\\"$\\\",\\\"p\\\",\\\"2\\\",{\\\"children\\\":\\\"TUGGI does not replace your navigation app: it runs alongside it, without getting in the way of your map or your music, and simply adds the cultural narration of the route. Start free, pick from 10 languages, and turn any trip into a journey with a story.\\\"}]]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"20:I[239810,[\\\"/_next/static/chunks/36c9e5bc4f7460fd.js\\\",\\\"/_next/static/chunks/27a1237e2a9f6c6c.js\\\",\\\"/_next/static/chunks/66e164642a425c8a.js\\\",\\\"/_next/static/chunks/9c38e031aa827488.js\\\",\\\"/_next/static/chunks/00fc9bc083c08a18.js\\\",\\\"/_next/static/chunks/d98e2f61488237bc.js\\\"],\\\"CoverageDensityCanvas\\\"]\\n\"])</script><script>self.__next_f.push([1,\"17:[[\\\"$\\\",\\\"section\\\",null,{\\\"data-block\\\":\\\"coverage-density\\\",\\\"className\\\":\\\"py-20 bg-tuggi-dark relative overflow-hidden\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"absolute inset-0 opacity-10\\\",\\\"style\\\":{\\\"backgroundImage\\\":\\\"radial-gradient(var(--color-tuggi-slate) 1px, transparent 1px)\\\",\\\"backgroundSize\\\":\\\