g-tuggi-dark text-tuggi-slate border-t border-gray-800\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"lg:col-span-4 flex flex-col space-y-6 lg:pr-8\",\"children\":[[\"$\",\"$Le\",null,{\"href\":\"/en\",\"localeCookie\":{\"name\":\"NEXT_LOCALE\",\"sameSite\":\"lax\"},\"className\":\"inline-block focus:outline-none focus-visible:ring-2 focus-visible:ring-tuggi-primary-text rounded-sm w-max\",\"children\":[\"$\",\"$Lf\",null,{\"src\":\"/images/logo_tuggi_full_white.png\",\"alt\":\"TUGGI\",\"width\":98,\"height\":32,\"className\":\"h-8 w-auto\"}]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-slate-400 max-w-xs leading-relaxed\",\"children\":\"Connecting people to the context of the physical world\"}]]}],[\"$\",\"div\",null,{\"className\":\"lg:col-span-2 flex flex-col\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-xs font-bold tracking-widest text-white uppercase mb-6\",\"children\":\"TUGGI (B2C)\"}],[\"$\",\"$Le\",null,{\"href\":{\"pathname\":\"/en/d/tuggi\",\"params\":{\"slug\":\"tuggi\"}},\"localeCookie\":{\"name\":\"NEXT_LOCALE\",\"sameSite\":\"lax\"},\"data-download-cta\":\"footer\",\"className\":\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\",\"children\":\"App Download\"}],[\"$\",\"$Le\",null,{\"href\":\"/en/drive\",\"localeCookie\":{\"name\":\"NEXT_LOCALE\",\"sameSite\":\"lax\"},\"className\":\"text-sm text-slate-400 hover:text-white transition-colors duration-200 block mb-3 focus-visible:ring-2 focus-visible:ring-tuggi-primary-text focus:outline-none rounded-sm w-max\",\"children\":\"Passes\"}],[\"$\",\"$Le\",null,{\"href\":\"/en/tours\",\"localeCookie\":{\"name\":\"NEXT_LOCALE\",\"sameSite\":\"lax\"},\"className\":\