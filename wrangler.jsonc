{
  // The site as a Cloudflare Worker, built by @opennextjs/cloudflare (tuggi-app#987).
  // Shape from opennext.js.org/cloudflare/get-started, consulted 2026-10-20.
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  // The Worker already created on the Cloudflare dashboard. Its git integration
  // refuses a deploy when this field differs from the connected Worker.
  "name": "tuggi-enterprise",
  // The newest date the installed wrangler 4.151.3 knows (`DEFAULT_COMPAT_DATE`
  // in node_modules/wrangler/wrangler-dist/cli.js). A later date has no effect,
  // because workerd implements nothing past its own build. Revisit on upgrade.
  "compatibility_date": "2026-10-19",
  // nodejs_compat is required by OpenNext; global_fetch_strictly_public is in
  // its get-started config.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // The optimizer behind `next/image`. Without it OpenNext's `/_next/image`
  // returns the original file (`templates/images.js`), so every image would
  // ship at full size where Vercel resized and converted it. Shape from
  // opennext.js.org/cloudflare/howtos/image; the same binding runs on
  // reserve-on-site. Billed as Images Transformed: 5,000 unique per month free;
  // past that, the Images Free plan fails new ones with 9422 and charges
  // nothing, the Paid plan charges per 1,000 (developers.cloudflare.com/images/
  // pricing, consulted 2026-10-20).
  "images": {
    "binding": "IMAGES"
  },
  // The incremental cache (open-next.config.ts). The binding name is the one the
  // adapter reads (`BINDING_NAME` in r2-incremental-cache.js, and
  // opennext.js.org/cloudflare/caching, consulted 2026-10-20). The bucket is
  // created by the operator on the account; locally `preview` runs on the R2
  // that Miniflare emulates under `.wrangler/state`, and nothing remote is
  // touched. `deploy` fills it with the build output before publishing.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "tuggi-enterprise-cache"
    }
  ],
  // The revalidation queue of OpenNext (open-next.config.ts): a route with a
  // `revalidate` that went stale is refreshed through it. Binding, class and
  // migration as the caching doc gives them, the same shape as
  // reserve-on-site/wrangler.jsonc. Removing the class later takes a
  // `deleted_classes` migration, which deletes the Durable Object.
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  // OpenNext calls its own Worker through this binding: the image optimizer and
  // the revalidation queue above both do. The get-started config declares it;
  // `service` must match `name` above, and changes with it.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tuggi-enterprise"
    }
  ],
  // `wrangler deploy` reapplies the whole Worker and turns off logs enabled only
  // on the dashboard. The rate limiter and the consent gate log through
  // console.error and console.warn, and that is the only evidence they leave.
  "observability": {
    "enabled": true
  }
}
