# Supabase — uma URL e DUAS chaves. As três são obrigatórias: o site não sobe
# sem elas (src/lib/supabase-server.ts lança na inicialização, de propósito).
#
# Cada nome diz o PODER da chave no banco, que é a única coisa que muda entre
# as duas. Um nome genérico como SUPABASE_API_KEY não diz nada sobre o que a
# chave pode fazer, e foi assim que uma chave trocou de poder sem ninguém ver.
SUPABASE_URL=https://your-project-ref.supabase.co

# Chave publicável (sb_publishable_... no painel, "Publishable key"). Sujeita à
# RLS: as requisições rodam como o papel `anon`. Usada por UM consumidor só,
# /api/leads, que insere em campaign.inbound_leads e não lê nada de volta.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# Chave de servico (a JWT legada `service_role`, ou a secret key nova). IGNORA
# a RLS inteira — nunca vai para o navegador, nunca entra em bundle. Usada por
# /api/attribution, /api/data-deletion e por tudo que passa por
# getSupabaseClient("serviceRole"): landing de parceiro, sitemap, unsubscribe.
# Os scripts de snapshot em scripts/*.mjs leem esta mesma variável.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Newsletter unsubscribe (página /[locale]/unsubscribe).
# DEVE ser o MESMO valor configurado como secret NEWSLETTER_SECRET na Edge
# Function send-newsletter do CMS (lá assina o link; aqui validamos a assinatura).
NEWSLETTER_SECRET=your_long_random_shared_secret_here
