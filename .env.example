# Supabase — uma URL e DUAS chaves. As três são obrigatórias: o site não sobe
# sem elas (src/lib/supabase-server.ts lança na inicialização, de propósito).
#
# Cada nome diz o PODER da chave no banco, que é a única coisa que muda entre
# as duas. Um nome genérico como SUPABASE_API_KEY não diz nada sobre o que a
# chave pode fazer, e foi assim que uma chave trocou de poder sem ninguém ver.
SUPABASE_URL=https://your-project-ref.supabase.co

# Chave publicável (sb_publishable_... no painel, "Publishable key"). Sujeita à
# RLS: as requisições rodam como o papel `anon`. Usada por UM consumidor só,
# /api/leads, que insere em campaign.inbound_leads e não lê nada de volta.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# Chave de servico (a JWT legada `service_role`, ou a secret key nova). IGNORA
# a RLS inteira — nunca vai para o navegador, nunca entra em bundle. Usada por
# /api/attribution, /api/data-deletion e por tudo que passa por
# getSupabaseClient("serviceRole"): landing de parceiro, sitemap, unsubscribe.
# Os scripts de snapshot em scripts/*.mjs leem esta mesma variável.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Newsletter unsubscribe (página /[locale]/unsubscribe).
# DEVE ser o MESMO valor configurado como secret NEWSLETTER_SECRET na Edge
# Function send-newsletter do CMS (lá assina o link; aqui validamos a assinatura).
NEWSLETTER_SECRET=your_long_random_shared_secret_here

# Segredo do contador de envios da proposta de parceria
# (/[locale]/parcerias/proposta → /api/partner-proposal).
#
# O limite por endereço é do banco (core.record_partner_form_attempt), e a chave
# do contador é um HMAC-SHA-256 do IP sob este segredo: o endereço em si nunca é
# guardado, nem em linha, nem em log. SEM ELE A ROTA RECUSA TODO ENVIO, de
# propósito — um digest sem segredo é reversível por força bruta sobre o espaço
# IPv4 inteiro, e cair para essa forma em silêncio seria pior do que recusar.
#
# DEVE ser o MESMO valor que o tuggi-cms usava enquanto o formulário morava lá:
# as linhas já escritas em core.partner_form_attempts foram chaveadas com ele.
# Trocar o segredo re-chaveia todo mundo, e custa no máximo uma janela de
# contagem (uma hora).
PARTNER_FORM_HASH_SECRET=your_long_random_shared_secret_here

# Origem que só resolve IPv4, para completar o clique com o IPv4 do visitante
# (POST /api/attribution/ip — contrato §4, card #682).
#
# `ip4.tuggi.app` é o MESMO deployment da Vercel, adicionado como CNAME
# DNS-only (nuvem cinza). Proxiado, a Cloudflare publica AAAA e o host perde a
# razão de existir: o navegador volta a falar IPv6 e a rota não observa IPv4
# nenhum. Aceite: `dig +short AAAA ip4.tuggi.app` tem de voltar VAZIO.
#
# É `NEXT_PUBLIC_` porque quem chama é o navegador, então o valor é embutido no
# bundle em tempo de BUILD — trocar depende de novo deploy, não de reiniciar.
# AUSENTE É ESTADO LEGAL e significa "não chama": sem ela nenhuma requisição
# sai, nada quebra, e só o caminho probabilístico fica sem essa rede.
NEXT_PUBLIC_ATTRIBUTION_IP_ORIGIN=https://ip4.tuggi.app
