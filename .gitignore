# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
# TUGGI_DIST_DIR builds (the e2e suite uses one so it never overwrites the
# .next/ a `next dev` on 3000 is serving from — see playwright.config.ts).
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...e o exemplo e o opt-in: e o unico lugar do repositorio que diz ao
# operador QUAIS variaveis a Vercel precisa ter. Ignorado, ele so existia na
# maquina de quem o escreveu (#132).
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Google Search Console exports (local analysis only)
https___*

# Memória dos agentes vive no workspace (../.claude/agent-memory/), não no repo do projeto.
.claude/agent-memory/
.claude/settings.local.json
.open-next/
